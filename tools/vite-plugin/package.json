{
  "name": "vite-plugin-metascript",
  "version": "0.1.0",
  "description": "Vite plugin for MetaScript — resolves .ms imports to compiler-emitted ES modules",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./rollup": {
      "types": "./rollup.d.ts",
      "default": "./rollup.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "compilerCore.js",
    "compilerCore.d.ts",
    "rollup.js",
    "rollup.d.ts"
  ],
  "dependencies": {
    "magic-string": "^0.30.17"
  },
  "peerDependencies": {
    "vite": ">=5",
    "rollup": ">=4"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true },
    "rollup": { "optional": true }
  }
}

// Writes std/crypto/pure/pcurveBaseTable.ms, the native base-point tables of std/crypto/pure/pcurve.
// Run from the repository root: msc run tools/crypto/genPcurveTables.ms

import { CurveMath, Point, p256Math, p384Math, basePoint, dbl, precompute } from "std/crypto/pure/pcurve";
import { mul, invert, Limbs } from "std/crypto/pure/montgomery";
import { exists, writeFile } from "std/fs";

export const pcurveBaseTablePath = "std/crypto/pure/pcurveBaseTable.ms";

function affineWords(cm: Readonly<CurveMath>, points: Readonly<Point[]>, stride: int32): uint32[] {
	const f = cm.field;
	const prefix: Limbs[] = [];
	let acc = f.one;
	for (const p of points) {
		prefix.push(acc);
		acc = mul(f, acc, p.z);
	}
	let inv = invert(f, acc);
	const out = new Array<uint32>(2 * stride * points.length);
	for (let i = points.length - 1; i >= 0; i--) {
		const zinv = mul(f, inv, prefix[i]);
		inv = mul(f, inv, points[i].z);
		const x = mul(f, points[i].x, zinv);
		const y = mul(f, points[i].y, zinv);
		for (let w = 0; w < f.words; w++) {
			out[2 * stride * i + w] = x[w];
			out[2 * stride * i + stride + w] = y[w];
		}
	}
	return out;
}

function baseWindowWords(cm: Readonly<CurveMath>): uint32[] {
	const points: Point[] = [];
	let base = basePoint(cm);
	for (let i = 0; i <= 8 * cm.field.words; i++) {
		const pc = precompute(cm, base, 8);
		for (let j = 1; j <= 8; j++) points.push(pc[j]);
		base = dbl(cm, pc[8]);
	}
	return affineWords(cm, points, cm.field.words);
}

function baseMultipleWords(cm: Readonly<CurveMath>): uint32[] {
	const pc = precompute(cm, basePoint(cm), 15);
	const points: Point[] = [];
	for (let j = 1; j < 16; j++) points.push(pc[j]);
	return affineWords(cm, points, 12);
}

function tableText(name: string, words: Readonly<uint32[]>): string {
	const lines: string[] = [];
	for (let i = 0; i < words.length; i += 8) {
		const row: string[] = [];
		for (let j = i; j < i + 8 && j < words.length; j++) row.push(`0x${words[j].toString(16).padStart(8, "0")}`);
		lines.push(`\t${row.join(", ")},`);
	}
	return `export const ${name}: Readonly<uint32[]> = [\n${lines.join("\n")}\n];\n`;
}

export function pcurveBaseTableText(): string {
	return [
		"// Generated by tools/crypto/genPcurveTables.ms from ./pcurve; edit the generator, not this file.\n",
		"// Regenerate from the repository root: msc run tools/crypto/genPcurveTables.ms\n",
		"/**\n",
		" * Window i of a curve holds j·16^i·G for j = 1 to 8 as affine x then y, Montgomery form, little-endian\n",
		" * 32-bit words, 2·size + 1 windows: entry j of window i starts at `(16 * i + 2 * (j - 1)) * words`.\n",
		" * The multiples hold 1·G to 15·G, 12 words per coordinate: entry j starts at `(j - 1) * 24`.\n",
		" */\n",
		tableText("p256Windows", baseWindowWords(p256Math)),
		"\n",
		tableText("p384Windows", baseWindowWords(p384Math)),
		"\n",
		tableText("p256Multiples", baseMultipleWords(p256Math)),
		"\n",
		tableText("p384Multiples", baseMultipleWords(p384Math)),
	].join("");
}

when (!testBuild) {
	if (!exists("std/crypto/pure/pcurve.ms")) throw new Error("genPcurveTables: run it from the repository root");
	const written = writeFile(pcurveBaseTablePath, pcurveBaseTableText());
	if (!written.ok) throw new Error(`genPcurveTables: cannot write ${pcurveBaseTablePath}`);
}

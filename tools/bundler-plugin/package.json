{
  "name": "metascript-bundler-plugin",
  "version": "0.1.0",
  "description": "MetaScript adapters for Vite, Rollup and webpack — resolve .ms imports to compiler-emitted ES modules",
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./core": {
      "types": "./compilerCore.d.ts",
      "default": "./compilerCore.js"
    },
    "./rollup": {
      "types": "./rollup.d.ts",
      "default": "./rollup.js"
    },
    "./webpack": {
      "types": "./webpack.d.ts",
      "default": "./webpack.js"
    },
    "./webpack/loader": "./webpackLoader.js"
  },
  "files": [
    "vite.js",
    "vite.d.ts",
    "compilerCore.js",
    "compilerCore.d.ts",
    "sourceDeclarations.js",
    "rollup.js",
    "rollup.d.ts",
    "webpack.js",
    "webpack.d.ts",
    "webpackLoader.js",
    "vendor"
  ],
  "dependencies": {
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "magic-string": "0.30.17",
    "rollup": "file:vendor/rollup4.tgz",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "webpack": "5.99.9"
  },
  "overrides": {
    "rollup": "$rollup"
  },
  "peerDependencies": {
    "vite": ">=5",
    "rollup": ">=4",
    "webpack": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true },
    "rollup": { "optional": true },
    "webpack": { "optional": true }
  }
}

/**
 * Process — JavaScript/Node.js Backend
 *
 * Mirrors the C backend API (std/process/index.cms) using Node.js built-ins.
 * readFile/writeFile re-exported from std/fs for backward compatibility.
 */

@import("node:process", { exit, cwd });
@import("node:child_process", { execSync, spawnSync });
@import("node:fs", { existsSync, readdirSync });
@import("node:os", { constants });

export extern function exit(code: number): never;
export extern function cwd(): string;
extern class process {
	static extern platform: string;
	static extern arch: string;
	static extern argv: string[];
}
extern function execSync(cmd: string): string;
extern function spawnSync(cmd: string, args: string[], options: SpawnOpts): SpawnResult;
extern function existsSync(path: string): boolean;
extern function readdirSync(path: string): string[];

interface SpawnOpts { stdio: string; }
interface SpawnResult { status: number; }

import { ProcessError, startFailed, nonZeroExit, signalTerminated } from "./errors";

export { ProcessError, ProcessErrorKind } from "./errors";
export { processError, spawnFailed, startFailed, notFound, nonZeroExit, signalTerminated, pipeError, isNotFound, isNonZeroExit, isRetryable } from "./errors";

// Re-export from fs (Result-returning)
export { readFile, writeFile } from "../fs/index";

// Node reports [node, script, ...args]; the C backend reports [argv0, ...args].
// Dropping node's own executable makes index 0 the program on both.
const nodeArgv: string[] = process.argv;
export const argv: string[] = nodeArgv.slice(1);

// Platform identifier — normalize Node's "win32" to our "windows" so MS code
// sees the same values across backends.
const nodePlatform: string = process.platform;
export const platform: string = nodePlatform == "win32" ? "windows" : nodePlatform;

const nodeArch: string = process.arch;
export const arch: string = nodeArch == "x64" ? "amd64"
	: nodeArch == "ia32" ? "i386"
	: nodeArch == "arm64" || nodeArch == "arm" || nodeArch == "riscv64" ? nodeArch
	: "other";

export function fileExists(path: string): boolean {
	return existsSync(path);
}

export function exec(command: string): number {
	execSync(command);
	return 0;
}

// Node-style `execFile`: no shell, forward-slash paths accepted natively.
export function execFile(path: string, args: string[] = []): number {
	const result = spawnSync(path, args, { stdio: "inherit" });
	return result.status;
}

interface Captured {
	startError: string;
	exitCode: int32;
	signal: int32;
	output: string;
	errorOutput: string;
}

function spawnCapture(path: string, args: string[], cwd: string): Captured {
	@emit(`const r = spawnSync(${path}, ${args}, { cwd: ${cwd} === "" ? undefined : ${cwd}, encoding: "utf8", maxBuffer: 16 * 1024 * 1024 });
return {
	startError: r.error ? (typeof r.error.code === "string" ? r.error.code : "UNKNOWN") : "",
	exitCode: r.status ?? 0,
	signal: r.signal ? (constants.signals[r.signal] ?? 0) : 0,
	output: r.stdout ?? "",
	errorOutput: r.stderr ?? "",
};`);
	unreachable;
}

export function execFileCapture(path: string, args: string[] = [], cwd: string = ""): Result<string, ProcessError> {
	const r = spawnCapture(path, args, cwd);
	if (r.startError != "") return Result.err(startFailed(path, r.startError));
	if (r.signal != 0) return Result.err(signalTerminated(path, r.signal, r.output, r.errorOutput));
	if (r.exitCode != 0) return Result.err(nonZeroExit(path, r.exitCode, r.output, r.errorOutput));
	return Result.ok(r.output);
}

// env — Deno-style namespaced env API.
export class env {
	static get(name: string): string {
		return "";
	}

	static set(name: string, value: string): boolean {
		return false;
	}

	static delete(name: string): boolean {
		return false;
	}
}

export function readDir(path: string): string[] {
	return readdirSync(path);
}

/**
 * Process — JavaScript/Node.js Backend
 *
 * Mirrors the C backend API (std/process/index.cms) using Node.js built-ins.
 * readFile/writeFile re-exported from std/fs for backward compatibility.
 */

@import("node:process", { exit, cwd });
@import("node:child_process", { spawnSync });
@import("node:fs", { existsSync, readdirSync });
@import("node:os", { constants });

export extern function exit(code: number): never;
export extern function cwd(): string;
extern class process {
	static extern platform: string;
	static extern arch: string;
	static extern argv: string[];
	static extern execPath: string;
}
extern function spawnSync(cmd: string, args: string[], options: SpawnOpts): SpawnResult;
extern function existsSync(path: string): boolean;
extern function readdirSync(path: string): string[];

interface SpawnOpts { stdio: string; }
interface SpawnResult { status: number; }

import { ProcessError, spawnFailed, startFailed, nonZeroExit, signalTerminated, pipeError } from "./errors";

export { ProcessError, ProcessErrorKind } from "./errors";
export { processError, spawnFailed, startFailed, notFound, nonZeroExit, signalTerminated, pipeError, isNotFound, isNonZeroExit, isRetryable } from "./errors";

// Re-export from fs (Result-returning)
export { readFile, writeFile } from "../fs/index";

// Node reports [node, script, ...args]; the C backend reports [argv0, ...args].
// Dropping node's own executable makes index 0 the program on both.
const nodeArgv: string[] = process.argv;
export const argv: string[] = nodeArgv.slice(1);
export const execPath: string = process.execPath;

// Platform identifier — normalize Node's "win32" to our "windows" so MS code
// sees the same values across backends.
const nodePlatform: string = process.platform;
export const platform: string = nodePlatform == "win32" ? "windows" : nodePlatform;

const nodeArch: string = process.arch;
export const arch: string = nodeArch == "x64" ? "amd64"
	: nodeArch == "ia32" ? "i386"
	: nodeArch == "arm64" || nodeArch == "arm" || nodeArch == "riscv64" ? nodeArch
	: "other";

export function fileExists(path: string): boolean {
	return existsSync(path);
}

export function exec(command: string): Result<string, ProcessError> {
	const r = spawnCapture(command, [], "", true, false);
	const failure = failureOf(command, r, true);
	if (failure != null) return Result.err(failure);
	return Result.ok(r.output);
}

export function execBytes(command: string): Result<Buffer, ProcessError> {
	const r = spawnCapture(command, [], "", true, true);
	const failure = failureOf(command, r, true);
	if (failure != null) return Result.err(failure);
	return Result.ok(r.outputBytes);
}

function failureOf(path: string, r: Captured, shell: boolean): ProcessError | null {
	if (r.startError != "") return shell ? spawnFailed(path, r.startError) : startFailed(path, r.startError);
	if (r.pipeError != "") return pipeError(path, r.pipeError);
	if (r.signal != 0) return signalTerminated(path, r.signal, r.output, r.errorOutput);
	if (r.exitCode != 0) return nonZeroExit(path, r.exitCode, r.output, r.errorOutput);
	return null;
}

// Node-style `execFile`: no shell, forward-slash paths accepted natively.
export function execFile(path: string, args: string[] = []): number {
	const result = spawnSync(path, args, { stdio: "inherit" });
	return result.status;
}

interface Captured {
	startError: string;
	startErrno: int32;
	pipeError: string;
	exitCode: int32;
	signal: int32;
	output: string;
	outputBytes: Buffer;
	errorOutput: string;
}

// `bytes` captures stdout as the bytes written (stderr still reads as text); otherwise `outputBytes` is empty.
function spawnCapture(path: string, args: string[], cwd: string, shell: boolean, bytes: boolean): Captured {
	@emit(`const r = spawnSync(${path}, ${args}, { cwd: ${cwd} === "" ? undefined : ${cwd}, shell: ${shell}, encoding: ${bytes} ? "buffer" : "utf8", maxBuffer: Infinity });
const code = r.error ? (typeof r.error.code === "string" ? r.error.code : "UNKNOWN") : "";
const started = !r.error || r.pid !== 0;
return {
	startError: started ? "" : code,
	startErrno: started ? 0 : (constants.errno[code] ?? 0),
	pipeError: started && r.error ? code : "",
	exitCode: r.status ?? 0,
	signal: r.signal ? (constants.signals[r.signal] ?? 0) : 0,
	output: ${bytes} ? (r.stdout ? r.stdout.toString("utf8") : "") : (r.stdout ?? ""),
	outputBytes: ${bytes} ? new Uint8Array(r.stdout ?? []) : new Uint8Array(0),
	errorOutput: ${bytes} ? (r.stderr ? r.stderr.toString("utf8") : "") : (r.stderr ?? ""),
};`);
	unreachable;
}

export function execFileCapture(path: string, args: string[] = [], cwd: string = ""): Result<string, ProcessError> {
	const r = spawnCapture(path, args, cwd, false, false);
	const failure = failureOf(path, r, false);
	if (failure != null) return Result.err(failure);
	return Result.ok(r.output);
}

export function execFileCaptureBytes(path: string, args: string[] = [], cwd: string = ""): Result<Buffer, ProcessError> {
	const r = spawnCapture(path, args, cwd, false, true);
	const failure = failureOf(path, r, false);
	if (failure != null) return Result.err(failure);
	return Result.ok(r.outputBytes);
}

export interface ExecFileResult {
	started: boolean;
	pipeOk: boolean;
	exitCode: int32;
	signal: int32;
	output: string;
	errorOutput: string;
	startErrno: int32;
}

export function execFileResult(path: string, args: string[] = [], cwd: string = ""): ExecFileResult {
	const r = spawnCapture(path, args, cwd, false, false);
	return {
		started: r.startError == "",
		pipeOk: r.pipeError == "",
		exitCode: r.exitCode,
		signal: r.signal,
		output: r.output,
		errorOutput: r.errorOutput,
		startErrno: r.startErrno,
	};
}

// env — Deno-style namespaced env API.
export class env {
	static get(name: string): string {
		@emit(`return process.env[${name}] ?? "";`);
		unreachable;
	}

	static set(name: string, value: string): boolean {
		@emit(`process.env[${name}] = ${value};
return true;`);
		unreachable;
	}

	static delete(name: string): boolean {
		@emit(`delete process.env[${name}];
return true;`);
		unreachable;
	}
}

export function readDir(path: string): string[] {
	return readdirSync(path);
}

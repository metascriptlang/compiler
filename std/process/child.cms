// A long-lived child process with its three pipes, driven synchronously.
//
// Every blocking call takes a deadline in milliseconds; 0 polls once. A read, write or wait
// also drains whichever other pipe is ready, so a child that floods stderr while the parent
// reads stdout, or that echoes while the parent is still writing, cannot deadlock it.
// A text chunk ends on a complete UTF-8 character: the bytes of a sequence the pipe delivered
// only in part wait for the next read, and an ill-formed sequence reads as U+FFFD. `readBytes`
// returns the bytes as they came.
// The async names readAsync, writeAsync and waitAsync are reserved for the same handle.

import {
	ProcessError,
	ProcessErrorKind,
	startFailed,
	errnoName,
	pipeError,
	timedOut,
	pipeClosed,
	outputOverflow,
} from "./errors";
import { incompleteTail } from "./utf8Tail";
import { utf8Text, wellFormedString } from "../core/string/bytes";
import { rawBuffer } from "../core/buffer/bytes";
import { childEnvironmentPairs } from "./environment";
import { CHILD_OK, CHILD_ENDED, CHILD_TIMEOUT, CHILD_PIPE_CLOSED, CHILD_OVERFLOW, SPAWN_MERGE_STDERR, SPAWN_OWN_GROUP } from "./outcome";
import { ChildCore, spawnChild, spawnUnsupported } from "./native";
import { platformName } from "./host";

const NO_SPAWN = "ENOSYS: process spawning is not supported on this target";

export enum ChildStream {
	Stdout,
	Stderr,
}

export struct ExitStatus {
	code: int32;
	signal: int32;
}

export struct ReadChunk {
	data: string;
	ended: boolean;
}

export struct ByteChunk {
	data: Buffer;
	ended: boolean;
}

export interface SpawnOptions {
	cwd?: string;
	mergeStderr?: boolean;
	ownProcessGroup?: boolean;
	env?: Record<string, string>;
}

export class ChildProcess {
	private core: ChildCore;
	pid: int32;
	command: string;
	private held: string[];

	constructor(core: ChildCore, command: string) {
		this.core = core;
		this.pid = core.pid;
		this.command = command;
		this.held = ["", ""];
	}

	// All bytes of `data`, or Timeout / PipeClosed naming how many were sent.
	write(data: string, timeoutMs: int32): Result<void, ProcessError> {
		const code = this.core.write(data, timeoutMs as int64);
		if (code == CHILD_OK) return Result.ok(null);
		const sent = `${this.core.written} of ${data.byteLength} bytes`;
		return Result.err(match (code) {
			CHILD_TIMEOUT => timedOut(this.command, `write after ${timeoutMs} ms, sent ${sent}`),
			CHILD_PIPE_CLOSED => pipeClosed(this.command, `stdin, sent ${sent}`),
			_ => this.osError("write"),
		});
	}

	closeStdin(): void {
		this.core.closeStdin();
	}

	// At least one byte, or `ended` at EOF. Timeout keeps whatever arrives later for the next read.
	read(stream: ChildStream, timeoutMs: int32): Result<ReadChunk, ProcessError> {
		const which = stream as int32;
		const code = this.core.read(which, timeoutMs as int64);
		if (code == CHILD_OK) return Result.ok({ data: this.takeText(which), ended: false });
		if (code == CHILD_ENDED) return Result.ok(this.endText(which));
		return Result.err(this.readFailure(stream, code, timeoutMs));
	}

	// The same read as `read`, with the bytes untouched.
	readBytes(stream: ChildStream, timeoutMs: int32): Result<ByteChunk, ProcessError> {
		const which = stream as int32;
		const code = this.core.read(which, timeoutMs as int64);
		if (code == CHILD_OK) {
			return Result.ok({ data: rawBuffer(this.core.take(which)), ended: false });
		}
		if (code == CHILD_ENDED) return Result.ok({ data: Buffer.alloc(0), ended: true });
		return Result.err(this.readFailure(stream, code, timeoutMs));
	}

	// Whatever stderr the pump has drained so far, decoded in full; does not wait.
	takeStderr(): string {
		const raw = this.held[1] + this.core.take(ChildStream.Stderr as int32);
		this.held[1] = "";
		return utf8Text(raw, false);
	}

	private takeText(which: int32): string {
		const raw = this.held[which] + this.core.take(which);
		const kept = incompleteTail(raw.asBytes());
		const length = raw.byteLength;
		this.held[which] = wellFormedString(raw.asBytes()[(length - kept)..length]);
		return utf8Text(raw.byteSlice(0, length - kept), false);
	}

	// At end of stream a held partial sequence is ill-formed: it reads as U+FFFD.
	private endText(which: int32): ReadChunk {
		const raw = this.held[which];
		this.held[which] = "";
		return { data: utf8Text(raw, false), ended: raw == "" };
	}

	private readFailure(stream: ChildStream, code: int32, timeoutMs: int32): ProcessError {
		const name = stream.toString().toLowerCase();
		return match (code) {
			CHILD_TIMEOUT => timedOut(this.command, `read ${name} after ${timeoutMs} ms`),
			CHILD_PIPE_CLOSED => pipeClosed(this.command, `${name} of a closed handle`),
			CHILD_OVERFLOW => outputOverflow(this.command, name),
			_ => this.osError(`read ${name}`),
		};
	}

	// The exit status, or Timeout with the child still running.
	wait(timeoutMs: int32): Result<ExitStatus, ProcessError> {
		const code = this.core.wait(timeoutMs as int64);
		if (code == CHILD_OK) return Result.ok(this.status());
		if (code == CHILD_TIMEOUT) {
			return Result.err(timedOut(this.command, `wait after ${timeoutMs} ms`));
		}
		return Result.err(this.osError("wait"));
	}

	// SIGKILL and reap; a child already reaped keeps its first status.
	kill(): Result<ExitStatus, ProcessError> {
		if (this.core.kill() == CHILD_OK) return Result.ok(this.status());
		return Result.err(this.osError("kill"));
	}

	// The most memory the reaped child and the children it waited for held at once, in bytes; null before it is reaped, where the OS does not say, and on Linux when it is no higher than this process's own peak, which a child's count starts from.
	peakRss(): number | null {
		const peak = this.core.peakRss();
		return peak > 0 ? peak as number : null;
	}

	// Kills and reaps a child still running and closes every pipe. Idempotent.
	close(): void {
		this.core.close();
	}

	private osError(what: string): ProcessError {
		return pipeError(this.command, `${what}: ${errnoName(this.core.lastErrno)}`);
	}

	private status(): ExitStatus {
		return { code: this.core.exitCode(), signal: this.core.signal() };
	}
}

// Starts `path` (searched on PATH when it has no slash) with stdin, stdout and stderr piped.
export function spawn(
	path: string,
	args: string[] = [],
	opts: SpawnOptions = {},
): Result<ChildProcess, ProcessError> {
	const flags: int32 = ((opts.mergeStderr ?? false) ? SPAWN_MERGE_STDERR : 0) | ((opts.ownProcessGroup ?? false) ? SPAWN_OWN_GROUP : 0);
	if ((flags & SPAWN_OWN_GROUP) != 0 && platformName() == "windows") return Result.err(startFailed(path, "ENOTSUP: ownProcessGroup is not supported on Windows yet"));
	const variables = opts.env;
	let environment: string[] | null = null;
	if (variables != null) {
		const prepared = childEnvironmentPairs(variables, platformName() == "windows");
		if (!prepared.ok) { return Result.err(startFailed(path, "EINVAL")); }
		environment = prepared.value;
	}
	const started = spawnChild(path, args, opts.cwd ?? "", flags, environment);
	if (started.ok) return Result.ok(new ChildProcess(started.value, path));
	if (spawnUnsupported(started.error)) return Result.err(startFailed(path, NO_SPAWN));
	return Result.err(startFailed(path, errnoName(started.error)));
}

// ===== Tests =====

function readAll(child: ChildProcess, stream: ChildStream): string {
	let text = "";
	for (let i = 0; i < 10000; i++) {
		const got = child.read(stream, 5000);
		if (!got.ok || got.value.ended) return text;
		text += got.value.data;
	}
	return text;
}

test "spawn of a missing program is NotFound naming ENOENT" {
	const r = spawn("/nonexistent/msProcChildProbe", []);
	assert !r.ok;
	if (!r.ok) {
		assert r.error.kind == ProcessErrorKind.NotFound;
		assert r.error.message.contains("ENOENT");
	}
}

const onWindows = platformName() == "windows";
const shell = onWindows ? "sh" : "/bin/sh";

test "spawn of a batch file on Windows is refused naming EINVAL" {
	if (!onWindows) return;
	for (const path of ["C:\\msProcChildProbe\\x.bat", "C:\\msProcChildProbe\\Y.CMD. "]) {
		const r = spawn(path, ["c&echo.PWNED"]);
		assert !r.ok;
		if (!r.ok) {
			assert r.error.kind == ProcessErrorKind.SpawnFailed;
			assert r.error.message == `spawnSync ${path} EINVAL`;
		}
	}
}

test "cwd sets the child's working directory" {
	const r = onWindows
		? spawn("cmd", ["/c", "cd"], { cwd: "C:\\" })
		: spawn("/bin/pwd", [], { cwd: "/" });
	assert r.ok;
	if (r.ok) {
		assert readAll(r.value, ChildStream.Stdout) == (onWindows ? "C:\\\r\n" : "/\n");
		r.value.close();
	}
}

test "mergeStderr sends stderr down stdout and leaves stderr ended" {
	const r = spawn(shell, ["-c", "echo out; echo err >&2"], { mergeStderr: true });
	assert r.ok;
	if (r.ok) {
		const child = r.value;
		assert readAll(child, ChildStream.Stdout) == "out\nerr\n";
		const err = child.read(ChildStream.Stderr, 0);
		assert err.ok && err.value.ended;
		child.close();
	}
}

test "kill ends every process a child in its own process group started" {
	const r = spawn(shell, ["-c", "sleep 30 & echo started; wait"], { ownProcessGroup: true });
	if (onWindows) {
		assert !r.ok && r.error.message.includes("ownProcessGroup is not supported on Windows yet");
		return;
	}
	assert r.ok;
	if (r.ok) {
		const child = r.value;
		const first = child.read(ChildStream.Stdout, 5000);
		assert first.ok && first.value.data == "started\n";
		const status = child.kill();
		assert status.ok && status.value.signal == 9;
		const after = child.read(ChildStream.Stdout, 5000);
		assert after.ok && after.value.ended;
		child.close();
	}
}

test "a closed handle refuses reads and writes and keeps its status" {
	const r = spawn(shell, ["-c", "exit 4"]);
	assert r.ok;
	if (r.ok) {
		const child = r.value;
		const status = child.wait(5000);
		assert status.ok && status.value.code == 4;
		child.close();
		const read = child.read(ChildStream.Stdout, 0);
		assert !read.ok && read.error.kind == ProcessErrorKind.PipeClosed;
		const sent = child.write("x", 0);
		assert !sent.ok && sent.error.kind == ProcessErrorKind.PipeClosed;
		const again = child.wait(0);
		assert again.ok && again.value.code == 4 && again.value.signal == 0;
	}
}

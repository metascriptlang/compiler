when (windows) {
	@include("windows.h");

	extern const CP_UTF8: uint32;
	extern const MB_ERR_INVALID_CHARS: uint32;
	extern const WC_ERR_INVALID_CHARS: uint32;
	extern function MultiByteToWideChar(
		codePage: uint32,
		flags: uint32,
		text: cstring,
		length: int32,
		wide: Ptr<uint16> | null,
		room: int32,
	): int32;
	extern function WideCharToMultiByte(
		codePage: uint32,
		flags: uint32,
		wide: Ptr<uint16>,
		length: int32,
		text: Ptr<uint8> | null,
		room: int32,
		fallback: Ptr<void> | null,
		usedFallback: Ptr<void> | null,
	): int32;
	extern function cMallocWide(size: uint64): Ptr<uint16> | null from "malloc";
	extern function cMallocBytes(size: uint64): Ptr<uint8> | null from "malloc";
	extern function cFreeBytes(bytes: Ptr<uint8>): void from "free";
	extern function msStringNew(data: cstring, length: int64): string;

	export extern function freeWide(wide: Ptr<uint16> | null): void from "free";

	export function allocWide(units: uint64): Ptr<uint16> | null {
		return cMallocWide(units * 2);
	}

	export function widePath(path: string): Ptr<uint16> | null {
		const units = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path as cstring, -1, null, 0);
		if (units <= 0) return null;
		const wide = allocWide(units as uint64);
		if (wide != null) {
			MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path as cstring, -1, wide, units);
		}
		return wide;
	}

	export function utf8Of(wide: Ptr<uint16>): string {
		const room = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide, -1, null, 0, null, null);
		if (room <= 0) return "";
		const bytes = cMallocBytes(room as uint64);
		if (bytes == null) return "";
		WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide, -1, bytes, room, null, null);
		const text = msStringNew(bytes as cstring, (room - 1) as int64);
		cFreeBytes(bytes);
		return text;
	}
}

@include("runtime/io/engine.h");
@compile("runtime/io/engineSelect.c");

import { IoError, IoErrorKind, ioError, notFound, permissionDenied, notDirectory } from "../io/errors";

extern function msFsWatchOpen_ms(path: string): int32;
extern function msFsWatchLastError(): int32;
extern function msIoWatchNext_ms(handle: int32, recursive: int32): Promise<string>;
extern function msFsWatchClose(handle: int32): void;
extern function msFsWriteSettled_ms(path: string): int32;
export extern function msIoRunOnce(timeoutMs: int32): int32;

const UNSUPPORTED = -2;

export class FsWatch {
	root: string;
	recursive: boolean;
	handle: int32;
	open: boolean;
	armed: Promise<string>;

	constructor(root: string, recursive: boolean, handle: int32) {
		this.root = root;
		this.recursive = recursive;
		this.handle = handle;
		this.open = true;
		this.armed = msIoWatchNext_ms(handle, recursive ? 1 : 0);
	}
}

export struct FsChanges {
	paths: string[];
	closed: string[];
	rescan: boolean;
	ended: boolean;
}

function openFailure(path: string, code: int32): IoError {
	return match (code) {
		2 | 3 => notFound(path),
		5 => permissionDenied(path),
		267 => notDirectory(path),
		_ => ioError(IoErrorKind.Unknown, path, `cannot watch ${path} (error ${code})`),
	};
}

export function watch(path: string, recursive: boolean = true): Result<FsWatch, IoError> {
	const handle = msFsWatchOpen_ms(path);
	if (handle == UNSUPPORTED) {
		return Result.err(ioError(IoErrorKind.Unknown, path, "file watching has no backend for this platform yet"));
	}
	if (handle < 0) return Result.err(openFailure(path, msFsWatchLastError()));
	return Result.ok(new FsWatch(path, recursive, handle));
}

export async function nextChanges(w: FsWatch): Promise<FsChanges> {
	if (!w.open) return { paths: [], closed: [], rescan: false, ended: true };
	const raw = await w.armed;
	if (raw == "") {
		w.open = false;
		return { paths: [], closed: [], rescan: false, ended: true };
	}
	if (w.open) w.armed = msIoWatchNext_ms(w.handle, w.recursive ? 1 : 0);
	if (raw == "*") return { paths: [], closed: [], rescan: true, ended: false };
	const paths: string[] = [];
	const closed: string[] = [];
	for (const line of raw.split("\n")) {
		const path = line.substring(1, line.length);
		if (!paths.includes(path)) paths.push(path);
		const at = closed.indexOf(path);
		if (line.startsWith("w")) {
			if (at < 0) closed.push(path);
		} else if (at >= 0) {
			closed.splice(at, 1);
		}
	}
	return { paths, closed, rescan: false, ended: false };
}

// True when no writer can still hold the file: absent, or (Windows) openable while denying
// writers. Linux cannot tell an open writer apart, so it answers false and reports closes in `closed`.
export function writeSettled(path: string): boolean {
	return msFsWriteSettled_ms(path) == 1;
}

export function closeWatch(w: FsWatch): void {
	if (!w.open) return;
	w.open = false;
	msFsWatchClose(w.handle);
}

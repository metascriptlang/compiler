import { asciiWords, utf8String } from "../core/string/bytes";

extern function msStringMarkAscii(s: string): void;

// The string the runtime read from outside as valid text: each ill-formed UTF-8 sequence becomes
// U+FFFD. An all-ASCII input is the same string, scanned once and not copied.
export function validText(raw: string): string {
	const bytes = raw.asBytes();
	const length = bytes.length as int64;
	if (length == 0) return raw;
	let i = asciiWords(bytes as Readonly<Ptr<uint8>>, length >> 3) << 3;
	while (i < length && bytes[i] < 0x80) i += 1;
	if (i < length) return utf8String(bytes, false);
	msStringMarkAscii(raw);
	return raw;
}

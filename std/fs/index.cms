// std/fs — File System

@include("runtime/fs/header.h");

import { IoError, ioErrorFromErrno, writeFailed } from "../io/errors";

extern function msFsLastErrno(): int32;
extern function msFsReadFile(path: string): string;
// Parked: readdir returns NULL at the end, and `Ptr<Dirent> | null` does not build yet
// (inbox 2026-10-22-nullable-ptr-to-extern-tag-struct-emits-a-field-copy-hook.md).
extern function msFsReadDirEntries(path: string): string;

const FAILED_WITHOUT_ERRNO: int32 = -1;

@include("errno.h");
@include("stdio.h");
@include("stdlib.h");
@include("sys/stat.h");

extern let errno: int32;
extern const EEXIST: int32;
extern struct FILE;
extern function cFopen(path: cstring, mode: cstring): Ptr<FILE> from "fopen";
extern function cFwrite(data: cstring, size: uint64, count: uint64, file: Ptr<FILE>): uint64 from "fwrite";
extern function cFclose(file: Ptr<FILE>): int32 from "fclose";
extern function cFree(p: Ptr<uint8>): void from "free";
extern function msStringFromCStr(s: cstring): string;
extern function msStringNew(data: cstring, length: int64): string;

when (windows) {
	@include("direct.h");
	@include("io.h");
	@include("windows.h");

	extern const EACCES: int32;
	extern const EISDIR: int32;
	extern const EINVAL: int32;
	extern const ENOMEM: int32;
	extern let _doserrno: uint32;
	extern function msFsErrnoFromWin32(code: uint32): int32;
	extern function cChmod(path: Ptr<uint16>, mode: int32): int32 from "_wchmod";
	extern function cMkdir(path: Ptr<uint16>): int32 from "_wmkdir";
	extern function cRmdir(path: Ptr<uint16>): int32 from "_wrmdir";
	extern function cUnlink(path: Ptr<uint16>): int32 from "_wunlink";
	extern function cWfopen(path: Ptr<uint16>, mode: Ptr<uint16>): Ptr<FILE> | null from "_wfopen";
	extern function cFullpath(resolved: Ptr<uint16> | null, path: Ptr<uint16>, length: uint64): Ptr<uint16> | null from "_wfullpath";
	extern function cStricmp(a: cstring, b: cstring): int32 from "_stricmp";
	extern function cMallocBytes(size: uint64): Ptr<uint8> | null from "malloc";
	extern function cMallocWide(size: uint64): Ptr<uint16> | null from "malloc";
	extern function cFreeWide(p: Ptr<uint16>): void from "free";

	extern struct Stat from "struct _stat64" { st_mode: uint16; st_size: int64; st_mtime: int64; }
	extern const S_IFMT: uint16;
	extern const S_IFREG: uint16;
	extern const S_IFDIR: uint16;

	extern const CP_UTF8: uint32;
	const UNIX_EPOCH_IN_FILETIME: int64 = 116444736000000000;
	const FILETIME_PER_SECOND: int64 = 10000000;
	extern const MOVEFILE_REPLACE_EXISTING: uint32;
	extern const SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE: uint32;
	extern const SYMBOLIC_LINK_FLAG_DIRECTORY: uint32;
	extern const INVALID_FILE_ATTRIBUTES: uint32;
	extern const FILE_ATTRIBUTE_DIRECTORY: uint32;
	extern const FILE_READ_ATTRIBUTES: uint32;
	extern const FILE_SHARE_READ: uint32;
	extern const FILE_SHARE_WRITE: uint32;
	extern const FILE_SHARE_DELETE: uint32;
	extern const OPEN_EXISTING: uint32;
	extern const FILE_FLAG_BACKUP_SEMANTICS: uint32;
	extern const FILE_NAME_NORMALIZED: uint32;
	extern const VOLUME_NAME_DOS: uint32;
	extern const FileBasicInfo: int32;
	extern const INVALID_HANDLE_VALUE: Ptr<void>;
	extern function GetLastError(): uint32;
	extern function CloseHandle(handle: Ptr<void>): int32;
	extern function MultiByteToWideChar(codePage: uint32, flags: uint32, text: cstring, length: int32, wide: Ptr<uint16> | null, room: int32): int32;
	extern function WideCharToMultiByte(codePage: uint32, flags: uint32, wide: Ptr<uint16>, length: int32, text: Ptr<uint8> | null, room: int32, fallback: Ptr<void> | null, usedFallback: Ptr<void> | null): int32;
	extern function MoveFileExW(oldPath: Ptr<uint16>, newPath: Ptr<uint16>, flags: uint32): int32;
	extern function GetFileAttributesW(path: Ptr<uint16>): uint32;
	extern function CreateSymbolicLinkW(path: Ptr<uint16>, target: Ptr<uint16>, flags: uint32): uint8;
	extern function CreateFileW(path: Ptr<uint16>, access: uint32, share: uint32, security: Ptr<void> | null, disposition: uint32, flags: uint32, template: Ptr<void> | null): Ptr<void>;
	extern function GetFinalPathNameByHandleW(handle: Ptr<void>, path: Ptr<uint16> | null, room: uint32, flags: uint32): uint32;
	extern struct LargeInteger from "LARGE_INTEGER" { QuadPart: int64; }
	extern struct FileTime from "FILETIME" { dwLowDateTime: uint32; dwHighDateTime: uint32; }
	extern struct HandleInformation from "BY_HANDLE_FILE_INFORMATION" {
		dwFileAttributes: uint32; ftLastWriteTime: FileTime;
		dwVolumeSerialNumber: uint32; nFileSizeHigh: uint32; nFileSizeLow: uint32;
		nFileIndexHigh: uint32; nFileIndexLow: uint32;
	}
	extern struct BasicInformation from "FILE_BASIC_INFO" { LastWriteTime: LargeInteger; ChangeTime: LargeInteger; }
	extern function GetFileInformationByHandle(handle: Ptr<void>, ref info: HandleInformation): int32;
	extern function GetFileInformationByHandleEx(handle: Ptr<void>, infoClass: int32, ref info: BasicInformation, size: uint32): int32;

	// UTF-16 length of a UTF-8 path including its NUL; 0 when it does not convert.
	function wideLength(path: cstring): int32 {
		return MultiByteToWideChar(CP_UTF8, 0, path, -1, null, 0);
	}
	function wideCopy(path: cstring, length: int32): Ptr<uint16> | null {
		const wide = cMallocWide((length as uint64) * 2);
		if (wide != null) MultiByteToWideChar(CP_UTF8, 0, path, -1, wide, length);
		return wide;
	}
	function widePath(path: string): Ptr<uint16> | null {
		const length = wideLength(path as cstring);
		return length > 0 ? wideCopy(path as cstring, length) : null;
	}

	function chmodErrno(path: string, mode: int32): int32 {
		const wide = widePath(path);
		if (wide == null) return EINVAL;
		const err = cChmod(wide, mode) == 0 ? 0 : errno;
		cFreeWide(wide);
		return err;
	}
	function rmdirErrno(path: string): int32 {
		const wide = widePath(path);
		if (wide == null) return EINVAL;
		_doserrno = 0;
		const done = cRmdir(wide) == 0;
		const err = done ? 0 : _doserrno != 0 ? msFsErrnoFromWin32(_doserrno) : errno;
		cFreeWide(wide);
		return err;
	}
	function mkdirErrno(path: string): int32 {
		const wide = widePath(path);
		if (wide == null) return EINVAL;
		const err = cMkdir(wide) == 0 ? 0 : errno;
		cFreeWide(wide);
		return err == EEXIST ? 0 : err;
	}
	function removeErrno(path: string): int32 {
		const wide = widePath(path);
		if (wide == null) return EINVAL;
		let err = cUnlink(wide) == 0 ? 0 : errno;
		if (err == EACCES && cChmod(wide, 438) == 0 && cUnlink(wide) == 0) err = 0;
		cFreeWide(wide);
		return err;
	}
	function writeFileErrno(path: string, content: string, mode: string): int32 {
		const widePathName = widePath(path);
		const wideMode = widePath(mode);
		if (widePathName == null || wideMode == null) {
			if (widePathName != null) cFreeWide(widePathName);
			if (wideMode != null) cFreeWide(wideMode);
			return EINVAL;
		}
		const file = cWfopen(widePathName, wideMode);
		const err = errno;
		cFreeWide(widePathName);
		cFreeWide(wideMode);
		if (file == null) return err == EACCES && isDirKernel(path) ? EISDIR : err;
		return writeAndClose(file, content);
	}

	// The CRT rename refuses an existing target; MoveFileExW replaces it, as POSIX rename
	// does. It fails with ACCESS_DENIED while a reader holds the target open without
	// FILE_SHARE_DELETE.
	function renameErrno(oldPath: string, newPath: string): int32 {
		const oldLength = wideLength(oldPath as cstring);
		const newLength = wideLength(newPath as cstring);
		if (oldLength <= 0 || newLength <= 0) return EINVAL;
		const oldWide = wideCopy(oldPath as cstring, oldLength);
		const newWide = wideCopy(newPath as cstring, newLength);
		if (oldWide == null || newWide == null) {
			if (oldWide != null) cFreeWide(oldWide);
			if (newWide != null) cFreeWide(newWide);
			return ENOMEM;
		}
		const moved = MoveFileExW(oldWide, newWide, MOVEFILE_REPLACE_EXISTING) != 0;
		const failure = moved ? 0 : GetLastError();
		cFreeWide(oldWide);
		cFreeWide(newWide);
		return moved ? 0 : msFsErrnoFromWin32(failure);
	}

	function symlinkErrno(target: string, path: string): int32 {
		const targetLength = wideLength(target as cstring);
		const pathLength = wideLength(path as cstring);
		if (targetLength <= 0 || pathLength <= 0) return EINVAL;
		const targetWide = wideCopy(target as cstring, targetLength);
		const pathWide = wideCopy(path as cstring, pathLength);
		if (targetWide == null || pathWide == null) {
			if (targetWide != null) cFreeWide(targetWide);
			if (pathWide != null) cFreeWide(pathWide);
			return ENOMEM;
		}
		for (let i = 0; i < targetLength; i++) {
			if (targetWide[i] == "/".code) targetWide[i] = "\\".code as uint16;
		}
		// A relative target is looked up from the working directory, not the link's.
		let flags = SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE;
		const attributes = GetFileAttributesW(targetWide);
		if (attributes != INVALID_FILE_ATTRIBUTES && (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0) {
			flags |= SYMBOLIC_LINK_FLAG_DIRECTORY;
		}
		const made = CreateSymbolicLinkW(pathWide, targetWide, flags) != 0;
		const failure = made ? 0 : GetLastError();
		cFreeWide(targetWide);
		cFreeWide(pathWide);
		return made ? 0 : msFsErrnoFromWin32(failure);
	}

	// No exec bit: any regular file counts, and the caller matches PATHEXT.
	function isExecutableKernel(path: string): boolean { return isFileKernel(path); }

	// _fullpath only normalizes the spelling; the path the opened file reports resolves
	// links. When that is the same spelling up to case, no link was crossed and the
	// caller's spelling stays.
	function realpathKernel(path: string): string {
		const wide = widePath(path);
		if (wide == null) return "";
		const full = cFullpath(null, wide, 0);
		cFreeWide(wide);
		if (full == null) return "";
		let st: Stat = {};
		let result = "";
		if (statOfWide(full, st)) {
			const spelled = utf8Of(full);
			const final = finalPath(full);
			result = final != "" && cStricmp(final as cstring, spelled as cstring) != 0 ? final : spelled;
		}
		cFreeWide(full);
		return result;
	}
	function finalPath(fullWide: Ptr<uint16>): string {
		const handle = CreateFileW(fullWide, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
			null, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, null);
		if (handle == INVALID_HANDLE_VALUE) return "";
		const flags = FILE_NAME_NORMALIZED | VOLUME_NAME_DOS;
		const need = GetFinalPathNameByHandleW(handle, null, 0, flags);
		const finalWide = need > 0 ? cMallocWide(((need + 1) as uint64) * 2) : null;
		const got = finalWide != null ? GetFinalPathNameByHandleW(handle, finalWide, need + 1, flags) : 0;
		CloseHandle(handle);
		if (finalWide == null) return "";
		const text = got != 0 && got <= need ? utf8Of(finalWide) : "";
		cFreeWide(finalWide);
		if (text.startsWith("\\\\?\\UNC\\")) return "\\" + text.slice(7, text.length);
		if (text.startsWith("\\\\?\\")) return text.slice(4, text.length);
		return text;
	}
	function utf8Of(wide: Ptr<uint16>): string {
		const room = WideCharToMultiByte(CP_UTF8, 0, wide, -1, null, 0, null, null);
		if (room <= 0) return "";
		const bytes = cMallocBytes(room as uint64);
		if (bytes == null) return "";
		WideCharToMultiByte(CP_UTF8, 0, wide, -1, bytes, room, null, null);
		const text = msStringNew(bytes as cstring, (room - 1) as int64);
		cFree(bytes);
		return text;
	}

	function statOf(path: string, ref st: Stat): boolean {
		const wide = widePath(path);
		if (wide == null) return false;
		const found = statOfWide(wide, st);
		cFreeWide(wide);
		return found;
	}
	function statOfWide(path: Ptr<uint16>, ref st: Stat): boolean {
		const file = CreateFileW(path, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
			null, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, null);
		if (file == INVALID_HANDLE_VALUE) return false;
		let info: HandleInformation = {};
		const ok = GetFileInformationByHandle(file, info) != 0;
		CloseHandle(file);
		if (!ok) return false;
		st.st_mode = (info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 ? S_IFDIR : S_IFREG;
		st.st_size = (((info.nFileSizeHigh as uint64) << 32) | (info.nFileSizeLow as uint64)) as int64;
		const written = (((info.ftLastWriteTime.dwHighDateTime as uint64) << 32) | (info.ftLastWriteTime.dwLowDateTime as uint64)) as int64;
		st.st_mtime = (written - UNIX_EPOCH_IN_FILETIME) / FILETIME_PER_SECOND;
		return true;
	}
	function modifiedTimeKernel(path: string): number {
		let st: Stat = {};
		return statOf(path, st) ? st.st_mtime as number : -1;
	}
	function changeStampKernel(path: string): string {
		const wide = widePath(path);
		if (wide == null) return "";
		const file = CreateFileW(wide, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
			null, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, null);
		cFreeWide(wide);
		if (file == INVALID_HANDLE_VALUE) return "";
		let info: HandleInformation = {};
		let basic: BasicInformation = {};
		const ok = GetFileInformationByHandle(file, info) != 0
			&& GetFileInformationByHandleEx(file, FileBasicInfo, basic, sizeof(BasicInformation) as uint32) != 0;
		CloseHandle(file);
		if (!ok || basic.ChangeTime.QuadPart == 0) return "";
		let buf: uint8[128] = [];
		let n = putDigits(buf, 0, info.dwVolumeSerialNumber as uint64, 1);
		buf[n] = 58; n = putDigits(buf, n + 1, info.nFileIndexHigh as uint64, 1);
		buf[n] = 46; n = putDigits(buf, n + 1, info.nFileIndexLow as uint64, 1);
		buf[n] = 58; n = putDigits(buf, n + 1, ((info.nFileSizeHigh as uint64) << 32) | (info.nFileSizeLow as uint64), 1);
		buf[n] = 58; n = putSigned(buf, n + 1, basic.LastWriteTime.QuadPart);
		buf[n] = 58; n = putSigned(buf, n + 1, basic.ChangeTime.QuadPart);
		return msStringNew(((buf as Span<uint8>) as Ptr<uint8>) as cstring, n as int64);
	}
} else {
	@include("unistd.h");

	extern function cChmod(path: cstring, mode: int32): int32 from "chmod";
	extern function cMkdir(path: cstring, mode: int32): int32 from "mkdir";
	extern function cRmdir(path: cstring): int32 from "rmdir";
	extern function cUnlink(path: cstring): int32 from "unlink";
	extern function cRename(oldPath: cstring, newPath: cstring): int32 from "rename";
	extern function cSymlink(target: cstring, path: cstring): int32 from "symlink";
	extern const X_OK: int32;
	extern function cAccess(path: cstring, mode: int32): int32 from "access";
	extern function cRealpath(path: cstring, resolved: Ptr<uint8> | null): Ptr<uint8> from "realpath";

	extern struct Timespec from "struct timespec" { tv_sec: int64; tv_nsec: int64; }
	when (macos || ios) {
		extern struct Stat from "struct stat" {
			st_dev: uint64; st_ino: uint64; st_mode: uint32; st_size: int64;
			st_mtimespec: Timespec; st_ctimespec: Timespec;
		}
		function mtimeOf(st: Stat): Timespec { return st.st_mtimespec; }
		function ctimeOf(st: Stat): Timespec { return st.st_ctimespec; }
	} else {
		extern struct Stat from "struct stat" {
			st_dev: uint64; st_ino: uint64; st_mode: uint32; st_size: int64;
			st_mtim: Timespec; st_ctim: Timespec;
		}
		function mtimeOf(st: Stat): Timespec { return st.st_mtim; }
		function ctimeOf(st: Stat): Timespec { return st.st_ctim; }
	}
	extern function cStat(path: cstring, ref buf: Stat): int32 from "stat";
	function statOf(path: string, ref st: Stat): boolean { return cStat(path as cstring, st) == 0; }
	extern const S_IFMT: uint32;
	extern const S_IFREG: uint32;
	extern const S_IFDIR: uint32;

	function chmodErrno(path: string, mode: int32): int32 {
		return cChmod(path as cstring, mode) == 0 ? 0 : errno;
	}
	function mkdirErrno(path: string): int32 {
		if (cMkdir(path as cstring, 493) == 0) return 0;
		const err = errno;
		return err == EEXIST ? 0 : err;
	}
	function rmdirErrno(path: string): int32 {
		return cRmdir(path as cstring) == 0 ? 0 : errno;
	}
	function renameErrno(oldPath: string, newPath: string): int32 {
		return cRename(oldPath as cstring, newPath as cstring) == 0 ? 0 : errno;
	}
	function symlinkErrno(target: string, path: string): int32 {
		return cSymlink(target as cstring, path as cstring) == 0 ? 0 : errno;
	}
	// Any later libc call (free included) may overwrite errno: read it straight after the
	// syscall, before anything else runs.
	function removeErrno(path: string): int32 {
		return cUnlink(path as cstring) == 0 ? 0 : errno;
	}
	function writeFileErrno(path: string, content: string, mode: string): int32 {
		const file = cFopen(path as cstring, mode as cstring);
		if (file == null) return errno;
		return writeAndClose(file, content);
	}
	function isExecutableKernel(path: string): boolean {
		when (wasm) {
			return false;
		} else {
			return cAccess(path as cstring, X_OK) == 0;
		}
	}
	function realpathKernel(path: string): string {
		const resolved = cRealpath(path as cstring, null);
		if (resolved == null) return "";
		const result = msStringFromCStr(resolved as cstring);
		cFree(resolved);
		return result;
	}

	function modifiedTimeKernel(path: string): number {
		let st: Stat = {};
		return cStat(path as cstring, st) == 0 ? mtimeOf(st).tv_sec as number : -1;
	}
	@inline
	function putTime(ref buf: uint8[128], at: int32, t: Timespec): int32 {
		const dot = putSigned(buf, at, t.tv_sec);
		buf[dot] = 46;
		return putDigits(buf, dot + 1, t.tv_nsec as uint64, 9);
	}
	function changeStampKernel(path: string): string {
		let st: Stat = {};
		if (cStat(path as cstring, st) != 0) return "";
		const changed = ctimeOf(st);
		if (changed.tv_sec == 0 && changed.tv_nsec == 0) return "";
		let buf: uint8[128] = [];
		let n = putDigits(buf, 0, st.st_dev, 1);
		buf[n] = 58; n = putDigits(buf, n + 1, st.st_ino, 1);
		buf[n] = 58; n = putSigned(buf, n + 1, st.st_size);
		buf[n] = 58; n = putTime(buf, n + 1, mtimeOf(st));
		buf[n] = 58; n = putTime(buf, n + 1, changed);
		return msStringNew(((buf as Span<uint8>) as Ptr<uint8>) as cstring, n as int64);
	}
}

function writeAndClose(file: Ptr<FILE>, content: string): int32 {
	const length = content.asBytes().length as uint64;
	let err: int32 = 0;
	if (cFwrite(content as cstring, 1, length, file) != length) err = errno != 0 ? errno : FAILED_WITHOUT_ERRNO;
	if (cFclose(file) != 0 && err == 0) err = errno != 0 ? errno : FAILED_WITHOUT_ERRNO;
	return err;
}

function existsKernel(path: string): boolean {
	let st: Stat = {};
	return statOf(path, st);
}
function isFileKernel(path: string): boolean {
	let st: Stat = {};
	return statOf(path, st) && (st.st_mode & S_IFMT) == S_IFREG;
}
function isDirKernel(path: string): boolean {
	let st: Stat = {};
	return statOf(path, st) && (st.st_mode & S_IFMT) == S_IFDIR;
}
function fileSizeKernel(path: string): number {
	let st: Stat = {};
	return statOf(path, st) ? st.st_size as number : -1;
}

// changeStamp runs once per cached source file, so it formats into one stack buffer
// as the C kernel did, instead of building intermediate strings.
@inline
function putDigits(ref buf: uint8[128], at: int32, value: uint64, width: int32): int32 {
	let digits = 1;
	let rest = value;
	while (rest >= 10) { rest = rest / 10; digits += 1; }
	if (digits < width) digits = width;
	let i = at + digits - 1;
	rest = value;
	while (i >= at) {
		buf[i] = (48 + rest % 10) as uint8;
		rest = rest / 10;
		i -= 1;
	}
	return at + digits;
}
@inline
function putSigned(ref buf: uint8[128], at: int32, value: int64): int32 {
	if (value >= 0) return putDigits(buf, at, value as uint64, 1);
	buf[at] = 45;
	return putDigits(buf, at + 1, (0 - (value + 1)) as uint64 + 1, 1);
}

function errnoResult(err: int32, path: string, what: string): Result<void, IoError> {
	if (err == 0) return Result.ok(null);
	if (err == FAILED_WITHOUT_ERRNO) return Result.err(writeFailed(path, what));
	return Result.err(ioErrorFromErrno(err, path));
}

// Path utilities (pure MetaScript)
export { dirname, basename, extname, join, resolve, isAbsolute, normalize } from "./path";

// ===== Result-returning API (primary) =====

export function readFile(path: string): Result<string, IoError> {
	const raw = msFsReadFile(path);
	const err = msFsLastErrno();
	if (err != 0) return Result.err(ioErrorFromErrno(err, path));
	return Result.ok(raw);
}

export function writeFile(path: string, content: string): Result<void, IoError> {
	return errnoResult(writeFileErrno(path, content, "wb"), path, "write failed");
}

export function appendFile(path: string, content: string): Result<void, IoError> {
	return errnoResult(writeFileErrno(path, content, "ab"), path, "append failed");
}

// Change POSIX permission bits on a path. Mode is passed as a decimal int32
// (e.g. 384 for rw------- = 0600).
export function chmod(path: string, mode: int32): Result<void, IoError> {
	return errnoResult(chmodErrno(path, mode), path, "chmod failed");
}

export function mkdir(path: string): Result<void, IoError> {
	return errnoResult(mkdirErrno(path), path, "mkdir failed");
}

export function rmdir(path: string): Result<void, IoError> {
	return errnoResult(rmdirErrno(path), path, "rmdir failed");
}

export function remove(path: string): Result<void, IoError> {
	return errnoResult(removeErrno(path), path, "remove failed");
}

// Recursively remove a file or directory tree, Go-style. Mirrors
// `os.RemoveAll`: a non-existent path returns ok so callers can clean up
// without racing isExist checks. Walks children depth-first, then rmdir's
// the root. Companion to `remove` (file only) for explicit intent —
// no boolean flag to misuse, two names read as the thing they do.
//
// Uses recursion — fine for msc cache layouts (~2 levels). Not suitable
// for pathological trees (> ~1000 deep). Symlink handling follows
// whatever runtime/fs/*.c does for remove().
export function removeAll(path: string): Result<void, IoError> {
	if (!exists(path)) return Result.ok(null);
	if (isDir(path)) {
		for (const entry of readDir(path)) {
			// readDir marks directories with a trailing "/" — strip for the child path.
			const name = entry.endsWith("/") ? entry.slice(0, entry.length - 1) : entry;
			const r = removeAll(path + "/" + name);
			if (!r.ok) return r;
		}
		return rmdir(path);
	}
	return remove(path);
}

export function symlink(target: string, path: string): Result<void, IoError> {
	return errnoResult(symlinkErrno(target, path), path, "symlink failed");
}

export function rename(oldPath: string, newPath: string): Result<void, IoError> {
	return errnoResult(renameErrno(oldPath, newPath), oldPath, "rename failed");
}

// ===== Predicates (stay as boolean — not fallible) =====

export function exists(path: string): boolean { return existsKernel(path); }
export function realpath(path: string): string { return realpathKernel(path); }
export function isFile(path: string): boolean { return isFileKernel(path); }
export function isDir(path: string): boolean { return isDirKernel(path); }
export function isExecutable(path: string): boolean { return isExecutableKernel(path); }
export function fileSize(path: string): number { return fileSizeKernel(path); }
export function modifiedTime(path: string): number { return modifiedTimeKernel(path); }
export function changeStamp(path: string): string { return changeStampKernel(path); }

// List directory entries. Directories have a trailing "/" marker.
// "." and ".." are always excluded. Returns an empty list on error or
// when the directory is empty — callers that need to distinguish should
// check `exists(path) && isDir(path)` first.
export function readDir(path: string): string[] {
	const result: string[] = [];
	for (const line of msFsReadDirEntries(path).split("\n")) {
		if (line != "") result.push(line);
	}
	return result;
}

// ===== Composed utilities =====

export function readLines(path: string): Result<string[], IoError> {
	const content = try readFile(path);
	if (content.length == 0) return Result.ok([]);
	return Result.ok(content.split("\n"));
}

export function writeLines(path: string, lines: string[]): Result<void, IoError> {
	return writeFile(path, lines.join("\n"));
}

export function copyFile(src: string, dst: string): Result<void, IoError> {
	const content = try readFile(src);
	return writeFile(dst, content);
}

export function ensureDir(path: string): Result<void, IoError> {
	if (exists(path)) return Result.ok(null);
	let i = 0;
	while (i < path.length) {
		if (path.charCodeAt(i) == "/".code) {
			if (i > 0) {
				const prefix = path.slice(0, i);
				if (!exists(prefix)) {
					const mkResult = mkdir(prefix);
					if (!mkResult.ok) return mkResult;
				}
			}
		}
		i = i + 1;
	}
	if (!exists(path)) {
		return mkdir(path);
	}
	return Result.ok(null);
}

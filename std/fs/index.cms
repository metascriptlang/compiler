// std/fs — File System (POSIX)

import {
	msFsReadFile, msFsWriteFileMode, msFsExists, msFsIsFile, msFsIsDir,
	msFsFileSize, msFsMkdir, msFsRmdir, msFsRemove, msFsRename,
} from "runtime/fs.h";

// Path utilities (pure MetaScript)
export { dirname, basename, extname, join, resolve, isAbsolute, normalize } from "./path";

// Direct C bindings
export extern function readFile(path: string): string from "msFsReadFile";
export extern function fileSize(path: string): number from "msFsFileSize";

// Boolean wrappers (C returns 1.0/0.0)
export function writeFile(path: string, content: string): boolean {
	return msFsWriteFileMode(path, content, "wb") === 1;
}

export function appendFile(path: string, content: string): boolean {
	return msFsWriteFileMode(path, content, "ab") === 1;
}

export function exists(path: string): boolean { return msFsExists(path) === 1; }
export function isFile(path: string): boolean { return msFsIsFile(path) === 1; }
export function isDir(path: string): boolean { return msFsIsDir(path) === 1; }
export function mkdir(path: string): boolean { return msFsMkdir(path) === 1; }
export function rmdir(path: string): boolean { return msFsRmdir(path) === 1; }
export function remove(path: string): boolean { return msFsRemove(path) === 1; }
export function rename(oldPath: string, newPath: string): boolean { return msFsRename(oldPath, newPath) === 1; }

// Pure MetaScript utilities
export function readLines(path: string): string[] {
	const content = msFsReadFile(path);
	if (content.length === 0) return [];
	return content.split("\n");
}

export function writeLines(path: string, lines: string[]): boolean {
	return msFsWriteFileMode(path, lines.join("\n"), "wb") === 1;
}

export function copyFile(src: string, dst: string): boolean {
	const content = msFsReadFile(src);
	if (content.length === 0) return false;
	return msFsWriteFileMode(dst, content, "wb") === 1;
}

export function ensureDir(path: string): boolean {
	if (msFsExists(path) === 1) return true;
	let i = 0;
	while (i < path.length) {
		if (path.charCodeAt(i) === "/".code) {
			if (i > 0) {
				const prefix = path.slice(0, i);
				if (msFsExists(prefix) !== 1) {
					if (msFsMkdir(prefix) !== 1) return false;
				}
			}
		}
		i = i + 1;
	}
	if (msFsExists(path) !== 1) {
		return msFsMkdir(path) === 1;
	}
	return true;
}

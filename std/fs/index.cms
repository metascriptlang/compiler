// std/fs — File System (POSIX)

@include("runtime/fs/header.h");

import { IoError, ioErrorFromErrno, writeFailed } from "../io/errors";

extern function msFsLastErrno(): int32;
extern function msFsReadFile(path: string): string;
// Parked: readdir returns NULL at the end, and `Ptr<Dirent> | null` does not build yet
// (inbox 2026-10-22-nullable-ptr-to-extern-tag-struct-emits-a-field-copy-hook.md).
extern function msFsReadDirEntries(path: string): string;

const FAILED_WITHOUT_ERRNO: int32 = -1;

when (windows) {
	extern function msFsChmod(path: string, mode: int32): number;
	extern function msFsMkdir(path: string): number;
	extern function msFsRmdir(path: string): number;
	extern function msFsRemove(path: string): number;
	extern function msFsRename(oldPath: string, newPath: string): number;
	extern function msFsSymlink(target: string, path: string): number;

	function lastErrnoOf(ok: number): int32 {
		if (ok == 1) return 0;
		const err = msFsLastErrno();
		return err != 0 ? err : FAILED_WITHOUT_ERRNO;
	}
	function chmodErrno(path: string, mode: int32): int32 { return lastErrnoOf(msFsChmod(path, mode)); }
	function mkdirErrno(path: string): int32 { return lastErrnoOf(msFsMkdir(path)); }
	function rmdirErrno(path: string): int32 { return lastErrnoOf(msFsRmdir(path)); }
	function removeErrno(path: string): int32 { return lastErrnoOf(msFsRemove(path)); }
	function renameErrno(oldPath: string, newPath: string): int32 { return lastErrnoOf(msFsRename(oldPath, newPath)); }
	function symlinkErrno(target: string, path: string): int32 { return lastErrnoOf(msFsSymlink(target, path)); }

	extern function msFsWriteFileMode(path: string, content: string, mode: string): number;
	extern function msFsIsExecutable(path: string): number;
	extern function msFsRealPath(path: string): string;

	function writeFileErrno(path: string, content: string, mode: string): int32 { return lastErrnoOf(msFsWriteFileMode(path, content, mode)); }
	function isExecutableKernel(path: string): boolean { return msFsIsExecutable(path) == 1; }
	function realpathKernel(path: string): string { return msFsRealPath(path); }

	extern function msFsExists(path: string): number;
	extern function msFsIsFile(path: string): number;
	extern function msFsIsDir(path: string): number;
	extern function msFsFileSize(path: string): number;
	extern function msFsModifiedTime(path: string): number;
	extern function msFsChangeStamp(path: string): string;

	function existsKernel(path: string): boolean { return msFsExists(path) == 1; }
	function isFileKernel(path: string): boolean { return msFsIsFile(path) == 1; }
	function isDirKernel(path: string): boolean { return msFsIsDir(path) == 1; }
	function fileSizeKernel(path: string): number { return msFsFileSize(path); }
	function modifiedTimeKernel(path: string): number { return msFsModifiedTime(path); }
	function changeStampKernel(path: string): string { return msFsChangeStamp(path); }
} else {
	@include("errno.h");
	@include("stdio.h");
	@include("stdlib.h");
	@include("unistd.h");
	@include("sys/stat.h");

	extern let errno: int32;
	extern const EEXIST: int32;
	extern function cChmod(path: cstring, mode: int32): int32 from "chmod";
	extern function cMkdir(path: cstring, mode: int32): int32 from "mkdir";
	extern function cRmdir(path: cstring): int32 from "rmdir";
	extern function cUnlink(path: cstring): int32 from "unlink";
	extern function cRename(oldPath: cstring, newPath: cstring): int32 from "rename";
	extern function cSymlink(target: cstring, path: cstring): int32 from "symlink";
	extern struct FILE;
	extern function cFopen(path: cstring, mode: cstring): Ptr<FILE> from "fopen";
	extern function cFwrite(data: cstring, size: uint64, count: uint64, file: Ptr<FILE>): uint64 from "fwrite";
	extern function cFclose(file: Ptr<FILE>): int32 from "fclose";
	extern const X_OK: int32;
	extern function cAccess(path: cstring, mode: int32): int32 from "access";
	extern function cRealpath(path: cstring, resolved: Ptr<uint8> | null): Ptr<uint8> from "realpath";
	extern function cFree(p: Ptr<uint8>): void from "free";
	extern function msStringFromCStr(s: cstring): string;
	extern function msStringNew(data: cstring, length: int64): string;

	extern struct Timespec from "struct timespec" { tv_sec: int64; tv_nsec: int64; }
	when (macos || ios) {
		extern struct Stat from "struct stat" {
			st_dev: uint64; st_ino: uint64; st_mode: uint32; st_size: int64;
			st_mtimespec: Timespec; st_ctimespec: Timespec;
		}
		function mtimeOf(st: Stat): Timespec { return st.st_mtimespec; }
		function ctimeOf(st: Stat): Timespec { return st.st_ctimespec; }
	} else {
		extern struct Stat from "struct stat" {
			st_dev: uint64; st_ino: uint64; st_mode: uint32; st_size: int64;
			st_mtim: Timespec; st_ctim: Timespec;
		}
		function mtimeOf(st: Stat): Timespec { return st.st_mtim; }
		function ctimeOf(st: Stat): Timespec { return st.st_ctim; }
	}
	extern const S_IFMT: uint32;
	extern const S_IFREG: uint32;
	extern const S_IFDIR: uint32;
	extern function cStat(path: cstring, ref buf: Stat): int32 from "stat";

	// POSIX lets any later libc call (free included) overwrite errno: read it straight
	// after the syscall, before anything else runs.

	function chmodErrno(path: string, mode: int32): int32 {
		return cChmod(path as cstring, mode) == 0 ? 0 : errno;
	}
	function mkdirErrno(path: string): int32 {
		if (cMkdir(path as cstring, 493) == 0) return 0;
		const err = errno;
		return err == EEXIST ? 0 : err;
	}
	function rmdirErrno(path: string): int32 {
		return cRmdir(path as cstring) == 0 ? 0 : errno;
	}
	function removeErrno(path: string): int32 {
		return cUnlink(path as cstring) == 0 ? 0 : errno;
	}
	function renameErrno(oldPath: string, newPath: string): int32 {
		return cRename(oldPath as cstring, newPath as cstring) == 0 ? 0 : errno;
	}
	function symlinkErrno(target: string, path: string): int32 {
		return cSymlink(target as cstring, path as cstring) == 0 ? 0 : errno;
	}
	function writeFileErrno(path: string, content: string, mode: string): int32 {
		const file = cFopen(path as cstring, mode as cstring);
		if (file == null) return errno;
		const length = content.asBytes().length as uint64;
		let err: int32 = 0;
		if (cFwrite(content as cstring, 1, length, file) != length) err = errno != 0 ? errno : FAILED_WITHOUT_ERRNO;
		if (cFclose(file) != 0 && err == 0) err = errno != 0 ? errno : FAILED_WITHOUT_ERRNO;
		return err;
	}
	function isExecutableKernel(path: string): boolean {
		when (wasm) {
			return false;
		} else {
			return cAccess(path as cstring, X_OK) == 0;
		}
	}
	function realpathKernel(path: string): string {
		const resolved = cRealpath(path as cstring, null);
		if (resolved == null) return "";
		const result = msStringFromCStr(resolved as cstring);
		cFree(resolved);
		return result;
	}

	function existsKernel(path: string): boolean {
		let st: Stat = {};
		return cStat(path as cstring, st) == 0;
	}
	function isFileKernel(path: string): boolean {
		let st: Stat = {};
		return cStat(path as cstring, st) == 0 && (st.st_mode & S_IFMT) == S_IFREG;
	}
	function isDirKernel(path: string): boolean {
		let st: Stat = {};
		return cStat(path as cstring, st) == 0 && (st.st_mode & S_IFMT) == S_IFDIR;
	}
	function fileSizeKernel(path: string): number {
		let st: Stat = {};
		return cStat(path as cstring, st) == 0 ? st.st_size as number : -1;
	}
	function modifiedTimeKernel(path: string): number {
		let st: Stat = {};
		return cStat(path as cstring, st) == 0 ? mtimeOf(st).tv_sec as number : -1;
	}
	// changeStamp runs once per cached source file, so it formats into one stack buffer
	// as the C kernel did, instead of building intermediate strings.
	@inline
	function putDigits(ref buf: uint8[128], at: int32, value: uint64, width: int32): int32 {
		let digits = 1;
		let rest = value;
		while (rest >= 10) { rest = rest / 10; digits += 1; }
		if (digits < width) digits = width;
		let i = at + digits - 1;
		rest = value;
		while (i >= at) {
			buf[i] = (48 + rest % 10) as uint8;
			rest = rest / 10;
			i -= 1;
		}
		return at + digits;
	}
	@inline
	function putSigned(ref buf: uint8[128], at: int32, value: int64): int32 {
		if (value >= 0) return putDigits(buf, at, value as uint64, 1);
		buf[at] = 45;
		return putDigits(buf, at + 1, (0 - (value + 1)) as uint64 + 1, 1);
	}
	@inline
	function putTime(ref buf: uint8[128], at: int32, t: Timespec): int32 {
		const dot = putSigned(buf, at, t.tv_sec);
		buf[dot] = 46;
		return putDigits(buf, dot + 1, t.tv_nsec as uint64, 9);
	}
	function changeStampKernel(path: string): string {
		let st: Stat = {};
		if (cStat(path as cstring, st) != 0) return "";
		const changed = ctimeOf(st);
		if (changed.tv_sec == 0 && changed.tv_nsec == 0) return "";
		let buf: uint8[128] = [];
		let n = putDigits(buf, 0, st.st_dev, 1);
		buf[n] = 58; n = putDigits(buf, n + 1, st.st_ino, 1);
		buf[n] = 58; n = putSigned(buf, n + 1, st.st_size);
		buf[n] = 58; n = putTime(buf, n + 1, mtimeOf(st));
		buf[n] = 58; n = putTime(buf, n + 1, changed);
		return msStringNew(((buf as Span<uint8>) as Ptr<uint8>) as cstring, n as int64);
	}
}

function errnoResult(err: int32, path: string, what: string): Result<void, IoError> {
	if (err == 0) return Result.ok(null);
	if (err == FAILED_WITHOUT_ERRNO) return Result.err(writeFailed(path, what));
	return Result.err(ioErrorFromErrno(err, path));
}

// Path utilities (pure MetaScript)
export { dirname, basename, extname, join, resolve, isAbsolute, normalize } from "./path";

// ===== Result-returning API (primary) =====

export function readFile(path: string): Result<string, IoError> {
	const raw = msFsReadFile(path);
	const err = msFsLastErrno();
	if (err != 0) return Result.err(ioErrorFromErrno(err, path));
	return Result.ok(raw);
}

export function writeFile(path: string, content: string): Result<void, IoError> {
	return errnoResult(writeFileErrno(path, content, "wb"), path, "write failed");
}

export function appendFile(path: string, content: string): Result<void, IoError> {
	return errnoResult(writeFileErrno(path, content, "ab"), path, "append failed");
}

// Change POSIX permission bits on a path. Mode is passed as a decimal int32
// (e.g. 384 for rw------- = 0600). No-op on Windows.
export function chmod(path: string, mode: int32): Result<void, IoError> {
	return errnoResult(chmodErrno(path, mode), path, "chmod failed");
}

export function mkdir(path: string): Result<void, IoError> {
	return errnoResult(mkdirErrno(path), path, "mkdir failed");
}

export function rmdir(path: string): Result<void, IoError> {
	return errnoResult(rmdirErrno(path), path, "rmdir failed");
}

export function remove(path: string): Result<void, IoError> {
	return errnoResult(removeErrno(path), path, "remove failed");
}

// Recursively remove a file or directory tree, Go-style. Mirrors
// `os.RemoveAll`: a non-existent path returns ok so callers can clean up
// without racing isExist checks. Walks children depth-first, then rmdir's
// the root. Companion to `remove` (file only) for explicit intent —
// no boolean flag to misuse, two names read as the thing they do.
//
// Uses recursion — fine for msc cache layouts (~2 levels). Not suitable
// for pathological trees (> ~1000 deep). Symlink handling follows
// whatever runtime/fs/*.c does for remove().
export function removeAll(path: string): Result<void, IoError> {
	if (!exists(path)) return Result.ok(null);
	if (isDir(path)) {
		for (const entry of readDir(path)) {
			// readDir marks directories with a trailing "/" — strip for the child path.
			const name = entry.endsWith("/") ? entry.slice(0, entry.length - 1) : entry;
			const r = removeAll(path + "/" + name);
			if (!r.ok) return r;
		}
		return rmdir(path);
	}
	return remove(path);
}

export function symlink(target: string, path: string): Result<void, IoError> {
	return errnoResult(symlinkErrno(target, path), path, "symlink failed");
}

export function rename(oldPath: string, newPath: string): Result<void, IoError> {
	return errnoResult(renameErrno(oldPath, newPath), oldPath, "rename failed");
}

// ===== Predicates (stay as boolean — not fallible) =====

export function exists(path: string): boolean { return existsKernel(path); }
export function realpath(path: string): string { return realpathKernel(path); }
export function isFile(path: string): boolean { return isFileKernel(path); }
export function isDir(path: string): boolean { return isDirKernel(path); }
export function isExecutable(path: string): boolean { return isExecutableKernel(path); }
export function fileSize(path: string): number { return fileSizeKernel(path); }
export function modifiedTime(path: string): number { return modifiedTimeKernel(path); }
export function changeStamp(path: string): string { return changeStampKernel(path); }

// List directory entries. Directories have a trailing "/" marker.
// "." and ".." are always excluded. Returns an empty list on error or
// when the directory is empty — callers that need to distinguish should
// check `exists(path) && isDir(path)` first.
export function readDir(path: string): string[] {
	const result: string[] = [];
	for (const line of msFsReadDirEntries(path).split("\n")) {
		if (line != "") result.push(line);
	}
	return result;
}

// ===== Composed utilities =====

export function readLines(path: string): Result<string[], IoError> {
	const content = try readFile(path);
	if (content.length == 0) return Result.ok([]);
	return Result.ok(content.split("\n"));
}

export function writeLines(path: string, lines: string[]): Result<void, IoError> {
	return writeFile(path, lines.join("\n"));
}

export function copyFile(src: string, dst: string): Result<void, IoError> {
	const content = try readFile(src);
	return writeFile(dst, content);
}

export function ensureDir(path: string): Result<void, IoError> {
	if (exists(path)) return Result.ok(null);
	let i = 0;
	while (i < path.length) {
		if (path.charCodeAt(i) == "/".code) {
			if (i > 0) {
				const prefix = path.slice(0, i);
				if (!exists(prefix)) {
					const mkResult = mkdir(prefix);
					if (!mkResult.ok) return mkResult;
				}
			}
		}
		i = i + 1;
	}
	if (!exists(path)) {
		return mkdir(path);
	}
	return Result.ok(null);
}

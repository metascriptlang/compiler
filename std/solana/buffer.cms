@include("runtime/solana/solana.h");
@compile("runtime/solana/host.c");

import { Pubkey } from "./pubkey";
import { ProgramError } from "./error";

extern function msSolPointer(address: uint64): Ptr<void>;
extern function msSolStoreU8(address: uint64, value: uint8): void;
extern function msSolStoreU16(address: uint64, value: uint16): void;
extern function msSolStoreU32(address: uint64, value: uint32): void;
extern function msSolStoreU64(address: uint64, value: uint64): void;
extern function msSolCopy(destination: uint64, source: uint64, length: uint64): void;
extern function msSolSpanAddress(data: Readonly<Span<uint8>>): uint64;

export struct Bytes {
	address: uint64;
	length: uint64;
}

export function storePubkey(key: Pubkey, address: uint64): void {
	const at = msSolPointer(address) as Ptr<Pubkey>;
	at[] = key;
}

// A BorshBuffer writes into storage the caller declared: valid while that frame runs, never returned.
export struct BorshBuffer {
	address: uint64;
	capacity: uint64;
	cursor: uint64;
}

export function borshBuffer(storage: Span<uint8>): BorshBuffer {
	return { address: msSolSpanAddress(storage), capacity: storage.length as uint64, cursor: 0 };
}

function reserved(buffer: BorshBuffer, width: uint64): uint64 {
	if (buffer.cursor > buffer.capacity || width > buffer.capacity - buffer.cursor) { return 0; }
	return buffer.address + buffer.cursor;
}

function filled(buffer: BorshBuffer, at: uint64, width: uint64): BorshBuffer {
	if (at == 0) { return { ...buffer, cursor: buffer.capacity + 1 }; }
	return { ...buffer, cursor: buffer.cursor + width };
}

export function u8(this buffer: BorshBuffer, value: uint8): BorshBuffer {
	const at = reserved(buffer, 1);
	if (at != 0) { msSolStoreU8(at, value); }
	return filled(buffer, at, 1);
}

export function u16(this buffer: BorshBuffer, value: uint16): BorshBuffer {
	const at = reserved(buffer, 2);
	if (at != 0) { msSolStoreU16(at, value); }
	return filled(buffer, at, 2);
}

export function u32(this buffer: BorshBuffer, value: uint32): BorshBuffer {
	const at = reserved(buffer, 4);
	if (at != 0) { msSolStoreU32(at, value); }
	return filled(buffer, at, 4);
}

export function u64(this buffer: BorshBuffer, value: uint64): BorshBuffer {
	const at = reserved(buffer, 8);
	if (at != 0) { msSolStoreU64(at, value); }
	return filled(buffer, at, 8);
}

export function i8(this buffer: BorshBuffer, value: int8): BorshBuffer {
	return buffer.u8(value as uint8);
}
export function i16(this buffer: BorshBuffer, value: int16): BorshBuffer {
	return buffer.u16(value as uint16);
}
export function i32(this buffer: BorshBuffer, value: int32): BorshBuffer {
	return buffer.u32(value as uint32);
}
export function i64(this buffer: BorshBuffer, value: int64): BorshBuffer {
	return buffer.u64(value as uint64);
}

export function bool(this buffer: BorshBuffer, value: boolean): BorshBuffer {
	return buffer.u8(value ? 1 : 0);
}

export function pubkey(this buffer: BorshBuffer, value: Pubkey): BorshBuffer {
	const at = reserved(buffer, 32);
	if (at != 0) { storePubkey(value, at); }
	return filled(buffer, at, 32);
}

export function bytes(this buffer: BorshBuffer, value: Bytes): BorshBuffer {
	const at = reserved(buffer, value.length);
	if (at != 0 && value.length > 0) { msSolCopy(at, value.address, value.length); }
	return filled(buffer, at, value.length);
}

export function overflowed(this buffer: BorshBuffer): boolean {
	return buffer.cursor > buffer.capacity;
}

export function written(this buffer: BorshBuffer): Result<Bytes, ProgramError> {
	if (buffer.overflowed()) { return Result.err(ProgramError.invalidArgument()); }
	const view: Bytes = { address: buffer.address, length: buffer.cursor };
	return Result.ok(view);
}

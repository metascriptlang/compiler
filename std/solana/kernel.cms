@include("runtime/solana/solana.h");
@compile("runtime/solana/host.c");

when (!solana) {
	import "./simulatorCrypto";
	import "./simulatorInvoke";
	import "./simulatorLog";
	import "./simulatorPrograms";
	import "./simulatorToken";
}

export extern function msSolInvokeMetas(
	program: uint64,
	metas: uint64,
	count: uint64,
	data: uint64,
	length: uint64,
	signers: uint64,
	signerCount: uint64,
): uint64;
export extern function msSolAccountCount(): uint64;
export extern function msSolAccountAt(index: uint64): uint64;
export extern function msSolAccountSlot(index: uint64): uint64;
export extern function msSolInstructionData(): uint64;
export extern function msSolInstructionDataLength(): uint64;
export extern function msSolSetResult(code: uint64): void;
export extern function msSolScratch(size: uint64): uint64;
export extern function msSolResult(): uint64;
export extern function msSolLog(address: uint64, length: uint64): void;
export extern function msSolLog64(a: uint64, b: uint64, c: uint64, d: uint64, e: uint64): void;
export extern function msSolLogPubkey(address: uint64): void;
export extern function msSolLogData(address: uint64, length: uint64): void;
export extern function msSolLogComputeUnits(): void;
export extern function msSolRemainingComputeUnits(): uint64;
export extern function msSolGetClock(out: uint64): uint64;
export extern function msSolRentAddress(): uint64;
export extern function msSolCurveValidatePoint(curve: uint64, point: uint64, result: uint64): uint64;
export extern function msSolSetReturnData(data: Readonly<Span<uint8>>): void;
export extern function msSolGetReturnData(data: uint64, length: uint64, programId: uint64): uint64;
export extern function msSolDeriveAddress(table: uint64, count: uint64, bump: uint64, program: uint64, out: uint64): uint64;
export extern function msSolFindAddress(table: uint64, count: uint64, program: uint64, out: uint64, bumpOut: uint64): uint64;
export extern function msSolFindCanonicalAddress(table: uint64, count: uint64, program: uint64, expected: uint64, bumpOut: uint64): uint64;
export extern function msSolFindExpectedAddress(table: uint64, count: uint64, program: uint64, expected: uint64, bumpOut: uint64): uint64;
export extern function msSolSeedStageInPlace(table: uint64, count: uint64, bump: uint64, program: uint64): uint64;
export extern function msSolFindExpectedStaged(table: uint64, used: uint64, expected: uint64): uint64;
export extern function msSolFindCanonicalStaged(table: uint64, used: uint64, expected: uint64): uint64;
export extern function msSolHashIsStaged(table: uint64, used: uint64, bump: uint64, expected: uint64): uint64;

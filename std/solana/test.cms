	maker: Pubkey;
	done: boolean;
}

function emitEntry(): void {
	const made: Made = { amount: 1234, maker: keyOf(7), done: true };
	emit<Made>(made);
}

test "emit logs Anchor's event discriminator and the Borsh fields as Program data" {
	const none: HostAccount[] = [];

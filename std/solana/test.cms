function crowdEntry(): void {
	const crowd: Crowd = {
		key0: patternedKey(),
		key1: patternedKey(),
		key2: patternedKey(),
		key3: patternedKey(),
		key4: patternedKey(),
		key5: patternedKey(),
		key6: patternedKey(),
		key7: patternedKey(),
		key8: patternedKey(),
		key9: patternedKey(),
		key10: patternedKey(),
		key11: patternedKey(),
		key12: patternedKey(),
		key13: patternedKey(),
		key14: patternedKey(),
		key15: patternedKey(),
		key16: patternedKey(),
		key17: patternedKey(),
		key18: patternedKey(),
		key19: patternedKey(),
		key20: patternedKey(),
		key21: patternedKey(),
		key22: patternedKey(),
		key23: patternedKey(),
		key24: patternedKey(),
		key25: patternedKey(),
		key26: patternedKey(),
		key27: patternedKey(),

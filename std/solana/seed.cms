@include("runtime/solana/solana.h");
@compile("runtime/solana/host.c");

import { Pubkey } from "./pubkey";
import { ProgramError } from "./error";

extern function msSolProgramId(): uint64;
extern function msSolLoadU64(address: uint64): uint64;
extern function msSolCopy(destination: uint64, source: uint64, length: uint64): void;
extern function msSolStringAddress(text: string): uint64;
extern function msSolStringLength(text: string): uint64;
extern function msSolSpanAddress(data: Readonly<Span<uint8>>): uint64;
extern function msSolTableAddress(table: Span<SeedSlice>): uint64 from "msSolSpanAddress";
extern function msSolSeedsAddress(table: Readonly<Span<SeedSlice>>): uint64 from "msSolSpanAddress";
extern function msSolSignersAddress(table: Readonly<Span<SignerSeeds>>): uint64 from "msSolSpanAddress";
extern function msSolSha256(slices: uint64, count: uint64, out: uint64): uint64;
extern function msSolCurveValidatePoint(curve: uint64, point: uint64, result: uint64): uint64;

const MAX_SEEDS: uint64 = 16;
const MAX_SEED_LENGTH: uint64 = 32;

// A SeedSlice points into the frame that built it: valid while that call runs, never returned.
export struct SeedSlice {
	address: uint64;
	length: uint64;
}

export struct SignerSeeds {
	address: uint64;
	length: uint64;
}

export struct Signing {
	table: uint64;
	count: uint64;
}

export struct ProgramAddress {
	key: Pubkey;
	bump: uint8;
}

export struct SeedTable {
	slices: SeedSlice[16];
	bump: uint8[1];
	count: uint64;
}

export function seedText(text: string): SeedSlice {
	return { address: msSolStringAddress(text), length: msSolStringLength(text) };
}

export function seedBytes(bytes: Readonly<Span<uint8>>): SeedSlice {
	return { address: msSolSpanAddress(bytes), length: bytes.length as uint64 };
}

export function seedKey(address: uint64): SeedSlice {
	return { address: address, length: 32 };
}

export function signerOf(seeds: Readonly<Span<SeedSlice>>): SignerSeeds {
	return { address: msSolSeedsAddress(seeds), length: seeds.length as uint64 };
}

function unsigned(): Signing {
	return { table: 0, count: 0 };
}

export function tableAddress(table: Readonly<Span<SeedSlice>>): uint64 {
	return msSolSeedsAddress(table);
}

export function bytesAddress(bytes: Readonly<Span<uint8>>): uint64 {
	return msSolSpanAddress(bytes);
}

export function ownProgram(): uint64 {
	return msSolProgramId();
}

function fits(table: uint64, count: uint64, limit: uint64): boolean {
	if (count > limit) { return false; }
	for (let index: uint64 = 0; index < count; index++) {
		if (msSolLoadU64(table + index * 16 + 8) > MAX_SEED_LENGTH) { return false; }
	}
	return true;
}

export function signingOf(signers: Readonly<Span<SignerSeeds>>): Signing {
	if (signers.length == 0) { return unsigned(); }
	return { table: msSolSignersAddress(signers), count: signers.length as uint64 };
}

const EDWARDS: uint64 = 0;

function offCurve(input: Span<SeedSlice>, count: uint64, out: uint64): boolean {
	const _hashed = msSolSha256(msSolTableAddress(input), count, out);
	return msSolCurveValidatePoint(EDWARDS, out, 0) != 0;
}

function tail(ref input: SeedSlice[18], at: uint64, program: uint64): void {
	input[at as int32] = { address: program, length: 32 };
	input[(at + 1) as int32] = seedText("ProgramDerivedAddress");
}

function createChecked(
	table: uint64,
	count: uint64,
	program: uint64,
): Result<Pubkey, ProgramError> {
	let input: SeedSlice[18] = [];
	if (count > 0) { msSolCopy(msSolTableAddress(input), table, count * 16); }
	tail(input, count, program);
	let key = Pubkey.zero();
	if (!offCurve(input, count + 2, msSolSpanAddress(key.bytes))) {
		return Result.err(ProgramError.invalidSeeds());
	}
	return Result.ok(key);
}

export function createAt(
	table: uint64,
	count: uint64,
	program: uint64,
): Result<Pubkey, ProgramError> {
	if (!fits(table, count, MAX_SEEDS)) { return Result.err(ProgramError.maxSeedLengthExceeded()); }
	return createChecked(table, count, program);
}

export function findAt(
	table: uint64,
	count: uint64,
	program: uint64,
): Result<ProgramAddress, ProgramError> {
	if (!fits(table, count, MAX_SEEDS - 1)) {
		return Result.err(ProgramError.maxSeedLengthExceeded());
	}
	let input: SeedSlice[18] = [];
	let bump: uint8[1] = [255];
	if (count > 0) { msSolCopy(msSolTableAddress(input), table, count * 16); }
	input[count as int32] = { address: msSolSpanAddress(bump), length: 1 };
	tail(input, count + 1, program);
	let found: ProgramAddress = { key: Pubkey.zero(), bump: 0 };
	const out = msSolSpanAddress(found.key.bytes);
	for (let attempt = 0; attempt < 255; attempt++) {
		bump[0] = (255 - attempt) as uint8;
		if (offCurve(input, count + 3, out)) {
			found.bump = bump[0];
			return Result.ok(found);
		}
	}
	return Result.err(ProgramError.invalidSeeds());
}

export function createAddress(
	seeds: Span<SeedSlice>,
	program: uint64,
): Result<Pubkey, ProgramError> {
	return createAt(tableAddress(seeds), seeds.length as uint64, program);
}

export function findAddress(
	seeds: Readonly<Span<SeedSlice>>,
	program: uint64,
): Result<ProgramAddress, ProgramError> {
	return findAt(tableAddress(seeds), seeds.length as uint64, program);
}

// The bump byte lives in the caller's table; returning the table by value would leave it dangling.
export function fillWithBump(
	ref into: SeedTable,
	table: uint64,
	count: uint64,
	bump: uint8,
): boolean {
	if (!fits(table, count, MAX_SEEDS - 1)) { return false; }
	if (count > 0) { msSolCopy(msSolTableAddress(into.slices), table, count * 16); }
	into.bump[0] = bump;
	into.slices[count] = { address: msSolSpanAddress(into.bump), length: 1 };
	into.count = count + 1;
	return true;
}

export function createAddressWithBump(
	seeds: Span<SeedSlice>,
	bump: uint8,
	program: uint64,
): Result<Pubkey, ProgramError> {
	let signed: SeedTable = { slices: [], bump: [0], count: 0 };
	if (!fillWithBump(signed, tableAddress(seeds), seeds.length as uint64, bump)) {
		return Result.err(ProgramError.maxSeedLengthExceeded());
	}
	return createChecked(msSolTableAddress(signed.slices), signed.count, program);
}

export function signerOfBumped(ref signed: SeedTable, ref one: SignerSeeds[1]): void {
	one[0] = { address: msSolTableAddress(signed.slices), length: signed.count };
}

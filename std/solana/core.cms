@include("runtime/solana/solana.h");
@compile("runtime/solana/host.c");

import {
	ASSOCIATED_TOKEN_PROGRAM_ID,
	Pubkey,
	TOKEN_2022_PROGRAM_ID,
	TOKEN_PROGRAM_ID,
	pubkeyOf,
} from "./pubkey";
import { ProgramError } from "./error";
import { Bytes, putPubkey, putU32, putU64, storePubkey } from "./buffer";
import { InstructionAccount } from "./cpi";
import { invokeSigned } from "./invoke";
import {
	SeedSlice,
	SeedTable,
	SignerSeeds,
	createAddressWithBump,
	fillWithBump,
	findAt,
	ownProgram,
	signerOfBumped,
	tableAddress,
} from "./seed";

export {
	Bytes,
	putBool,
	putBytes,
	putI16,
	putI32,
	putI64,
	putI8,
	putPubkey,
	putSpan,
	putU16,
	putU32,
	putU64,
	putU8,
} from "./buffer";
export { CpiAccount, InstructionAccount, MAX_CPI_ACCOUNTS, invokeList } from "./cpi";

extern function msSolAccountCount(): uint64;
extern function msSolAccountAt(index: uint64): uint64;
extern function msSolInstructionData(): uint64;
extern function msSolInstructionDataLength(): uint64;
extern function msSolProgramId(): uint64;
extern function msSolSetResult(code: uint64): void;
extern function msSolPointer(address: uint64): Ptr<void>;
extern function msSolLoadU8(address: uint64): uint8;
extern function msSolLoadU16(address: uint64): uint16;
extern function msSolLoadU32(address: uint64): uint32;
extern function msSolLoadU64(address: uint64): uint64;
extern function msSolStoreU8(address: uint64, value: uint8): void;
extern function msSolStoreU16(address: uint64, value: uint16): void;
extern function msSolStoreU32(address: uint64, value: uint32): void;
extern function msSolStoreU64(address: uint64, value: uint64): void;
extern function msSolCopy(destination: uint64, source: uint64, length: uint64): void;
extern function msSolFill(destination: uint64, value: uint8, length: uint64): void;
extern function msSolLog64(a: uint64, b: uint64, c: uint64, d: uint64, e: uint64): void;
extern function msSolLogPubkey(address: uint64): void;
extern function msSolLogData(address: uint64, length: uint64): void;
extern function msSolLogComputeUnits(): void;
extern function msSolRemainingComputeUnits(): uint64;
extern function msSolWordsAddress(words: Span<uint64>): uint64 from "msSolSpanAddress";
extern function msSolSpanAddress(data: Readonly<Span<uint8>>): uint64;
extern function msSolGetClock(out: uint64): uint64;
extern function msSolGetRent(out: uint64): uint64;
extern function msSolSetReturnData(data: Readonly<Span<uint8>>): void;
extern function msSolGetReturnData(data: uint64, length: uint64, programId: uint64): uint64;

const MAX_RETURN_DATA: uint64 = 1024;

export struct Account {
	address: uint64;
}

export struct AccountMeta {
	key: Pubkey;
	writable: boolean;
	signer: boolean;
}

export struct Clock {
	slot: uint64;
	epochStartTimestamp: int64;
	epoch: uint64;
	leaderScheduleEpoch: uint64;
	unixTimestamp: int64;
}

export struct ReturnData {
	program: Pubkey;
	length: uint64;
	data: uint8[1024];
}

export function failWith(error: ProgramError): void {
	msSolSetResult(error.code);
}

function loadPubkey(address: uint64): Pubkey {
	const at = msSolPointer(address) as Ptr<Pubkey>;
	return at[];
}

export function programId(): Pubkey {
	return loadPubkey(msSolProgramId());
}

export function instructionData(): Bytes {
	const data: Bytes = { address: msSolInstructionData(), length: msSolInstructionDataLength() };
	return data;
}

export function accountCount(): int32 {
	return msSolAccountCount() as int32;
}

export function account(index: int32): Result<Account, ProgramError> {
	if (index < 0) { return Result.err(ProgramError.notEnoughAccountKeys()); }
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.notEnoughAccountKeys()); }
	const found: Account = { address: address };
	return Result.ok(found);
}

export function signerAccount(index: int32): Result<Account, ProgramError> {
	const found = try account(index);
	if (!found.isSigner()) { return Result.err(ProgramError.missingRequiredSignature()); }
	return Result.ok(found);
}

export function writableAccount(index: int32): Result<Account, ProgramError> {
	const found = try account(index);
	if (!found.isWritable()) { return Result.err(ProgramError.invalidArgument()); }
	return Result.ok(found);
}

export function key(this account: Account): Pubkey {
	return loadPubkey(account.address + 8);
}

export function keyAddress(this account: Account): uint64 {
	return account.address + 8;
}

export function owner(this account: Account): Pubkey {
	return loadPubkey(account.address + 40);
}

export function lamports(this account: Account): uint64 {
	return msSolLoadU64(account.address + 72);
}

export function setLamports(this account: Account, lamports: uint64): void {
	msSolStoreU64(account.address + 72, lamports);
}

export function dataLength(this account: Account): uint64 {
	return msSolLoadU64(account.address + 80);
}

export function data(this account: Account): Bytes {
	const bytes: Bytes = { address: account.address + 88, length: account.dataLength() };
	return bytes;
}

export function isSigner(this account: Account): boolean {
	return msSolLoadU8(account.address + 1) != 0;
}

export function isWritable(this account: Account): boolean {
	return msSolLoadU8(account.address + 2) != 0;
}

export function isExecutable(this account: Account): boolean {
	return msSolLoadU8(account.address + 3) != 0;
}

export function isOwnedBy(this account: Account, candidate: Pubkey): boolean {
	return keysEqual(account.address + 40, msSolSpanAddress(candidate.bytes));
}

export function assign(this account: Account, newOwner: Pubkey): void {
	storePubkey(newOwner, account.address + 40);
}

export function resize(this account: Account, newLength: uint64): Result<uint64, ProgramError> {
	const currentLength = account.dataLength();
	const growth: int64 = (newLength as int64) - (currentLength as int64);
	const previousDelta: int64 = (msSolLoadU32(account.address + 4) as int32) as int64;
	const nextDelta: int64 = previousDelta + growth;
	if (nextDelta > 10240) { return Result.err(ProgramError.invalidRealloc()); }
	if (newLength > currentLength) {
		msSolFill(account.address + 88 + currentLength, 0, newLength - currentLength);
	}
	msSolStoreU32(account.address + 4, (nextDelta as int32) as uint32);
	msSolStoreU64(account.address + 80, newLength);
	return Result.ok(newLength);
}

function checkedAddress(bytes: Bytes, offset: uint64, width: uint64): Result<uint64, ProgramError> {
	if (offset > bytes.length || width > bytes.length - offset) {
		return Result.err(ProgramError.accountDataTooSmall());
	}
	return Result.ok(bytes.address + offset);
}

export function readU8(this bytes: Bytes, offset: uint64): Result<uint8, ProgramError> {
	const address = try checkedAddress(bytes, offset, 1);
	return Result.ok(msSolLoadU8(address));
}

export function readU16(this bytes: Bytes, offset: uint64): Result<uint16, ProgramError> {
	const address = try checkedAddress(bytes, offset, 2);
	return Result.ok(msSolLoadU16(address));
}

export function readU32(this bytes: Bytes, offset: uint64): Result<uint32, ProgramError> {
	const address = try checkedAddress(bytes, offset, 4);
	return Result.ok(msSolLoadU32(address));
}

export function readU64(this bytes: Bytes, offset: uint64): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 8);
	return Result.ok(msSolLoadU64(address));
}

export function readPubkey(this bytes: Bytes, offset: uint64): Result<Pubkey, ProgramError> {
	const address = try checkedAddress(bytes, offset, 32);
	return Result.ok(loadPubkey(address));
}

export function writeU8(
	this bytes: Bytes,
	offset: uint64,
	value: uint8,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 1);
	msSolStoreU8(address, value);
	return Result.ok(offset + 1);
}

export function writeU16(
	this bytes: Bytes,
	offset: uint64,
	value: uint16,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 2);
	msSolStoreU16(address, value);
	return Result.ok(offset + 2);
}

export function writeU32(
	this bytes: Bytes,
	offset: uint64,
	value: uint32,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 4);
	msSolStoreU32(address, value);
	return Result.ok(offset + 4);
}

export function writeU64(
	this bytes: Bytes,
	offset: uint64,
	value: uint64,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 8);
	msSolStoreU64(address, value);
	return Result.ok(offset + 8);
}

export function writePubkey(
	this bytes: Bytes,
	offset: uint64,
	value: Pubkey,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 32);
	storePubkey(value, address);
	return Result.ok(offset + 32);
}

export function range(
	this bytes: Bytes,
	offset: uint64,
	length: uint64,
): Result<Bytes, ProgramError> {
	const address = try checkedAddress(bytes, offset, length);
	const view: Bytes = { address: address, length: length };
	return Result.ok(view);
}

export function copyFrom(this bytes: Bytes, source: Bytes): Result<uint64, ProgramError> {
	if (source.length > bytes.length) { return Result.err(ProgramError.accountDataTooSmall()); }
	if (source.length > 0) { msSolCopy(bytes.address, source.address, source.length); }
	return Result.ok(source.length);
}

export function fillWith(this bytes: Bytes, value: uint8): void {
	if (bytes.length > 0) { msSolFill(bytes.address, value, bytes.length); }
}

function flagByte(value: boolean): uint8 {
	if (value) { return 1; }
	return 0;
}

export function writable(this typeof AccountMeta, key: Pubkey): AccountMeta {
	return { key: key, writable: true, signer: false };
}

export function readonly(this typeof AccountMeta, key: Pubkey): AccountMeta {
	return { key: key, writable: false, signer: false };
}

export function writable(this typeof InstructionAccount, account: Account): InstructionAccount {
	return { key: account.address + 8, writable: 1, signer: 0 };
}

export function readonly(this typeof InstructionAccount, account: Account): InstructionAccount {
	return { key: account.address + 8, writable: 0, signer: 0 };
}

export function writableSigner(this typeof InstructionAccount, account: Account): InstructionAccount {
	return { key: account.address + 8, writable: 1, signer: 1 };
}

export function readonlySigner(this typeof InstructionAccount, account: Account): InstructionAccount {
	return { key: account.address + 8, writable: 0, signer: 1 };
}

export function pubkey(this meta: InstructionAccount): Pubkey {
	return loadPubkey(meta.key);
}

export function flagged(
	this typeof InstructionAccount,
	account: Account,
	writable: boolean,
	signer: boolean,
): InstructionAccount {
	return { key: account.address + 8, writable: flagByte(writable), signer: flagByte(signer) };
}

export function createAccount(
	payer: Account,
	target: Account,
	lamports: uint64,
	space: uint64,
	newOwner: Pubkey,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	let storage: uint8[52] = [];
	let length = putU32(storage, 0, 0);
	length = putU64(storage, length, lamports);
	length = putU64(storage, length, space);
	length = putPubkey(storage, length, newOwner);
	return invokeSigned(
		Pubkey.zero(),
		[InstructionAccount.writableSigner(payer), InstructionAccount.writableSigner(target)],
		storage,
		length,
		signers,
	);
}

export function assignTo(
	target: Account,
	newOwner: Pubkey,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	let storage: uint8[36] = [];
	const length = putPubkey(storage, putU32(storage, 0, 1), newOwner);
	return invokeSigned(
		Pubkey.zero(),
		[InstructionAccount.writableSigner(target)],
		storage,
		length,
		signers,
	);
}

export function transfer(
	source: Account,
	destination: Account,
	lamports: uint64,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	let storage: uint8[12] = [];
	const length = putU64(storage, putU32(storage, 0, 2), lamports);
	return invokeSigned(
		Pubkey.zero(),
		[InstructionAccount.writableSigner(source), InstructionAccount.writable(destination)],
		storage,
		length,
		signers,
	);
}

export function allocate(
	target: Account,
	space: uint64,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	let storage: uint8[12] = [];
	const length = putU64(storage, putU32(storage, 0, 8), space);
	return invokeSigned(
		Pubkey.zero(),
		[InstructionAccount.writableSigner(target)],
		storage,
		length,
		signers,
	);
}

export function minimumBalance(dataLength: uint64): uint64 {
	let rent: uint64[3] = [];
	const _status = msSolGetRent(msSolWordsAddress(rent));
	const lamportsPerByte = rent[0];
	const thresholdBits = rent[1];
	const twoBits: uint64 = 0x4000000000000000;
	const bytes = dataLength + 128;
	if (thresholdBits == twoBits) { return 2 * bytes * lamportsPerByte; }
	return bytes * lamportsPerByte;
}

export function createProgramAccount(
	payer: Account,
	target: Account,
	space: uint64,
	newOwner: Pubkey,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	const required = minimumBalance(space);
	const current = target.lamports();
	if (current == 0) {
		return createAccount(payer, target, required, space, newOwner, signers);
	}
	if (required > current) {
		const _funded = try transfer(payer, target, required - current);
	}
	const _allocated = try allocate(target, space, signers);
	return assignTo(target, newOwner, signers);
}

export function createProgramAccountSeeded(
	payer: Account,
	target: Account,
	space: uint64,
	newOwner: Pubkey,
	seeds: Span<SeedSlice>,
	bump: uint8,
): Result<uint64, ProgramError> {
	let signed: SeedTable = { slices: [], bump: [0], count: 0 };
	if (!fillWithBump(signed, tableAddress(seeds), seeds.length as uint64, bump)) {
		return Result.err(ProgramError.maxSeedLengthExceeded());
	}
	let one: SignerSeeds[1] = [{ address: 0, length: 0 }];
	signerOfBumped(signed, one);
	return createProgramAccount(payer, target, space, newOwner, one);
}

export function clock(): Clock {
	let words: uint64[5] = [];
	const _status = msSolGetClock(msSolWordsAddress(words));
	const value: Clock = {
		slot: words[0],
		epochStartTimestamp: words[1] as int64,
		epoch: words[2],
		leaderScheduleEpoch: words[3],
		unixTimestamp: words[4] as int64,
	};
	return value;
}

export function setReturnData(data: Readonly<Span<uint8>>): void {
	msSolSetReturnData(data);
}

export function returnData(): ReturnData | null {
	let found: ReturnData = { program: Pubkey.zero(), length: 0, data: [] };
	const length = msSolGetReturnData(
		msSolSpanAddress(found.data),
		MAX_RETURN_DATA,
		msSolSpanAddress(found.program.bytes),
	);
	if (length == 0) { return null; }
	found.length = Math.min(length, MAX_RETURN_DATA);
	return found;
}

function returnDataAddress(
	found: ReturnData,
	offset: uint64,
	width: uint64,
): Result<uint64, ProgramError> {
	if (offset > found.length || width > found.length - offset) {
		return Result.err(ProgramError.accountDataTooSmall());
	}
	return Result.ok(msSolSpanAddress(found.data) + offset);
}

export function readU8(this found: ReturnData, offset: uint64): Result<uint8, ProgramError> {
	const address = try returnDataAddress(found, offset, 1);
	return Result.ok(msSolLoadU8(address));
}

export function readU16(this found: ReturnData, offset: uint64): Result<uint16, ProgramError> {
	const address = try returnDataAddress(found, offset, 2);
	return Result.ok(msSolLoadU16(address));
}

export function readU32(this found: ReturnData, offset: uint64): Result<uint32, ProgramError> {
	const address = try returnDataAddress(found, offset, 4);
	return Result.ok(msSolLoadU32(address));
}

export function readU64(this found: ReturnData, offset: uint64): Result<uint64, ProgramError> {
	const address = try returnDataAddress(found, offset, 8);
	return Result.ok(msSolLoadU64(address));
}

export function readPubkey(this found: ReturnData, offset: uint64): Result<Pubkey, ProgramError> {
	const address = try returnDataAddress(found, offset, 32);
	return Result.ok(loadPubkey(address));
}

export function logU64(value: uint64): void {
	msSolLog64(0, 0, 0, 0, value);
}

export function logPubkey(key: Pubkey): void {
	msSolLogPubkey(msSolSpanAddress(key.bytes));
}

export function logComputeUnits(): void {
	msSolLogComputeUnits();
}

export function remainingComputeUnits(): uint64 {
	return msSolRemainingComputeUnits();
}

test "custom error 0 is not the success code" {
	const customZero: uint64 = 4294967296;
	assert ProgramError.custom(0).code == customZero;
	assert ProgramError.custom(7).code == 7;
}

export struct System {}
export struct Token {}
export struct Token2022 {}
export struct AssociatedToken {}

export function id(this typeof System): Pubkey { return Pubkey.zero(); }
export function id(this typeof Token): Pubkey { return TOKEN_PROGRAM_ID; }
export function id(this typeof Token2022): Pubkey { return TOKEN_2022_PROGRAM_ID; }
export function id(this typeof AssociatedToken): Pubkey { return ASSOCIATED_TOKEN_PROGRAM_ID; }

export type Signer = distinct Account;
export type WritableSigner = distinct Account;
export type Writable = distinct Account;
export type SystemAccount = distinct Account;
export type Program<P> = distinct Account;
export type Owned<T> = distinct Account;
export type Mutable<T> = distinct Account;
export type External<T> = distinct Account;
export type ExternalMutable<T> = distinct Account;
export type Delegated<T> = distinct Account;

@delegate export function key(this proof: Signer): Pubkey;
@delegate export function key(this proof: WritableSigner): Pubkey;
@delegate export function key(this proof: Writable): Pubkey;
@delegate export function key(this proof: SystemAccount): Pubkey;
@delegate export function key<P>(this proof: Program<P>): Pubkey;
@delegate export function key<T>(this proof: Owned<T>): Pubkey;
@delegate export function key<T>(this proof: Mutable<T>): Pubkey;
@delegate export function key<T>(this proof: External<T>): Pubkey;
@delegate export function key<T>(this proof: ExternalMutable<T>): Pubkey;
@delegate export function key<T>(this proof: Delegated<T>): Pubkey;

@delegate export function keyAddress(this proof: Signer): uint64;
@delegate export function keyAddress(this proof: WritableSigner): uint64;
@delegate export function keyAddress(this proof: Writable): uint64;
@delegate export function keyAddress(this proof: SystemAccount): uint64;
@delegate export function keyAddress<P>(this proof: Program<P>): uint64;
@delegate export function keyAddress<T>(this proof: Owned<T>): uint64;
@delegate export function keyAddress<T>(this proof: Mutable<T>): uint64;
@delegate export function keyAddress<T>(this proof: External<T>): uint64;
@delegate export function keyAddress<T>(this proof: ExternalMutable<T>): uint64;
@delegate export function keyAddress<T>(this proof: Delegated<T>): uint64;

@delegate export function lamports(this proof: Signer): uint64;
@delegate export function lamports(this proof: WritableSigner): uint64;
@delegate export function lamports(this proof: Writable): uint64;
@delegate export function lamports(this proof: SystemAccount): uint64;
@delegate export function lamports<T>(this proof: Owned<T>): uint64;
@delegate export function lamports<T>(this proof: Mutable<T>): uint64;
@delegate export function lamports<T>(this proof: External<T>): uint64;
@delegate export function lamports<T>(this proof: ExternalMutable<T>): uint64;
@delegate export function lamports<T>(this proof: Delegated<T>): uint64;

@delegate export function owner(this proof: Writable): Pubkey;
@delegate export function owner<T>(this proof: External<T>): Pubkey;
@delegate export function owner<T>(this proof: ExternalMutable<T>): Pubkey;

@delegate export function dataLength<T>(this proof: Owned<T>): uint64;
@delegate export function dataLength<T>(this proof: Mutable<T>): uint64;
@delegate export function dataLength<T>(this proof: Delegated<T>): uint64;

export function keysEqual(left: uint64, right: uint64): boolean {
	return msSolLoadU64(left) == msSolLoadU64(right) &&
		msSolLoadU64(left + 8) == msSolLoadU64(right + 8) &&
		msSolLoadU64(left + 16) == msSolLoadU64(right + 16) &&
		msSolLoadU64(left + 24) == msSolLoadU64(right + 24);
}

function keyIsZero(address: uint64): boolean {
	return (msSolLoadU64(address) | msSolLoadU64(address + 8) | msSolLoadU64(address + 16) |
		msSolLoadU64(address + 24)) == 0;
}

function claimExclusive(address: uint64): boolean {
	if (msSolLoadU8(address) != 0xff) { return false; }
	msSolStoreU8(address, 0);
	return true;
}

export const DELEGATION_PROGRAM_ID: Pubkey = pubkeyOf("DELeGGvXpWV2fqJUhqcF5ZSYMS4JTLjteaAMARRSaeSh");

function programDataFailure(
	address: uint64,
	owner: uint64,
	discriminator: uint64,
	size: uint64,
): uint64 {
	if (!keysEqual(address + 40, owner)) { return ProgramError.accountOwnedByWrongProgram().code; }
	const length = msSolLoadU64(address + 80);
	if (length < 8) { return ProgramError.accountDiscriminatorNotFound().code; }
	if (msSolLoadU64(address + 88) != discriminator) {
		return ProgramError.accountDiscriminatorMismatch().code;
	}
	if (length < 8 + size) { return ProgramError.accountDidNotDeserialize().code; }
	return 0;
}

function proofResult(address: uint64, failure: uint64): Result<Account, ProgramError> {
	if (failure != 0) { return Result.err({ code: failure }); }
	const found: Account = { address: address };
	return Result.ok(found);
}

export function signer(index: int32): Result<Signer, ProgramError> {
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.accountNotEnoughKeys()); }
	if (msSolLoadU8(address + 1) == 0) { return Result.err(ProgramError.accountNotSigner()); }
	const found: Account = { address: address };
	return Result.ok(found as Signer);
}

export function writableSigner(index: int32): Result<WritableSigner, ProgramError> {
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.accountNotEnoughKeys()); }
	if (msSolLoadU8(address + 1) == 0) { return Result.err(ProgramError.accountNotSigner()); }
	if (msSolLoadU8(address + 2) == 0) { return Result.err(ProgramError.constraintMut()); }
	const found: Account = { address: address };
	return Result.ok(found as WritableSigner);
}

export function writable(index: int32): Result<Writable, ProgramError> {
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.accountNotEnoughKeys()); }
	if (msSolLoadU8(address + 2) == 0) { return Result.err(ProgramError.constraintMut()); }
	const found: Account = { address: address };
	return Result.ok(found as Writable);
}

export function systemAccount(index: int32): Result<SystemAccount, ProgramError> {
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.accountNotEnoughKeys()); }
	if (!keyIsZero(address + 40)) { return Result.err(ProgramError.accountNotSystemOwned()); }
	const found: Account = { address: address };
	return Result.ok(found as SystemAccount);
}

export function unchecked(index: int32): Result<Account, ProgramError> {
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.accountNotEnoughKeys()); }
	const found: Account = { address: address };
	return Result.ok(found);
}

export function programAccount(index: int32, id: Pubkey): Result<Account, ProgramError> {
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.accountNotEnoughKeys()); }
	if (!keysEqual(address + 8, msSolSpanAddress(id.bytes))) {
		return Result.err(ProgramError.invalidProgramId());
	}
	if (msSolLoadU8(address + 3) == 0) { return Result.err(ProgramError.invalidProgramExecutable()); }
	const found: Account = { address: address };
	return Result.ok(found);
}

export function ownedFailure(
	index: int32,
	discriminator: uint64,
	size: uint64,
	out found: Account,
): uint64 {
	found = { address: msSolAccountAt(index as uint64) };
	if (found.address == 0) { return ProgramError.accountNotEnoughKeys().code; }
	return programDataFailure(found.address, msSolProgramId(), discriminator, size);
}

export function delegatedFailure(
	index: int32,
	discriminator: uint64,
	size: uint64,
	out found: Account,
): uint64 {
	found = { address: msSolAccountAt(index as uint64) };
	if (found.address == 0) { return ProgramError.accountNotEnoughKeys().code; }
	return programDataFailure(
		found.address,
		msSolSpanAddress(DELEGATION_PROGRAM_ID.bytes),
		discriminator,
		size,
	);
}

export function mutableFailure(
	index: int32,
	discriminator: uint64,
	size: uint64,
	out found: Account,
): uint64 {
	found = { address: msSolAccountAt(index as uint64) };
	if (found.address == 0) { return ProgramError.accountNotEnoughKeys().code; }
	const failure = programDataFailure(found.address, msSolProgramId(), discriminator, size);
	if (failure != 0) { return failure; }
	if (msSolLoadU8(found.address + 2) == 0) { return ProgramError.constraintMut().code; }
	if (!claimExclusive(found.address)) { return ProgramError.accountBorrowFailed().code; }
	return 0;
}

export function ownedAccount(
	index: int32,
	discriminator: uint64,
	size: uint64,
): Result<Account, ProgramError> {
	let found: Account = { address: 0 };
	const failure = ownedFailure(index, discriminator, size, found);
	return proofResult(found.address, failure);
}

export function delegatedAccount(
	index: int32,
	discriminator: uint64,
	size: uint64,
): Result<Account, ProgramError> {
	let found: Account = { address: 0 };
	const failure = delegatedFailure(index, discriminator, size, found);
	return proofResult(found.address, failure);
}

export function mutableAccount(
	index: int32,
	discriminator: uint64,
	size: uint64,
): Result<Account, ProgramError> {
	let found: Account = { address: 0 };
	const failure = mutableFailure(index, discriminator, size, found);
	return proofResult(found.address, failure);
}

export function exclusiveWritable(found: Account): Result<Account, ProgramError> {
	if (!found.isWritable()) { return Result.err(ProgramError.constraintMut()); }
	if (!claimExclusive(found.address)) { return Result.err(ProgramError.accountBorrowFailed()); }
	return Result.ok(found);
}

export function data<T>(this proof: Mutable<T>): Ptr<T> {
	return msSolPointer((proof as Account).address + 96) as Ptr<T>;
}

export function data<T>(this proof: Owned<T>): Readonly<Ptr<T>> {
	return msSolPointer((proof as Account).address + 96) as Ptr<T>;
}

export function data<T>(this proof: Delegated<T>): Readonly<Ptr<T>> {
	return msSolPointer((proof as Account).address + 96) as Ptr<T>;
}

export function read<T>(this proof: External<T>): Result<T, ProgramError> {
	return T.decode((proof as Account).data());
}

export function read<T>(this proof: ExternalMutable<T>): Result<T, ProgramError> {
	return T.decode((proof as Account).data());
}


export function selectedInstruction(table: Readonly<Span<uint8>>): Result<int32, ProgramError> {
	if (msSolInstructionDataLength() < 8) { return Result.err(ProgramError.instructionMissing()); }
	const word = msSolLoadU64(msSolInstructionData());
	const base = msSolSpanAddress(table);
	const count = table.length >> 3;
	for (let member = 0; member < count; member++) {
		if (msSolLoadU64(base + (member as uint64) * 8) == word) { return Result.ok(member); }
	}
	return Result.err(ProgramError.instructionFallbackNotFound());
}

function argumentAddress(offset: uint64, width: uint64): uint64 {
	const data = instructionData();
	if (data.length < 8 || offset + width > data.length - 8) { return 0; }
	return data.address + 8 + offset;
}

export function argsFit(length: uint64): boolean {
	const data = instructionData();
	return data.length >= 8 && data.length - 8 >= length;
}

export function argU8(offset: uint64): uint8 {
	const at = argumentAddress(offset, 1);
	return at == 0 ? 0 : msSolLoadU8(at);
}

export function argU16(offset: uint64): uint16 {
	const at = argumentAddress(offset, 2);
	return at == 0 ? 0 : msSolLoadU16(at);
}

export function argU32(offset: uint64): uint32 {
	const at = argumentAddress(offset, 4);
	return at == 0 ? 0 : msSolLoadU32(at);
}

export function argU64(offset: uint64): uint64 {
	const at = argumentAddress(offset, 8);
	return at == 0 ? 0 : msSolLoadU64(at);
}

export function argI8(offset: uint64): int8 { return argU8(offset) as int8; }
export function argI16(offset: uint64): int16 { return argU16(offset) as int16; }
export function argI32(offset: uint64): int32 { return argU32(offset) as int32; }
export function argI64(offset: uint64): int64 { return argU64(offset) as int64; }

export function argBool(offset: uint64): boolean {
	return argU8(offset) == 1;
}

export function argBoolValid(offset: uint64): boolean {
	return argU8(offset) <= 1;
}

export function argPubkey(offset: uint64): Pubkey {
	const at = argumentAddress(offset, 32);
	return at == 0 ? Pubkey.zero() : loadPubkey(at);
}

export function argBytesFit(offset: uint64): boolean {
	if (!argsFit(offset + 4)) { return false; }
	return argsFit(offset + 4 + (argU32(offset) as uint64));
}

export function argBytes(offset: uint64): Bytes {
	if (!argBytesFit(offset)) {
		const empty: Bytes = { address: 0, length: 0 };
		return empty;
	}
	const length = argU32(offset) as uint64;
	const view: Bytes = { address: argumentAddress(offset + 4, length), length: length };
	return view;
}

function initialized(
	payer: WritableSigner,
	target: Writable,
	space: uint64,
	discriminator: uint64,
	signers: Readonly<Span<SignerSeeds>>,
): Result<Account, ProgramError> {
	const funding = payer as Account;
	const created = target as Account;
	if (funding.key() == created.key()) {
		return Result.err(ProgramError.tryingToInitPayerAsProgramAccount());
	}
	const _made = try createProgramAccount(funding, created, space, programId(), signers);
	msSolStoreU64(created.address + 88, discriminator);
	if (!claimExclusive(created.address)) { return Result.err(ProgramError.accountBorrowFailed()); }
	return Result.ok(created);
}

export function createdAccount(
	payer: WritableSigner,
	target: Writable,
	space: uint64,
	discriminator: uint64,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<Account, ProgramError> {
	return initialized(payer, target, space, discriminator, signers);
}

export struct DerivedAccount {
	account: Account;
	bump: uint8;
}

export function createdPdaAccount(
	payer: WritableSigner,
	target: Writable,
	seeds: Span<SeedSlice>,
	space: uint64,
	discriminator: uint64,
): Result<DerivedAccount, ProgramError> {
	const found = try findAt(tableAddress(seeds), seeds.length as uint64, ownProgram());
	if (found.key != (target as Account).key()) {
		return Result.err(ProgramError.constraintSeeds());
	}
	let signed: SeedTable = { slices: [], bump: [0], count: 0 };
	if (!fillWithBump(signed, tableAddress(seeds), seeds.length as uint64, found.bump)) {
		return Result.err(ProgramError.maxSeedLengthExceeded());
	}
	let one: SignerSeeds[1] = [{ address: 0, length: 0 }];
	signerOfBumped(signed, one);
	const created = try initialized(payer, target, space, discriminator, one);
	return Result.ok({ account: created, bump: found.bump });
}

export function canonicalBump(
	account: Account,
	seeds: Span<SeedSlice>,
): Result<uint8, ProgramError> {
	const found = try findAt(tableAddress(seeds), seeds.length as uint64, ownProgram());
	if (found.key != account.key()) { return Result.err(ProgramError.constraintSeeds()); }
	return Result.ok(found.bump);
}

export function givenBump(
	account: Account,
	seeds: Span<SeedSlice>,
	bump: uint8,
): Result<uint8, ProgramError> {
	const derived = createAddressWithBump(seeds, bump, ownProgram());
	if (!derived.ok || derived.value != account.key()) {
		return Result.err(ProgramError.constraintSeeds());
	}
	return Result.ok(bump);
}

export function closedProgramAccount(
	target: Account,
	destination: Account,
): Result<uint64, ProgramError> {
	if (target.key() == destination.key()) { return Result.err(ProgramError.constraintClose()); }
	const moved = target.lamports();
	const total = destination.lamports() + moved;
	if (total < moved) { return Result.err(ProgramError.arithmeticOverflow()); }
	destination.setLamports(total);
	target.setLamports(0);
	target.assign(Pubkey.zero());
	const _emptied = try target.resize(0);
	return Result.ok(moved);
}

export function resizedProgramAccount(
	target: Account,
	space: uint64,
	funding: Account,
): Result<uint64, ProgramError> {
	const current = target.dataLength();
	if (space > current && space - current > 10240) {
		return Result.err(ProgramError.accountReallocExceedsLimit());
	}
	const required = minimumBalance(space);
	const held = target.lamports();
	if (required > held) {
		const _funded = try transfer(funding, target, required - held);
	} else if (held > required) {
		target.setLamports(required);
		funding.setLamports(funding.lamports() + (held - required));
	}
	return target.resize(space);
}

export function expectAddress(actual: Pubkey, expected: Pubkey): Result<void, ProgramError> {
	if (actual != expected) { return Result.err(ProgramError.constraintAddress()); }
	return Result.ok(null);
}

export function expectHasOne(actual: Pubkey, expected: Pubkey): Result<void, ProgramError> {
	if (actual != expected) { return Result.err(ProgramError.constraintHasOne()); }
	return Result.ok(null);
}

export function keysMatch(
	actual: uint64,
	expected: uint64,
	failure: uint64,
): Result<void, ProgramError> {
	if (!keysEqual(actual, expected)) { return Result.err({ code: failure }); }
	return Result.ok(null);
}

export function holds(condition: boolean, failure: uint64): Result<void, ProgramError> {
	if (!condition) { return Result.err({ code: failure }); }
	return Result.ok(null);
}

export function seedsGiven(
	key: uint64,
	seeds: Span<SeedSlice>,
	bump: uint8,
): Result<void, ProgramError> {
	const derived = createAddressWithBump(seeds, bump, ownProgram());
	if (!derived.ok || !keysEqual(msSolSpanAddress(derived.value.bytes), key)) {
		return Result.err(ProgramError.constraintSeeds());
	}
	return Result.ok(null);
}

export function seedsCanonical(key: uint64, seeds: Span<SeedSlice>): Result<void, ProgramError> {
	const found = try findAt(tableAddress(seeds), seeds.length as uint64, ownProgram());
	if (!keysEqual(msSolSpanAddress(found.key.bytes), key)) {
		return Result.err(ProgramError.constraintSeeds());
	}
	return Result.ok(null);
}

const MAX_EVENT_BYTES: uint64 = 1024;

@noinline export function logEvent(
	discriminator: Readonly<Span<uint8>>,
	layout: Readonly<Span<uint8>>,
	values: Readonly<Span<uint64>>,
): uint64 {
	let storage: uint8[1024] = [];
	const base = msSolSpanAddress(storage);
	if (layout.length != values.length || discriminator.length != 8) {
		failWith(ProgramError.invalidArgument());
		return 0;
	}
	for (let index = 0; index < 8; index++) { msSolStoreU8(base + (index as uint64), discriminator[index]); }
	let at: uint64 = 8;
	for (let index = 0; index < layout.length; index++) {
		const width = layout[index] as uint64;
		if (width > MAX_EVENT_BYTES - at) {
			failWith(ProgramError.invalidArgument());
			return 0;
		}
		if (width == 1) { msSolStoreU8(base + at, values[index] as uint8); }
		else if (width == 2) { msSolStoreU16(base + at, values[index] as uint16); }
		else if (width == 4) { msSolStoreU32(base + at, values[index] as uint32); }
		else if (width == 8) { msSolStoreU64(base + at, values[index]); }
		else if (width == 32) { msSolCopy(base + at, values[index], 32); }
		else {
			failWith(ProgramError.invalidArgument());
			return 0;
		}
		at = at + width;
	}
	msSolLogData(base, at);
	return at;
}

export function logData(bytes: Bytes): void {
	msSolLogData(bytes.address, bytes.length);
}

export function transferLamports(
	from: WritableSigner,
	to: Writable,
	lamports: uint64,
): Result<uint64, ProgramError> {
	return transfer(from as Account, to as Account, lamports);
}

export function asSigner(this proof: WritableSigner): Signer {
	return (proof as Account) as Signer;
}

export function asWritable(this proof: WritableSigner): Writable {
	return (proof as Account) as Writable;
}

export function asWritable<T>(this proof: Mutable<T>): Writable {
	return (proof as Account) as Writable;
}

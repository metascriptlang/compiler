@include("runtime/solana/solana.h");
@compile("runtime/solana/host.c");

import {
	ASSOCIATED_TOKEN_PROGRAM_ID,
	SYSTEM_PROGRAM_ID,
	Pubkey,
	TOKEN_2022_PROGRAM_ID,
	TOKEN_PROGRAM_ID,
	pubkeyOf,
} from "./pubkey";
import { ProgramError } from "./error";
import { isPlainData } from "std/typetraits";
import { Bytes, putAddress, putPubkey, putU32, putU64, storePubkey } from "./buffer";
import {
	SeedSlice,
	SeedTable,
	SignerSeeds,
	fillWithBump,
	findCanonicalFailureAt,
	findCanonicalStagedFailure,
	findExpectedStagedFailure,
	hashStagedFailure,
	ownProgram,
	signerOf,
	signerOfBumped,
	signingOf,
	stagedInPlace,
	tableAddress,
} from "./seed";

export {
	Bytes,
	putBool,
	putBytes,
	putI16,
	putI32,
	putI64,
	putI8,
	putPrefix,
	putPubkey,
	putSpan,
	putU16,
	putU32,
	putU64,
	putU8,
} from "./buffer";

extern function msSolMetasAddress(table: Readonly<Span<InstructionAccount>>): uint64 from "msSolSpanAddress";
extern function msSolInvokeMetas(
	program: uint64,
	metas: uint64,
	count: uint64,
	data: uint64,
	length: uint64,
	signers: uint64,
	signerCount: uint64,
): uint64;
extern function msSolAccountCount(): uint64;
extern function msSolAccountAt(index: uint64): uint64;
extern function msSolInstructionData(): uint64;
extern function msSolInstructionDataLength(): uint64;
extern function msSolProgramId(): uint64;
extern function msSolSetResult(code: uint64): void;
extern function msSolPointer(address: uint64): Ptr<void>;
extern function msSolLoadU8(address: uint64): uint8;
extern function msSolLoadU16(address: uint64): uint16;
extern function msSolLoadU32(address: uint64): uint32;
extern function msSolLoadU64(address: uint64): uint64;
extern function msSolStoreU8(address: uint64, value: uint8): void;
extern function msSolStoreU16(address: uint64, value: uint16): void;
extern function msSolStoreU32(address: uint64, value: uint32): void;
extern function msSolStoreU64(address: uint64, value: uint64): void;
extern function msSolCopy(destination: uint64, source: uint64, length: uint64): void;
extern function msSolScratch(size: uint64): uint64;
extern function msSolFill(destination: uint64, value: uint8, length: uint64): void;
extern function msSolDataRoom(record: uint64): uint64;
extern function msSolLog(address: uint64, length: uint64): void;
extern function msSolStringAddress(text: string): uint64;
extern function msSolStringLength(text: string): uint64;
extern function msSolLog64(a: uint64, b: uint64, c: uint64, d: uint64, e: uint64): void;
extern function msSolLogPubkey(address: uint64): void;
extern function msSolLogData(address: uint64, length: uint64): void;
extern function msSolLogComputeUnits(): void;
extern function msSolRemainingComputeUnits(): uint64;
extern function msSolWordsAddress(words: Span<uint64>): uint64 from "msSolSpanAddress";
extern function msSolSeedsAddress(table: Readonly<Span<SeedSlice>>): uint64 from "msSolSpanAddress";
extern function msSolSpanAddress(data: Readonly<Span<uint8>>): uint64;
extern function msSolGetClock(out: uint64): uint64;
extern function msSolRentAddress(): uint64;
extern function msSolCurveValidatePoint(curve: uint64, point: uint64, result: uint64): uint64;
extern function msSolSetReturnData(data: Readonly<Span<uint8>>): void;
extern function msSolGetReturnData(data: uint64, length: uint64, programId: uint64): uint64;

const MAX_RETURN_DATA: uint64 = 1024;

export const SCRATCH_MAX_COUNT: uint64 = 262144;

export struct Account {
	private address: uint64;
}

export const MAX_CPI_ACCOUNTS: uint64 = 64;

// The runtime's SolAccountMeta: the key is the address of the account's key in the input buffer. Only this
// module builds one, from an Account, so every key points at a record the runtime parsed.
export struct InstructionAccount {
	private key: uint64;
	private writable: uint8;
	private signer: uint8;
}

@inline export function invokeCpi(
	program: Pubkey,
	metas: Readonly<Span<InstructionAccount>>,
	data: Readonly<Span<uint8>>,
	length: uint64,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	const count = metas.length as uint64;
	if (count > MAX_CPI_ACCOUNTS || length > (data.length as uint64)) {
		return Result.err(ProgramError.invalidArgument());
	}
	const signing = signingOf(signers);
	const status = msSolInvokeMetas(
		msSolSpanAddress(program.bytes),
		msSolMetasAddress(metas),
		count,
		msSolSpanAddress(data),
		length,
		signing.table,
		signing.count,
	);
	if (status != 0) {
		const failure: ProgramError = { code: status };
		return Result.err(failure);
	}
	return Result.ok(status);
}

export function invokeList(
	program: Pubkey,
	accounts: Readonly<Span<InstructionAccount>>,
	data: Readonly<Span<uint8>>,
	length: uint64,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	return invokeCpi(program, accounts, data, length, signers);
}

test "InstructionAccount has the runtime's size" {
	assert sizeof(InstructionAccount) == 16;
}

export struct AccountMeta {
	key: Pubkey;
	writable: boolean;
	signer: boolean;
}

export struct Clock {
	slot: uint64;
	epochStartTimestamp: int64;
	epoch: uint64;
	leaderScheduleEpoch: uint64;
	unixTimestamp: int64;
}

export struct ReturnData {
	program: Pubkey;
	length: uint64;
	data: uint8[1024];
}

// The address of `count` T on the program heap, 8-aligned, or InvalidArgument when the heap cannot hold them. The heap
// starts every instruction zeroed and the bump pointer never moves back, so the bytes are zero.
// Only `scratch<T>(count)` calls this, and it keeps no address: a span of exactly `count` elements is all it hands out.
export function scratchAddress<T>(count: uint64): Result<uint64, ProgramError> {
	when (isPlainData<T>()) {
		const width = sizeof(T) as uint64;
		if (count > SCRATCH_MAX_COUNT) {
			return Result.err(ProgramError.invalidArgument());
		}
		const address = msSolScratch(count * width);
		if (address == 0) { return Result.err(ProgramError.invalidArgument()); }
		return Result.ok(address);
	} else {
		const refused: uint64 = @comptime {
			throw new Error("scratch<T>(count): T owns managed memory (a string, an array, a class, or a struct holding one); scratch holds plain data only: numbers, booleans, Pubkey, and structs or fixed arrays of those");
		};
		return Result.ok(refused);
	}
}

export function failWith(error: ProgramError): void {
	msSolSetResult(error.code);
}

function loadPubkey(address: uint64): Pubkey {
	const at = msSolPointer(address) as Ptr<Pubkey>;
	return at[];
}

export function programId(): Pubkey {
	return loadPubkey(msSolProgramId());
}

export function instructionData(): Bytes {
	const data: Bytes = { address: msSolInstructionData(), length: msSolInstructionDataLength() };
	return data;
}

export function accountCount(): int32 {
	return msSolAccountCount() as int32;
}

export function account(index: int32): Result<Account, ProgramError> {
	if (index < 0) { return Result.err(ProgramError.notEnoughAccountKeys()); }
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.notEnoughAccountKeys()); }
	const found: Account = { address: address };
	return Result.ok(found);
}

export function signerAccount(index: int32): Result<Account, ProgramError> {
	const found = try account(index);
	if (!found.isSigner()) { return Result.err(ProgramError.missingRequiredSignature()); }
	return Result.ok(found);
}

export function writableAccount(index: int32): Result<Account, ProgramError> {
	const found = try account(index);
	if (!found.isWritable()) { return Result.err(ProgramError.invalidArgument()); }
	return Result.ok(found);
}

export function key(this account: Account): Pubkey {
	return loadPubkey(account.address + 8);
}

export function keyAddress(this account: Account): uint64 {
	return account.address + 8;
}

export function owner(this account: Account): Pubkey {
	return loadPubkey(account.address + 40);
}

export function lamports(this account: Account): uint64 {
	return msSolLoadU64(account.address + 72);
}

export function setLamports(this account: Account, lamports: uint64): void {
	msSolStoreU64(account.address + 72, lamports);
}

export function dataLength(this account: Account): uint64 {
	return msSolLoadU64(account.address + 80);
}

export function data(this account: Account): Bytes {
	const bytes: Bytes = { address: account.address + 88, length: account.dataLength() };
	return bytes;
}

export function isSigner(this account: Account): boolean {
	return msSolLoadU8(account.address + 1) != 0;
}

export function isWritable(this account: Account): boolean {
	return msSolLoadU8(account.address + 2) != 0;
}

export function isExecutable(this account: Account): boolean {
	return msSolLoadU8(account.address + 3) != 0;
}

export function isOwnedBy(this account: Account, candidate: Pubkey): boolean {
	return keysEqual(account.address + 40, msSolSpanAddress(candidate.bytes));
}

export function assign(this account: Account, newOwner: Pubkey): void {
	storePubkey(newOwner, account.address + 40);
}

const GROWTH_MASK: uint32 = 0xffffff;

function growthOf(packed: uint32): int64 {
	const stored: int64 = (packed >> 8) as int64;
	return stored <= 10240 ? stored : stored - 16777216;
}

function withGrowth(packed: uint32, growth: int64): uint32 {
	return (packed & 0xff) | ((((growth as int32) as uint32) & GROWTH_MASK) << 8);
}

@noinline function grown(account: Account, currentLength: uint64, newLength: uint64): Result<uint64, ProgramError> {
	const packed = msSolLoadU32(account.address + 4);
	const growth: int64 = growthOf(packed) + ((newLength - currentLength) as int64);
	if (growth > 10240 || newLength > msSolDataRoom(account.address)) { return Result.err(ProgramError.invalidRealloc()); }
	msSolFill(account.address + 88 + currentLength, 0, newLength - currentLength);
	msSolStoreU32(account.address + 4, withGrowth(packed, growth));
	msSolStoreU64(account.address + 80, newLength);
	return Result.ok(newLength);
}

export function resize(this account: Account, newLength: uint64): Result<uint64, ProgramError> {
	const currentLength = account.dataLength();
	if (newLength > currentLength) { return grown(account, currentLength, newLength); }
	const packed = msSolLoadU32(account.address + 4);
	msSolStoreU32(account.address + 4, withGrowth(packed, growthOf(packed) - ((currentLength - newLength) as int64)));
	msSolStoreU64(account.address + 80, newLength);
	return Result.ok(newLength);
}

function checkedAddress(bytes: Bytes, offset: uint64, width: uint64): Result<uint64, ProgramError> {
	if (offset > bytes.length || width > bytes.length - offset) {
		return Result.err(ProgramError.accountDataTooSmall());
	}
	return Result.ok(bytes.address + offset);
}

export function readU8(this bytes: Bytes, offset: uint64): Result<uint8, ProgramError> {
	const address = try checkedAddress(bytes, offset, 1);
	return Result.ok(msSolLoadU8(address));
}

export function readU16(this bytes: Bytes, offset: uint64): Result<uint16, ProgramError> {
	const address = try checkedAddress(bytes, offset, 2);
	return Result.ok(msSolLoadU16(address));
}

export function readU32(this bytes: Bytes, offset: uint64): Result<uint32, ProgramError> {
	const address = try checkedAddress(bytes, offset, 4);
	return Result.ok(msSolLoadU32(address));
}

export function readU64(this bytes: Bytes, offset: uint64): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 8);
	return Result.ok(msSolLoadU64(address));
}

export function readPubkey(this bytes: Bytes, offset: uint64): Result<Pubkey, ProgramError> {
	const address = try checkedAddress(bytes, offset, 32);
	return Result.ok(loadPubkey(address));
}

export function writeU8(
	this bytes: Bytes,
	offset: uint64,
	value: uint8,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 1);
	msSolStoreU8(address, value);
	return Result.ok(offset + 1);
}

export function writeU16(
	this bytes: Bytes,
	offset: uint64,
	value: uint16,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 2);
	msSolStoreU16(address, value);
	return Result.ok(offset + 2);
}

export function writeU32(
	this bytes: Bytes,
	offset: uint64,
	value: uint32,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 4);
	msSolStoreU32(address, value);
	return Result.ok(offset + 4);
}

export function writeU64(
	this bytes: Bytes,
	offset: uint64,
	value: uint64,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 8);
	msSolStoreU64(address, value);
	return Result.ok(offset + 8);
}

export function writePubkey(
	this bytes: Bytes,
	offset: uint64,
	value: Pubkey,
): Result<uint64, ProgramError> {
	const address = try checkedAddress(bytes, offset, 32);
	storePubkey(value, address);
	return Result.ok(offset + 32);
}

export function range(
	this bytes: Bytes,
	offset: uint64,
	length: uint64,
): Result<Bytes, ProgramError> {
	const address = try checkedAddress(bytes, offset, length);
	const view: Bytes = { address: address, length: length };
	return Result.ok(view);
}

export function copyFrom(this bytes: Bytes, source: Bytes): Result<uint64, ProgramError> {
	if (source.length > bytes.length) { return Result.err(ProgramError.accountDataTooSmall()); }
	if (source.length > 0) { msSolCopy(bytes.address, source.address, source.length); }
	return Result.ok(source.length);
}

export function fillWith(this bytes: Bytes, value: uint8): void {
	if (bytes.length > 0) { msSolFill(bytes.address, value, bytes.length); }
}

function flagByte(value: boolean): uint8 {
	if (value) { return 1; }
	return 0;
}

export function writable(this typeof AccountMeta, key: Pubkey): AccountMeta {
	return { key: key, writable: true, signer: false };
}

export function readonly(this typeof AccountMeta, key: Pubkey): AccountMeta {
	return { key: key, writable: false, signer: false };
}

export function writable(this typeof InstructionAccount, account: Account): InstructionAccount {
	return { key: account.address + 8, writable: 1, signer: 0 };
}

export function readonly(this typeof InstructionAccount, account: Account): InstructionAccount {
	return { key: account.address + 8, writable: 0, signer: 0 };
}

export function writableSigner(this typeof InstructionAccount, account: Account): InstructionAccount {
	return { key: account.address + 8, writable: 1, signer: 1 };
}

export function readonlySigner(this typeof InstructionAccount, account: Account): InstructionAccount {
	return { key: account.address + 8, writable: 0, signer: 1 };
}

export function recordFlagged(this meta: InstructionAccount): InstructionAccount {
	const record = meta.key - 8;
	return { key: meta.key, writable: msSolLoadU8(record + 2), signer: msSolLoadU8(record + 1) };
}

export function signerFlag(this meta: InstructionAccount): uint8 { return meta.signer; }

export function writableFlag(this meta: InstructionAccount): uint8 { return meta.writable; }

export function pubkey(this meta: InstructionAccount): Pubkey {
	return loadPubkey(meta.key);
}

export function flagged(
	this typeof InstructionAccount,
	account: Account,
	writable: boolean,
	signer: boolean,
): InstructionAccount {
	return { key: account.address + 8, writable: flagByte(writable), signer: flagByte(signer) };
}

export function createAccount(
	payer: Account,
	target: Account,
	lamports: uint64,
	space: uint64,
	newOwner: Pubkey,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	let storage: uint8[52] = [];
	let length = putU32(storage, 0, 0);
	length = putU64(storage, length, lamports);
	length = putU64(storage, length, space);
	length = putPubkey(storage, length, newOwner);
	return invokeCpi(
		SYSTEM_PROGRAM_ID,
		[InstructionAccount.writableSigner(payer), InstructionAccount.writableSigner(target)],
		storage,
		length,
		signers,
	);
}

export function assignTo(
	target: Account,
	newOwner: Pubkey,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	let storage: uint8[36] = [];
	const length = putPubkey(storage, putU32(storage, 0, 1), newOwner);
	return invokeCpi(
		SYSTEM_PROGRAM_ID,
		[InstructionAccount.writableSigner(target)],
		storage,
		length,
		signers,
	);
}

@inline export function transfer(
	source: Account,
	destination: Account,
	lamports: uint64,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	let storage: uint8[12] = [];
	const length = putU64(storage, putU32(storage, 0, 2), lamports);
	return invokeCpi(
		SYSTEM_PROGRAM_ID,
		[InstructionAccount.writableSigner(source), InstructionAccount.writable(destination)],
		storage,
		length,
		signers,
	);
}

export function allocate(
	target: Account,
	space: uint64,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	let storage: uint8[12] = [];
	const length = putU64(storage, putU32(storage, 0, 8), space);
	return invokeCpi(
		SYSTEM_PROGRAM_ID,
		[InstructionAccount.writableSigner(target)],
		storage,
		length,
		signers,
	);
}

export function minimumBalance(dataLength: uint64): uint64 {
	const rent = msSolRentAddress();
	if (rent == 0) {
		failWith(ProgramError.unsupportedSysvar());
		return 0;
	}
	const lamportsPerByte = msSolLoadU64(rent);
	const thresholdBits = msSolLoadU64(rent + 8);
	const twoBits: uint64 = 0x4000000000000000;
	const bytes = dataLength + 128;
	if (thresholdBits == twoBits) { return 2 * bytes * lamportsPerByte; }
	return bytes * lamportsPerByte;
}

export function createProgramAccount(
	payer: Account,
	target: Account,
	space: uint64,
	newOwner: Pubkey,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<uint64, ProgramError> {
	if (keysEqual(payer.keyAddress(), target.keyAddress())) { return Result.err(ProgramError.invalidArgument()); }
	return createAccountAllowPrefund(payer, target, minimumBalance(space), space, msSolSpanAddress(newOwner.bytes), signers);
}

@inline export function createAccountAllowPrefund(
	payer: Account,
	target: Account,
	required: uint64,
	space: uint64,
	owner: uint64,
	signers: Readonly<Span<SignerSeeds>>,
): Result<uint64, ProgramError> {
	const current = target.lamports();
	const funding = required > current ? required - current : 0;
	const owner0 = msSolLoadU64(owner);
	const owner1 = msSolLoadU64(owner + 8);
	const owner2 = msSolLoadU64(owner + 16);
	const owner3 = msSolLoadU64(owner + 24);
	let storage: uint8[52] = [];
	let length = putU32(storage, 0, 13);
	length = putU64(storage, length, funding);
	length = putU64(storage, length, space);
	length = putU64(storage, length, owner0);
	length = putU64(storage, length, owner1);
	length = putU64(storage, length, owner2);
	length = putU64(storage, length, owner3);
	if (funding == 0) {
		return invokeCpi(
			SYSTEM_PROGRAM_ID,
			[InstructionAccount.writableSigner(target)],
			storage,
			length,
			signers,
		);
	}
	return invokeCpi(
		SYSTEM_PROGRAM_ID,
		[InstructionAccount.writableSigner(target), InstructionAccount.writableSigner(payer)],
		storage,
		length,
		signers,
	);
}

export function createProgramAccountSeeded(
	payer: Account,
	target: Account,
	space: uint64,
	newOwner: Pubkey,
	seeds: Readonly<Span<SeedSlice>>,
): Result<uint8, ProgramError> {
	if (keysEqual(payer.keyAddress(), target.keyAddress())) { return Result.err(ProgramError.invalidArgument()); }
	const bump = try canonicalBump(target, seeds);
	let signed: SeedTable = { slices: [], bump: [0], count: 0 };
	if (!fillWithBump(signed, tableAddress(seeds), seeds.length as uint64, bump)) {
		return Result.err(ProgramError.maxSeedLengthExceeded());
	}
	let one: SignerSeeds[1] = [{ address: 0, length: 0 }];
	signerOfBumped(signed, one);
	const _created = try createProgramAccount(payer, target, space, newOwner, one);
	return Result.ok(bump);
}

export function clock(): Clock {
	let words: uint64[5] = [];
	if (msSolGetClock(msSolWordsAddress(words)) != 0) { failWith(ProgramError.unsupportedSysvar()); }
	const value: Clock = {
		slot: words[0],
		epochStartTimestamp: words[1] as int64,
		epoch: words[2],
		leaderScheduleEpoch: words[3],
		unixTimestamp: words[4] as int64,
	};
	return value;
}

export function setReturnData(data: Readonly<Span<uint8>>): void {
	msSolSetReturnData(data);
}

export function returnData(): ReturnData | null {
	let found: ReturnData = { program: Pubkey.zero(), length: 0, data: [] };
	const length = msSolGetReturnData(
		msSolSpanAddress(found.data),
		MAX_RETURN_DATA,
		msSolSpanAddress(found.program.bytes),
	);
	if (length == 0) { return null; }
	found.length = Math.min(length, MAX_RETURN_DATA);
	return found;
}

export function returnDataFrom(program: Pubkey): Result<ReturnData | null, ProgramError> {
	const found = returnData();
	if (found !== null && !found.program.equals(program)) {
		return Result.err(ProgramError.incorrectProgramId());
	}
	return Result.ok(found);
}

function returnDataAddress(
	found: ReturnData,
	offset: uint64,
	width: uint64,
): Result<uint64, ProgramError> {
	if (offset > found.length || width > found.length - offset) {
		return Result.err(ProgramError.accountDataTooSmall());
	}
	return Result.ok(msSolSpanAddress(found.data) + offset);
}

export function readU8(this found: ReturnData, offset: uint64): Result<uint8, ProgramError> {
	const address = try returnDataAddress(found, offset, 1);
	return Result.ok(msSolLoadU8(address));
}

export function readU16(this found: ReturnData, offset: uint64): Result<uint16, ProgramError> {
	const address = try returnDataAddress(found, offset, 2);
	return Result.ok(msSolLoadU16(address));
}

export function readU32(this found: ReturnData, offset: uint64): Result<uint32, ProgramError> {
	const address = try returnDataAddress(found, offset, 4);
	return Result.ok(msSolLoadU32(address));
}

export function readU64(this found: ReturnData, offset: uint64): Result<uint64, ProgramError> {
	const address = try returnDataAddress(found, offset, 8);
	return Result.ok(msSolLoadU64(address));
}

export function readPubkey(this found: ReturnData, offset: uint64): Result<Pubkey, ProgramError> {
	const address = try returnDataAddress(found, offset, 32);
	return Result.ok(loadPubkey(address));
}

export function logU64(value: uint64): void {
	msSolLog64(0, 0, 0, 0, value);
}

export function logText(text: string): void {
	msSolLog(msSolStringAddress(text), msSolStringLength(text));
}

export function logText(text: Bytes): void {
	msSolLog(text.address, text.length);
}

export function logPubkey(key: Pubkey): void {
	msSolLogPubkey(msSolSpanAddress(key.bytes));
}

export function logComputeUnits(): void {
	msSolLogComputeUnits();
}

export function remainingComputeUnits(): uint64 {
	return msSolRemainingComputeUnits();
}

test "custom error 0 is not the success code" {
	const customZero: uint64 = 4294967296;
	assert ProgramError.custom(0).code == customZero;
	assert ProgramError.custom(7).code == 7;
}

export struct System {}
export struct Token {}
export struct Token2022 {}
export struct AssociatedToken {}

export function id(this typeof System): Pubkey { return Pubkey.zero(); }
export function id(this typeof Token): Pubkey { return TOKEN_PROGRAM_ID; }
export function id(this typeof Token2022): Pubkey { return TOKEN_2022_PROGRAM_ID; }
export function id(this typeof AssociatedToken): Pubkey { return ASSOCIATED_TOKEN_PROGRAM_ID; }

export function keysEqual(left: uint64, right: uint64): boolean {
	return msSolLoadU64(left) == msSolLoadU64(right) &&
		msSolLoadU64(left + 8) == msSolLoadU64(right + 8) &&
		msSolLoadU64(left + 16) == msSolLoadU64(right + 16) &&
		msSolLoadU64(left + 24) == msSolLoadU64(right + 24);
}

export function keyIsZero(address: uint64): boolean {
	return (msSolLoadU64(address) | msSolLoadU64(address + 8) | msSolLoadU64(address + 16) |
		msSolLoadU64(address + 24)) == 0;
}

const DUPLICATED_RECORD: uint8 = 2;

@inline export function duplicateFailure(address: uint64): uint64 {
	return msSolLoadU8(address + 4) == DUPLICATED_RECORD ? ProgramError.constraintDuplicateMutableAccount().code : 0;
}

@noinline function borrowFailure(address: uint64): uint64 {
	return msSolLoadU8(address + 4) == DUPLICATED_RECORD
		? ProgramError.constraintDuplicateMutableAccount().code
		: ProgramError.accountBorrowFailed().code;
}

function claimExclusive(address: uint64): boolean {
	if (msSolLoadU8(address + 4) != 0) { return false; }
	msSolStoreU8(address + 4, 1);
	return true;
}

export const DELEGATION_PROGRAM_ID: Pubkey = pubkeyOf("DELeGGvXpWV2fqJUhqcF5ZSYMS4JTLjteaAMARRSaeSh");

@noinline function shortProgramDataFailure(
	address: uint64,
	discriminator: uint64,
	length: uint64,
): uint64 {
	if (length < 8) { return ProgramError.accountDiscriminatorNotFound().code; }
	if (msSolLoadU64(address + 88) != discriminator) {
		return ProgramError.accountDiscriminatorMismatch().code;
	}
	return ProgramError.accountDidNotDeserialize().code;
}

function programDataFailure(
	address: uint64,
	owner: uint64,
	discriminator: uint64,
	size: uint64,
): uint64 {
	if (!keysEqual(address + 40, owner)) { return ProgramError.accountOwnedByWrongProgram().code; }
	const length = msSolLoadU64(address + 80);
	if (length < 8 + size) { return shortProgramDataFailure(address, discriminator, length); }
	if (msSolLoadU64(address + 88) != discriminator) {
		return ProgramError.accountDiscriminatorMismatch().code;
	}
	return 0;
}

@inline export function accountAt(index: int32, out failure: uint64): Account {
	const address = msSolAccountAt(index as uint64);
	failure = address == 0 ? ProgramError.accountNotEnoughKeys().code : 0;
	return { address: address };
}

@inline export function recordAddress(this account: Account): uint64 { return account.address; }

export function unchecked(index: int32): Result<Account, ProgramError> {
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return Result.err(ProgramError.accountNotEnoughKeys()); }
	const found: Account = { address: address };
	return Result.ok(found);
}

@inline export function programFailure(index: int32, id: Pubkey, out found: Account): uint64 {
	const address = msSolAccountAt(index as uint64);
	if (address == 0) { return ProgramError.accountNotEnoughKeys().code; }
	if (!keysEqual(address + 8, msSolSpanAddress(id.bytes))) {
		return ProgramError.invalidProgramId().code;
	}
	if (msSolLoadU8(address + 3) == 0) { return ProgramError.invalidProgramExecutable().code; }
	found = { address: address };
	return 0;
}

// The same checks with the program id given as its four little-endian words, so a typed Program<P>
// compares immediates and builds no Pubkey on the stack.
@inline export function programWordsAtFailure(
	address: uint64, word0: uint64, word1: uint64, word2: uint64, word3: uint64,
): uint64 {
	if (msSolLoadU64(address + 8) != word0 || msSolLoadU64(address + 16) != word1 ||
		msSolLoadU64(address + 24) != word2 || msSolLoadU64(address + 32) != word3) {
		return ProgramError.invalidProgramId().code;
	}
	if (msSolLoadU8(address + 3) == 0) { return ProgramError.invalidProgramExecutable().code; }
	return 0;
}

export function programAccount(index: int32, id: Pubkey): Result<Account, ProgramError> {
	let found: Account;
	const failure = programFailure(index, id, found);
	if (failure != 0) { return Result.err({ code: failure }); }
	return Result.ok(found);
}

export function ownedFailure(index: int32, discriminator: uint64, size: uint64, out failure: uint64): Account {
	const found = accountAt(index, failure);
	if (failure == 0) { failure = ownedAtFailure(found.address, discriminator, size); }
	return found;
}

export function delegatedFailure(index: int32, discriminator: uint64, size: uint64, out failure: uint64): Account {
	const found = accountAt(index, failure);
	if (failure == 0) { failure = delegatedAtFailure(found.address, discriminator, size); }
	return found;
}

export function mutableEnvelopeFailure(index: int32, discriminator: uint64, size: uint64, out failure: uint64): Account {
	const found = accountAt(index, failure);
	if (failure == 0) { failure = mutableEnvelopeAtFailure(found.address, discriminator, size); }
	return found;
}

@inline export function delegatedAtFailure(address: uint64, discriminator: uint64, size: uint64): uint64 {
	return programDataFailure(address, msSolSpanAddress(DELEGATION_PROGRAM_ID.bytes), discriminator, size);
}

@inline export function ownedAtFailure(address: uint64, discriminator: uint64, size: uint64): uint64 {
	return programDataFailure(address, msSolProgramId(), discriminator, size);
}

@inline export function mutableEnvelopeAtFailure(
	address: uint64,
	discriminator: uint64,
	size: uint64,
): uint64 {
	const failure = programDataFailure(address, msSolProgramId(), discriminator, size);
	if (failure != 0) { return failure; }
	if (msSolLoadU32(address + 2) == 1) { return 0; }
	if (msSolLoadU8(address + 2) == 0) { return ProgramError.constraintMut().code; }
	if (msSolLoadU8(address + 4) != 0) { return borrowFailure(address); }
	return 0;
}

export function exclusiveWritable(found: Account): Result<Account, ProgramError> {
	if (!found.isWritable()) { return Result.err(ProgramError.constraintMut()); }
	if (!claimExclusive(found.address)) { return Result.err({ code: borrowFailure(found.address) }); }
	return Result.ok(found);
}

export function instructionHasWord(word: uint64): boolean {
	return msSolInstructionDataLength() >= 8 && msSolLoadU64(msSolInstructionData()) == word;
}

export function instructionHasDiscriminator(): boolean { return msSolInstructionDataLength() >= 8; }

function argumentFits(offset: uint64, width: uint64): boolean {
	const data = instructionData();
	if (data.length < 8) { return false; }
	const available = data.length - 8;
	return offset <= available && width <= available - offset;
}

function argumentAddress(offset: uint64, width: uint64): uint64 {
	return argumentFits(offset, width) ? msSolInstructionData() + 8 + offset : 0;
}

export function argsFit(length: uint64): boolean {
	const data = instructionData();
	return data.length >= 8 && data.length - 8 >= length;
}

export function argU8(offset: uint64): uint8 {
	return argumentFits(offset, 1) ? msSolLoadU8(msSolInstructionData() + 8 + offset) : 0;
}

export function argU16(offset: uint64): uint16 {
	return argumentFits(offset, 2) ? msSolLoadU16(msSolInstructionData() + 8 + offset) : 0;
}

export function argU32(offset: uint64): uint32 {
	return argumentFits(offset, 4) ? msSolLoadU32(msSolInstructionData() + 8 + offset) : 0;
}

@inline
export function argU64(offset: uint64): uint64 {
	return argumentFits(offset, 8) ? msSolLoadU64(msSolInstructionData() + 8 + offset) : 0;
}

export function argI8(offset: uint64): int8 {
	return (((argU8(offset) as int16) ^ 128) - 128) as int8;
}
export function argI16(offset: uint64): int16 {
	return (((argU16(offset) as int32) ^ 32768) - 32768) as int16;
}
export function argI32(offset: uint64): int32 {
	return (((argU32(offset) as int64) ^ 2147483648) - 2147483648) as int32;
}
export function argI64(offset: uint64): int64 { return argU64(offset) as int64; }

export function argBool(offset: uint64): boolean {
	return argU8(offset) == 1;
}

export function argBoolValid(offset: uint64): boolean {
	return argumentFits(offset, 1) && msSolLoadU8(msSolInstructionData() + 8 + offset) <= 1;
}

export function argPubkey(offset: uint64): Pubkey {
	return argumentFits(offset, 32) ? loadPubkey(msSolInstructionData() + 8 + offset) : Pubkey.zero();
}

export function argBytesFit(offset: uint64): boolean {
	const at = argumentAddress(offset, 4);
	if (at == 0) { return false; }
	const length = msSolLoadU32(at) as uint64;
	const data = instructionData();
	return length <= data.length - 8 - offset - 4;
}

export function argBytes(offset: uint64): Bytes {
	if (!argBytesFit(offset)) {
		const empty: Bytes = { address: 0, length: 0 };
		return empty;
	}
	const length = argU32(offset) as uint64;
	const view: Bytes = { address: argumentAddress(offset + 4, length), length: length };
	return view;
}

@inline function initialized(
	funding: Account,
	created: Account,
	space: uint64,
	discriminator: uint64,
	signers: Readonly<Span<SignerSeeds>>,
): Result<Account, ProgramError> {
	if (keysEqual(funding.keyAddress(), created.keyAddress())) {
		return Result.err(ProgramError.tryingToInitPayerAsProgramAccount());
	}
	if (space < 8) { return Result.err(ProgramError.accountDataTooSmall()); }
	const _made = try createAccountAllowPrefund(funding, created, minimumBalance(space), space, msSolProgramId(), signers);
	msSolStoreU64(created.address + 88, discriminator);
	if (!claimExclusive(created.address)) { return Result.err(ProgramError.accountBorrowFailed()); }
	return Result.ok(created);
}

export function createdAccount(
	payer: Account,
	target: Account,
	space: uint64,
	discriminator: uint64,
	signers: Readonly<Span<SignerSeeds>> = [],
): Result<Account, ProgramError> {
	return initialized(payer, target, space, discriminator, signers);
}

export struct DerivedAccount {
	account: Account;
	bump: uint8;
}

export struct SlottedSeeds {
	private table: uint64;
	private used: uint64;
}

// Only `slottedTable` builds one: a seed list with three free slices after it and a byte for the bump. The hash reads
// that table in place and leaves the bump in the byte, so the seeds and the next slice sign for the address.
@inline export function slottedSeeds(seeds: Readonly<Span<SeedSlice>>, bump: Readonly<Span<uint8>>): SlottedSeeds {
	return { table: msSolSeedsAddress(seeds), used: stagedInPlace(seeds, bump) };
}

@inline function slotBump(seeds: SlottedSeeds): uint8 {
	return msSolLoadU8(msSolLoadU64(seeds.table + seeds.used * 16));
}

export function createdPdaAccount(
	payer: Account,
	target: Account,
	seeds: SlottedSeeds,
	space: uint64,
	discriminator: uint64,
): Result<DerivedAccount, ProgramError> {
	const failure = seedsCanonicalProvenFailure(target.keyAddress(), seeds);
	if (failure != 0) { return Result.err({ code: failure }); }
	const one: SignerSeeds[1] = [{ address: seeds.table, length: seeds.used + 1 }];
	const created = try initialized(payer, target, space, discriminator, one);
	return Result.ok({ account: created, bump: slotBump(seeds) });
}

// Only `signedPda(call, pda, seeds)` calls this, with the table it passes to that call as its signers. The matching hash
// skips the curve check because the runtime derives every signer before it runs the callee and refuses an address on the
// curve; an `ok` here proves nothing about the address until that CPI has run.
export function foundSigner(account: Account, seeds: SlottedSeeds): Result<SignerSeeds, ProgramError> {
	const failure = seedsCanonicalProvenFailure(account.keyAddress(), seeds);
	if (failure != 0) { return Result.err({ code: failure }); }
	return Result.ok({ address: seeds.table, length: seeds.used + 1 });
}

// The address and bump of literal seeds, folded at compile time against the declared program id:
// the run-time find is replaced by one key compare.
export function createdPdaAccountAt(
	payer: Account,
	target: Account,
	seeds: Readonly<Span<SeedSlice>>,
	word0: uint64, word1: uint64, word2: uint64, word3: uint64,
	space: uint64,
	discriminator: uint64,
): Result<Account, ProgramError> {
	const mismatch = seedsFoldedFailure(target.keyAddress(), word0, word1, word2, word3);
	if (mismatch != 0) { return Result.err({ code: mismatch }); }
	const one: SignerSeeds[1] = [signerOf(seeds)];
	return initialized(payer, target, space, discriminator, one);
}

@inline export function canonicalBump(
	account: Account,
	seeds: Readonly<Span<SeedSlice>>,
): Result<uint8, ProgramError> {
	let bump: uint8[1] = [0];
	const failure = findCanonicalFailureAt(tableAddress(seeds), seeds.length as uint64, ownProgram(), account.keyAddress(), msSolSpanAddress(bump));
	if (failure != 0) { return Result.err({ code: failure }); }
	return Result.ok(bump[0]);
}

@inline export function slottedCanonicalBump(account: Account, seeds: SlottedSeeds): Result<uint8, ProgramError> {
	const failure = seedsCanonicalFailure(account.keyAddress(), seeds);
	if (failure != 0) { return Result.err({ code: failure }); }
	return Result.ok(slotBump(seeds));
}

// The account is proven owned by this program, so its address is off the curve and the matching bump
// needs no sol_curve_validate_point; every higher bump is still curve-checked inside the find.
export function canonicalBumpProven(account: Account, seeds: SlottedSeeds): Result<uint8, ProgramError> {
	const failure = seedsCanonicalProvenFailure(account.keyAddress(), seeds);
	if (failure != 0) { return Result.err({ code: failure }); }
	return Result.ok(slotBump(seeds));
}

@inline export function canonicalBumpOwned(account: Account, seeds: SlottedSeeds): Result<uint8, ProgramError> {
	if (!keysEqual(account.address + 40, ownProgram())) {
		return Result.err(ProgramError.accountOwnedByWrongProgram());
	}
	return canonicalBumpProven(account, seeds);
}

export function givenBump(account: Account, seeds: SlottedSeeds, bump: uint8): Result<uint8, ProgramError> {
	const failure = seedsGivenFailure(account.keyAddress(), seeds, bump);
	if (failure != 0) { return Result.err({ code: failure }); }
	return Result.ok(bump);
}

// An account owned by this program sits at an address that signed or that invoke_signed created, and neither
// exists on the curve, so a hash match proves off-curve without sol_curve_validate_point.
export function givenBumpOwned(account: Account, seeds: SlottedSeeds, bump: uint8): Result<uint8, ProgramError> {
	const failure = seedsGivenOwnedFailure(account, seeds, bump);
	if (failure != 0) { return Result.err({ code: failure }); }
	return Result.ok(bump);
}

export function closedProgramAccount(
	target: Account,
	destination: Account,
): Result<uint64, ProgramError> {
	if (target.key() == destination.key()) { return Result.err(ProgramError.constraintClose()); }
	if (!target.isWritable() || !destination.isWritable()) { return Result.err(ProgramError.constraintMut()); }
	if (!keysEqual(target.address + 40, msSolProgramId())) { return Result.err(ProgramError.accountOwnedByWrongProgram()); }
	const moved = target.lamports();
	const total = destination.lamports() + moved;
	if (total < moved) { return Result.err(ProgramError.arithmeticOverflow()); }
	destination.setLamports(total);
	target.setLamports(0);
	if (target.dataLength() >= 8) { msSolStoreU64(target.address + 88, 0xffffffffffffffff); }
	target.assign(Pubkey.zero());
	const _emptied = try target.resize(0);
	return Result.ok(moved);
}

export function resizedProgramAccount(
	target: Account,
	space: uint64,
	funding: Account,
	floor: uint64,
): Result<uint64, ProgramError> {
	const current = target.dataLength();
	if (space != current && space < floor) { return Result.err(ProgramError.accountDataTooSmall()); }
	if (space > current && space - current > 10240) {
		return Result.err(ProgramError.accountReallocExceedsLimit());
	}
	const payerIsAccount = funding.address == target.address;
	const held = target.lamports();
	const required = minimumBalance(space);
	if (space > current) {
		if (required > held) {
			if (payerIsAccount) { return Result.err(ProgramError.invalidArgument()); }
			const _funded = try transfer(funding, target, required - held);
		}
	} else if (space < current && !payerIsAccount) {
		const reclaimable = minimumBalance(current) - required;
		const above = held > required ? held - required : 0;
		const refund = reclaimable < above ? reclaimable : above;
		const payerLamports = funding.lamports();
		if (payerLamports + refund < payerLamports) { return Result.err(ProgramError.arithmeticOverflow()); }
		funding.setLamports(payerLamports + refund);
		target.setLamports(held - refund);
	}
	return target.resize(space);
}

export function expectAddress(actual: Pubkey, expected: Pubkey): Result<void, ProgramError> {
	if (actual != expected) { return Result.err(ProgramError.constraintAddress()); }
	return Result.ok(null);
}

export function expectHasOne(actual: Pubkey, expected: Pubkey): Result<void, ProgramError> {
	if (actual != expected) { return Result.err(ProgramError.constraintHasOne()); }
	return Result.ok(null);
}

@inline export function keysFailure(actual: uint64, expected: uint64, failure: uint64): uint64 {
	if (msSolLoadU64(actual) != msSolLoadU64(expected)) { return failure; }
	if (msSolLoadU64(actual + 8) != msSolLoadU64(expected + 8)) { return failure; }
	if (msSolLoadU64(actual + 16) != msSolLoadU64(expected + 16)) { return failure; }
	if (msSolLoadU64(actual + 24) != msSolLoadU64(expected + 24)) { return failure; }
	return 0;
}

export function keysMatch(actual: uint64, expected: uint64, failure: uint64): Result<void, ProgramError> {
	const code = keysFailure(actual, expected, failure);
	if (code != 0 || (failure == 0 && !keysEqual(actual, expected))) { return Result.err({ code: code }); }
	return Result.ok(null);
}

@inline export function conditionFailure(condition: boolean, failure: uint64): uint64 {
	return condition ? 0 : failure;
}

@inline export function holds(condition: boolean, failure: uint64): Result<void, ProgramError> {
	const code = conditionFailure(condition, failure);
	if (!condition) { return Result.err({ code: code }); }
	return Result.ok(null);
}

export function seedsGivenFailure(key: uint64, seeds: SlottedSeeds, bump: uint8): uint64 {
	if (seedsGivenProvenFailure(key, seeds, bump) != 0 || msSolCurveValidatePoint(0, key, 0) == 0) {
		return ProgramError.constraintSeeds().code;
	}
	return 0;
}

@inline export function seedsGivenProvenFailure(key: uint64, seeds: SlottedSeeds, bump: uint8): uint64 {
	return hashStagedFailure(seeds.table, seeds.used, bump as uint64, key);
}

@inline export function seedsGivenOwnedFailure(account: Account, seeds: SlottedSeeds, bump: uint8): uint64 {
	if (!keysEqual(account.address + 40, ownProgram())) {
		return ProgramError.accountOwnedByWrongProgram().code;
	}
	return seedsGivenProvenFailure(account.keyAddress(), seeds, bump);
}

@inline export function seedsCanonicalFailure(key: uint64, seeds: SlottedSeeds): uint64 {
	return findCanonicalStagedFailure(seeds.table, seeds.used, key);
}

@inline export function seedsCanonicalProvenFailure(key: uint64, seeds: SlottedSeeds): uint64 {
	return findExpectedStagedFailure(seeds.table, seeds.used, key);
}

@inline export function seedsFoldedFailure(
	key: uint64, word0: uint64, word1: uint64, word2: uint64, word3: uint64,
): uint64 {
	if (msSolLoadU64(key) != word0 || msSolLoadU64(key + 8) != word1 ||
		msSolLoadU64(key + 16) != word2 || msSolLoadU64(key + 24) != word3) {
		return ProgramError.constraintSeeds().code;
	}
	return 0;
}

@inline export function seedsFoldedGivenFailure(
	key: uint64, word0: uint64, word1: uint64, word2: uint64, word3: uint64, bump: uint8, folded: uint8,
): uint64 {
	if (bump != folded) { return ProgramError.constraintSeeds().code; }
	return seedsFoldedFailure(key, word0, word1, word2, word3);
}

export function seedsFolded(
	key: uint64, word0: uint64, word1: uint64, word2: uint64, word3: uint64,
): Result<void, ProgramError> {
	const code = seedsFoldedFailure(key, word0, word1, word2, word3);
	if (code != 0) { return Result.err({ code: code }); }
	return Result.ok(null);
}

const MAX_EVENT_BYTES: uint64 = 1024;

@noinline export function logEvent(
	discriminator: Readonly<Span<uint8>>,
	layout: Readonly<Span<uint8>>,
	values: Readonly<Span<uint64>>,
): uint64 {
	let storage: uint8[1024] = [];
	const base = msSolSpanAddress(storage);
	if (layout.length != values.length || discriminator.length != 8) {
		failWith(ProgramError.invalidArgument());
		return 0;
	}
	for (let index = 0; index < 8; index++) { msSolStoreU8(base + (index as uint64), discriminator[index]); }
	let at: uint64 = 8;
	for (let index = 0; index < layout.length; index++) {
		const width = layout[index] as uint64;
		if (width > MAX_EVENT_BYTES - at) {
			failWith(ProgramError.invalidArgument());
			return 0;
		}
		if (width == 1) { msSolStoreU8(base + at, values[index] as uint8); }
		else if (width == 2) { msSolStoreU16(base + at, values[index] as uint16); }
		else if (width == 4) { msSolStoreU32(base + at, values[index] as uint32); }
		else if (width == 8) { msSolStoreU64(base + at, values[index]); }
		else if (width == 32) { msSolCopy(base + at, values[index], 32); }
		else {
			failWith(ProgramError.invalidArgument());
			return 0;
		}
		at = at + width;
	}
	msSolLogData(base, at);
	return at;
}

export function logData(bytes: Bytes): void {
	msSolLogData(bytes.address, bytes.length);
}

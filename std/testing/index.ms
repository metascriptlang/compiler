// MetaScript Testing Framework
//
// Compiler intrinsic: these function signatures provide type information
// for the type checker. Actual behavior is generated by codegen when
// is_test_mode is enabled. In normal compilation, calls are stripped.

export function test(name: string, body: () => void): void {}
export function check(condition: boolean): void {}
export function require(condition: boolean): void {}
export function testGroup(name: string, body: () => void): void {}

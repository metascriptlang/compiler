/**
 * I/O — C/POSIX Backend
 *
 * Provides stdin reading and stdout/stderr writing.
 */

@include("io/native.h");

extern function msReadLine(): string;
extern function msReadBytes(n: number): string;
extern function msReadFile(path: string): string;
extern function msWriteStdout(s: string): void;
extern function msWriteStderr(s: string): void;

export function readLine(): string {
	return msReadLine();
}

export function readBytes(n: number): string {
	return msReadBytes(n);
}

export function readFile(path: string): string {
	return msReadFile(path);
}

export function writeStdout(s: string): void {
	msWriteStdout(s);
}

export function writeStderr(s: string): void {
	msWriteStderr(s);
}

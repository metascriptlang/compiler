// HTTP Client — connect, send request, read response.
// Imports std/net for TCP, parser/headers for protocol handling.

@include("std/net/native.h");

extern function msNetSocket(): int32;
extern function msNetConnect(fd: int32, host: string, port: int32): int32;
extern function msNetSend(fd: int32, data: string): int32;
extern function msNetRecv(fd: int32, maxBytes: int32): string;
extern function msNetClose(fd: int32): void;
extern function msNetSetTimeout(fd: int32, ms: int32): int32;

import {
	HttpMethod, HttpResponse, HttpHeaders, RequestOptions, ParsedUrl,
	methodToString,
} from "./types";
import {
	HttpError,
	connectionFailed, socketError, invalidResponse, tooManyRedirects,
} from "./errors";
import {
	createHeaders, setHeader, getHeader, hasHeader, serializeHeaders,
	getContentLength, isChunked,
} from "./headers";
import { parseResponse, parseUrl, decodeChunked } from "./parser";

// ===== Client Interface =====

export interface HttpClient {
	timeout: int32;
	maxRedirects: int32;
	userAgent: string;
}

export function createClient(): HttpClient {
	return {
		timeout: 30000,
		maxRedirects: 5,
		userAgent: "MetaScript/1.0",
	};
}

// ===== One-Shot Functions =====

export function httpGet(host: string, port: int32, path: string): Result<HttpResponse, HttpError> {
	const headers = createHeaders();
	return doRequest({
		method: HttpMethod.GET,
		hostname: host,
		port: port,
		path: path,
		headers: headers,
		body: "",
		timeout: 30000,
	});
}

export function httpPost(host: string, port: int32, path: string, body: string, contentType: string): Result<HttpResponse, HttpError> {
	const headers = createHeaders();
	setHeader(headers, "content-type", contentType);
	return doRequest({
		method: HttpMethod.POST,
		hostname: host,
		port: port,
		path: path,
		headers: headers,
		body: body,
		timeout: 30000,
	});
}

// Full options request.
export function request(options: RequestOptions): Result<HttpResponse, HttpError> {
	return doRequest(options);
}

// ===== Client Methods =====

export function clientGet(c: HttpClient, host: string, port: int32, path: string): Result<HttpResponse, HttpError> {
	const headers = createHeaders();
	setHeader(headers, "user-agent", c.userAgent);
	return requestWithRedirects({
		method: HttpMethod.GET,
		hostname: host,
		port: port,
		path: path,
		headers: headers,
		body: "",
		timeout: c.timeout,
	}, c.maxRedirects);
}

export function clientPost(c: HttpClient, host: string, port: int32, path: string, body: string, contentType: string): Result<HttpResponse, HttpError> {
	const headers = createHeaders();
	setHeader(headers, "content-type", contentType);
	setHeader(headers, "user-agent", c.userAgent);
	return requestWithRedirects({
		method: HttpMethod.POST,
		hostname: host,
		port: port,
		path: path,
		headers: headers,
		body: body,
		timeout: c.timeout,
	}, c.maxRedirects);
}

// ===== Core Request =====

function doRequest(options: RequestOptions): Result<HttpResponse, HttpError> {
	const fd = msNetSocket();
	if (fd < 0) return Result.err(socketError("socket() failed"));

	if (options.timeout > 0) {
		msNetSetTimeout(fd, options.timeout);
	}

	if (msNetConnect(fd, options.hostname, options.port) < 0) {
		msNetClose(fd);
		return Result.err(connectionFailed("connect to " + options.hostname + ":" + options.port.toString() + " failed"));
	}

	// Build request
	setHeader(options.headers, "host", options.hostname);
	if (options.body.length > 0) {
		setHeader(options.headers, "content-length", options.body.length.toString());
	}
	setHeader(options.headers, "connection", "close");

	let reqStr = methodToString(options.method) + " " + options.path + " HTTP/1.1\r\n";
	reqStr = reqStr + serializeHeaders(options.headers) + "\r\n" + options.body;

	if (msNetSend(fd, reqStr) < 0) {
		msNetClose(fd);
		return Result.err(socketError("send failed"));
	}

	// Read response headers
	let data = msNetRecv(fd, 8192);
	if (data.length === 0) {
		msNetClose(fd);
		return Result.err(invalidResponse("empty response"));
	}

	// Parse status + headers
	const parsed = parseResponse(data);
	if (!parsed.ok) {
		msNetClose(fd);
		return Result.err(parsed.error);
	}

	// Read full body
	const contentLength = getContentLength(parsed.value.headers);
	let body = "";

	if (isChunked(parsed.value.headers)) {
		// Read until we have all chunked data
		let chunkedData = data.slice(parsed.value.bodyStart, data.length);
		// Keep reading until we see the final chunk terminator
		while (!chunkedData.startsWith("0\r\n") && !chunkedData.contains("\r\n0\r\n")) {
			const more = msNetRecv(fd, 8192);
			if (more.length === 0) break;
			chunkedData = chunkedData + more;
		}
		msNetClose(fd);
		const decoded = decodeChunked(chunkedData);
		if (!decoded.ok) return Result.err(decoded.error);
		body = decoded.value;
	} else if (contentLength > 0) {
		body = readFullBody(fd, data, parsed.value.bodyStart, contentLength);
		msNetClose(fd);
	} else if (contentLength < 0) {
		// No Content-Length, no chunked: read until connection close
		body = readUntilClose(fd, data, parsed.value.bodyStart);
		msNetClose(fd);
	} else {
		msNetClose(fd);
	}

	return Result.ok({
		status: parsed.value.status,
		statusText: parsed.value.statusText,
		headers: parsed.value.headers,
		body: body,
	});
}

// ===== Body Reading Helpers =====

function readFullBody(fd: int32, initialData: string, bodyStart: int32, contentLength: int32): string {
	const available = initialData.length - bodyStart;
	if (available >= contentLength) {
		return initialData.slice(bodyStart, bodyStart + contentLength);
	}
	let body = initialData.slice(bodyStart, initialData.length);
	let remaining = contentLength - available;
	while (remaining > 0) {
		const chunk = msNetRecv(fd, remaining);
		if (chunk.length === 0) break;
		body = body + chunk;
		remaining = remaining - chunk.length;
	}
	return body;
}

function readUntilClose(fd: int32, initialData: string, bodyStart: int32): string {
	let body = initialData.slice(bodyStart, initialData.length);
	while (true) {
		const chunk = msNetRecv(fd, 8192);
		if (chunk.length === 0) break;
		body = body + chunk;
	}
	return body;
}

// ===== Redirect Following =====

export function requestWithRedirects(options: RequestOptions, maxRedirects: int32): Result<HttpResponse, HttpError> {
	let remaining = maxRedirects;
	let currentHostname = options.hostname;
	let currentPort = options.port;
	let currentPath = options.path;
	let currentMethod = options.method;
	let currentBody = options.body;

	while (remaining >= 0) {
		const headers = createHeaders();
		// Copy original headers
		let i = 0;
		while (i < options.headers._names.length) {
			setHeader(headers, options.headers._names[i], options.headers._values[i]);
			i = i + 1;
		}

		const resp = doRequest({
			method: currentMethod,
			hostname: currentHostname,
			port: currentPort,
			path: currentPath,
			headers: headers,
			body: currentBody,
			timeout: options.timeout,
		});
		if (!resp.ok) return resp;

		if (resp.value.status < 300 || resp.value.status >= 400) {
			return resp;
		}

		// Follow redirect
		const location = getHeader(resp.value.headers, "location");
		if (location.length === 0) return resp;

		// Handle absolute vs relative redirect
		if (location.startsWith("http://") || location.startsWith("https://")) {
			const parsed = parseUrl(location);
			if (!parsed.ok) return Result.err(parsed.error);
			currentHostname = parsed.value.hostname;
			currentPort = parsed.value.port;
			currentPath = parsed.value.path;
			if (parsed.value.query.length > 0) {
				currentPath = currentPath + "?" + parsed.value.query;
			}
		} else {
			// Relative redirect — same host
			currentPath = location;
		}

		// 301/302/303: force GET and strip body (per RFC 7231)
		// 307/308: preserve method and body
		if (resp.value.status === 301 || resp.value.status === 302 || resp.value.status === 303) {
			currentMethod = HttpMethod.GET;
			currentBody = "";
		}

		remaining = remaining - 1;
	}
	return Result.err(tooManyRedirects(maxRedirects));
}

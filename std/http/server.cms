// HTTP Server — event-loop-per-core architecture.
// Each core: kqueue/epoll selector multiplexing all connections.
// Parallel across cores (spawn + SO_REUSEPORT), concurrent within each (selector).

@emit("#define MS_SELECTOR_BRIDGE");
@include("runtime/os.h");
@include("runtime/net/socket.h");
@include("runtime/actor/selector.h");
@include("runtime/net/eventLoopUring.h");

extern function msNetSocket(): int32;
extern function msNetBind(fd: int32, addr: string, port: int32): int32;
extern function msNetBindShared(fd: int32, addr: string, port: int32): int32;
extern function msNetListen(fd: int32, backlog: int32): int32;
extern function msNetAccept(fd: int32): int32;
extern function msNetSend(fd: int32, data: string): int32;
extern function msNetRecv(fd: int32, maxBytes: int32): string;
extern function msNetClose(fd: int32): void;
extern function msNetSetTimeout(fd: int32, ms: int32): int32;
extern function msNetSetNonBlocking(fd: int32): int32;
extern function msNetAcceptNonBlock(fd: int32): int32;
extern function msNetRecvNonBlock(fd: int32, maxBytes: int32): string;
extern function msNetSendNonBlock(fd: int32, data: string, offset: int32): int32;
extern function msSelectorOpen(): int64;
extern function msSelectorAdd(sel: int64, fd: int32, events: int32): int32;
extern function msSelectorModify(sel: int64, fd: int32, events: int32): int32;
extern function msSelectorRemove(sel: int64, fd: int32): int32;
extern function msSelectorWait(sel: int64, timeoutMs: int32): int32;
extern function msSelectorEventFd(index: int32): int32;
extern function msSelectorEventFlags(index: int32): int32;
extern function msSelectorClose(sel: int64): void;
extern function msRunOnce(timeoutMs: int32): boolean;
extern function msGetWakePipeFd(): int32;

// io_uring native event loop (Linux only — falls back to selector on macOS)
extern function msHasUringEventLoop(): int32;
extern function msUringEvtInit(): int32;
extern function msUringSubmitAccept(listenFd: int32): void;
extern function msUringSubmitRecv(fd: int32, buf: string, len: int32): void;
extern function msUringSubmitSend(fd: int32, buf: string, len: int32): void;
extern function msUringWait(timeoutMs: int32): int32;
extern function msUringEventFd(idx: int32): int32;
extern function msUringEventOp(idx: int32): int32;
extern function msUringEventRes(idx: int32): int32;
extern function msUringRecvData(fd: int32, bytesRecv: int32): string;
extern function msUringFastHeaderCheck(fd: int32, bytesRecv: int32): int32;
extern function msUringBuildResponse(fd: int32, status: int32, statusText: string, contentType: string, body: string): string;
extern function msFastParseMethod(data: string): int32;
extern function msFastParsePath(data: string): string;
extern function msNetSetTcpNoDelay(fd: int32): void;
extern function msNetSetNoSigpipe(fd: int32): void;

// Zero-alloc hot path externs (Phase 1-4)
extern function recvAll(this dest: string, fd: int32): int32 from "&msNetRecvAll";
extern function buildResponseReuse(this dest: string, status: int32, st: string, ct: string, body: string): void from "&msBuildResponseReuse";
extern function parsePathInto(this dest: string, data: string): void from "&msFastParsePathInto";
extern function shiftLeft(this s: string, offset: int32): void from "&msStringShiftLeft";
extern function msStringNewCap(cap: int64): string;

import {
	HttpMethod, HttpRequest, HttpHeaders, ServerResponse, RequestHandler, AsyncRequestHandler,
	statusText,
} from "./types";
import { HttpError, socketError } from "./errors";
import * as hdrs from "./headers";
import { frameRequest, FrameResult } from "./parser";
extern function msOsCpuCount(): int32;

// ===== Server =====

export interface HttpServer {
	fd: int32;
	handler: RequestHandler;
	running: boolean;
	address: string;
	port: int32;
	keepAlive: boolean;
	keepAliveTimeout: int32;
	maxRequestsPerConnection: int32;
	maxHeaderSize: int32;
	maxBodySize: int32;
}

export function createServer(handler: RequestHandler): HttpServer {
	return {
		fd: -1, handler: handler, running: false,
		address: "0.0.0.0", port: 0,
		keepAlive: true, keepAliveTimeout: 65000,
		maxRequestsPerConnection: 0, maxHeaderSize: 8192, maxBodySize: 1048576,
	};
}

export function listen(this server: HttpServer, addr: string, port: int32): Result<void, HttpError> {
	const fd = msNetSocket();
	if (fd < 0) return Result.err(socketError("socket() failed"));
	if (msNetBind(fd, addr, port) < 0) {
		msNetClose(fd);
		return Result.err(socketError(`bind() failed on ${addr}:${port}`));
	}
	if (msNetListen(fd, 1024) < 0) {
		msNetClose(fd);
		return Result.err(socketError("listen() failed"));
	}
	server.fd = fd;
	server.address = addr;
	server.port = port;
	return Result.ok(null);
}

export function stop(server: HttpServer): void {
	server.running = false;
	if (server.fd >= 0) { msNetClose(server.fd); server.fd = -1; }
}

// ===== Response Helpers =====

// Build HTTP response in one C-level allocation (httpbeast pattern).
// Used as fast path when res.headers is empty — zero template literal overhead.
extern function msBuildResponse(status: int32, statusText: string, contentType: string, body: string): string;

// Slow path: build response in MS code, honoring user-set res.headers
// (CORS, custom auth, cookies, etc.). Fast path skipped when res.headers
// has entries beyond what sendBody would auto-set.
function sendBody(res: ServerResponse, contentType: string, body: string): void {
	if (!hdrs.hasHeader(res.headers, "content-type")) {
		hdrs.setHeader(res.headers, "content-type", contentType);
	}
	endResponse(res, body);
}

// Module-level mirror of the server's current keep-alive timeout, in seconds.
// Set by serve()/serveConcurrent() before the event loop starts; read by
// endResponse to emit the `Keep-Alive: timeout=N` header. Without this,
// browsers default to ~300s (Chrome) or longer pool TTL — they reuse sockets
// long after the server closes them, causing a multi-second stall on the
// first request that lands on a dead pooled socket.
let kaTimeoutSeconds: int32 = 60;

// Internal: build wire response from res.status + res.headers + body.
// Honors any user-set headers (Access-Control-*, etc.). Auto Content-Length
// if not already set — note: uses string length, not UTF-8 byte length, so
// non-ASCII bodies need explicit Content-Length until byteLength helper exists.
//
// RFC 7230 §3.3.2: 1xx/204/304 responses MUST NOT carry Content-Length.
// Chrome blocks the next request on a CORS-preflight connection for ~5s if
// the 204 OPTIONS response includes Content-Length — strict parser waits
// thinking the response is malformed.
//
// RFC 7234 §5.2 / Node http: emit `Keep-Alive: timeout=<seconds>` so the
// client's connection pool aligns with the server's idle timeout. Without
// this, browsers reuse sockets long after the server has closed them,
// stalling the next request ~5s on dead-socket detection.
function endResponse(res: ServerResponse, data: string): void {
	if (res._finished) return;
	const status = res.status;
	const noBodyAllowed = status === 204 || status === 304 || (status >= 100 && status < 200);
	if (noBodyAllowed) {
		// Strip body-related headers — even if user set them, they're invalid here.
		hdrs.removeHeader(res.headers, "content-length");
		hdrs.removeHeader(res.headers, "content-type");
	} else if (!hdrs.hasHeader(res.headers, "content-length")) {
		hdrs.setHeader(res.headers, "content-length", data.length.toString());
	}
	if (!hdrs.hasHeader(res.headers, "keep-alive") && !hdrs.hasHeader(res.headers, "connection")) {
		hdrs.setHeader(res.headers, "keep-alive", "timeout=" + kaTimeoutSeconds.toString());
	}
	const headerStr = hdrs.serializeHeaders(res.headers);
	const body = noBodyAllowed ? "" : data;
	res._responseData = "HTTP/1.1 " + status.toString() + " " + statusText(status) + "\r\n" + headerStr + "\r\n" + body;
	res.headersSent = true;
	res._finished = true;
}

export function sendText(res: ServerResponse, text: string): void {
	sendBody(res, "text/plain; charset=utf-8", text);
}

export function sendJson(res: ServerResponse, json: string): void {
	sendBody(res, "application/json", json);
}

export function sendHtml(res: ServerResponse, html: string): void {
	sendBody(res, "text/html; charset=utf-8", html);
}

export function sendError(res: ServerResponse, status: int32, msg: string): void {
	res.status = status;
	sendBody(res, "text/plain", msg);
}

// Raw response — send pre-built response string directly (zero overhead).
// For users who build their own HTTP response (custom headers, status, etc.).
// NOTE: under multi-loop event loop this can desync fd state — prefer
// res.setHeader(...) + sendJson/sendText which honor headers automatically.
export function sendRaw(res: ServerResponse, raw: string): void {
	res._responseData = raw;
	res.headersSent = true;
	res._finished = true;
}

// ===== Node-style extension methods on ServerResponse =====
// res.setHeader / getHeader / removeHeader / hasHeader / writeHead / end / json
// All resolve at call site to direct function calls (no v-table).

export function setHeader(this res: ServerResponse, name: string, value: string): void {
	hdrs.setHeader(res.headers, name, value);
}

export function getHeader(this res: ServerResponse, name: string): string {
	return hdrs.getHeader(res.headers, name);
}

export function removeHeader(this res: ServerResponse, name: string): void {
	hdrs.removeHeader(res.headers, name);
}

export function hasHeader(this res: ServerResponse, name: string): boolean {
	return hdrs.hasHeader(res.headers, name);
}

// Set status + merge headers, no body sent yet.
export function writeHead(this res: ServerResponse, status: int32, headers: HttpHeaders = null as unknown as HttpHeaders): void {
	res.status = status;
	if (headers !== null) {
		let i = 0;
		while (i < headers._names.length) {
			hdrs.setHeader(res.headers, headers._names[i], headers._values[i]);
			i = i + 1;
		}
	}
}

// End the response with optional body. Honors all res.headers set so far.
export function end(this res: ServerResponse, data: string = ""): void {
	endResponse(res, data);
}

// Express-style sugar: set content-type to application/json + end with body.
export function json(this res: ServerResponse, body: string): void {
	if (!hdrs.hasHeader(res.headers, "content-type")) {
		hdrs.setHeader(res.headers, "content-type", "application/json");
	}
	endResponse(res, body);
}

// Direct fd access — for advanced socket ops (setsockopt, shutdown, etc.)
export function getClientFd(req: HttpRequest): int32 {
	return req.clientFd;
}


// ===== Event Loop =====

interface ClientState {
	data: string;
	sendQueue: string;
	bytesSent: int32;
	headersEndPos: int32;
	asyncPending: boolean;
	// Pre-allocated per-connection — reused across requests (zero alloc after first request)
	request: HttpRequest;
	response: ServerResponse;
}

function initClient(fd: int32): ClientState {
	return {
		data: msStringNewCap(4096), sendQueue: "", bytesSent: 0, headersEndPos: -1, asyncPending: false,
		request: {
			method: HttpMethod.GET, path: msStringNewCap(256), version: "1.1",
			headers: hdrs.createHeaders(), body: "", clientFd: fd,
		},
		response: {
			fd: fd, status: 200,
			headers: hdrs.createHeaders(),
			_chunks: [],
			headersSent: false, _finished: false, _chunked: false,
			_responseData: msStringNewCap(4096),
		},
	};
}

function resetClient(client: ClientState, fd: int32): void {
	client.data.setLength(0);
	client.bytesSent = 0;
	client.headersEndPos = -1;
	client.asyncPending = false;
	client.request.method = HttpMethod.GET;
	client.request.clientFd = fd;
	client.request.body = "";
	client.request.headers._names.length = 0;
	client.request.headers._values.length = 0;
	client.response.fd = fd;
	client.response.status = 200;
	client.response.headersSent = false;
	client.response._finished = false;
	client.response._chunked = false;
	client.response.headers._names.length = 0;
	client.response.headers._values.length = 0;
	client.response._responseData.setLength(0);
}

function resetRequest(client: ClientState, fd: int32, method: int32): void {
	client.request.method = method as unknown as HttpMethod;
	// path is set by parsePathInto (zero-alloc) — not reset here
	client.request.clientFd = fd;
	client.request.body = "";
	// Headers MUST be cleared — frameRequest reads CL/TE from this struct.
	// Stale headers from a previous pipelined request would mislead framing
	// (e.g. a GET reusing a POST connection sees Content-Length=5 → needMore).
	client.request.headers._names.length = 0;
	client.request.headers._values.length = 0;
}

function resetResponse(client: ClientState, fd: int32): void {
	client.response.fd = fd;
	client.response.status = 200;
	client.response.headersSent = false;
	client.response._finished = false;
	client.response._chunked = false;
	client.response.headers._names.length = 0;
	client.response.headers._values.length = 0;
	client.response._responseData.setLength(0);  // preserves buffer (= "" would free it)
}

// Fast headers check: O(1) last-4-bytes, then slow linear fallback (httpbeast pattern)
extern function msFastHeadersCheck(data: string): int32;
extern function msSlowHeadersCheck(data: string): int32;

function findHeaderEnd(data: string): int32 {
	const fast = msFastHeadersCheck(data);
	if (fast >= 0) return fast;
	return msSlowHeadersCheck(data);
}

// Parse request-line headers from `data[0..endPos)` into `headers`.
// Skips the request line (first CRLF). No fold-line / continuation support,
// no validation. Sufficient to expose Content-Length / Transfer-Encoding /
// Authorization / etc. to the body framer and handlers.
function parseHeadersInline(data: string, endPos: int32, headers: HttpHeaders): void {
	let lineStart: int32 = 0;
	while (lineStart < endPos) {
		let lineEnd = lineStart;
		while (lineEnd + 1 < endPos && !(data.charCodeAt(lineEnd) === "\r".code && data.charCodeAt(lineEnd + 1) === "\n".code)) {
			lineEnd = lineEnd + 1;
		}
		if (lineEnd === lineStart) break;  // empty line = end of headers
		// Skip first line (request line "METHOD path HTTP/1.1")
		if (lineStart > 0) {
			let colon = lineStart;
			while (colon < lineEnd && data.charCodeAt(colon) !== ":".code) colon = colon + 1;
			if (colon < lineEnd) {
				const name = data.slice(lineStart, colon);
				let valStart = colon + 1;
				while (valStart < lineEnd && (data.charCodeAt(valStart) === " ".code || data.charCodeAt(valStart) === "\t".code)) valStart = valStart + 1;
				hdrs.addHeader(headers, name, data.slice(valStart, lineEnd));
			}
		}
		lineStart = (lineEnd + 2) as int32;
	}
}

// Build minimal HTTP error response (no body, Connection: close).
// Used by body framer rejects (400 / 411 / 413) before handler dispatch.
function buildErrorResponse(status: int32): string {
	return "HTTP/1.1 " + status.toString() + " " + statusText(status) + "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
}

export function serveConcurrent(server: HttpServer, threads: int32 = 0): void {
	const n = threads > 0 ? threads : msOsCpuCount();
	server.running = true;
	kaTimeoutSeconds = server.keepAliveTimeout / 1000;
	if (server.fd >= 0) { msNetClose(server.fd); server.fd = -1; }

	const addr = server.address;
	const port = server.port;
	const handler = server.handler;

	const useUring = msHasUringEventLoop() === 1;

	for (let i = 0; i < n - 1; i += 1) {
		spawn(() => {
			const fd = msNetSocket();
			if (fd < 0) return null;
			if (msNetBindShared(fd, addr, port) < 0) { msNetClose(fd); return null; }
			if (msNetListen(fd, 1024) < 0) { msNetClose(fd); return null; }
			msNetSetNonBlocking(fd);
			if (useUring) { eventLoopUring(server, fd, handler); }
			else { eventLoop(server, fd, handler); }
			msNetClose(fd);
			return null;
		});
	}

	const fd = msNetSocket();
	if (fd < 0) return;
	if (msNetBindShared(fd, addr, port) < 0) { msNetClose(fd); return; }
	if (msNetListen(fd, 1024) < 0) { msNetClose(fd); return; }
	msNetSetNonBlocking(fd);
	if (useUring) { eventLoopUring(server, fd, handler); }
	else { eventLoop(server, fd, handler); }
	msNetClose(fd);
}

// After send completes: check for pipelined data or reset to READ.
function resetOrPipeline(server: HttpServer, client: ClientState, fd: int32, sel: int64, handler: RequestHandler): void {
	// Honor server-side keep-alive setting: if disabled, close the connection
	// after sending a response (Connection: close semantics). Without this,
	// eventLoop always re-arms read regardless, leaving sockets in a state
	// where reused connections (curl --next, browser pool) can stall.
	if (!server.keepAlive) {
		msSelectorRemove(sel, fd);
		msNetClose(fd);
		return;
	}
	if (client.data.length > 0) {
		const nextEnd = findHeaderEnd(client.data);
		if (nextEnd >= 0) {
			client.headersEndPos = nextEnd;
			dispatch(server, client, fd, sel, handler);
			return;
		}
	}
	client.headersEndPos = -1;
	msSelectorModify(sel, fd, 1);
}

function eventLoop(server: HttpServer, listenFd: int32, handler: RequestHandler): void {
	const sel = msSelectorOpen();
	msSelectorAdd(sel, listenFd, 1);
	const maxFds = 1024;
	const clients: ClientState[] = new Array(maxFds);
	let ci = 0;
	while (ci < maxFds) {
		clients[ci] = initClient(ci);
		ci = ci + 1;
	}

	while (server.running) {
		const count = msSelectorWait(sel, -1);
		if (count < 0) continue;
		let i = 0;
		while (i < count) {
			const fd = msSelectorEventFd(i);
			const flags = msSelectorEventFlags(i);

			if (fd === listenFd) {
				// Accept all pending
				while (true) {
					const cfd = msNetAcceptNonBlock(listenFd);
					if (cfd < 0) break;
					if (cfd >= maxFds) { msNetClose(cfd); continue; }
					msNetSetTcpNoDelay(cfd);
					msNetSetNonBlocking(cfd);
					msNetSetNoSigpipe(cfd);
					msSelectorAdd(sel, cfd, 1);
					resetClient(clients[cfd], cfd);
				}
			} else if (fd >= maxFds) {
				// fd out of range — shouldn't happen, but don't crash
				msSelectorRemove(sel, fd);
				msNetClose(fd);
			} else if ((flags & 1) !== 0) {
				// Zero-alloc recv: drain all available data into pre-allocated buffer
				const client = clients[fd];
				const n = client.data.recvAll(fd);
				if (n < 0) {
					msSelectorRemove(sel, fd);
					msNetClose(fd);
				} else {
					const endPos = findHeaderEnd(client.data);
					if (endPos >= 0) {
						client.headersEndPos = endPos;
						dispatch(server, client, fd, sel, handler);
					}
				}
			} else if ((flags & 2) !== 0) {
				// Send directly from _responseData (zero-copy, no sendQueue intermediary)
				const client = clients[fd];
				const resp = client.response._responseData;
				if (resp.length > 0) {
					const sent = msNetSendNonBlock(fd, resp, client.bytesSent);
					if (sent < 0) {
						msSelectorRemove(sel, fd);
						msNetClose(fd);
					} else {
						client.bytesSent = client.bytesSent + sent;
						if (client.bytesSent >= resp.length) {
							client.bytesSent = 0;
							resetOrPipeline(server, client, fd, sel, handler);
						}
					}
				}
			} else if ((flags & 4) !== 0) {
				msSelectorRemove(sel, fd);
				msNetClose(fd);
			}
			i = i + 1;
		}
		// Drain async dispatcher — enables Promise callbacks/timers in handlers (httpbeast pattern)
		msRunOnce(0);
	}
	msSelectorClose(sel);
}

// Sync send error response + close fd. Used when frameRequest rejects
// (400/411/413). Error response is small (~80 bytes) so msNetSend rarely
// blocks; acceptable for v1 in the non-blocking event loop.
function sendErrorAndClose(fd: int32, sel: int64, status: int32): void {
	msNetSend(fd, buildErrorResponse(status));
	msSelectorRemove(sel, fd);
	msNetClose(fd);
}

function dispatch(server: HttpServer, client: ClientState, fd: int32, sel: int64, handler: RequestHandler): void {
	const data = client.data;
	let endPos = client.headersEndPos;

	// Fast header check (msFastHeadersCheck) returns `len` when buffer ends
	// with \r\n\r\n. Chunked terminator (`0\r\n\r\n`) and pipelined GET both
	// satisfy this — false-match leaves bufferAfter empty (chunked) or eats
	// the next request (pipelined). Validate with slow scan when fast claims
	// end-of-buffer; if slow finds an earlier CRLFCRLF, that's the real end.
	if (endPos === (data.length as int32)) {
		const slowEnd = msSlowHeadersCheck(data);
		if (slowEnd >= 0 && slowEnd < endPos) {
			endPos = slowEnd;
			client.headersEndPos = slowEnd;
		}
	}

	const methodInt = msFastParseMethod(data);
	if (methodInt < 0) { client.data.setLength(0); client.headersEndPos = -1; return; }

	// Zero-alloc path parse: writes into pre-allocated request.path buffer
	client.request.path.parsePathInto(data);
	if (client.request.path.length === 0) { client.data.setLength(0); client.headersEndPos = -1; return; }

	// Reuse pre-allocated request/response (zero heap alloc)
	resetRequest(client, fd, methodInt);
	resetResponse(client, fd);
	parseHeadersInline(data, endPos, client.request.headers);

	// Frame body via shared helper. Non-blocking: needMore returns early so
	// the event loop can recv more bytes and re-enter dispatch.
	const bufferAfter = data.slice(endPos, data.length);
	const frame = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
	if (frame.kind === "needMore") {
		// DoS guard: cap raw body bytes (data after headers)
		if ((bufferAfter.length as int32) > server.maxBodySize) {
			sendErrorAndClose(fd, sel, 413);
			return;
		}
		// Leave headersEndPos set; eventLoop will re-call after next recv.
		// (Re-parsing headers each event is wasted but correct for v1.)
		return;
	}
	if (frame.kind === "reject") {
		sendErrorAndClose(fd, sel, frame.rejectStatus);
		return;
	}

	// Ready — populate body and dispatch handler.
	client.request.body = frame.body;
	handler(client.request, client.response);

	// Advance buffer past consumed bytes (headers + body) so pipelined
	// requests align correctly for the next dispatch.
	const totalConsumed = (endPos + frame.bytesConsumed) as int32;
	if (totalConsumed < data.length) {
		client.data.shiftLeft(totalConsumed);
	} else {
		client.data.setLength(0);
	}

	// Send directly from _responseData (no sendQueue copy)
	if (client.response._finished && client.response._responseData.length > 0) {
		client.bytesSent = 0;
		msSelectorModify(sel, fd, 3);
	} else {
		client.headersEndPos = -1;
	}
}

// ===== Blocking Mode (for simple use / testing) =====

export function serve(server: HttpServer): void {
	server.running = true;
	kaTimeoutSeconds = server.keepAliveTimeout / 1000;
	while (server.running) {
		const clientFd = msNetAccept(server.fd);
		if (clientFd < 0) continue;
		if (server.keepAliveTimeout > 0) msNetSetTimeout(clientFd, server.keepAliveTimeout);
		handleBlocking(server, clientFd);
		msNetClose(clientFd);
	}
}

export function serveN(server: HttpServer, count: int32): void {
	server.running = true;
	let served = 0;
	while (server.running && served < count) {
		const clientFd = msNetAccept(server.fd);
		if (clientFd < 0) continue;
		handleBlocking(server, clientFd);
		msNetClose(clientFd);
		served = served + 1;
	}
	server.running = false;
}

function handleBlocking(server: HttpServer, fd: int32): void {
	let requestCount = 0;
	let keepGoing = true;
	const client = initClient(fd);
	while (keepGoing) {
		// 1. Drain headers: recv until we see \r\n\r\n.
		// NB: use slow check (linear scan) — fast check returns `len` when buffer
		// ends with \r\n\r\n, which falsely matches the chunked terminator
		// (`0\r\n\r\n`) and leaves bufferAfter empty.
		let data = msNetRecv(fd, server.maxHeaderSize);
		if (data.length === 0) return;  // peer closed
		let endPos = msSlowHeadersCheck(data);
		while (endPos < 0) {
			if (data.length >= server.maxHeaderSize) return;  // header too large
			const more = msNetRecv(fd, server.maxHeaderSize);
			if (more.length === 0) return;  // peer closed mid-headers
			data = data + more;
			endPos = msSlowHeadersCheck(data);
		}

		// 2. Parse method + path + headers.
		const methodInt = msFastParseMethod(data);
		if (methodInt < 0) return;
		client.request.path.parsePathInto(data);
		if (client.request.path.length === 0) return;

		resetRequest(client, fd, methodInt);
		resetResponse(client, fd);
		parseHeadersInline(data, endPos, client.request.headers);

		// 3. Frame body — recv more bytes until ready/reject.
		// DoS guard: cap raw bytes after concat. Chunked has no upfront size,
		// so without this an attacker can stream chunks without terminator
		// → bufferAfter unbounded → eventual OOM.
		//
		// V1 LIMITATION: tryDecodeChunked is called each iteration on the FULL
		// bufferAfter (re-decode from start), giving O(n²) per request. Even
		// with this cap, a 1MB chunked attack amplifies RSS by ~400x via string
		// concat churn before 413 fires. Functional DoS is blocked; tight
		// memory bound needs an incremental chunked decoder (v2).
		let bufferAfter = data.slice(endPos, data.length);
		let frame: FrameResult = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
		while (frame.kind === "needMore") {
			const more = msNetRecv(fd, server.maxHeaderSize);
			if (more.length === 0) return;  // peer closed mid-body
			bufferAfter = bufferAfter + more;
			if ((bufferAfter.length as int32) > server.maxBodySize) {
				msNetSend(fd, buildErrorResponse(413));
				return;
			}
			frame = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
		}
		if (frame.kind === "reject") {
			msNetSend(fd, buildErrorResponse(frame.rejectStatus));
			return;  // close connection (Connection: close)
		}

		// 4. Dispatch.
		client.request.body = frame.body;
		server.handler(client.request, client.response);
		if (client.response._responseData.length > 0) msNetSend(fd, client.response._responseData);

		requestCount = requestCount + 1;
		if (!server.keepAlive) keepGoing = false;
		else if (server.maxRequestsPerConnection > 0 && requestCount >= server.maxRequestsPerConnection) keepGoing = false;
	}
}

// ===== io_uring Native Event Loop (Linux) =====
// Same logic as eventLoop but uses native RECV/SEND/ACCEPT via io_uring.
// Zero epoll, zero separate recv/send syscalls — all through the ring buffer.
// Per-fd response buffers: zero malloc after warmup (msBuildResponseReuse).

function eventLoopUring(server: HttpServer, listenFd: int32, handler: RequestHandler): void {
	if (msUringEvtInit() < 0) {
		// Fallback to selector-based event loop
		eventLoop(server, listenFd, handler);
		return;
	}

	const maxFds = 1024;
	const clients: ClientState[] = new Array(maxFds);
	let ci = 0;
	while (ci < maxFds) {
		clients[ci] = initClient(ci);
		ci = ci + 1;
	}

	// Start accepting
	msUringSubmitAccept(listenFd);

	while (server.running) {
		const count = msUringWait(-1);
		let i = 0;
		while (i < count) {
			const evFd = msUringEventFd(i);
			const op = msUringEventOp(i);
			const res = msUringEventRes(i);

			if (op === 0) {
				// ACCEPT — set socket opts, start recv
				if (res >= 0 && res < maxFds) {
					msNetSetTcpNoDelay(res);
					msNetSetNoSigpipe(res);
					msNetSetNonBlocking(res);
					clients[res] = initClient(res);
					msUringSubmitRecv(res, "", 4096);
				} else if (res >= 0) {
					msNetClose(res);
				}
				msUringSubmitAccept(listenFd);
			} else if (op === 1) {
				// RECV — fast path: check headers on raw C buffer, parse + dispatch
				if (res <= 0) {
					msNetClose(evFd);
				} else if (evFd >= 0 && evFd < maxFds) {
					const headerEnd = msUringFastHeaderCheck(evFd, res);
					if (headerEnd < 0) {
						msUringSubmitRecv(evFd, "", 4096);
					} else {
						const data = msUringRecvData(evFd, res);
						const methodInt = msFastParseMethod(data);
						if (methodInt >= 0) {
							const client = clients[evFd];
							client.request.path.parsePathInto(data);
							resetRequest(client, evFd, methodInt);
							resetResponse(client, evFd);
							handler(client.request, client.response);
							if (client.response._finished && client.response._responseData.length > 0) {
								msUringSubmitSend(evFd, client.response._responseData, client.response._responseData.length);
							} else {
								msUringSubmitRecv(evFd, "", 4096);
							}
						} else {
							msNetClose(evFd);
						}
					}
				}
			} else if (op === 2) {
				// SEND complete — re-arm recv for keep-alive
				if (evFd >= 0 && evFd < maxFds) {
					clients[evFd].sendQueue = "";
					msUringSubmitRecv(evFd, "", 4096);
				}
			}
			i = i + 1;
		}
		msRunOnce(0);
	}
}

// ===== Async Handler Support =====
// Enables handlers that use await (e.g., await spawn(() => heavyWork())).
// The event loop continues processing other connections while a handler is suspended.
// Completion callbacks fire via msRunOnce(0) on the same event loop thread.

export function createServerAsync(handler: AsyncRequestHandler): HttpServer {
	return {
		fd: -1, handler: null as unknown as RequestHandler, running: false,
		address: "0.0.0.0", port: 0,
		keepAlive: true, keepAliveTimeout: 65000,
		maxRequestsPerConnection: 0, maxHeaderSize: 8192, maxBodySize: 1048576,
	};
}

// Async dispatch — the stepper state machine IS the callback mechanism.
// State 0: parse + call handler → yields handler's Promise → suspends.
// State 1: handler completed → arm fd for WRITE → done.
// msAsyncCb resumes state 1 inside msProcessCallbacks (same event loop thread).
async function dispatchAsync(server: HttpServer, client: ClientState, fd: int32, sel: int64, handler: AsyncRequestHandler, inflight: int32[]): Promise<void> {
	const data = client.data;
	let endPos = client.headersEndPos;

	// Fast/slow header check guard (see dispatch comment).
	if (endPos === (data.length as int32)) {
		const slowEnd = msSlowHeadersCheck(data);
		if (slowEnd >= 0 && slowEnd < endPos) {
			endPos = slowEnd;
			client.headersEndPos = slowEnd;
		}
	}

	const methodInt = msFastParseMethod(data);
	if (methodInt < 0) { client.data.setLength(0); client.headersEndPos = -1; client.asyncPending = false; inflight[0] = inflight[0] - 1; return; }

	client.request.path.parsePathInto(data);
	if (client.request.path.length === 0) { client.data.setLength(0); client.headersEndPos = -1; client.asyncPending = false; inflight[0] = inflight[0] - 1; return; }

	resetRequest(client, fd, methodInt);
	resetResponse(client, fd);
	parseHeadersInline(data, endPos, client.request.headers);

	// Frame body. needMore/reject must reset asyncPending + inflight since
	// the caller (eventLoopAsync) incremented them before calling dispatchAsync.
	const bufferAfter = data.slice(endPos, data.length);
	const frame = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
	if (frame.kind === "needMore") {
		if ((bufferAfter.length as int32) > server.maxBodySize) {
			sendErrorAndClose(fd, sel, 413);
			client.asyncPending = false;
			inflight[0] = inflight[0] - 1;
			return;
		}
		// Wait for next recv event. Reset asyncPending so eventLoopAsync resumes
		// recv on this fd; leave headersEndPos set (re-parsed on next dispatch).
		client.asyncPending = false;
		inflight[0] = inflight[0] - 1;
		return;
	}
	if (frame.kind === "reject") {
		sendErrorAndClose(fd, sel, frame.rejectStatus);
		client.asyncPending = false;
		inflight[0] = inflight[0] - 1;
		return;
	}

	// Ready — populate body and await handler.
	client.request.body = frame.body;
	const totalConsumed = (endPos + frame.bytesConsumed) as int32;

	await handler(client.request, client.response);

	// Stepper resumes here after handler completes (via msRunOnce → msProcessCallbacks)
	client.asyncPending = false;
	inflight[0] = inflight[0] - 1;

	if (totalConsumed < data.length) {
		client.data.shiftLeft(totalConsumed);
	} else {
		client.data.setLength(0);
	}

	// Arm WRITE if response is ready
	if (client.response._finished && client.response._responseData.length > 0) {
		client.bytesSent = 0;
		msSelectorModify(sel, fd, 3);
	} else {
		client.headersEndPos = -1;
	}
}

// After async send completes: check for pipelined data or reset to READ.
function resetOrPipelineAsync(server: HttpServer, client: ClientState, fd: int32, sel: int64, handler: AsyncRequestHandler, inflight: int32[]): void {
	if (client.data.length > 0) {
		const nextEnd = findHeaderEnd(client.data);
		if (nextEnd >= 0) {
			client.headersEndPos = nextEnd;
			client.asyncPending = true;
			inflight[0] = inflight[0] + 1;
			dispatchAsync(server, client, fd, sel, handler, inflight);
			return;
		}
	}
	client.headersEndPos = -1;
	msSelectorModify(sel, fd, 1);
}

function eventLoopAsync(server: HttpServer, listenFd: int32, handler: AsyncRequestHandler): void {
	const sel = msSelectorOpen();
	msSelectorAdd(sel, listenFd, 1);

	// Track in-flight async handlers to switch between blocking and polling.
	// When asyncInFlight > 0, poll with 1ms timeout so msRunOnce(0) picks up spawn completions.
	// When asyncInFlight == 0, block indefinitely (same as sync event loop — zero overhead).
	//
	// Why NOT register the wake pipe with the HTTP selector:
	// serveConcurrentAsync spawns N event loops. The wake pipe is global (single MPSC queue).
	// If all N selectors register the wake pipe, a spawn completion wakes ALL N threads, and
	// all N call msCompletionQueueDrain concurrently — but the MPSC queue is single-consumer.
	// Timeout-based polling avoids this race entirely.
	const inflight: int32[] = [0];

	const maxFds = 1024;
	const clients: ClientState[] = new Array(maxFds);
	let ci = 0;
	while (ci < maxFds) {
		clients[ci] = initClient(ci);
		ci = ci + 1;
	}

	while (server.running) {
		const timeout = inflight[0] > 0 ? 1 : -1;
		const count = msSelectorWait(sel, timeout);
		if (count < 0) {
			// Timeout or error — still drain completions below
			if (inflight[0] > 0) {
				msRunOnce(0);
			}
			continue;
		}
		let i = 0;
		while (i < count) {
			const fd = msSelectorEventFd(i);
			const flags = msSelectorEventFlags(i);

			if (fd === listenFd) {
				while (true) {
					const cfd = msNetAcceptNonBlock(listenFd);
					if (cfd < 0) break;
					if (cfd >= maxFds) { msNetClose(cfd); continue; }
					msNetSetTcpNoDelay(cfd);
					msNetSetNonBlocking(cfd);
					msNetSetNoSigpipe(cfd);
					msSelectorAdd(sel, cfd, 1);
					resetClient(clients[cfd], cfd);
				}
			} else if (fd >= maxFds) {
				msSelectorRemove(sel, fd);
				msNetClose(fd);
			} else if ((flags & 1) !== 0) {
				const client = clients[fd];
				// Skip recv+dispatch while async handler is in-flight for this connection.
				// Data buffers in kernel until handler completes.
				if (!client.asyncPending) {
					const n = client.data.recvAll(fd);
					if (n < 0) {
						msSelectorRemove(sel, fd);
						msNetClose(fd);
					} else {
						const endPos = findHeaderEnd(client.data);
						if (endPos >= 0) {
							client.headersEndPos = endPos;
							client.asyncPending = true;
							inflight[0] = inflight[0] + 1;
							dispatchAsync(server, client, fd, sel, handler, inflight);
						}
					}
				}
			} else if ((flags & 2) !== 0) {
				const client = clients[fd];
				const resp = client.response._responseData;
				if (resp.length > 0) {
					const sent = msNetSendNonBlock(fd, resp, client.bytesSent);
					if (sent < 0) {
						msSelectorRemove(sel, fd);
						msNetClose(fd);
					} else {
						client.bytesSent = client.bytesSent + sent;
						if (client.bytesSent >= resp.length) {
							client.bytesSent = 0;
							resetOrPipelineAsync(server, client, fd, sel, handler, inflight);
						}
					}
				}
			} else if ((flags & 4) !== 0) {
				msSelectorRemove(sel, fd);
				msNetClose(fd);
			}
			i = i + 1;
		}
		// Fires async handler completion callbacks (stepper resumption).
		// Drains MPSC completion queue + processes callbacks = async steppers resume here.
		msRunOnce(0);
	}
	msSelectorClose(sel);
}

export function serveConcurrentAsync(server: HttpServer, handler: AsyncRequestHandler, threads: int32 = 0): void {
	const n = threads > 0 ? threads : msOsCpuCount();
	server.running = true;
	if (server.fd >= 0) { msNetClose(server.fd); server.fd = -1; }

	const addr = server.address;
	const port = server.port;

	for (let i = 0; i < n - 1; i += 1) {
		spawn(() => {
			const fd = msNetSocket();
			if (fd < 0) return null;
			if (msNetBindShared(fd, addr, port) < 0) { msNetClose(fd); return null; }
			if (msNetListen(fd, 1024) < 0) { msNetClose(fd); return null; }
			msNetSetNonBlocking(fd);
			eventLoopAsync(server, fd, handler);
			msNetClose(fd);
			return null;
		});
	}

	const fd = msNetSocket();
	if (fd < 0) return;
	if (msNetBindShared(fd, addr, port) < 0) { msNetClose(fd); return; }
	if (msNetListen(fd, 1024) < 0) { msNetClose(fd); return; }
	msNetSetNonBlocking(fd);
	eventLoopAsync(server, fd, handler);
	msNetClose(fd);
}


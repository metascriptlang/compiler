// HTTP Server — event-loop-per-core architecture.
// Each core: kqueue/epoll selector multiplexing all connections.
// Parallel across cores (spawn + SO_REUSEPORT), concurrent within each (selector).

@emit("#define MS_SELECTOR_BRIDGE");
@include("runtime/os.h");
@include("runtime/net/socket.h");
@include("runtime/actor/selector.h");
@include("runtime/net/eventLoopUring.h");
@include("runtime/io/engine.h");

extern function msNetSocket(): int32;
extern function msNetBind(fd: int32, addr: string, port: int32): int32;
extern function msNetBindShared(fd: int32, addr: string, port: int32): int32;
extern function msNetListen(fd: int32, backlog: int32): int32;
extern function msNetAccept(fd: int32): int32;
extern function msNetSend(fd: int32, data: string): int32;
extern function msNetRecv(fd: int32, maxBytes: int32): string;
extern function msNetClose(fd: int32): void;
extern function msNetSetTimeout(fd: int32, ms: int32): int32;
extern function msNetSetNonBlocking(fd: int32): int32;
extern function msNetAcceptNonBlock(fd: int32): int32;
extern function msNetRecvNonBlock(fd: int32, maxBytes: int32): string;
extern function msNetSendNonBlock(fd: int32, data: string, offset: int32): int32;
extern function msSelectorOpen(): int64;
extern function msSelectorAdd(sel: int64, fd: int32, events: int32): int32;
extern function msSelectorModify(sel: int64, fd: int32, events: int32): int32;
extern function msSelectorRemove(sel: int64, fd: int32): int32;
extern function msSelectorWait(sel: int64, timeoutMs: int32): int32;
extern function msSelectorEventFd(index: int32): int32;
extern function msSelectorEventFlags(index: int32): int32;
extern function msSelectorClose(sel: int64): void;
extern function msRunOnce(timeoutMs: int32): boolean;

// io_uring native event loop (Linux only — falls back to selector on macOS)
extern function msHasUringEventLoop(): int32;
extern function msUringEvtInit(): int32;
extern function msUringSubmitAccept(listenFd: int32): void;
extern function msUringSubmitRecv(fd: int32, buf: string, len: int32): void;
extern function msUringSubmitSend(fd: int32, buf: string, len: int32): void;
extern function msUringWait(timeoutMs: int32): int32;
extern function msUringEventFd(idx: int32): int32;
extern function msUringEventOp(idx: int32): int32;
extern function msUringEventRes(idx: int32): int32;
extern function msUringRecvData(fd: int32, bytesRecv: int32): string;
extern function msUringFastHeaderCheck(fd: int32, bytesRecv: int32): int32;
extern function msUringBuildResponse(fd: int32, status: int32, statusText: string, contentType: string, body: string): string;
extern function msFastParseMethod(data: string): int32;
extern function msFastParsePath(data: string): string;
extern function msNetSetTcpNoDelay(fd: int32): void;
extern function msNetSetNoSigpipe(fd: int32): void;

// Cached "Date: <imf-fixdate>\r\n" header line — thread-local, refreshed at
// most 1×/sec, returned as msString with literal flag (zero-alloc append).
extern function msHttpDateLine(): string;

// Static response cache (Layer D). See runtime/net/socket.h for design.
extern function msEpochSec(): int64;
extern function msStaticCacheHit(slotId: int32, sec: int64): int32;
extern function msStaticCacheGet(slotId: int32): string;
extern function msStaticCachePut(slotId: int32, sec: int64, source: string): void;

// Zero-alloc hot path externs (Phase 1-4)
extern function recvAll(this dest: string, fd: int32): int32 from "&msNetRecvAll";
extern function buildResponseReuse(this dest: string, status: int32, st: string, ct: string, body: string): void from "&msBuildResponseReuse";
extern function parsePathInto(this dest: string, data: string): void from "&msFastParsePathInto";
extern function shiftLeft(this s: string, offset: int32): void from "&msStringShiftLeft";
extern function msStringNewCap(cap: int64): string;

import {
	HttpMethod, HttpRequest, HttpHeaders, ServerResponse, RequestHandler, AsyncRequestHandler,
	statusText,
} from "./types";
import { HttpError, socketError } from "./errors";
import * as hdrs from "./headers";
import { frameRequest, FrameResult } from "./parser";
import { acceptAsync, recvAsync, sendAsync } from "std/net";
extern function msIoRunOnce(timeoutMs: int32): int32;
extern function msIoEngineCancelFd_ms(fd: int32): void;
extern function msMonoTimeMs(): int64 from "msMonoTimeMs";
extern function msOsCpuCount(): int32;

// ===== Server =====

export interface HttpServer {
	fd: int32;
	handler: RequestHandler;
	running: boolean;
	address: string;
	port: int32;
	keepAlive: boolean;
	keepAliveTimeout: int32;
	maxRequestsPerConnection: int32;
	maxHeaderSize: int32;
	maxBodySize: int32;
}

export function createServer(handler: RequestHandler): HttpServer {
	return {
		fd: -1, handler: handler, running: false,
		address: "0.0.0.0", port: 0,
		keepAlive: true, keepAliveTimeout: 10000,
		maxRequestsPerConnection: 0, maxHeaderSize: 8192, maxBodySize: 1048576,
	};
}

export function listen(this server: HttpServer, addr: string, port: int32): Result<void, HttpError> {
	const fd = msNetSocket();
	if (fd < 0) return Result.err(socketError("socket() failed"));
	if (msNetBind(fd, addr, port) < 0) {
		msNetClose(fd);
		return Result.err(socketError(`bind() failed on ${addr}:${port}`));
	}
	if (msNetListen(fd, 1024) < 0) {
		msNetClose(fd);
		return Result.err(socketError("listen() failed"));
	}
	server.fd = fd;
	server.address = addr;
	server.port = port;
	return Result.ok(null);
}

export function stop(server: HttpServer): void {
	server.running = false;
	if (server.fd >= 0) { msNetClose(server.fd); server.fd = -1; }
}

// ===== Response Helpers =====

// Build HTTP response in one C-level allocation (httpbeast pattern).
// Used as fast path when res.headers is empty — zero template literal overhead.
extern function msBuildResponse(status: int32, statusText: string, contentType: string, body: string): string;

// Slow path: build response in MS code, honoring user-set res.headers
// (CORS, custom auth, cookies, etc.). Fast path skipped when res.headers
// has entries beyond what sendBody would auto-set.
function sendBody(res: ServerResponse, contentType: string, body: string): void {
	if (!hdrs.hasHeader(res.headers, "content-type")) {
		hdrs.setHeader(res.headers, "content-type", contentType);
	}
	endResponse(res, body);
}

// Module-level mirror of the server's current keep-alive timeout, in seconds.
// Set by serve()/serveConcurrent() before the event loop starts; read by
// endResponse to emit the `Keep-Alive: timeout=N` header. Without this,
// browsers default to ~300s (Chrome) or longer pool TTL — they reuse sockets
// long after the server closes them, causing a multi-second stall on the
// first request that lands on a dead pooled socket.
let kaTimeoutSeconds: int32 = 60;

// Pre-built status-line literals for common codes (Bun/uWebSockets pattern).
// Returns full "HTTP/1.1 <code> <text>\r\n" string from a single match-table lookup —
// 1 msStringAppend, zero alloc. Cold codes fall through to "" so the caller
// rebuilds the line via status.toString() + statusText(status).
function statusLine(code: int32): string {
	return match (code) {
		200 => "HTTP/1.1 200 OK\r\n",
		201 => "HTTP/1.1 201 Created\r\n",
		202 => "HTTP/1.1 202 Accepted\r\n",
		204 => "HTTP/1.1 204 No Content\r\n",
		301 => "HTTP/1.1 301 Moved Permanently\r\n",
		302 => "HTTP/1.1 302 Found\r\n",
		303 => "HTTP/1.1 303 See Other\r\n",
		304 => "HTTP/1.1 304 Not Modified\r\n",
		307 => "HTTP/1.1 307 Temporary Redirect\r\n",
		308 => "HTTP/1.1 308 Permanent Redirect\r\n",
		400 => "HTTP/1.1 400 Bad Request\r\n",
		401 => "HTTP/1.1 401 Unauthorized\r\n",
		403 => "HTTP/1.1 403 Forbidden\r\n",
		404 => "HTTP/1.1 404 Not Found\r\n",
		405 => "HTTP/1.1 405 Method Not Allowed\r\n",
		409 => "HTTP/1.1 409 Conflict\r\n",
		413 => "HTTP/1.1 413 Payload Too Large\r\n",
		422 => "HTTP/1.1 422 Unprocessable Entity\r\n",
		429 => "HTTP/1.1 429 Too Many Requests\r\n",
		500 => "HTTP/1.1 500 Internal Server Error\r\n",
		501 => "HTTP/1.1 501 Not Implemented\r\n",
		502 => "HTTP/1.1 502 Bad Gateway\r\n",
		503 => "HTTP/1.1 503 Service Unavailable\r\n",
		504 => "HTTP/1.1 504 Gateway Timeout\r\n",
		_ => "",
	};
}

// Drift detector: statusLine literals must match statusText(code) exactly.
// Adding a code to one but not the other is silently wrong — the cold path
// in endResponse uses statusText, fast path uses statusLine. Mismatched
// reason phrases would leak through to clients depending on the path taken.
// Tests cover every code statusLine claims to handle; CI flags any drift.
test "statusLine matches statusText for all fast-path codes" {
	const codes: int32[] = [200, 201, 202, 204, 301, 302, 303, 304, 307, 308,
	                        400, 401, 403, 404, 405, 409, 413, 422, 429,
	                        500, 501, 502, 503, 504];
	for (const c of codes) {
		const expected = "HTTP/1.1 " + c.toString() + " " + statusText(c) + "\r\n";
		assert statusLine(c) === expected;
	}
}

test "statusLine returns empty string for uncommon codes (triggers fallback)" {
	assert statusLine(206) === "";    // Partial Content — uncommon
	assert statusLine(418) === "";    // Teapot — uncommon
	assert statusLine(999) === "";    // bogus
	assert statusLine(0) === "";      // bogus
}

// Internal: build wire response from res.status + res.headers + body.
// Honors any user-set headers (Access-Control-*, etc.). Auto Content-Length
// if not already set — note: uses string length, not UTF-8 byte length, so
// non-ASCII bodies need explicit Content-Length until byteLength helper exists.
//
// RFC 7230 §3.3.2: 1xx/204/304 responses MUST NOT carry Content-Length.
// Chrome blocks the next request on a CORS-preflight connection for ~5s if
// the 204 OPTIONS response includes Content-Length — strict parser waits
// thinking the response is malformed.
//
// RFC 7234 §5.2 / Node http: emit `Keep-Alive: timeout=<seconds>` so the
// client's connection pool aligns with the server's idle timeout. Without
// this, browsers reuse sockets long after the server has closed them,
// stalling the next request ~5s on dead-socket detection.
function endResponse(res: ServerResponse, data: string): void {
	if (res._finished) return;
	const status = res.status;
	const noBodyAllowed = status === 204 || status === 304 || (status >= 100 && status < 200);
	if (noBodyAllowed) {
		// Strip body-related headers — even if user set them, they're invalid here.
		hdrs.removeHeader(res.headers, "content-length");
		hdrs.removeHeader(res.headers, "content-type");
	} else if (!hdrs.hasHeader(res.headers, "content-length")) {
		// Content-Length is byte count per RFC 7230 — for UTF-8 response bodies
		// .length (UTF-16 code units) under-reports; client truncates the body.
		hdrs.setHeader(res.headers, "content-length", data.byteLength().toString());
	}
	if (!hdrs.hasHeader(res.headers, "keep-alive") && !hdrs.hasHeader(res.headers, "connection")) {
		hdrs.setHeader(res.headers, "keep-alive", "timeout=" + kaTimeoutSeconds.toString());
	}
	// Build response in-place into _responseData (pre-allocated 4KB cap via initClient).
	// Zero alloc for responses that fit in cap — buffer is reused across requests
	// because resetResponse calls setLength(0) (preserves cap). Parity with
	// httpbeast (Karax) and uWebSockets (Bun) which use the same in-place pattern.
	//
	// Compiler trick: every `res._responseData += X` below is lowered by
	// src/transform/native/stringOpLower.ms to `msStringAppend(&res._responseData, X)`
	// — an in-place byte-copy into the existing payload, NOT a fresh concat that
	// would replace the msString and discard the pre-allocated capacity. The
	// fast path requires HiddenAddr semantics on the LHS (see Fix E history).
	res._responseData.setLength(0);
	// Status line: try pre-built literal first (1 append, zero alloc).
	// Falls back to dynamic build for uncommon codes — keeps slow path correct.
	const fastLine = statusLine(status);
	if (fastLine.length > 0) {
		res._responseData += fastLine;
	} else {
		res._responseData += "HTTP/1.1 ";
		res._responseData += status.toString();
		res._responseData += " ";
		res._responseData += statusText(status);
		res._responseData += "\r\n";
	}
	// RFC 7231 §7.1.1.2: emit Date on every response. Cached thread-local
	// regenerated at most once per wall-clock second — zero strftime per
	// request in the hot path. Skipped on 1xx since they aren't full responses.
	if (status >= 200) res._responseData += msHttpDateLine();
	// Inline header serialization — avoids an intermediate string from serializeHeaders().
	for (let i = 0; i < res.headers._names.length; i = i + 1) {
		res._responseData += res.headers._names[i];
		res._responseData += ": ";
		res._responseData += res.headers._values[i];
		res._responseData += "\r\n";
	}
	res._responseData += "\r\n";
	if (!noBodyAllowed) res._responseData += data;
	res.headersSent = true;
	res._finished = true;
}

export function sendText(res: ServerResponse, text: string): void {
	sendBody(res, "text/plain; charset=utf-8", text);
}

export function sendJson(res: ServerResponse, json: string): void {
	sendBody(res, "application/json", json);
}

export function sendHtml(res: ServerResponse, html: string): void {
	sendBody(res, "text/html; charset=utf-8", html);
}

export function sendError(res: ServerResponse, status: int32, msg: string): void {
	res.status = status;
	sendBody(res, "text/plain", msg);
}

// Raw response — send pre-built response string directly (zero overhead).
// For users who build their own HTTP response (custom headers, status, etc.).
// NOTE: under multi-loop event loop this can desync fd state — prefer
// res.setHeader(...) + sendJson/sendText which honor headers automatically.
export function sendRaw(res: ServerResponse, raw: string): void {
	res._responseData = raw;
	res.headersSent = true;
	res._finished = true;
}

// ===== Static response cache (Layer D — Bun-parity for static endpoints) =====
//
// Cache an entire HTTP response (status line + headers + body) so static
// endpoints like /health, /robots.txt, /version do ZERO build work on the
// hot path — just one memcpy from a per-thread cache into the per-fd send
// buffer.
//
// Usage: pick a distinct slotId (0..63) at each call site. The handler is
// responsible for slot uniqueness across endpoints — collisions cause
// undefined-but-safe behavior (different bodies overwrite each other every
// rebuild).
//
//   if (req.path === "/health")
//       sendStatic(res, 0, 200, "application/json", "{\"ok\":true}");
//
// Cache lifetime: per wall-clock second (matches Date header refresh cadence).
// 64 slots per thread. Slots not in use cost nothing.
//
// Trade-off vs sendJson: only valid when status / contentType / body are
// pinned at the call site. Dynamic responses (per-user data, timestamps)
// should keep using sendJson/sendBody — every request would be a cache miss
// AND the overhead of msStaticCachePut would hurt.
export function sendStatic(res: ServerResponse, slotId: int32, status: int32, contentType: string, body: string): void {
	const sec = msEpochSec();
	if (msStaticCacheHit(slotId, sec) === 1) {
		// HOT PATH — copy cached bytes into per-fd response buffer.
		// _responseData keeps its own pre-allocated payload (4KB cap via
		// initClient); the cached msString is literal-flagged so DRC won't
		// touch refcount on it.
		//
		// Tried but reverted: `_responseData = cache` (struct assign, share
		// payload, zero memcpy). Bench showed no win — memcpy of ~100 bytes
		// is sub-noise (~5ns). The bug it exposed (per-second cache eviction
		// race with in-flight io_uring SEND) drove the two-generation cache
		// design in runtime/net/socket.h, which we keep for future use.
		res._responseData.setLength(0);
		res._responseData += msStaticCacheGet(slotId);
		res.headersSent = true;
		res._finished = true;
		return;
	}
	// COLD PATH — runs at most once per second per slot. Delegate to
	// endResponse to build the wire bytes, so the status-line / Date /
	// Content-Length / Keep-Alive logic stays in ONE place. Then snapshot
	// the result into the cache for subsequent requests in the same second.
	//
	// Headers are wiped first: sendStatic is for endpoints with no per-request
	// customization (handler-set CORS / cookies / etc. don't apply). Callers
	// that need custom headers should keep using sendJson + sendBody.
	res.status = status;
	res.headers._names.length = 0;
	res.headers._values.length = 0;
	hdrs.setHeader(res.headers, "content-type", contentType);
	endResponse(res, body);
	msStaticCachePut(slotId, sec, res._responseData);
}

// ===== Node-style extension methods on ServerResponse =====
// res.setHeader / getHeader / removeHeader / hasHeader / writeHead / end / json
// All resolve at call site to direct function calls (no v-table).

export function setHeader(this res: ServerResponse, name: string, value: string): void {
	hdrs.setHeader(res.headers, name, value);
}

export function getHeader(this res: ServerResponse, name: string): string {
	return hdrs.getHeader(res.headers, name);
}

export function removeHeader(this res: ServerResponse, name: string): void {
	hdrs.removeHeader(res.headers, name);
}

export function hasHeader(this res: ServerResponse, name: string): boolean {
	return hdrs.hasHeader(res.headers, name);
}

// Set status + merge headers, no body sent yet.
export function writeHead(this res: ServerResponse, status: int32, headers: HttpHeaders = null as unknown as HttpHeaders): void {
	res.status = status;
	if (headers !== null) {
		let i = 0;
		while (i < headers._names.length) {
			hdrs.setHeader(res.headers, headers._names[i], headers._values[i]);
			i = i + 1;
		}
	}
}

// End the response with optional body. Honors all res.headers set so far.
export function end(this res: ServerResponse, data: string = ""): void {
	endResponse(res, data);
}

// Express-style sugar: set content-type to application/json + end with body.
export function json(this res: ServerResponse, body: string): void {
	if (!hdrs.hasHeader(res.headers, "content-type")) {
		hdrs.setHeader(res.headers, "content-type", "application/json");
	}
	endResponse(res, body);
}

// Direct fd access — for advanced socket ops (setsockopt, shutdown, etc.)
export function getClientFd(req: HttpRequest): int32 {
	return req.clientFd;
}

// ===== Protocol switch / fd handoff =====
//
// Signal that the handler is taking ownership of the underlying socket fd
// (e.g. WebSocket upgrade after sending 101 Switching Protocols, raw TCP
// takeover, HTTP/2 upgrade, etc.). After the current response is written,
// the event loop removes the fd from its selector and STOPS managing it —
// in particular, it will NOT close the fd and will NOT re-arm read for
// pipelined HTTP requests. From that point on, the caller owns the fd's
// lifecycle (recv loop, close on disconnect, etc.).
//
// Typical WebSocket usage:
//
//   res.setHeader("Upgrade", "websocket");
//   res.setHeader("Connection", "Upgrade");
//   res.setHeader("Sec-WebSocket-Accept", deriveAcceptKey(clientKey));
//   res.status = 101;
//   const fd = res.detach();   // signal handoff; returns fd for convenience
//   res.end();                  // flush 101 through normal HTTP write pipeline
//   // ... spawn an actor that owns fd from here ...
//
// Status 101 has no body (RFC 7230 §3.3.2 / endResponse `noBodyAllowed`), so
// the 101 response is just the header block. The handler MUST set Upgrade +
// Connection: Upgrade headers before calling res.end() — otherwise std/http's
// default `Keep-Alive: timeout=N` injection kicks in and the response is
// no longer a valid protocol switch.
export function detach(this res: ServerResponse): int32 {
	res._upgraded = true;
	return res.fd;
}


// ===== Event Loop =====

interface ClientState {
	data: string;
	sendQueue: string;
	bytesSent: int32;
	headersEndPos: int32;
	asyncPending: boolean;
	// Monotonic ms; 0 = slot unused. Compared against keepAliveTimeout
	// in idleSweep().
	lastActivityMs: int64;
	// Pre-allocated per-connection — reused across requests (zero alloc after first request)
	request: HttpRequest;
	response: ServerResponse;
}

// Lazy capacity: msStringNewCap(0) yields a zero-length msString with no
// backing payload. First append on each field grows the buffer to fit —
// after warmup the per-fd memory matches the typical response size
// (~300 bytes) instead of the worst-case 4 KB. This makes a single
// MetaScript HTTP process behave like Rust/C wrt resident memory: ~7 MB
// pre-alloc instead of ~70 MB across 8 worker threads + 1024 fd slots.
function initClient(fd: int32): ClientState {
	return {
		data: msStringNewCap(0), sendQueue: "", bytesSent: 0, headersEndPos: -1, asyncPending: false,
		lastActivityMs: 0 as int64,
		request: {
			method: HttpMethod.GET, path: msStringNewCap(0), version: "1.1",
			headers: hdrs.createHeaders(), body: "", clientFd: fd,
		},
		response: {
			fd: fd, status: 200,
			headers: hdrs.createHeaders(),
			_chunks: [],
			headersSent: false, _finished: false, _chunked: false,
			_responseData: msStringNewCap(0),
			_upgraded: false,
		},
	};
}

function resetClient(client: ClientState, fd: int32): void {
	client.data.setLength(0);
	client.bytesSent = 0;
	client.headersEndPos = -1;
	client.asyncPending = false;
	client.lastActivityMs = msMonoTimeMs();
	client.request.method = HttpMethod.GET;
	client.request.clientFd = fd;
	client.request.body = "";
	client.request.headers._names.length = 0;
	client.request.headers._values.length = 0;
	client.response.fd = fd;
	client.response.status = 200;
	client.response.headersSent = false;
	client.response._finished = false;
	client.response._chunked = false;
	client.response.headers._names.length = 0;
	client.response.headers._values.length = 0;
	client.response._responseData.setLength(0);
	client.response._upgraded = false;
}

function resetRequest(client: ClientState, fd: int32, method: int32): void {
	client.request.method = method as unknown as HttpMethod;
	// path is set by parsePathInto (zero-alloc) — not reset here
	client.request.clientFd = fd;
	client.request.body = "";
	// Headers MUST be cleared — frameRequest reads CL/TE from this struct.
	// Stale headers from a previous pipelined request would mislead framing
	// (e.g. a GET reusing a POST connection sees Content-Length=5 → needMore).
	client.request.headers._names.length = 0;
	client.request.headers._values.length = 0;
}

function resetResponse(client: ClientState, fd: int32): void {
	client.response.fd = fd;
	client.response.status = 200;
	client.response.headersSent = false;
	client.response._finished = false;
	client.response._chunked = false;
	client.response.headers._names.length = 0;
	client.response.headers._values.length = 0;
	client.response._responseData.setLength(0);  // preserves buffer (= "" would free it)
	client.response._upgraded = false;
}

// Fast headers check: O(1) last-4-bytes, then slow linear fallback (httpbeast pattern)
extern function msFastHeadersCheck(data: string): int32;
extern function msSlowHeadersCheck(data: string): int32;

// Returns position AFTER the first \r\n\r\n in `data`, or -1 if not yet
// complete. The fast O(1) last-4-bytes check is correct for the common GET
// case but yields false positives when the recv buffer happens to END with
// \r\n\r\n (POST body containing CRLFCRLF, chunked terminator, pipelined
// request boundary). When fast claims "buffer end is header end", validate
// with slowCheck; if slow finds an EARLIER terminator, that's the real one.
function findHeaderEnd(data: string): int32 {
	const fast = msFastHeadersCheck(data);
	if (fast < 0) return msSlowHeadersCheck(data);
	const slow = msSlowHeadersCheck(data);
	if (slow >= 0 && slow < fast) return slow;
	return fast;
}

// Parse request-line headers from `data[0..endPos)` into `headers`.
// Skips the request line (first CRLF). No fold-line / continuation support,
// no validation. Sufficient to expose Content-Length / Transfer-Encoding /
// Authorization / etc. to the body framer and handlers.
function parseHeadersInline(data: string, endPos: int32, headers: HttpHeaders): void {
	let lineStart: int32 = 0;
	while (lineStart < endPos) {
		let lineEnd = lineStart;
		while (lineEnd + 1 < endPos && !(data.charCodeAt(lineEnd) === "\r".code && data.charCodeAt(lineEnd + 1) === "\n".code)) {
			lineEnd = lineEnd + 1;
		}
		if (lineEnd === lineStart) break;  // empty line = end of headers
		// Skip first line (request line "METHOD path HTTP/1.1")
		if (lineStart > 0) {
			let colon = lineStart;
			while (colon < lineEnd && data.charCodeAt(colon) !== ":".code) colon = colon + 1;
			if (colon < lineEnd) {
				const name = data.slice(lineStart, colon);
				let valStart = colon + 1;
				while (valStart < lineEnd && (data.charCodeAt(valStart) === " ".code || data.charCodeAt(valStart) === "\t".code)) valStart = valStart + 1;
				hdrs.addHeader(headers, name, data.slice(valStart, lineEnd));
			}
		}
		lineStart = (lineEnd + 2) as int32;
	}
}

// Build minimal HTTP error response (no body, Connection: close).
// Used by body framer rejects (400 / 411 / 413) before handler dispatch.
function buildErrorResponse(status: int32): string {
	return "HTTP/1.1 " + status.toString() + " " + statusText(status) + "\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
}

// ===== Z V2 — Unified Async Event Loop =====
//
// Per-connection async fiber pattern (Bun/uWebSockets-derived).
// listenAsyncLoop awaits each accept; for each connection it fires a
// fire-and-forget handleConnSync/handleConnAsync that owns its own
// recv/send cycle. One engine selector per thread drives all I/O via
// acceptAsync / recvAsync / sendAsync (engine.h completion API,
// platform-agnostic: kqueue / epoll / io_uring / IOCP).
//
// Driver: while (running) msIoRunOnce(DRIVER_POLL_MS) — short poll wakes
// engine + actors on any I/O activity; dispatcher drained per cycle via
// msRunOnce(0) inside msIoRunOnce. 10ms compromise: engine selector
// alone doesn't see actor-mailbox writes (Layer 1 vs Layer 2 wake gap
// per PARALOCK Amendment A), so we poll periodically to let
// msActorPollHook drain queued actor work.

const DRIVER_POLL_MS: int32 = 10;
const MAX_CLIENT_FDS: int32 = 1024;
const SWEEP_INTERVAL_TICKS: int32 = 100;

// Force-close idle conns. cancelFd completes the pending recv future with
// peer-close shape; msNetClose triggers engine cleanup on uring/IOCP.
// Opt-out via keepAliveTimeout <= 0 (e.g. WS servers that drive their
// own ping/pong).
function idleSweep(clients: ClientState[], server: HttpServer): void {
	if (server.keepAliveTimeout <= 0) return;
	const now = msMonoTimeMs();
	const threshold = now - (server.keepAliveTimeout as int64);
	let i: int32 = 0;
	while (i < MAX_CLIENT_FDS) {
		const c = clients[i];
		if (c.lastActivityMs !== (0 as int64) && c.lastActivityMs < threshold) {
			msIoEngineCancelFd_ms(i);
			msNetClose(i);
			c.lastActivityMs = 0 as int64;
		}
		i = i + 1;
	}
}

function driveWithSweep(server: HttpServer, clients: ClientState[]): void {
	let sweepTick: int32 = 0;
	while (server.running) {
		msIoRunOnce(DRIVER_POLL_MS);
		sweepTick = sweepTick + 1;
		if (sweepTick >= SWEEP_INTERVAL_TICKS) {
			sweepTick = 0;
			idleSweep(clients, server);
		}
	}
}

function allocClients(): ClientState[] {
	const clients: ClientState[] = new Array(MAX_CLIENT_FDS);
	let ci: int32 = 0;
	while (ci < MAX_CLIENT_FDS) {
		clients[ci] = initClient(ci);
		ci = ci + 1;
	}
	return clients;
}

export function serveConcurrent(server: HttpServer, threads: int32 = 0): void {
	const n = threads > 0 ? threads : msOsCpuCount();
	server.running = true;
	kaTimeoutSeconds = server.keepAliveTimeout / 1000;
	if (server.fd >= 0) { msNetClose(server.fd); server.fd = -1; }

	const addr = server.address;
	const port = server.port;
	const handler = server.handler;

	const useUring = msHasUringEventLoop() === 1;

	for (let i = 0; i < n - 1; i += 1) {
		spawn(() => {
			const fd = msNetSocket();
			if (fd < 0) return null;
			if (msNetBindShared(fd, addr, port) < 0) { msNetClose(fd); return null; }
			if (msNetListen(fd, 1024) < 0) { msNetClose(fd); return null; }
			msNetSetNonBlocking(fd);
			if (useUring) {
				eventLoopUring(server, fd, handler);
			} else {
				const clients = allocClients();
				listenAsyncLoop(server, fd, handler, clients);
				driveWithSweep(server, clients);
			}
			msNetClose(fd);
			return null;
		});
	}

	const fd = msNetSocket();
	if (fd < 0) return;
	if (msNetBindShared(fd, addr, port) < 0) { msNetClose(fd); return; }
	if (msNetListen(fd, 1024) < 0) { msNetClose(fd); return; }
	msNetSetNonBlocking(fd);
	if (useUring) {
		eventLoopUring(server, fd, handler);
	} else {
		const clients = allocClients();
		listenAsyncLoop(server, fd, handler, clients);
		driveWithSweep(server, clients);
	}
	msNetClose(fd);
}

async function listenAsyncLoop(server: HttpServer, listenFd: int32, handler: RequestHandler, clients: ClientState[]): Promise<void> {
	while (server.running) {
		const cfd = await acceptAsync(listenFd);
		if (cfd >= 0 && cfd < MAX_CLIENT_FDS) {
			msNetSetTcpNoDelay(cfd);
			msNetSetNoSigpipe(cfd);
			msNetSetNonBlocking(cfd);
			resetClient(clients[cfd], cfd);
			handleConnSync(server, clients[cfd], cfd, handler);
		} else if (cfd >= MAX_CLIENT_FDS) {
			msNetClose(cfd);
		}
		// cfd < 0: accept error, drop silently
	}
}

async function handleConnSync(server: HttpServer, client: ClientState, fd: int32, handler: RequestHandler): Promise<void> {
	let alive: boolean = true;
	let requestCount: int32 = 0;
	while (alive && server.running) {
		// 1) Drain headers until findHeaderEnd succeeds
		let endPos: int32 = findHeaderEnd(client.data);
		while (alive && endPos < 0) {
			if ((client.data.byteLength() as int32) > server.maxHeaderSize) {
				msNetSend(fd, buildErrorResponse(431));
				alive = false;
			} else {
				const chunk = await recvAsync(fd, server.maxHeaderSize);
				if (chunk.length === 0) {
					alive = false;
				} else {
					client.data += chunk; client.lastActivityMs = msMonoTimeMs();
					endPos = findHeaderEnd(client.data);
				}
			}
		}
		if (!alive) break;
		client.headersEndPos = endPos;

		// 2) Parse method + path + headers
		const methodInt = msFastParseMethod(client.data);
		if (methodInt < 0) { alive = false; break; }
		client.request.path.parsePathInto(client.data);
		if (client.request.path.length === 0) { alive = false; break; }
		resetRequest(client, fd, methodInt);
		resetResponse(client, fd);
		parseHeadersInline(client.data, endPos, client.request.headers);

		// 3) Frame body — recv more until ready / reject
		let bufferAfter = client.data.slice(endPos, client.data.length);
		let frame: FrameResult = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
		while (alive && frame.kind === "needMore") {
			if ((bufferAfter.byteLength() as int32) > server.maxBodySize) {
				msNetSend(fd, buildErrorResponse(413));
				alive = false;
			} else {
				const more = await recvAsync(fd, server.maxHeaderSize);
				if (more.length === 0) {
					alive = false;
				} else {
					client.data += more; client.lastActivityMs = msMonoTimeMs();
					bufferAfter = client.data.slice(endPos, client.data.length);
					frame = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
				}
			}
		}
		if (!alive) break;
		if (frame.kind === "reject") {
			msNetSend(fd, buildErrorResponse(frame.rejectStatus));
			alive = false;
			break;
		}

		// 4) Dispatch handler (sync)
		client.request.body = frame.body;
		handler(client.request, client.response);

		// 5) Send response
		const resp = client.response._responseData;
		if (resp.length > 0) {
			const sent = await sendAsync(fd, resp);
			if (sent < 0) { alive = false; break; }
		}

		// 6) Advance buffer past consumed bytes (pipelining-safe)
		const totalConsumed = (endPos + frame.bytesConsumed) as int32;
		if (totalConsumed < client.data.length) {
			client.data.shiftLeft(totalConsumed);
		} else {
			client.data.setLength(0);
		}

		// 7) Protocol switch / keep-alive
		if (client.response._upgraded) return;  // fd ownership handed off
		if (!server.keepAlive) break;
		requestCount = requestCount + 1;
		if (server.maxRequestsPerConnection > 0 && requestCount >= server.maxRequestsPerConnection) break;
	}
	// Multi-worker SO_REUSEPORT: fd numbers reused across workers; without
	// this reset a stale lastActivityMs could trigger one worker to kill
	// another's freshly-accepted fd.
	client.lastActivityMs = 0 as int64;
	msNetClose(fd);
}

// ===== Blocking Mode (for simple use / testing) =====

export function serve(server: HttpServer): void {
	server.running = true;
	kaTimeoutSeconds = server.keepAliveTimeout / 1000;
	while (server.running) {
		const clientFd = msNetAccept(server.fd);
		if (clientFd < 0) continue;
		// Match eventLoop / async / io_uring paths — Mac doesn't get MSG_NOSIGNAL
		// (it's #defined to 0), so a send() to a closed peer raises SIGPIPE and
		// kills the process. SO_NOSIGPIPE on the client fd converts that to a
		// recoverable EPIPE return. Single-thread `serve()` callers (vendor
		// stdio-style MCP transports) depend on this.
		msNetSetNoSigpipe(clientFd);
		if (server.keepAliveTimeout > 0) msNetSetTimeout(clientFd, server.keepAliveTimeout);
		const upgraded = handleBlocking(server, clientFd);
		// If the handler called res.detach() the fd is now owned by the
		// caller's protocol layer (e.g. a WebSocket recv loop) — don't close.
		if (!upgraded) msNetClose(clientFd);
	}
}

export function serveN(server: HttpServer, count: int32): void {
	server.running = true;
	let served = 0;
	while (server.running && served < count) {
		const clientFd = msNetAccept(server.fd);
		if (clientFd < 0) continue;
		const upgraded = handleBlocking(server, clientFd);
		if (!upgraded) msNetClose(clientFd);
		served = served + 1;
	}
	server.running = false;
}

// Returns true iff the handler upgraded the connection (called res.detach());
// caller must NOT close the fd in that case — it has been handed off.
function handleBlocking(server: HttpServer, fd: int32): boolean {
	let requestCount = 0;
	let keepGoing = true;
	const client = initClient(fd);
	while (keepGoing) {
		// 1. Drain headers: recv until findHeaderEnd locates the real \r\n\r\n
		// terminator. (findHeaderEnd validates fast/slow internally — see its
		// comment for the false-match guard.)
		let data = msNetRecv(fd, server.maxHeaderSize);
		if (data.length === 0) return false;  // peer closed
		let endPos = findHeaderEnd(data);
		while (endPos < 0) {
			if (data.length >= server.maxHeaderSize) return false;  // header too large
			const more = msNetRecv(fd, server.maxHeaderSize);
			if (more.length === 0) return false;  // peer closed mid-headers
			data = data + more;
			endPos = findHeaderEnd(data);
		}

		// 2. Parse method + path + headers.
		const methodInt = msFastParseMethod(data);
		if (methodInt < 0) return false;
		client.request.path.parsePathInto(data);
		if (client.request.path.length === 0) return false;

		resetRequest(client, fd, methodInt);
		resetResponse(client, fd);
		parseHeadersInline(data, endPos, client.request.headers);

		// 3. Frame body — recv more bytes until ready/reject.
		// DoS guard: cap raw bytes after concat. Chunked has no upfront size,
		// so without this an attacker can stream chunks without terminator
		// → bufferAfter unbounded → eventual OOM.
		//
		// V1 LIMITATION: tryDecodeChunked is called each iteration on the FULL
		// bufferAfter (re-decode from start), giving O(n²) per request. Even
		// with this cap, a 1MB chunked attack amplifies RSS by ~400x via string
		// concat churn before 413 fires. Functional DoS is blocked; tight
		// memory bound needs an incremental chunked decoder (v2).
		let bufferAfter = data.slice(endPos, data.length);
		let frame: FrameResult = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
		while (frame.kind === "needMore") {
			const more = msNetRecv(fd, server.maxHeaderSize);
			if (more.length === 0) return false;  // peer closed mid-body
			bufferAfter = bufferAfter + more;
			// Byte-oriented cap — see frameRequest for the same rationale.
			if ((bufferAfter.byteLength() as int32) > server.maxBodySize) {
				msNetSend(fd, buildErrorResponse(413));
				return false;
			}
			frame = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
		}
		if (frame.kind === "reject") {
			msNetSend(fd, buildErrorResponse(frame.rejectStatus));
			return false;  // close connection (Connection: close)
		}

		// 4. Dispatch.
		client.request.body = frame.body;
		server.handler(client.request, client.response);
		if (client.response._responseData.length > 0) msNetSend(fd, client.response._responseData);

		// Protocol switch: handler took ownership of fd via res.detach(). Stop
		// the keep-alive loop and signal caller to skip msNetClose.
		if (client.response._upgraded) return true;

		requestCount = requestCount + 1;
		if (!server.keepAlive) keepGoing = false;
		else if (server.maxRequestsPerConnection > 0 && requestCount >= server.maxRequestsPerConnection) keepGoing = false;
	}
	return false;
}

// ===== io_uring Native Event Loop (Linux) =====
// Same logic as eventLoop but uses native RECV/SEND/ACCEPT via io_uring.
// Zero epoll, zero separate recv/send syscalls — all through the ring buffer.
// Per-fd response buffers: zero malloc after warmup (msBuildResponseReuse).

// io_uring RECV dispatch: accumulate bytes into client.data, find header end,
// frame body, dispatch handler. Submits the next uring op (recv / send / close)
// based on framer state. Mirrors `dispatch()` (selector path) but with uring
// submission instead of msSelectorModify.
function dispatchUringRecv(server: HttpServer, client: ClientState, fd: int32, handler: RequestHandler): void {
	// Find header end if not yet known. client.data is the accumulated buffer
	// across multiple recvs — required for split headers/body or large headers.
	if (client.headersEndPos < 0) {
		const endPos = findHeaderEnd(client.data);
		if (endPos < 0) {
			// Headers incomplete — wait for more bytes.
			if ((client.data.byteLength() as int32) > server.maxHeaderSize) {
				msNetSend(fd, buildErrorResponse(431));
				msNetClose(fd);
				return;
			}
			msUringSubmitRecv(fd, "", 4096);
			return;
		}
		client.headersEndPos = endPos;
	}

	const methodInt = msFastParseMethod(client.data);
	if (methodInt < 0) { msNetClose(fd); return; }

	client.request.path.parsePathInto(client.data);
	if (client.request.path.length === 0) { msNetClose(fd); return; }

	resetRequest(client, fd, methodInt);
	resetResponse(client, fd);
	parseHeadersInline(client.data, client.headersEndPos, client.request.headers);

	const bufferAfter = client.data.slice(client.headersEndPos, client.data.length);
	const frame = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
	if (frame.kind === "needMore") {
		if ((bufferAfter.byteLength() as int32) > server.maxBodySize) {
			msNetSend(fd, buildErrorResponse(413));
			msNetClose(fd);
			return;
		}
		msUringSubmitRecv(fd, "", 4096);
		return;
	}
	if (frame.kind === "reject") {
		msNetSend(fd, buildErrorResponse(frame.rejectStatus));
		msNetClose(fd);
		return;
	}

	client.request.body = frame.body;
	handler(client.request, client.response);

	const totalConsumed = (client.headersEndPos + frame.bytesConsumed) as int32;
	if (totalConsumed < client.data.length) {
		client.data.shiftLeft(totalConsumed);
	} else {
		client.data.setLength(0);
	}
	client.headersEndPos = -1;

	// Protocol switch (res.detach + WebSocket upgrade): same shape as selector
	// path. SEND-complete branch will skip the re-arm recv when _upgraded.
	if (client.response._upgraded) {
		if (client.response._finished && client.response._responseData.length > 0) {
			msUringSubmitSend(fd, client.response._responseData, client.response._responseData.length);
		}
		// else: fd silently detached, no further uring ops
		return;
	}

	if (client.response._finished && client.response._responseData.length > 0) {
		msUringSubmitSend(fd, client.response._responseData, client.response._responseData.length);
	} else {
		msUringSubmitRecv(fd, "", 4096);
	}
}

function eventLoopUring(server: HttpServer, listenFd: int32, handler: RequestHandler): void {
	if (msUringEvtInit() < 0) {
		// Fallback to engine-based async event loop (kqueue / epoll / poll)
		const clients = allocClients();
		listenAsyncLoop(server, listenFd, handler, clients);
		driveWithSweep(server, clients);
		return;
	}

	const maxFds = 1024;
	// Lazy ClientState — each slot allocates on first ACCEPT for that fd
	// and is reused for all subsequent connections that reuse the fd. This
	// keeps RSS proportional to ACTIVE connections, matching Rust hyper /
	// C libmicrohttpd; pre-allocating 1024 × ~250 byte structs eagerly
	// would inflate baseline by ~2 MB per worker thread for no gain.
	const clients: ClientState[] = new Array(maxFds);

	msUringSubmitAccept(listenFd);

	while (server.running) {
		const count = msUringWait(-1);
		let i = 0;
		while (i < count) {
			const evFd = msUringEventFd(i);
			const op = msUringEventOp(i);
			const res = msUringEventRes(i);

			if (op === 0) {
				// ACCEPT — set socket opts, start recv
				if (res >= 0 && res < maxFds) {
					msNetSetTcpNoDelay(res);
					msNetSetNoSigpipe(res);
					msNetSetNonBlocking(res);
					if (clients[res] === null as unknown as ClientState) {
						clients[res] = initClient(res);
					} else {
						resetClient(clients[res], res);
					}
					msUringSubmitRecv(res, "", 4096);
				} else if (res >= 0) {
					msNetClose(res);
				}
				msUringSubmitAccept(listenFd);
			} else if (op === 1) {
				// RECV — accumulate bytes into client.data, then dispatch via helper.
				// dispatchUringRecv handles header-end detection, body framing
				// (Content-Length / chunked), and submitting the next uring op.
				if (res <= 0) {
					msNetClose(evFd);
				} else if (evFd >= 0 && evFd < maxFds) {
					const client = clients[evFd];
					if (client !== null as unknown as ClientState) {
						client.data += msUringRecvData(evFd, res);
						dispatchUringRecv(server, client, evFd, handler);
					}
				}
			} else if (op === 2) {
				// SEND complete — re-arm recv for keep-alive, UNLESS the handler
				// took over the fd via res.detach() (protocol switch). In the
				// upgrade case the fd is now owned by the caller's recv loop;
				// don't resubmit a recv that would steal frames from it.
				if (evFd >= 0 && evFd < maxFds) {
					clients[evFd].sendQueue = "";
					if (!clients[evFd].response._upgraded) {
						msUringSubmitRecv(evFd, "", 4096);
					}
				}
			}
			i = i + 1;
		}
		msRunOnce(0);
	}
}

// ===== Async Handler Support =====
// Enables handlers that use await (e.g., await spawn(() => heavyWork())).
// The event loop continues processing other connections while a handler is suspended.
// Completion callbacks fire via msRunOnce(0) on the same event loop thread.

export function createServerAsync(handler: AsyncRequestHandler): HttpServer {
	return {
		fd: -1, handler: null as unknown as RequestHandler, running: false,
		address: "0.0.0.0", port: 0,
		keepAlive: true, keepAliveTimeout: 10000,
		maxRequestsPerConnection: 0, maxHeaderSize: 8192, maxBodySize: 1048576,
	};
}


async function listenAsyncLoopA(server: HttpServer, listenFd: int32, handler: AsyncRequestHandler, clients: ClientState[]): Promise<void> {
	while (server.running) {
		const cfd = await acceptAsync(listenFd);
		if (cfd >= 0 && cfd < MAX_CLIENT_FDS) {
			msNetSetTcpNoDelay(cfd);
			msNetSetNoSigpipe(cfd);
			msNetSetNonBlocking(cfd);
			resetClient(clients[cfd], cfd);
			handleConnAsync(server, clients[cfd], cfd, handler);
		} else if (cfd >= MAX_CLIENT_FDS) {
			msNetClose(cfd);
		}
	}
}

async function handleConnAsync(server: HttpServer, client: ClientState, fd: int32, handler: AsyncRequestHandler): Promise<void> {
	let alive: boolean = true;
	let requestCount: int32 = 0;
	while (alive && server.running) {
		// 1) Drain headers
		let endPos: int32 = findHeaderEnd(client.data);
		while (alive && endPos < 0) {
			if ((client.data.byteLength() as int32) > server.maxHeaderSize) {
				msNetSend(fd, buildErrorResponse(431));
				alive = false;
			} else {
				const chunk = await recvAsync(fd, server.maxHeaderSize);
				if (chunk.length === 0) {
					alive = false;
				} else {
					client.data += chunk; client.lastActivityMs = msMonoTimeMs();
					endPos = findHeaderEnd(client.data);
				}
			}
		}
		if (!alive) break;
		client.headersEndPos = endPos;

		// 2) Parse method + path + headers
		const methodInt = msFastParseMethod(client.data);
		if (methodInt < 0) { alive = false; break; }
		client.request.path.parsePathInto(client.data);
		if (client.request.path.length === 0) { alive = false; break; }
		resetRequest(client, fd, methodInt);
		resetResponse(client, fd);
		parseHeadersInline(client.data, endPos, client.request.headers);

		// 3) Frame body
		let bufferAfter = client.data.slice(endPos, client.data.length);
		let frame: FrameResult = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
		while (alive && frame.kind === "needMore") {
			if ((bufferAfter.byteLength() as int32) > server.maxBodySize) {
				msNetSend(fd, buildErrorResponse(413));
				alive = false;
			} else {
				const more = await recvAsync(fd, server.maxHeaderSize);
				if (more.length === 0) {
					alive = false;
				} else {
					client.data += more; client.lastActivityMs = msMonoTimeMs();
					bufferAfter = client.data.slice(endPos, client.data.length);
					frame = frameRequest(client.request.headers, methodInt as unknown as HttpMethod, bufferAfter, server.maxBodySize);
				}
			}
		}
		if (!alive) break;
		if (frame.kind === "reject") {
			msNetSend(fd, buildErrorResponse(frame.rejectStatus));
			alive = false;
			break;
		}

		// 4) Dispatch async handler (THE KEY DIFFERENCE FROM SYNC)
		client.request.body = frame.body;
		await handler(client.request, client.response);

		// 5) Send response
		const resp = client.response._responseData;
		if (resp.length > 0) {
			const sent = await sendAsync(fd, resp);
			if (sent < 0) { alive = false; break; }
		}

		// 6) Advance buffer
		const totalConsumed = (endPos + frame.bytesConsumed) as int32;
		if (totalConsumed < client.data.length) {
			client.data.shiftLeft(totalConsumed);
		} else {
			client.data.setLength(0);
		}

		// 7) Protocol switch / keep-alive
		if (client.response._upgraded) return;
		if (!server.keepAlive) break;
		requestCount = requestCount + 1;
		if (server.maxRequestsPerConnection > 0 && requestCount >= server.maxRequestsPerConnection) break;
	}
	client.lastActivityMs = 0 as int64;  // see handleConnSync above
	msNetClose(fd);
}

export function serveConcurrentAsync(server: HttpServer, handler: AsyncRequestHandler, threads: int32 = 0): void {
	const n = threads > 0 ? threads : msOsCpuCount();
	server.running = true;
	kaTimeoutSeconds = server.keepAliveTimeout / 1000;
	if (server.fd >= 0) { msNetClose(server.fd); server.fd = -1; }

	const addr = server.address;
	const port = server.port;

	for (let i = 0; i < n - 1; i += 1) {
		spawn(() => {
			const fd = msNetSocket();
			if (fd < 0) return null;
			if (msNetBindShared(fd, addr, port) < 0) { msNetClose(fd); return null; }
			if (msNetListen(fd, 1024) < 0) { msNetClose(fd); return null; }
			msNetSetNonBlocking(fd);
			const clients = allocClients();
			listenAsyncLoopA(server, fd, handler, clients);
			driveWithSweep(server, clients);
			msNetClose(fd);
			return null;
		});
	}

	const fd = msNetSocket();
	if (fd < 0) return;
	if (msNetBindShared(fd, addr, port) < 0) { msNetClose(fd); return; }
	if (msNetListen(fd, 1024) < 0) { msNetClose(fd); return; }
	msNetSetNonBlocking(fd);
	const clients = allocClients();
	listenAsyncLoopA(server, fd, handler, clients);
	driveWithSweep(server, clients);
	msNetClose(fd);
}

// Selector — event notification API for MetaScript
// Wraps kqueue (macOS/BSD), epoll (Linux), poll (POSIX fallback).
// Used for event-loop-per-core HTTP server architecture.

@emit("#define MS_SELECTOR_BRIDGE");
@include("runtime/actor/selector.h");

// Event flags (bitmask)
export const EVENT_READ: int32 = 1;
export const EVENT_WRITE: int32 = 2;
export const EVENT_ERROR: int32 = 4;

// C bindings (bridge layer — int64 handles instead of raw pointers)
extern function msSelectorOpen(): int64;
extern function msSelectorClose(sel: int64): void;
extern function msSelectorAdd(sel: int64, fd: int32, events: int32): int32;
extern function msSelectorModify(sel: int64, fd: int32, events: int32): int32;
extern function msSelectorRemove(sel: int64, fd: int32): int32;
extern function msSelectorWait(sel: int64, timeoutMs: int32): int32;
extern function msSelectorEventFd(index: int32): int32;
extern function msSelectorEventFlags(index: int32): int32;

// Public API
export function createSelector(): int64 { return msSelectorOpen(); }
export function destroySelector(sel: int64): void { msSelectorClose(sel); }
export function selectorRegister(sel: int64, fd: int32, events: int32): int32 { return msSelectorAdd(sel, fd, events); }
export function selectorUpdate(sel: int64, fd: int32, events: int32): int32 { return msSelectorModify(sel, fd, events); }
export function selectorUnregister(sel: int64, fd: int32): int32 { return msSelectorRemove(sel, fd); }
export function selectorPoll(sel: int64, timeoutMs: int32): int32 { return msSelectorWait(sel, timeoutMs); }
export function eventFd(index: int32): int32 { return msSelectorEventFd(index); }
export function eventFlags(index: int32): int32 { return msSelectorEventFlags(index); }

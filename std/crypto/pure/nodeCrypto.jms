import { Buffer } from "std/core/buffer";
import { ByteInput } from "std/core/buffer/bytes";

@import("node:crypto", { createHash, createHmac, pbkdf2Sync, hkdfSync });

export type NodeInput = string | Readonly<Uint8Array>;

export interface NodeHash {}

/** What node reads in place: a string or a Uint8Array as it is, other bytes copied once into a Uint8Array. */
export function nodeInput<D extends ByteInput>(data: D): NodeInput {
	if (typeof data == "string") return data;
	if (data instanceof Uint8Array) return data;
	return uint8ArrayFrom(data);
}

// Uint8Array.from copies 1 MB at 1142 MB/s against 324 for new Uint8Array(array) (node 24.1, Mac, 2026-11-10).
extern function uint8ArrayFrom(data: Readonly<Span<uint8>>): Uint8Array from "(s => Uint8Array.from(s.off === 0 && s.len === s.base.length ? s.base : s.base.slice(s.off, s.off + s.len)))(#)";

extern function msDigest(name: string, data: NodeInput): Uint8Array from "createHash(#).update(#).digest()";
extern function msHmac(name: string, key: NodeInput, data: NodeInput): Uint8Array from "createHmac(#, #).update(#).digest()";
extern function msHashNew(name: string): NodeHash from "createHash(#)";
extern function msHmacNew(name: string, key: NodeInput): NodeHash from "createHmac(#, #)";
extern function msHashUpdate(hash: NodeHash, data: NodeInput): void from "#.update(#)";
extern function msHashDigest(hash: NodeHash): Uint8Array from "#.digest()";
extern function msPbkdf2(password: NodeInput, salt: NodeInput, iterations: int32, keyLength: int32, digest: string): Uint8Array from "pbkdf2Sync(#, #, #, #, #)";
extern function msHkdf(digest: string, ikm: NodeInput, salt: NodeInput, info: NodeInput, length: int32): ArrayBuffer from "hkdfSync(#, #, #, #, #)";

/** A Buffer over the bytes node returned, without a copy. */
export function bufferOver(bytes: Uint8Array): Buffer {
	return new Buffer(bytes.buffer, bytes.byteOffset, bytes.length);
}

export function nodeDigest(name: string, data: NodeInput): Buffer { return bufferOver(msDigest(name, data)); }
export function nodeHmac(name: string, key: NodeInput, data: NodeInput): Buffer { return bufferOver(msHmac(name, key, data)); }
export function nodeHashNew(name: string): NodeHash { return msHashNew(name); }
export function nodeHmacNew(name: string, key: NodeInput): NodeHash { return msHmacNew(name, key); }
export function nodeHashUpdate(hash: NodeHash, data: NodeInput): void { msHashUpdate(hash, data); }
export function nodeHashDigest(hash: NodeHash): Buffer { return bufferOver(msHashDigest(hash)); }
export function nodePbkdf2(password: NodeInput, salt: NodeInput, iterations: int32, keyLength: int32, digest: string): Buffer {
	return bufferOver(msPbkdf2(password, salt, iterations, keyLength, digest));
}
export function nodeHkdf(digest: string, ikm: NodeInput, salt: NodeInput, info: NodeInput, length: int32): Buffer {
	return new Buffer(msHkdf(digest, ikm, salt, info, length));
}

extern function msInputLength(data: NodeInput): int32 from "(x => typeof x === \"string\" ? new TextEncoder().encode(x).length : x.length)(#)";
extern function msInputHead(data: NodeInput, count: int32): uint8[] from "((x, n) => Array.from((typeof x === \"string\" ? new TextEncoder().encode(x) : x).subarray(0, n)))(#, #)";

/** The byte length of what node reads: a string's UTF-8 length. */
export function nodeInputLength(data: NodeInput): int32 { return msInputLength(data); }
/** The first `count` bytes, copied. */
export function nodeInputHead(data: NodeInput, count: int32): uint8[] { return msInputHead(data, count); }

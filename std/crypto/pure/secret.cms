/** Hides a value from the C optimizer, so a mask built from a secret bit stays a mask and never becomes a branch. */
export function valueBarrier(value: uint32): uint32 {
	@emit(`__asm__("" : "+r"(${value}));`);
	return value;
}

/** Zeroes secret bytes with a memset the C compiler cannot drop: the volatile asm after it may read the memory, as a volatile memset would. */
export function wipeBytes(data: Span<uint8>): void {
	const length = data.length;
	if (length == 0) return;
	const cursor = data as Ptr<uint8>;
	@emit(`memset(${cursor}, 0, (size_t)${length}); __asm__ __volatile__("" : : "r"(${cursor}) : "memory");`);
}

/** Zeroes secret 32-bit limbs as wipeBytes does for bytes. */
export function wipeWords(data: Span<uint32>): void {
	const length = data.length;
	if (length == 0) return;
	const cursor = data as Ptr<uint32>;
	@emit(`memset(${cursor}, 0, (size_t)${length} * 4); __asm__ __volatile__("" : : "r"(${cursor}) : "memory");`);
}

/** Zeroes secret 64-bit words as wipeBytes does for bytes. */
export function wipeWords64(data: Span<uint64>): void {
	const length = data.length;
	if (length == 0) return;
	const cursor = data as Ptr<uint64>;
	@emit(`memset(${cursor}, 0, (size_t)${length} * 8); __asm__ __volatile__("" : : "r"(${cursor}) : "memory");`);
}

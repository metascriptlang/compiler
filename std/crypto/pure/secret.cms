/** Hides a value from the C optimizer, so a mask built from a secret bit stays a mask and never becomes a branch. */
export function valueBarrier(value: uint32): uint32 {
	@emit(`__asm__("" : "+r"(${value}));`);
	return value;
}

/** Zeroes secret bytes with volatile stores, which the C compiler cannot drop as dead before the array is freed. */
export function wipeBytes(data: Span<uint8>): void {
	const length = data.length;
	if (length == 0) return;
	const cursor = data as Ptr<uint8>;
	@emit(`volatile uint8_t *bytes = (volatile uint8_t*)${cursor}; for (int64_t i = 0; i < ${length}; i++) bytes[i] = 0;`);
}

/** Zeroes secret 32-bit limbs with volatile stores, as wipeBytes does for bytes. */
export function wipeWords(data: Span<uint32>): void {
	const length = data.length;
	if (length == 0) return;
	const cursor = data as Ptr<uint32>;
	@emit(`volatile uint32_t *words = (volatile uint32_t*)${cursor}; for (int64_t i = 0; i < ${length}; i++) words[i] = 0;`);
}

/** Zeroes secret 64-bit words with volatile stores, as wipeBytes does for bytes. */
export function wipeWords64(data: Span<uint64>): void {
	const length = data.length;
	if (length == 0) return;
	const cursor = data as Ptr<uint64>;
	@emit(`volatile uint64_t *words = (volatile uint64_t*)${cursor}; for (int64_t i = 0; i < ${length}; i++) words[i] = 0;`);
}

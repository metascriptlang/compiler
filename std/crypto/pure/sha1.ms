import { HashState, HashBytes } from "./state";

export function initSha1(state: Span<uint32>): void {
	state[0] = 0x67452301;
	state[1] = 0xefcdab89;
	state[2] = 0x98badcfe;
	state[3] = 0x10325476;
	state[4] = 0xc3d2e1f0;
}

function rotl(v: uint32, c: uint32): uint32 {
	return (v << c) | (v >> (32 - c));
}

when (!js) {
	export function compressSha1Words(state: Span<uint32>, data: HashBytes, off: int32): void {
		let w0: uint32 = ((data[off + 0] as uint32) << 24) | ((data[off + 1] as uint32) << 16) | ((data[off + 2] as uint32) << 8) | (data[off + 3] as uint32);
		let w1: uint32 = ((data[off + 4] as uint32) << 24) | ((data[off + 5] as uint32) << 16) | ((data[off + 6] as uint32) << 8) | (data[off + 7] as uint32);
		let w2: uint32 = ((data[off + 8] as uint32) << 24) | ((data[off + 9] as uint32) << 16) | ((data[off + 10] as uint32) << 8) | (data[off + 11] as uint32);
		let w3: uint32 = ((data[off + 12] as uint32) << 24) | ((data[off + 13] as uint32) << 16) | ((data[off + 14] as uint32) << 8) | (data[off + 15] as uint32);
		let w4: uint32 = ((data[off + 16] as uint32) << 24) | ((data[off + 17] as uint32) << 16) | ((data[off + 18] as uint32) << 8) | (data[off + 19] as uint32);
		let w5: uint32 = ((data[off + 20] as uint32) << 24) | ((data[off + 21] as uint32) << 16) | ((data[off + 22] as uint32) << 8) | (data[off + 23] as uint32);
		let w6: uint32 = ((data[off + 24] as uint32) << 24) | ((data[off + 25] as uint32) << 16) | ((data[off + 26] as uint32) << 8) | (data[off + 27] as uint32);
		let w7: uint32 = ((data[off + 28] as uint32) << 24) | ((data[off + 29] as uint32) << 16) | ((data[off + 30] as uint32) << 8) | (data[off + 31] as uint32);
		let w8: uint32 = ((data[off + 32] as uint32) << 24) | ((data[off + 33] as uint32) << 16) | ((data[off + 34] as uint32) << 8) | (data[off + 35] as uint32);
		let w9: uint32 = ((data[off + 36] as uint32) << 24) | ((data[off + 37] as uint32) << 16) | ((data[off + 38] as uint32) << 8) | (data[off + 39] as uint32);
		let w10: uint32 = ((data[off + 40] as uint32) << 24) | ((data[off + 41] as uint32) << 16) | ((data[off + 42] as uint32) << 8) | (data[off + 43] as uint32);
		let w11: uint32 = ((data[off + 44] as uint32) << 24) | ((data[off + 45] as uint32) << 16) | ((data[off + 46] as uint32) << 8) | (data[off + 47] as uint32);
		let w12: uint32 = ((data[off + 48] as uint32) << 24) | ((data[off + 49] as uint32) << 16) | ((data[off + 50] as uint32) << 8) | (data[off + 51] as uint32);
		let w13: uint32 = ((data[off + 52] as uint32) << 24) | ((data[off + 53] as uint32) << 16) | ((data[off + 54] as uint32) << 8) | (data[off + 55] as uint32);
		let w14: uint32 = ((data[off + 56] as uint32) << 24) | ((data[off + 57] as uint32) << 16) | ((data[off + 58] as uint32) << 8) | (data[off + 59] as uint32);
		let w15: uint32 = ((data[off + 60] as uint32) << 24) | ((data[off + 61] as uint32) << 16) | ((data[off + 62] as uint32) << 8) | (data[off + 63] as uint32);
		let v0 = state[0];
		let v1 = state[1];
		let v2 = state[2];
		let v3 = state[3];
		let v4 = state[4];
		v4 = v4 + rotl(v0, 5) + 0x5a827999 + w0 + ((v1 & v2) | (~v1 & v3));
		v1 = rotl(v1, 30);
		v3 = v3 + rotl(v4, 5) + 0x5a827999 + w1 + ((v0 & v1) | (~v0 & v2));
		v0 = rotl(v0, 30);
		v2 = v2 + rotl(v3, 5) + 0x5a827999 + w2 + ((v4 & v0) | (~v4 & v1));
		v4 = rotl(v4, 30);
		v1 = v1 + rotl(v2, 5) + 0x5a827999 + w3 + ((v3 & v4) | (~v3 & v0));
		v3 = rotl(v3, 30);
		v0 = v0 + rotl(v1, 5) + 0x5a827999 + w4 + ((v2 & v3) | (~v2 & v4));
		v2 = rotl(v2, 30);
		v4 = v4 + rotl(v0, 5) + 0x5a827999 + w5 + ((v1 & v2) | (~v1 & v3));
		v1 = rotl(v1, 30);
		v3 = v3 + rotl(v4, 5) + 0x5a827999 + w6 + ((v0 & v1) | (~v0 & v2));
		v0 = rotl(v0, 30);
		v2 = v2 + rotl(v3, 5) + 0x5a827999 + w7 + ((v4 & v0) | (~v4 & v1));
		v4 = rotl(v4, 30);
		v1 = v1 + rotl(v2, 5) + 0x5a827999 + w8 + ((v3 & v4) | (~v3 & v0));
		v3 = rotl(v3, 30);
		v0 = v0 + rotl(v1, 5) + 0x5a827999 + w9 + ((v2 & v3) | (~v2 & v4));
		v2 = rotl(v2, 30);
		v4 = v4 + rotl(v0, 5) + 0x5a827999 + w10 + ((v1 & v2) | (~v1 & v3));
		v1 = rotl(v1, 30);
		v3 = v3 + rotl(v4, 5) + 0x5a827999 + w11 + ((v0 & v1) | (~v0 & v2));
		v0 = rotl(v0, 30);
		v2 = v2 + rotl(v3, 5) + 0x5a827999 + w12 + ((v4 & v0) | (~v4 & v1));
		v4 = rotl(v4, 30);
		v1 = v1 + rotl(v2, 5) + 0x5a827999 + w13 + ((v3 & v4) | (~v3 & v0));
		v3 = rotl(v3, 30);
		v0 = v0 + rotl(v1, 5) + 0x5a827999 + w14 + ((v2 & v3) | (~v2 & v4));
		v2 = rotl(v2, 30);
		v4 = v4 + rotl(v0, 5) + 0x5a827999 + w15 + ((v1 & v2) | (~v1 & v3));
		v1 = rotl(v1, 30);
		w0 = rotl(w13 ^ w8 ^ w2 ^ w0, 1);
		v3 = v3 + rotl(v4, 5) + 0x5a827999 + w0 + ((v0 & v1) | (~v0 & v2));
		v0 = rotl(v0, 30);
		w1 = rotl(w14 ^ w9 ^ w3 ^ w1, 1);
		v2 = v2 + rotl(v3, 5) + 0x5a827999 + w1 + ((v4 & v0) | (~v4 & v1));
		v4 = rotl(v4, 30);
		w2 = rotl(w15 ^ w10 ^ w4 ^ w2, 1);
		v1 = v1 + rotl(v2, 5) + 0x5a827999 + w2 + ((v3 & v4) | (~v3 & v0));
		v3 = rotl(v3, 30);
		w3 = rotl(w0 ^ w11 ^ w5 ^ w3, 1);
		v0 = v0 + rotl(v1, 5) + 0x5a827999 + w3 + ((v2 & v3) | (~v2 & v4));
		v2 = rotl(v2, 30);
		w4 = rotl(w1 ^ w12 ^ w6 ^ w4, 1);
		v4 = v4 + rotl(v0, 5) + 0x6ed9eba1 + w4 + (v1 ^ v2 ^ v3);
		v1 = rotl(v1, 30);
		w5 = rotl(w2 ^ w13 ^ w7 ^ w5, 1);
		v3 = v3 + rotl(v4, 5) + 0x6ed9eba1 + w5 + (v0 ^ v1 ^ v2);
		v0 = rotl(v0, 30);
		w6 = rotl(w3 ^ w14 ^ w8 ^ w6, 1);
		v2 = v2 + rotl(v3, 5) + 0x6ed9eba1 + w6 + (v4 ^ v0 ^ v1);
		v4 = rotl(v4, 30);
		w7 = rotl(w4 ^ w15 ^ w9 ^ w7, 1);
		v1 = v1 + rotl(v2, 5) + 0x6ed9eba1 + w7 + (v3 ^ v4 ^ v0);
		v3 = rotl(v3, 30);
		w8 = rotl(w5 ^ w0 ^ w10 ^ w8, 1);
		v0 = v0 + rotl(v1, 5) + 0x6ed9eba1 + w8 + (v2 ^ v3 ^ v4);
		v2 = rotl(v2, 30);
		w9 = rotl(w6 ^ w1 ^ w11 ^ w9, 1);
		v4 = v4 + rotl(v0, 5) + 0x6ed9eba1 + w9 + (v1 ^ v2 ^ v3);
		v1 = rotl(v1, 30);
		w10 = rotl(w7 ^ w2 ^ w12 ^ w10, 1);
		v3 = v3 + rotl(v4, 5) + 0x6ed9eba1 + w10 + (v0 ^ v1 ^ v2);
		v0 = rotl(v0, 30);
		w11 = rotl(w8 ^ w3 ^ w13 ^ w11, 1);
		v2 = v2 + rotl(v3, 5) + 0x6ed9eba1 + w11 + (v4 ^ v0 ^ v1);
		v4 = rotl(v4, 30);
		w12 = rotl(w9 ^ w4 ^ w14 ^ w12, 1);
		v1 = v1 + rotl(v2, 5) + 0x6ed9eba1 + w12 + (v3 ^ v4 ^ v0);
		v3 = rotl(v3, 30);
		w13 = rotl(w10 ^ w5 ^ w15 ^ w13, 1);
		v0 = v0 + rotl(v1, 5) + 0x6ed9eba1 + w13 + (v2 ^ v3 ^ v4);
		v2 = rotl(v2, 30);
		w14 = rotl(w11 ^ w6 ^ w0 ^ w14, 1);
		v4 = v4 + rotl(v0, 5) + 0x6ed9eba1 + w14 + (v1 ^ v2 ^ v3);
		v1 = rotl(v1, 30);
		w15 = rotl(w12 ^ w7 ^ w1 ^ w15, 1);
		v3 = v3 + rotl(v4, 5) + 0x6ed9eba1 + w15 + (v0 ^ v1 ^ v2);
		v0 = rotl(v0, 30);
		w0 = rotl(w13 ^ w8 ^ w2 ^ w0, 1);
		v2 = v2 + rotl(v3, 5) + 0x6ed9eba1 + w0 + (v4 ^ v0 ^ v1);
		v4 = rotl(v4, 30);
		w1 = rotl(w14 ^ w9 ^ w3 ^ w1, 1);
		v1 = v1 + rotl(v2, 5) + 0x6ed9eba1 + w1 + (v3 ^ v4 ^ v0);
		v3 = rotl(v3, 30);
		w2 = rotl(w15 ^ w10 ^ w4 ^ w2, 1);
		v0 = v0 + rotl(v1, 5) + 0x6ed9eba1 + w2 + (v2 ^ v3 ^ v4);
		v2 = rotl(v2, 30);
		w3 = rotl(w0 ^ w11 ^ w5 ^ w3, 1);
		v4 = v4 + rotl(v0, 5) + 0x6ed9eba1 + w3 + (v1 ^ v2 ^ v3);
		v1 = rotl(v1, 30);
		w4 = rotl(w1 ^ w12 ^ w6 ^ w4, 1);
		v3 = v3 + rotl(v4, 5) + 0x6ed9eba1 + w4 + (v0 ^ v1 ^ v2);
		v0 = rotl(v0, 30);
		w5 = rotl(w2 ^ w13 ^ w7 ^ w5, 1);
		v2 = v2 + rotl(v3, 5) + 0x6ed9eba1 + w5 + (v4 ^ v0 ^ v1);
		v4 = rotl(v4, 30);
		w6 = rotl(w3 ^ w14 ^ w8 ^ w6, 1);
		v1 = v1 + rotl(v2, 5) + 0x6ed9eba1 + w6 + (v3 ^ v4 ^ v0);
		v3 = rotl(v3, 30);
		w7 = rotl(w4 ^ w15 ^ w9 ^ w7, 1);
		v0 = v0 + rotl(v1, 5) + 0x6ed9eba1 + w7 + (v2 ^ v3 ^ v4);
		v2 = rotl(v2, 30);
		w8 = rotl(w5 ^ w0 ^ w10 ^ w8, 1);
		v4 = v4 + rotl(v0, 5) + 0x8f1bbcdc + w8 + ((v1 & v2) ^ (v1 & v3) ^ (v2 & v3));
		v1 = rotl(v1, 30);
		w9 = rotl(w6 ^ w1 ^ w11 ^ w9, 1);
		v3 = v3 + rotl(v4, 5) + 0x8f1bbcdc + w9 + ((v0 & v1) ^ (v0 & v2) ^ (v1 & v2));
		v0 = rotl(v0, 30);
		w10 = rotl(w7 ^ w2 ^ w12 ^ w10, 1);
		v2 = v2 + rotl(v3, 5) + 0x8f1bbcdc + w10 + ((v4 & v0) ^ (v4 & v1) ^ (v0 & v1));
		v4 = rotl(v4, 30);
		w11 = rotl(w8 ^ w3 ^ w13 ^ w11, 1);
		v1 = v1 + rotl(v2, 5) + 0x8f1bbcdc + w11 + ((v3 & v4) ^ (v3 & v0) ^ (v4 & v0));
		v3 = rotl(v3, 30);
		w12 = rotl(w9 ^ w4 ^ w14 ^ w12, 1);
		v0 = v0 + rotl(v1, 5) + 0x8f1bbcdc + w12 + ((v2 & v3) ^ (v2 & v4) ^ (v3 & v4));
		v2 = rotl(v2, 30);
		w13 = rotl(w10 ^ w5 ^ w15 ^ w13, 1);
		v4 = v4 + rotl(v0, 5) + 0x8f1bbcdc + w13 + ((v1 & v2) ^ (v1 & v3) ^ (v2 & v3));
		v1 = rotl(v1, 30);
		w14 = rotl(w11 ^ w6 ^ w0 ^ w14, 1);
		v3 = v3 + rotl(v4, 5) + 0x8f1bbcdc + w14 + ((v0 & v1) ^ (v0 & v2) ^ (v1 & v2));
		v0 = rotl(v0, 30);
		w15 = rotl(w12 ^ w7 ^ w1 ^ w15, 1);
		v2 = v2 + rotl(v3, 5) + 0x8f1bbcdc + w15 + ((v4 & v0) ^ (v4 & v1) ^ (v0 & v1));
		v4 = rotl(v4, 30);
		w0 = rotl(w13 ^ w8 ^ w2 ^ w0, 1);
		v1 = v1 + rotl(v2, 5) + 0x8f1bbcdc + w0 + ((v3 & v4) ^ (v3 & v0) ^ (v4 & v0));
		v3 = rotl(v3, 30);
		w1 = rotl(w14 ^ w9 ^ w3 ^ w1, 1);
		v0 = v0 + rotl(v1, 5) + 0x8f1bbcdc + w1 + ((v2 & v3) ^ (v2 & v4) ^ (v3 & v4));
		v2 = rotl(v2, 30);
		w2 = rotl(w15 ^ w10 ^ w4 ^ w2, 1);
		v4 = v4 + rotl(v0, 5) + 0x8f1bbcdc + w2 + ((v1 & v2) ^ (v1 & v3) ^ (v2 & v3));
		v1 = rotl(v1, 30);
		w3 = rotl(w0 ^ w11 ^ w5 ^ w3, 1);
		v3 = v3 + rotl(v4, 5) + 0x8f1bbcdc + w3 + ((v0 & v1) ^ (v0 & v2) ^ (v1 & v2));
		v0 = rotl(v0, 30);
		w4 = rotl(w1 ^ w12 ^ w6 ^ w4, 1);
		v2 = v2 + rotl(v3, 5) + 0x8f1bbcdc + w4 + ((v4 & v0) ^ (v4 & v1) ^ (v0 & v1));
		v4 = rotl(v4, 30);
		w5 = rotl(w2 ^ w13 ^ w7 ^ w5, 1);
		v1 = v1 + rotl(v2, 5) + 0x8f1bbcdc + w5 + ((v3 & v4) ^ (v3 & v0) ^ (v4 & v0));
		v3 = rotl(v3, 30);
		w6 = rotl(w3 ^ w14 ^ w8 ^ w6, 1);
		v0 = v0 + rotl(v1, 5) + 0x8f1bbcdc + w6 + ((v2 & v3) ^ (v2 & v4) ^ (v3 & v4));
		v2 = rotl(v2, 30);
		w7 = rotl(w4 ^ w15 ^ w9 ^ w7, 1);
		v4 = v4 + rotl(v0, 5) + 0x8f1bbcdc + w7 + ((v1 & v2) ^ (v1 & v3) ^ (v2 & v3));
		v1 = rotl(v1, 30);
		w8 = rotl(w5 ^ w0 ^ w10 ^ w8, 1);
		v3 = v3 + rotl(v4, 5) + 0x8f1bbcdc + w8 + ((v0 & v1) ^ (v0 & v2) ^ (v1 & v2));
		v0 = rotl(v0, 30);
		w9 = rotl(w6 ^ w1 ^ w11 ^ w9, 1);
		v2 = v2 + rotl(v3, 5) + 0x8f1bbcdc + w9 + ((v4 & v0) ^ (v4 & v1) ^ (v0 & v1));
		v4 = rotl(v4, 30);
		w10 = rotl(w7 ^ w2 ^ w12 ^ w10, 1);
		v1 = v1 + rotl(v2, 5) + 0x8f1bbcdc + w10 + ((v3 & v4) ^ (v3 & v0) ^ (v4 & v0));
		v3 = rotl(v3, 30);
		w11 = rotl(w8 ^ w3 ^ w13 ^ w11, 1);
		v0 = v0 + rotl(v1, 5) + 0x8f1bbcdc + w11 + ((v2 & v3) ^ (v2 & v4) ^ (v3 & v4));
		v2 = rotl(v2, 30);
		w12 = rotl(w9 ^ w4 ^ w14 ^ w12, 1);
		v4 = v4 + rotl(v0, 5) + 0xca62c1d6 + w12 + (v1 ^ v2 ^ v3);
		v1 = rotl(v1, 30);
		w13 = rotl(w10 ^ w5 ^ w15 ^ w13, 1);
		v3 = v3 + rotl(v4, 5) + 0xca62c1d6 + w13 + (v0 ^ v1 ^ v2);
		v0 = rotl(v0, 30);
		w14 = rotl(w11 ^ w6 ^ w0 ^ w14, 1);
		v2 = v2 + rotl(v3, 5) + 0xca62c1d6 + w14 + (v4 ^ v0 ^ v1);
		v4 = rotl(v4, 30);
		w15 = rotl(w12 ^ w7 ^ w1 ^ w15, 1);
		v1 = v1 + rotl(v2, 5) + 0xca62c1d6 + w15 + (v3 ^ v4 ^ v0);
		v3 = rotl(v3, 30);
		w0 = rotl(w13 ^ w8 ^ w2 ^ w0, 1);
		v0 = v0 + rotl(v1, 5) + 0xca62c1d6 + w0 + (v2 ^ v3 ^ v4);
		v2 = rotl(v2, 30);
		w1 = rotl(w14 ^ w9 ^ w3 ^ w1, 1);
		v4 = v4 + rotl(v0, 5) + 0xca62c1d6 + w1 + (v1 ^ v2 ^ v3);
		v1 = rotl(v1, 30);
		w2 = rotl(w15 ^ w10 ^ w4 ^ w2, 1);
		v3 = v3 + rotl(v4, 5) + 0xca62c1d6 + w2 + (v0 ^ v1 ^ v2);
		v0 = rotl(v0, 30);
		w3 = rotl(w0 ^ w11 ^ w5 ^ w3, 1);
		v2 = v2 + rotl(v3, 5) + 0xca62c1d6 + w3 + (v4 ^ v0 ^ v1);
		v4 = rotl(v4, 30);
		w4 = rotl(w1 ^ w12 ^ w6 ^ w4, 1);
		v1 = v1 + rotl(v2, 5) + 0xca62c1d6 + w4 + (v3 ^ v4 ^ v0);
		v3 = rotl(v3, 30);
		w5 = rotl(w2 ^ w13 ^ w7 ^ w5, 1);
		v0 = v0 + rotl(v1, 5) + 0xca62c1d6 + w5 + (v2 ^ v3 ^ v4);
		v2 = rotl(v2, 30);
		w6 = rotl(w3 ^ w14 ^ w8 ^ w6, 1);
		v4 = v4 + rotl(v0, 5) + 0xca62c1d6 + w6 + (v1 ^ v2 ^ v3);
		v1 = rotl(v1, 30);
		w7 = rotl(w4 ^ w15 ^ w9 ^ w7, 1);
		v3 = v3 + rotl(v4, 5) + 0xca62c1d6 + w7 + (v0 ^ v1 ^ v2);
		v0 = rotl(v0, 30);
		w8 = rotl(w5 ^ w0 ^ w10 ^ w8, 1);
		v2 = v2 + rotl(v3, 5) + 0xca62c1d6 + w8 + (v4 ^ v0 ^ v1);
		v4 = rotl(v4, 30);
		w9 = rotl(w6 ^ w1 ^ w11 ^ w9, 1);
		v1 = v1 + rotl(v2, 5) + 0xca62c1d6 + w9 + (v3 ^ v4 ^ v0);
		v3 = rotl(v3, 30);
		w10 = rotl(w7 ^ w2 ^ w12 ^ w10, 1);
		v0 = v0 + rotl(v1, 5) + 0xca62c1d6 + w10 + (v2 ^ v3 ^ v4);
		v2 = rotl(v2, 30);
		w11 = rotl(w8 ^ w3 ^ w13 ^ w11, 1);
		v4 = v4 + rotl(v0, 5) + 0xca62c1d6 + w11 + (v1 ^ v2 ^ v3);
		v1 = rotl(v1, 30);
		w12 = rotl(w9 ^ w4 ^ w14 ^ w12, 1);
		v3 = v3 + rotl(v4, 5) + 0xca62c1d6 + w12 + (v0 ^ v1 ^ v2);
		v0 = rotl(v0, 30);
		w13 = rotl(w10 ^ w5 ^ w15 ^ w13, 1);
		v2 = v2 + rotl(v3, 5) + 0xca62c1d6 + w13 + (v4 ^ v0 ^ v1);
		v4 = rotl(v4, 30);
		w14 = rotl(w11 ^ w6 ^ w0 ^ w14, 1);
		v1 = v1 + rotl(v2, 5) + 0xca62c1d6 + w14 + (v3 ^ v4 ^ v0);
		v3 = rotl(v3, 30);
		w15 = rotl(w12 ^ w7 ^ w1 ^ w15, 1);
		v0 = v0 + rotl(v1, 5) + 0xca62c1d6 + w15 + (v2 ^ v3 ^ v4);
		v2 = rotl(v2, 30);
		state[0] = state[0] + v0;
		state[1] = state[1] + v1;
		state[2] = state[2] + v2;
		state[3] = state[3] + v3;
		state[4] = state[4] + v4;
	}
}

when (js) {
	function compressSha1Block(h: HashState, data: Readonly<uint8[]>, off: int32): void {
		for (let i = 0; i < 16; i++) {
			const at = off + i * 4;
			h.schedule[i] = ((data[at] as uint32) << 24) | ((data[at + 1] as uint32) << 16) | ((data[at + 2] as uint32) << 8) | (data[at + 3] as uint32);
		}
		for (let i = 16; i < 80; i++) {
			h.schedule[i] = rotl(h.schedule[i - 3] ^ h.schedule[i - 8] ^ h.schedule[i - 14] ^ h.schedule[i - 16], 1);
		}
		let a = h.state[0];
		let b = h.state[1];
		let c = h.state[2];
		let d = h.state[3];
		let e = h.state[4];
		for (let i = 0; i < 20; i++) {
			const next = rotl(a, 5) + ((b & c) ^ (~b & d)) + e + 0x5a827999 + h.schedule[i];
			e = d;
			d = c;
			c = rotl(b, 30);
			b = a;
			a = next;
		}
		for (let i = 20; i < 40; i++) {
			const next = rotl(a, 5) + (b ^ c ^ d) + e + 0x6ed9eba1 + h.schedule[i];
			e = d;
			d = c;
			c = rotl(b, 30);
			b = a;
			a = next;
		}
		for (let i = 40; i < 60; i++) {
			const next = rotl(a, 5) + ((b & c) ^ (b & d) ^ (c & d)) + e + 0x8f1bbcdc + h.schedule[i];
			e = d;
			d = c;
			c = rotl(b, 30);
			b = a;
			a = next;
		}
		for (let i = 60; i < 80; i++) {
			const next = rotl(a, 5) + (b ^ c ^ d) + e + 0xca62c1d6 + h.schedule[i];
			e = d;
			d = c;
			c = rotl(b, 30);
			b = a;
			a = next;
		}
		h.state[0] = h.state[0] + a;
		h.state[1] = h.state[1] + b;
		h.state[2] = h.state[2] + c;
		h.state[3] = h.state[3] + d;
		h.state[4] = h.state[4] + e;
	}
}

export function compressSha1(h: HashState, data: HashBytes, off: int32): void {
	when (!js) {
		compressSha1Words(h.state, data, off);
	} else {
		compressSha1Block(h, data, off);
	}
}

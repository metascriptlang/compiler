	v15 = v15 ^ v3;
	v15 = (v15 >> 32) | (v15 << 32);
	v11 = v11 + v15;
	v7 = v7 ^ v11;
	v7 = (v7 >> 24) | (v7 << 40);
	v3 = v3 + v7 + m7;
	v15 = v15 ^ v3;
	v15 = (v15 >> 16) | (v15 << 48);
	v11 = v11 + v15;
	v7 = v7 ^ v11;
	v7 = (v7 >> 63) | (v7 << 1);
	v0 = v0 + v5 + m8;
	v15 = v15 ^ v0;
	v15 = (v15 >> 32) | (v15 << 32);
	v10 = v10 + v15;
	v5 = v5 ^ v10;
	v5 = (v5 >> 24) | (v5 << 40);
	v0 = v0 + v5 + m9;
	v15 = v15 ^ v0;
	v15 = (v15 >> 16) | (v15 << 48);
	v10 = v10 + v15;
	v5 = v5 ^ v10;
	v5 = (v5 >> 63) | (v5 << 1);
	v1 = v1 + v6 + m10;
	v12 = v12 ^ v1;
	v12 = (v12 >> 32) | (v12 << 32);
	v11 = v11 + v12;
	v6 = v6 ^ v11;
	v6 = (v6 >> 24) | (v6 << 40);
	v1 = v1 + v6 + m11;
	v12 = v12 ^ v1;
	v12 = (v12 >> 16) | (v12 << 48);
	v11 = v11 + v12;
	v6 = v6 ^ v11;
	v6 = (v6 >> 63) | (v6 << 1);
	v2 = v2 + v7 + m12;
	v13 = v13 ^ v2;
	v13 = (v13 >> 32) | (v13 << 32);
	v8 = v8 + v13;
	v7 = v7 ^ v8;
	v7 = (v7 >> 24) | (v7 << 40);
	v2 = v2 + v7 + m13;
	v13 = v13 ^ v2;
	v13 = (v13 >> 16) | (v13 << 48);
	v8 = v8 + v13;
	v7 = v7 ^ v8;
	v7 = (v7 >> 63) | (v7 << 1);
	v3 = v3 + v4 + m14;
	v14 = v14 ^ v3;
	v14 = (v14 >> 32) | (v14 << 32);
	v9 = v9 + v14;
	v4 = v4 ^ v9;
	v4 = (v4 >> 24) | (v4 << 40);
	v3 = v3 + v4 + m15;
	v14 = v14 ^ v3;
	v14 = (v14 >> 16) | (v14 << 48);
	v9 = v9 + v14;
	v4 = v4 ^ v9;
	v4 = (v4 >> 63) | (v4 << 1);
	v0 = v0 + v4 + m14;
	v12 = v12 ^ v0;
	v12 = (v12 >> 32) | (v12 << 32);
	v8 = v8 + v12;
	v4 = v4 ^ v8;
	v4 = (v4 >> 24) | (v4 << 40);
	v0 = v0 + v4 + m10;
	v12 = v12 ^ v0;
	v12 = (v12 >> 16) | (v12 << 48);
	v8 = v8 + v12;
	v4 = v4 ^ v8;
	v4 = (v4 >> 63) | (v4 << 1);
	v1 = v1 + v5 + m4;
	v13 = v13 ^ v1;
	v13 = (v13 >> 32) | (v13 << 32);
	v9 = v9 + v13;
	v5 = v5 ^ v9;
	v5 = (v5 >> 24) | (v5 << 40);
	v1 = v1 + v5 + m8;
	v13 = v13 ^ v1;
	v13 = (v13 >> 16) | (v13 << 48);
	v9 = v9 + v13;
	v5 = v5 ^ v9;
	v5 = (v5 >> 63) | (v5 << 1);
	v2 = v2 + v6 + m9;
	v14 = v14 ^ v2;
	v14 = (v14 >> 32) | (v14 << 32);
	v10 = v10 + v14;
	v6 = v6 ^ v10;
	v6 = (v6 >> 24) | (v6 << 40);
	v2 = v2 + v6 + m15;
	v14 = v14 ^ v2;
	v14 = (v14 >> 16) | (v14 << 48);
	v10 = v10 + v14;
	v6 = v6 ^ v10;
	v6 = (v6 >> 63) | (v6 << 1);
	v3 = v3 + v7 + m13;
	v15 = v15 ^ v3;
	v15 = (v15 >> 32) | (v15 << 32);
	v11 = v11 + v15;
	v7 = v7 ^ v11;
	v7 = (v7 >> 24) | (v7 << 40);
	v3 = v3 + v7 + m6;
	v15 = v15 ^ v3;
	v15 = (v15 >> 16) | (v15 << 48);
	v11 = v11 + v15;
	v7 = v7 ^ v11;
	v7 = (v7 >> 63) | (v7 << 1);
	v0 = v0 + v5 + m1;
	v15 = v15 ^ v0;
	v15 = (v15 >> 32) | (v15 << 32);
	v10 = v10 + v15;
	v5 = v5 ^ v10;
	v5 = (v5 >> 24) | (v5 << 40);
	v0 = v0 + v5 + m12;
	v15 = v15 ^ v0;
	v15 = (v15 >> 16) | (v15 << 48);

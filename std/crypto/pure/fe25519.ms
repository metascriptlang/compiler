/** The 32 bytes at `from`, little-endian, bit 255 ignored; a value at or above P is accepted and reduced. */
export function feFromBytes(bytes: Readonly<uint8[]>, from: int32): Fe {
	const s = new Array<uint8>(32);
	for (let i = 0; i < 32; i++) s[i] = bytes[from + i];
	s[31] = s[31] & 127;
	return fiat_25519_from_bytes(s);
}

/** The canonical little-endian encoding, below P. */
export function feToBytes(a: Fe): uint8[] {
	return fiat_25519_to_bytes(a);
}

export function feAdd(a: Fe, b: Fe): Fe {
	return fiat_25519_carry(fiat_25519_add(a, b));
}

export function feSub(a: Fe, b: Fe): Fe {
	return fiat_25519_carry(fiat_25519_sub(a, b));
}

/** a + b left loose: valid only as an operand of feMul or feSqr, which accept fiat's loose bounds. */
export function feAddLoose(a: Fe, b: Fe): Fe {
	return fiat_25519_add(a, b);
}

/** a - b left loose: valid only as an operand of feMul or feSqr, which accept fiat's loose bounds. */
export function feSubLoose(a: Fe, b: Fe): Fe {
	return fiat_25519_sub(a, b);
}

export function feNeg(a: Fe): Fe {
	return feSub(feZero, a);
}

export function feMul(a: Fe, b: Fe): Fe {
	return fiat_25519_carry_mul(a, b);
}

export function feSqr(a: Fe): Fe {
	return fiat_25519_carry_square(a);
}

export function feMul121666(a: Fe): Fe {
	return fiat_25519_carry_scmul_121666(a);
}

export function feSqrK(a: Fe, count: int32): Fe {
	let r = a;
	for (let i = 0; i < count; i++) r = fiat_25519_carry_square(r);
	return r;
}

/** x^(2^252 - 3), the shared exponent of the inverse and of the square root. */
export function fePow2252m3(x: Fe): Fe {
	const b2 = feMul(feSqr(x), x);
	const b4 = feMul(feSqrK(b2, 2), b2);
	const b5 = feMul(feSqrK(b4, 1), x);
	const b10 = feMul(feSqrK(b5, 5), b5);
	const b20 = feMul(feSqrK(b10, 10), b10);
	const b40 = feMul(feSqrK(b20, 20), b20);
	const b80 = feMul(feSqrK(b40, 40), b40);
	const b160 = feMul(feSqrK(b80, 80), b80);
	const b240 = feMul(feSqrK(b160, 80), b80);
	const b250 = feMul(feSqrK(b240, 10), b10);
	return feMul(feSqrK(b250, 2), x);
}

/** x^(P - 2) = (x^(2^252 - 3))^8 * x^3, zero for zero; the operation sequence never depends on x. */
export function feInv(x: Fe): Fe {
	return feMul(feSqrK(fePow2252m3(x), 3), feMul(feSqr(x), x));
}

export function feIsZero(a: Fe): boolean {
	const s = fiat_25519_to_bytes(a);
	let bits = 0;
	for (let i = 0; i < 32; i++) bits = bits | (s[i] as int32);
	return bits == 0;
}

export function feEqual(a: Fe, b: Fe): boolean {
	return feIsZero(feSub(a, b));
}

/** The low bit of the canonical encoding, the sign Ed25519 stores in bit 255. */
export function feIsNegative(a: Fe): boolean {
	return ((fiat_25519_to_bytes(a)[0] as int32) & 1) == 1;
}

/** b when bit is 1, a when it is 0, without a branch on bit. */
export function feCMov(a: Fe, b: Fe, bit: uint32): Fe {
	const mask = valueBarrier((0 - (bit as int32)) as uint32);
	let out: Fe = a;
	for (let i = 0; i < 10; i++) out[i] = a[i] ^ (mask & (a[i] ^ b[i]));
	return out;
}

/** An affine point in ref10's niels form: y + x, y - x and 2dxy. */
export struct Niels {
	yPlusX: Fe;
	yMinusX: Fe;
	xy2d: Fe;
}

/**
 * Entry `magnitude - 1` of row `row` of a ref10 base table (three elements per entry, eight entries
 * per row), negated when `negative` is 1 and the identity for magnitude 0. It reads all eight
 * entries and moves limbs under masks, as ref10's select and ge_precomp_cmov do.
 */
export function feSelectNiels(table: Readonly<Fe[]>, row: int32, magnitude: int32, negative: uint32): Niels {
	let t: Niels = { yPlusX: feOne, yMinusX: feOne, xy2d: feZero };
	for (let j = 1; j <= 8; j++) {
		const mask = valueBarrier((0 - ((((magnitude ^ j) - 1) >> 31) & 1)) as uint32);
		const at = 3 * (row * 8 + j - 1);
		for (let i = 0; i < 10; i++) t.yPlusX[i] = t.yPlusX[i] ^ (mask & (t.yPlusX[i] ^ table[at][i]));
		for (let i = 0; i < 10; i++) t.yMinusX[i] = t.yMinusX[i] ^ (mask & (t.yMinusX[i] ^ table[at + 1][i]));
		for (let i = 0; i < 10; i++) t.xy2d[i] = t.xy2d[i] ^ (mask & (t.xy2d[i] ^ table[at + 2][i]));
	}
	const flip = valueBarrier((0 - (negative as int32)) as uint32);
	const minusXy = feNeg(t.xy2d);
	for (let i = 0; i < 10; i++) {
		const swap = flip & (t.yPlusX[i] ^ t.yMinusX[i]);
		t.yPlusX[i] = t.yPlusX[i] ^ swap;
		t.yMinusX[i] = t.yMinusX[i] ^ swap;
		t.xy2d[i] = t.xy2d[i] ^ (flip & (t.xy2d[i] ^ minusXy[i]));
	}
	return t;
}

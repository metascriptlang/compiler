/**
 * X25519 on the JavaScript backend, over WebCrypto (`crypto.subtle`, X25519 in Node 20+ and current browsers).
 *
 * The same async surface as index.cms. WebCrypto has no synchronous API, so the `*Sync` forms
 * (`sharedSecretSync`, `X25519PrivateKey.generateSync`, `fromRawSync`, `X25519PublicKey.importSync`,
 * `exportSync`) do not exist here: calling one is the compile error "Module has no export". There is no
 * `.ms` fallback for a WebCrypto without X25519; that case returns a `CryptoError`.
 */

import { Buffer } from "std/core/buffer";
import { Bytes } from "std/core/buffer/bytes";
import { bytesOf } from "../pure/bytes";
import { CryptoError, CryptoErrorKind, cryptoError } from "../errors";
export { CryptoError, CryptoErrorKind } from "../errors";

@emit(`function msXSubtle() {
	const c = globalThis.crypto;
	return c && c.subtle ? c.subtle : null;
}
const msXNoSubtle = "crypto.subtle is unavailable: browsers expose it only on secure contexts (https or localhost)";
function msXMessage(e) {
	return String(e && e.message ? e.message : e);
}
function msXUnb64url(text) {
	const padded = text.replace(/-/g, "+").replace(/_/g, "/");
	return Uint8Array.from(atob(padded), (ch) => ch.charCodeAt(0));
}
const msXPkcs8Prefix = [0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x6e, 0x04, 0x22, 0x04, 0x20];
async function msXFromRaw(raw) {
	const s = msXSubtle();
	if (!s) return { key: null, pub: null, raw: [], error: msXNoSubtle };
	try {
		const key = await s.importKey("pkcs8", Uint8Array.from([...msXPkcs8Prefix, ...raw]), { name: "X25519" }, true, ["deriveBits"]);
		const pubRaw = msXUnb64url((await s.exportKey("jwk", key)).x);
		const pub = await s.importKey("raw", pubRaw, { name: "X25519" }, true, []);
		return { key, pub, raw: Array.from(pubRaw), error: "" };
	} catch (e) {
		return { key: null, pub: null, raw: [], error: msXMessage(e) };
	}
}
async function msXImportPublic(raw) {
	const s = msXSubtle();
	if (!s) return { key: null, pub: null, raw: [], error: msXNoSubtle };
	try {
		const pub = await s.importKey("raw", Uint8Array.from(raw), { name: "X25519" }, true, []);
		return { key: null, pub, raw: Array.from(raw), error: "" };
	} catch (e) {
		return { key: null, pub: null, raw: [], error: msXMessage(e) };
	}
}
async function msXDerive(key, pub) {
	const s = msXSubtle();
	if (!s) return { value: [], error: msXNoSubtle };
	try {
		const bits = new Uint8Array(await s.deriveBits({ name: "X25519", public: pub }, key, 256));
		return { value: Array.from(bits), error: "" };
	} catch (e) {
		return { value: [], error: msXMessage(e) };
	}
}
function msXRandom() {
	const out = new Uint8Array(32);
	globalThis.crypto.getRandomValues(out);
	return Array.from(out);
}`);

interface Imported {
	key: unknown;
	pub: unknown;
	raw: Buffer;
	error: string;
}

interface Derived {
	value: Buffer;
	error: string;
}

extern function xFromRaw(raw: Buffer): Promise<Imported> from "msXFromRaw(#)";
extern function xImportPublic(raw: Buffer): Promise<Imported> from "msXImportPublic(#)";
extern function xDerive(key: unknown, pub: unknown): Promise<Derived> from "msXDerive(#, #)";
extern function xRandom(): Buffer from "msXRandom()";

function invalidKey(operation: string, message: string): CryptoError {
	return cryptoError(CryptoErrorKind.InvalidKey, operation, message);
}

export class X25519PublicKey {
	_raw: Buffer;
	_key: unknown;

	static async import(raw: Bytes): Promise<Result<X25519PublicKey, CryptoError>> {
		const bytes = bytesOf(raw);
		if (bytes.length != 32) return Result.err(invalidKey("X25519PublicKey.import", "public key must be 32 bytes"));
		const done = await xImportPublic(bytes);
		if (done.error != "") return Result.err(invalidKey("X25519PublicKey.import", done.error));
		return Result.ok({ _raw: bytes.slice(0), _key: done.pub });
	}

	async export(): Promise<Result<Buffer, CryptoError>> {
		return Result.ok(this._raw.slice(0));
	}
}

export class X25519PrivateKey {
	_key: unknown;
	_public: X25519PublicKey;

	static async generate(): Promise<Result<X25519PrivateKey, CryptoError>> {
		const made = await X25519PrivateKey.fromRaw(xRandom());
		if (!made.ok) return Result.err(cryptoError(CryptoErrorKind.KeyGenerationFailed, "X25519PrivateKey.generate", made.error.message));
		return Result.ok(made.value);
	}

	static async fromRaw(raw: Bytes): Promise<Result<X25519PrivateKey, CryptoError>> {
		const bytes = bytesOf(raw);
		if (bytes.length != 32) return Result.err(invalidKey("X25519PrivateKey.fromRaw", "private key must be 32 bytes"));
		const done = await xFromRaw(bytes);
		if (done.error != "") return Result.err(invalidKey("X25519PrivateKey.fromRaw", done.error));
		return Result.ok({ _key: done.key, _public: { _raw: done.raw, _key: done.pub } });
	}

	publicKey(): X25519PublicKey {
		return this._public;
	}
}

// Refuses a low-order public key, whose shared secret would be all zero (RFC 7748 6.1).
export async function sharedSecret(privateKey: X25519PrivateKey, publicKey: X25519PublicKey): Promise<Result<Buffer, CryptoError>> {
	const done = await xDerive(privateKey._key, publicKey._key);
	if (done.error != "") return Result.err(cryptoError(CryptoErrorKind.KeyDerivationFailed, "x25519.sharedSecret", "key agreement failed"));
	let any: uint8 = 0;
	for (let i = 0; i < done.value.length; i++) any = any | done.value[i];
	if (any == 0) return Result.err(cryptoError(CryptoErrorKind.KeyDerivationFailed, "x25519.sharedSecret", "key agreement failed"));
	return Result.ok(done.value);
}

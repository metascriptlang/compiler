import {
	fiat_25519_add, fiat_25519_carry, fiat_25519_carry_mul,
	fiat_25519_carry_square, fiat_25519_carry_scmul_121666,
	fiat_25519_from_bytes, fiat_25519_sub, fiat_25519_to_bytes,
} from "./field";
import { wipeBytes } from "./wipe";

struct FieldElement { limbs: uint32[10]; }

struct X25519Scratch {
	secret: uint8[32];
	coordinate: uint8[32];
	x1: FieldElement;
	x2: FieldElement;
	z2: FieldElement;
	x3: FieldElement;
	z3: FieldElement;
	t0: FieldElement;
	t1: FieldElement;
	t0Squared: FieldElement;
	t1Squared: FieldElement;
	delta: FieldElement;
	scaled: FieldElement;
	result: FieldElement;
	swap: uint32;
}

function zero(): FieldElement { return { limbs: [] }; }
function one(): FieldElement {
	let element = zero();
	element.limbs[0] = 1;
	return element;
}

function add(a: FieldElement, b: FieldElement): FieldElement {
	let loose = zero();
	let tight = zero();
	fiat_25519_add(
		(loose.limbs as Span<uint32> as Ptr<uint32>),
		(a.limbs as Span<uint32> as Ptr<uint32>),
		(b.limbs as Span<uint32> as Ptr<uint32>),
	);
	fiat_25519_carry(
		(tight.limbs as Span<uint32> as Ptr<uint32>),
		(loose.limbs as Span<uint32> as Ptr<uint32>),
	);
	return tight;
}

function subtract(a: FieldElement, b: FieldElement): FieldElement {
	let loose = zero();
	let tight = zero();
	fiat_25519_sub(
		(loose.limbs as Span<uint32> as Ptr<uint32>),
		(a.limbs as Span<uint32> as Ptr<uint32>),
		(b.limbs as Span<uint32> as Ptr<uint32>),
	);
	fiat_25519_carry(
		(tight.limbs as Span<uint32> as Ptr<uint32>),
		(loose.limbs as Span<uint32> as Ptr<uint32>),
	);
	return tight;
}

function multiply(a: FieldElement, b: FieldElement): FieldElement {
	let result = zero();
	fiat_25519_carry_mul(
		(result.limbs as Span<uint32> as Ptr<uint32>),
		(a.limbs as Span<uint32> as Ptr<uint32>),
		(b.limbs as Span<uint32> as Ptr<uint32>),
	);
	return result;
}

function square(a: FieldElement): FieldElement {
	let result = zero();
	fiat_25519_carry_square(
		(result.limbs as Span<uint32> as Ptr<uint32>),
		(a.limbs as Span<uint32> as Ptr<uint32>),
	);
	return result;
}

function multiply121666(a: FieldElement): FieldElement {
	let result = zero();
	fiat_25519_carry_scmul_121666(
		(result.limbs as Span<uint32> as Ptr<uint32>),
		(a.limbs as Span<uint32> as Ptr<uint32>),
	);
	return result;
}

function squareN(value: FieldElement, count: int32): FieldElement {
	let result = value;
	for (let i = 0; i < count; i++) { result = square(result); }
	return result;
}

function invert(value: FieldElement): FieldElement {
	let t0 = square(value);
	let t1 = multiply(squareN(t0, 2), value);
	t0 = multiply(t0, t1);
	t1 = multiply(t1, square(t0));
	t1 = multiply(t1, squareN(t1, 5));
	let t2 = multiply(squareN(t1, 10), t1);
	t2 = squareN(multiply(t2, squareN(t2, 20)), 10);
	t1 = multiply(t1, t2);
	t2 = multiply(squareN(t1, 50), t1);
	return multiply(
		squareN(multiply(t1, squareN(multiply(t2, squareN(t2, 100)), 50)), 5),
		t0,
	);
}

function conditionalSwap(
	ref a: FieldElement,
	ref b: FieldElement,
	swap: uint32,
): void {
	const mask = (0 - (swap as int32)) as uint32;
	for (let i = 0; i < 10; i++) {
		const difference = mask & (a.limbs[i] ^ b.limbs[i]);
		a.limbs[i] ^= difference;
		b.limbs[i] ^= difference;
	}
}

/** All pointers must address 32 bytes. Disjoint inputs are unchanged; output
 * may alias either or both inputs because they are copied before output writes.
 * Returns zero for a zero shared coordinate; callers reject it when needed. */
export function x25519ScalarMult(
	output: Ptr<uint8>,
	scalar: Ptr<uint8>,
	point: Ptr<uint8>,
): void {
	let scratch: X25519Scratch = {
		secret: [], coordinate: [],
		x1: zero(), x2: one(), z2: zero(), x3: zero(), z3: one(),
		t0: zero(), t1: zero(), t0Squared: zero(), t1Squared: zero(),
		delta: zero(), scaled: zero(), result: zero(), swap: 0,
	};
	defer wipeBytes(
		(scratch as Ptr<X25519Scratch> as Ptr<uint8>),
		sizeof(X25519Scratch) as uint64,
	);
	for (let i = 0; i < 32; i++) {
		scratch.secret[i] = scalar[i];
		scratch.coordinate[i] = point[i];
	}
	scratch.secret[0] &= 248;
	scratch.secret[31] = (scratch.secret[31] & 127) | 64;
	scratch.coordinate[31] &= 127;
	fiat_25519_from_bytes(
		(scratch.x1.limbs as Span<uint32> as Ptr<uint32>),
		(scratch.coordinate as Span<uint8> as Ptr<uint8>),
	);
	scratch.x3 = scratch.x1;
	for (let position = 254; position >= 0; position--) {
		const bit = ((scratch.secret[position >> 3] >>
			((position & 7) as uint8)) & 1) as uint32;
		scratch.swap ^= bit;
		conditionalSwap(scratch.x2, scratch.x3, scratch.swap);
		conditionalSwap(scratch.z2, scratch.z3, scratch.swap);
		scratch.swap = bit;
		scratch.t0 = subtract(scratch.x3, scratch.z3);
		scratch.t1 = subtract(scratch.x2, scratch.z2);
		scratch.x2 = add(scratch.x2, scratch.z2);
		scratch.z2 = add(scratch.x3, scratch.z3);
		scratch.z3 = multiply(scratch.t0, scratch.x2);
		scratch.z2 = multiply(scratch.z2, scratch.t1);
		scratch.t0Squared = square(scratch.t1);
		scratch.t1Squared = square(scratch.x2);
		scratch.x3 = add(scratch.z3, scratch.z2);
		scratch.z2 = subtract(scratch.z3, scratch.z2);
		scratch.x2 = multiply(scratch.t1Squared, scratch.t0Squared);
		scratch.delta = subtract(scratch.t1Squared, scratch.t0Squared);
		scratch.z2 = square(scratch.z2);
		scratch.scaled = multiply121666(scratch.delta);
		scratch.x3 = square(scratch.x3);
		scratch.z3 = multiply(scratch.x1, scratch.z2);
		scratch.z2 = multiply(scratch.delta, add(scratch.t0Squared, scratch.scaled));
	}
	conditionalSwap(scratch.x2, scratch.x3, scratch.swap);
	conditionalSwap(scratch.z2, scratch.z3, scratch.swap);
	scratch.result = multiply(scratch.x2, invert(scratch.z2));
	fiat_25519_to_bytes(
		output,
		(scratch.result.limbs as Span<uint32> as Ptr<uint32>),
	);
}

@include("runtime/core/buffer.h");

import { Buffer } from "std/core/buffer";

extern function outputPointer(buf: Buffer): Ptr<uint8> from "msBufferData";

export function newUninitOutputBuffer(length: int64): Buffer {
	return Buffer.allocUnsafe(length as number);
}

export function outputBytes(buf: Buffer): Ptr<uint8> {
	return outputPointer(buf);
}

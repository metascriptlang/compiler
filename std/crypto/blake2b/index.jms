/**
 * BLAKE2b on the JavaScript backend: the same surface as index.cms. WebCrypto has no BLAKE2, so every
 * form runs the portable code in `std/crypto/pure`, and the async forms call the `*Sync` forms.
 */

import { Buffer } from "std/core/buffer";
import { ByteInput } from "std/core/buffer/bytes";
import { bytesOf } from "../pure/bytes";
import { Blake2bState, newBlake2b, updateBlake2b, finishBlake2b, blake2bOf } from "../pure/blake2b";
import { CryptoError, CryptoErrorKind, cryptoError } from "../errors";
export { CryptoError, CryptoErrorKind } from "../errors";


function badHashSize(hashSize: int32, op: string): CryptoError | null {
	if (hashSize < 1 || hashSize > 64) {
		return cryptoError(CryptoErrorKind.InvalidInput, op, `hashSize must be 1-64, got ${hashSize}`);
	}
	return null;
}

// ===== One-shot Hashing =====

export function blake2bSync<D extends ByteInput>(data: D, hashSize: int32 = 32): Result<Buffer, CryptoError> {
	return blake2bSyncOwned(bytesOf(data), hashSize);
}

function blake2bSyncOwned(data: Buffer, hashSize: int32): Result<Buffer, CryptoError> {
	const bad = badHashSize(hashSize, "blake2b");
	if (bad != null) return Result.err(bad);
	return Result.ok(blake2bOf(hashSize, [], data) as Buffer);
}

export function blake2bKeyedSync<K extends ByteInput, D extends ByteInput>(keyBytes: K, data: D, hashSize: int32 = 32): Result<Buffer, CryptoError> {
	return blake2bKeyedSyncOwned(bytesOf(keyBytes), bytesOf(data), hashSize);
}

function blake2bKeyedSyncOwned(keyBytes: Buffer, data: Buffer, hashSize: int32): Result<Buffer, CryptoError> {
	const key = keyBytes;
	if (key.length < 1 || key.length > 64) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidKey, "blake2bKeyed", "key must be 1-64 bytes"));
	}
	const bad = badHashSize(hashSize, "blake2bKeyed");
	if (bad != null) return Result.err(bad);
	return Result.ok(blake2bOf(hashSize, key, data) as Buffer);
}

export function blake2b<D extends ByteInput>(data: D, hashSize: int32 = 32): Promise<Result<Buffer, CryptoError>> {
	return blake2bOwned(bytesOf(data), hashSize);
}

async function blake2bOwned(data: Buffer, hashSize: int32): Promise<Result<Buffer, CryptoError>> {
	return blake2bSyncOwned(data, hashSize);
}

export function blake2bKeyed<K extends ByteInput, D extends ByteInput>(keyBytes: K, data: D, hashSize: int32 = 32): Promise<Result<Buffer, CryptoError>> {
	return blake2bKeyedOwned(bytesOf(keyBytes), bytesOf(data), hashSize);
}

async function blake2bKeyedOwned(keyBytes: Buffer, data: Buffer, hashSize: int32): Promise<Result<Buffer, CryptoError>> {
	return blake2bKeyedSyncOwned(keyBytes, data, hashSize);
}

// ===== Streaming (sync only) =====

export class Blake2b {
	_state: Blake2bState;

	update<D extends ByteInput>(data: D): Blake2b {
		if (this._state.finished) throw new Error("Blake2b.update: the hasher already produced its digest");
		const bytes = bytesOf(data);
		updateBlake2b(this._state, bytes, 0, bytes.length as int32);
		return this;
	}

	digest(): Buffer {
		if (this._state.finished) throw new Error("Blake2b.digest: the hasher already produced its digest");
		return finishBlake2b(this._state) as Buffer;
	}
}

export function createBlake2b(hashSize: int32 = 32): Result<Blake2b, CryptoError> {
	const bad = badHashSize(hashSize, "createBlake2b");
	if (bad != null) return Result.err(bad);
	return Result.ok({ _state: newBlake2b(hashSize, []) });
}

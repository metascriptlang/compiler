// std/crypto — Raiser tier. Hash family only (the surface the compiler
// itself reaches): kernels are host bridges over the same runtime/crypto/
// hash.c + mbedtls TUs index.cms @compiles into this binary. HMAC, random, key
// derivation and the cipher/AEAD submodules are NOT carried on this tier
// yet — nothing in the compiler imports them.
//
// The names and result types are index.cms's. Raiser runs an async function's body inline
// (card raiser-async-call-runs-inline), which changes nothing for a body that cannot throw
// after a suspension, and these bodies never suspend.

import { Buffer } from "std/core/buffer";
import { Bytes } from "std/core/buffer/bytes";
import { encodeHex, encodeBase64 } from "../core/encoding";
import { CryptoError, CryptoErrorKind, hashFailed } from "./errors";
export { CryptoError, CryptoErrorKind, cryptoError } from "./errors";

extern function msCryptoInit(): boolean from "msCryptoInit";
extern function msCryptoCleanup(): void from "msCryptoCleanup";
extern function digestOfText(algorithm: string, data: string): Buffer from "msCryptoDigest";
extern function digestOfBytes(algorithm: string, data: Readonly<uint8[]>): Buffer from "msCryptoDigest";

export type HashAlgorithm =
	| "sha256" | "sha512" | "sha384" | "sha224"
	| "sha1" | "md5" | "ripemd160"
	| "sha3-224" | "sha3-256" | "sha3-384" | "sha3-512";

export function init(): boolean {
	return msCryptoInit();
}

export function cleanup(): void {
	msCryptoCleanup();
}

export function digestSync(algorithm: HashAlgorithm, data: Bytes): Result<Buffer, CryptoError> {
	const out = typeof data == "string" ? digestOfText(algorithm, data) : digestOfBytes(algorithm, data);
	if (out.length == 0) {
		return Result.err(hashFailed(algorithm, "Hash computation failed"));
	}
	return Result.ok(out);
}

export async function digest(algorithm: HashAlgorithm, data: Bytes): Promise<Result<Buffer, CryptoError>> {
	return digestSync(algorithm, data);
}

export function sha256Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("sha256", data); }
export function sha384Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("sha384", data); }
export function sha512Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("sha512", data); }
export function sha1Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("sha1", data); }
export function md5Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("md5", data); }

export async function sha256(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("sha256", data); }
export async function sha384(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("sha384", data); }
export async function sha512(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("sha512", data); }
export async function sha1(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("sha1", data); }
export async function md5(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("md5", data); }

export function toHex(data: Bytes): string {
	if (typeof data == "string") return data.asBytes().encodeHex();
	return data.encodeHex();
}

export function toBase64(data: Bytes): string {
	if (typeof data == "string") return data.asBytes().encodeBase64();
	return data.encodeBase64();
}

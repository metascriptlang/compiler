@include("runtime/crypto/hash.h");

import { Buffer } from "std/core/buffer";
import { Bytes, rawString, rawBuffer } from "std/core/buffer/bytes";
import { encodedHash, encodedHmac, encodedHashFinal, encodedHmacFinal } from "./encodingNative";

// mbedTLS include paths + minimal config
@passC("-Iruntime/crypto");
@passC("-Ivendor/mbedtls/tf-psa-crypto/include");
@passC("-Ivendor/mbedtls/tf-psa-crypto/core");
@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/include");
@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/src");
@passC("-DMBEDTLS_CONFIG_FILE=\"<mbedtls/mbedtlsConfig.h>\"");

// Our crypto implementation
@compile("runtime/crypto/hash.c");
// psa_util.c is NOT compiled here: nothing in this module references any of its
// exports (mbedtls_psa_get_random, mbedtls_ecdsa_{raw_to_der,der_to_raw}, …) —
// its only callers are the PSA/TLS vendor sources, which std/crypto/tls owns.
// Compiling it here made this module depend on symbols it does not compile
// (psa_generate_random from psa_crypto.c, mbedtls_asn1_* from asn1{parse,write}.c),
// all of which live in std/crypto/tls. See that file for the owner list.
//
// md.c still *references* three psa_util.c symbols from a function that is
// compiled but never called here, so the COFF linker demands them even though
// ELF strips the section. psaMdStubs.c supplies weak definitions; when
// std/crypto/tls is alive its psa_util.c provides the strong ones and wins.
@compile("runtime/crypto/psaMdStubs.c");

// mbedTLS vendor sources (hash algorithms)
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/md.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/sha256.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/sha512.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/sha1.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/sha3.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/md5.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/ripemd160.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/platform_util.c");
// mbedtls_calloc / mbedtls_free live here and are real functions, not macros,
// because the config sets MBEDTLS_PLATFORM_MEMORY. md.c and the sha256/sha512
// self-tests call them, so this module does not link without platform.c.
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/platform.c");

// C bindings (private — wrapped by exported functions)

// Initialization
extern function msCryptoInit(): boolean;
extern function msCryptoCleanup(): void;

// Hashing
extern function msCryptoHashBuffer(algorithm: string, data: string): string;

// HMAC
extern function msCryptoHmacBuffer(algorithm: string, key: string, data: string): string;

// Random
extern function msCryptoRandomBytes(size: number): string;
extern function msCryptoRandomInt(min: number, max: number): number;
extern function msCryptoRandomUuid(): string;

// Timing-safe comparison
extern function msCryptoTimingSafeEqual(a: string, b: string): boolean;

// Streaming hash (int64 handle wrappers)
extern function msCryptoHashInitHandle(algorithm: string): int64;
extern function msCryptoHashUpdateHandle(ctx: int64, data: string): void;
extern function msCryptoHashFinalBufferHandle(ctx: int64): string;
extern function msCryptoHashFreeHandle(ctx: int64): void;

// Streaming HMAC (int64 handle wrappers)
extern function msCryptoHmacInitHandle(algorithm: string, key: string): int64;
extern function msCryptoHmacUpdateHandle(ctx: int64, data: string): void;
extern function msCryptoHmacFinalBufferHandle(ctx: int64): string;
extern function msCryptoHmacFreeHandle(ctx: int64): void;

// Utility
extern function msCryptoIsHashSupported(algorithm: string): boolean;

// Key Derivation
extern function msCryptoPbkdf2(password: string, salt: string, iterations: int32, keyLength: int32, digest: string): string;
extern function msCryptoHkdf(algorithm: string, ikm: string, salt: string, info: string, length: int32): string;

// ===== Types =====

export type HashAlgorithm =
	| "sha256" | "sha512" | "sha384" | "sha224"
	| "sha1" | "md5" | "ripemd160"
	| "sha3-224" | "sha3-256" | "sha3-384" | "sha3-512";

export type HashEncoding = "hex" | "base64";

import { CryptoError, CryptoErrorKind, hashFailed, hmacFailed, randomFailed, keyDerivationFailed } from "./errors";
export { CryptoError, CryptoErrorKind, cryptoError } from "./errors";

// ===== Initialization =====

export function init(): boolean {
	return msCryptoInit();
}

export function cleanup(): void {
	msCryptoCleanup();
}

// ===== Hash Functions =====

export function hash(algorithm: string, data: Bytes, encoding: string = "hex"): Result<string, CryptoError> {
	const result = encodedHash(algorithm, rawString(data), encoding);
	if (result == "") return Result.err(hashFailed(algorithm, "Hash computation failed"));
	return Result.ok(result);
}

export function sha256(data: Bytes, encoding: string = "hex"): Result<string, CryptoError> { return hash("sha256", data, encoding); }
export function sha512(data: Bytes, encoding: string = "hex"): Result<string, CryptoError> { return hash("sha512", data, encoding); }
export function sha384(data: Bytes, encoding: string = "hex"): Result<string, CryptoError> { return hash("sha384", data, encoding); }
export function sha1(data: Bytes, encoding: string = "hex"): Result<string, CryptoError> { return hash("sha1", data, encoding); }
export function md5(data: Bytes, encoding: string = "hex"): Result<string, CryptoError> { return hash("md5", data, encoding); }

export function hashBuffer(algorithm: string, data: Bytes): Result<Buffer, CryptoError> {
	const result = msCryptoHashBuffer(algorithm, rawString(data));
	if (result == "") {
		return Result.err(hashFailed(algorithm, "Hash computation failed"));
	}
	return Result.ok(rawBuffer(result));
}

// ===== HMAC Functions =====

export function hmac(
	algorithm: string,
	key: Bytes,
	data: Bytes,
	encoding: string = "hex"
): Result<string, CryptoError> {
	const result = encodedHmac(algorithm, rawString(key), rawString(data), encoding);
	if (result == "") return Result.err(hmacFailed(algorithm, "HMAC computation failed"));
	return Result.ok(result);
}

export function hmacBuffer(algorithm: string, key: Bytes, data: Bytes): Result<Buffer, CryptoError> {
	const result = msCryptoHmacBuffer(algorithm, rawString(key), rawString(data));
	if (result == "") {
		return Result.err(hmacFailed(algorithm, "HMAC computation failed"));
	}
	return Result.ok(rawBuffer(result));
}

// ===== Random Functions =====

export function randomBytes(size: number): Result<Buffer, CryptoError> {
	const result = msCryptoRandomBytes(size);
	if (result == "") {
		return Result.err(randomFailed("Random byte generation failed"));
	}
	return Result.ok(rawBuffer(result));
}

export function randomInt(min: number, max: number): Result<number, CryptoError> {
	const result = msCryptoRandomInt(min, max);
	if (result == -1) {
		return Result.err(randomFailed("Random integer generation failed"));
	}
	return Result.ok(result);
}

export function randomUUID(): Result<string, CryptoError> {
	const result = msCryptoRandomUuid();
	if (result == "") {
		return Result.err(randomFailed("UUID generation failed"));
	}
	return Result.ok(result);
}

// ===== Timing-Safe Comparison =====

export function timingSafeEqual(a: Bytes, b: Bytes): boolean {
	return msCryptoTimingSafeEqual(rawString(a), rawString(b));
}

// ===== Streaming Hash =====

export class Hasher {
	_ctx: int64;

	static create(algorithm: string): Hasher {
		const ctx = msCryptoHashInitHandle(algorithm);
		return { _ctx: ctx };
	}

	update(data: Bytes): Hasher {
		if (this._ctx != 0) {
			msCryptoHashUpdateHandle(this._ctx, rawString(data));
		}
		return this;
	}

	digest(encoding: string = "hex"): string {
		if (this._ctx == 0) {
			return "";
		}
		const ctx = this._ctx;
		this._ctx = 0;
		return encodedHashFinal(ctx, encoding);
	}

	digestBuffer(): Buffer {
		if (this._ctx == 0) {
			return rawBuffer("");
		}
		const result = msCryptoHashFinalBufferHandle(this._ctx);
		this._ctx = 0;
		return rawBuffer(result);
	}

	onDestroy(): void {
		if (this._ctx != 0) {
			msCryptoHashFreeHandle(this._ctx);
			this._ctx = 0;
		}
	}
}

// ===== Streaming HMAC =====

export class Hmac {
	_ctx: int64;

	static create(algorithm: string, key: Bytes): Hmac {
		const ctx = msCryptoHmacInitHandle(algorithm, rawString(key));
		return { _ctx: ctx };
	}

	update(data: Bytes): Hmac {
		if (this._ctx != 0) {
			msCryptoHmacUpdateHandle(this._ctx, rawString(data));
		}
		return this;
	}

	digest(encoding: string = "hex"): string {
		if (this._ctx == 0) {
			return "";
		}
		const ctx = this._ctx;
		this._ctx = 0;
		return encodedHmacFinal(ctx, encoding);
	}

	digestBuffer(): Buffer {
		if (this._ctx == 0) {
			return rawBuffer("");
		}
		const result = msCryptoHmacFinalBufferHandle(this._ctx);
		this._ctx = 0;
		return rawBuffer(result);
	}

	onDestroy(): void {
		if (this._ctx != 0) {
			msCryptoHmacFreeHandle(this._ctx);
			this._ctx = 0;
		}
	}
}

// ===== Factory Functions =====

export function createHash(algorithm: string): Hasher {
	return Hasher.create(algorithm);
}

export function createHmac(algorithm: string, key: Bytes): Hmac {
	return Hmac.create(algorithm, key);
}

// ===== Utility =====

export function getHashes(): string[] {
	return ["sha256", "sha512", "sha384", "sha224", "sha1", "md5", "ripemd160",
		"sha3-256", "sha3-384", "sha3-512", "sha3-224"];
}

export function isHashSupported(algorithm: string): boolean {
	return msCryptoIsHashSupported(algorithm);
}

// ===== Encoding =====

import { encodeHex, decodeHexString, encodeBase64, decodeBase64String } from "../core/encoding";
import { emptyEncoding } from "../core/encoding/output";

export function toHex(data: Bytes): string {
	if (typeof data == "string") {
		if (data.asBytes().length == 0) return emptyEncoding;
		return data.asBytes().encodeHex();
	}
	if (data.length == 0) return emptyEncoding;
	return data.encodeHex();
}

export function fromHex(hex: string): Buffer {
	if (hex.asBytes().length == 0) return rawBuffer("");
	return rawBuffer(hex.decodeHexString());
}

export function toBase64(data: Bytes): string {
	if (typeof data == "string") {
		if (data.asBytes().length == 0) return emptyEncoding;
		return data.asBytes().encodeBase64();
	}
	if (data.length == 0) return emptyEncoding;
	return data.encodeBase64();
}

export function fromBase64(b64: string): Buffer {
	if (b64.asBytes().length == 0) return rawBuffer("");
	return rawBuffer(b64.decodeBase64String());
}

// ===== Key Derivation =====

export function pbkdf2(password: Bytes, salt: Bytes, iterations: int32, keyLength: int32, digest: string): Result<Buffer, CryptoError> {
	if (digest == "") digest = "sha256";
	const result = msCryptoPbkdf2(rawString(password), rawString(salt), iterations, keyLength, digest);
	if (result.byteLength == 0) return Result.err(keyDerivationFailed("pbkdf2", "key derivation failed"));
	return Result.ok(rawBuffer(result));
}

export function hkdf(algorithm: string, ikm: Bytes, salt: Bytes, info: Bytes, length: int32): Result<Buffer, CryptoError> {
	if (algorithm == "") algorithm = "sha256";
	const result = msCryptoHkdf(algorithm, rawString(ikm), rawString(salt), rawString(info), length);
	if (result.byteLength == 0) return Result.err(keyDerivationFailed("hkdf", "key derivation failed"));
	return Result.ok(rawBuffer(result));
}

// ===== Async Versions (spawn to worker thread for heavy operations) =====

export async function pbkdf2Async(password: string, salt: string, iterations: int32, keyLength: int32, digest: string): Promise<Result<Buffer, CryptoError>> {
	return await spawn(() => { return pbkdf2(password, salt, iterations, keyLength, digest); });
}

export async function hashAsync(algorithm: string, data: string, encoding: string): Promise<Result<string, CryptoError>> {
	return await spawn(() => { return hash(algorithm, data, encoding); });
}

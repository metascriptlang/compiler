@include("runtime/crypto/hash.h");

import { Buffer } from "std/core/buffer";
import { Bytes, rawString, rawBuffer } from "std/core/buffer/bytes";
import { newUninitOutputBuffer, outputBytes } from "./outputBuffer";
// The Raiser host table and the websocket handshake call msCryptoHashString, which this import carries.
import "./encodingNative";

// mbedTLS include paths + minimal config
@passC("-Iruntime/crypto");
@passC("-Ivendor/mbedtls/tf-psa-crypto/include");
@passC("-Ivendor/mbedtls/tf-psa-crypto/core");
@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/include");
@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/src");
@passC("-DMBEDTLS_CONFIG_FILE=\"<mbedtls/mbedtlsConfig.h>\"");
// Hardware SHA-2 where the CPU has it, detected at run time; the vendor build_info reads
// psa/crypto_config.h, not mbedtlsConfig.h, so these two are set on the command line.
@passC("-DMBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT");
@passC("-DMBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT");

// Our crypto implementation
@compile("runtime/crypto/hash.c");
// psa_util.c is NOT compiled here: nothing in this module references any of its
// exports (mbedtls_psa_get_random, mbedtls_ecdsa_{raw_to_der,der_to_raw}, …) —
// its only callers are the PSA/TLS vendor sources, which std/crypto/tls owns.
// Compiling it here made this module depend on symbols it does not compile
// (psa_generate_random from psa_crypto.c, mbedtls_asn1_* from asn1{parse,write}.c),
// all of which live in std/crypto/tls. See that file for the owner list.
//
// md.c still *references* three psa_util.c symbols from a function that is
// compiled but never called here, so the COFF linker demands them even though
// ELF strips the section. psaMdStubs.c supplies weak definitions; when
// std/crypto/tls is alive its psa_util.c provides the strong ones and wins.
@compile("runtime/crypto/psaMdStubs.c");

// mbedTLS vendor sources (hash algorithms)
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/md.c");
@compile("runtime/crypto/sha256Hw.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/sha512.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/sha1.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/sha3.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/md5.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/ripemd160.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/platform_util.c");
// mbedtls_calloc / mbedtls_free live here and are real functions, not macros,
// because the config sets MBEDTLS_PLATFORM_MEMORY. md.c and the sha256/sha512
// self-tests call them, so this module does not link without platform.c.
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/platform.c");

// C bindings (private — wrapped by exported functions)

// Initialization
extern function msCryptoInit(): boolean;
extern function msCryptoCleanup(): void;

// Hashing
extern function msCryptoHashSpanInto(algorithm: string, data: Readonly<Span<uint8>>, output: Ptr<uint8>, capacity: int64): int64;

// HMAC
extern function msCryptoHmacSpanInto(algorithm: string, key: Readonly<Span<uint8>>, data: Readonly<Span<uint8>>, output: Ptr<uint8>, capacity: int64): int64;

// Random
extern function msCryptoRandomBytes(size: number): string;
extern function msCryptoRandomIntInto(min: number, max: number, ref out: int64): int32;
extern function msCryptoRandomUuid(): string;

// Timing-safe comparison
extern function msCryptoTimingSafeEqual(a: string, b: string): boolean;

// Streaming hash (int64 handle wrappers)
extern function msCryptoHashInitHandle(algorithm: string): int64;
extern function msCryptoHashUpdateHandle(ctx: int64, data: string): void;
extern function msCryptoHashFinalBufferHandle(ctx: int64): string;
extern function msCryptoHashFreeHandle(ctx: int64): void;

// Streaming HMAC (int64 handle wrappers)
extern function msCryptoHmacInitHandle(algorithm: string, key: string): int64;
extern function msCryptoHmacUpdateHandle(ctx: int64, data: string): void;
extern function msCryptoHmacFinalBufferHandle(ctx: int64): string;
extern function msCryptoHmacFreeHandle(ctx: int64): void;

// Utility
extern function msCryptoIsHashSupported(algorithm: string): boolean;
extern function msCryptoHashSize(algorithm: string): number;

// Key Derivation
extern function msCryptoPbkdf2(password: string, salt: string, iterations: int32, keyLength: int32, digest: string): string;
extern function msCryptoHkdf(algorithm: string, ikm: string, salt: string, info: string, length: int32): string;

// ===== Types =====

export type HashAlgorithm =
	| "sha256" | "sha512" | "sha384" | "sha224"
	| "sha1" | "md5" | "ripemd160"
	| "sha3-224" | "sha3-256" | "sha3-384" | "sha3-512";

import { CryptoError, CryptoErrorKind, hashFailed, hmacFailed, randomFailed, keyDerivationFailed, invalidInput, invalidEncoding } from "./errors";
export { CryptoError, CryptoErrorKind, cryptoError } from "./errors";

// ===== Initialization =====

export function init(): boolean {
	return msCryptoInit();
}

export function cleanup(): void {
	msCryptoCleanup();
}

// ===== Hash Functions =====

export function digestSync(algorithm: HashAlgorithm, data: Bytes): Result<Buffer, CryptoError> {
	const size = msCryptoHashSize(algorithm) as int64;
	const out = newUninitOutputBuffer(size);
	if (size == 0 || msCryptoHashSpanInto(algorithm, typeof data == "string" ? data.asBytes() : data, outputBytes(out), size) != size) {
		return Result.err(hashFailed(algorithm, "Hash computation failed"));
	}
	return Result.ok(out);
}

export async function digest(algorithm: HashAlgorithm, data: Bytes): Promise<Result<Buffer, CryptoError>> {
	return digestSync(algorithm, data);
}

export function sha256Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("sha256", data); }
export function sha384Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("sha384", data); }
export function sha512Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("sha512", data); }
export function sha1Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("sha1", data); }
export function md5Sync(data: Bytes): Result<Buffer, CryptoError> { return digestSync("md5", data); }

export async function sha256(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("sha256", data); }
export async function sha384(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("sha384", data); }
export async function sha512(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("sha512", data); }
export async function sha1(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("sha1", data); }
export async function md5(data: Bytes): Promise<Result<Buffer, CryptoError>> { return digestSync("md5", data); }

// ===== HMAC Functions =====

export function hmacSync(algorithm: HashAlgorithm, key: Bytes, data: Bytes): Result<Buffer, CryptoError> {
	const size = msCryptoHashSize(algorithm) as int64;
	const out = newUninitOutputBuffer(size);
	if (size == 0 || msCryptoHmacSpanInto(algorithm, typeof key == "string" ? key.asBytes() : key, typeof data == "string" ? data.asBytes() : data, outputBytes(out), size) != size) {
		return Result.err(hmacFailed(algorithm, "HMAC computation failed"));
	}
	return Result.ok(out);
}

export async function hmac(algorithm: HashAlgorithm, key: Bytes, data: Bytes): Promise<Result<Buffer, CryptoError>> {
	return hmacSync(algorithm, key, data);
}

// ===== Random Functions =====

export function randomBytesSync(size: number): Result<Buffer, CryptoError> {
	const result = msCryptoRandomBytes(size);
	if (result == "" && size != 0) {
		return Result.err(randomFailed("Random byte generation failed"));
	}
	return Result.ok(rawBuffer(result));
}

export async function randomBytes(size: number): Promise<Result<Buffer, CryptoError>> {
	return randomBytesSync(size);
}

const RANDOM_INT_BAD_MIN = 1;
const RANDOM_INT_BAD_MAX = 2;
const RANDOM_INT_EMPTY_RANGE = 3;
const RANDOM_INT_RANGE_TOO_WIDE = 4;
const RANDOM_INT_SOURCE_FAILED = 5;

export function randomIntSync(min: number, max: number): Result<number, CryptoError> {
	let drawn: int64 = 0;
	const status = msCryptoRandomIntInto(min, max, drawn);
	if (status == 0) return Result.ok(drawn as number);
	if (status == RANDOM_INT_BAD_MIN) return Result.err(invalidInput("random", "min must be a safe integer"));
	if (status == RANDOM_INT_BAD_MAX) return Result.err(invalidInput("random", "max must be a safe integer"));
	if (status == RANDOM_INT_EMPTY_RANGE) return Result.err(invalidInput("random", "max must be greater than min"));
	if (status == RANDOM_INT_RANGE_TOO_WIDE) return Result.err(invalidInput("random", "max - min must be less than 2^48"));
	if (status == RANDOM_INT_SOURCE_FAILED) return Result.err(randomFailed("Random integer generation failed"));
	throw new Error(`randomInt: unhandled status ${status}`);
}

export async function randomInt(min: number, max: number): Promise<Result<number, CryptoError>> {
	return randomIntSync(min, max);
}

export function randomUUIDSync(): Result<string, CryptoError> {
	const result = msCryptoRandomUuid();
	if (result == "") {
		return Result.err(randomFailed("UUID generation failed"));
	}
	return Result.ok(result);
}

export async function randomUUID(): Promise<Result<string, CryptoError>> {
	return randomUUIDSync();
}

// ===== Timing-Safe Comparison =====

export function timingSafeEqual(a: Bytes, b: Bytes): boolean {
	return msCryptoTimingSafeEqual(rawString(a), rawString(b));
}

// ===== Streaming Hash =====

export class Hasher {
	_ctx: int64;

	static create(algorithm: HashAlgorithm): Hasher {
		const ctx = msCryptoHashInitHandle(algorithm);
		if (ctx == 0) throw new Error(`createHash: could not start "${algorithm}"`);
		return { _ctx: ctx };
	}

	update(data: Bytes): Hasher {
		if (this._ctx != 0) {
			msCryptoHashUpdateHandle(this._ctx, rawString(data));
		}
		return this;
	}

	digest(): Buffer {
		if (this._ctx == 0) {
			return rawBuffer("");
		}
		const result = msCryptoHashFinalBufferHandle(this._ctx);
		this._ctx = 0;
		return rawBuffer(result);
	}

	onDestroy(): void {
		if (this._ctx != 0) {
			msCryptoHashFreeHandle(this._ctx);
			this._ctx = 0;
		}
	}
}

// ===== Streaming HMAC =====

export class Hmac {
	_ctx: int64;

	static create(algorithm: HashAlgorithm, key: Bytes): Hmac {
		const ctx = msCryptoHmacInitHandle(algorithm, rawString(key));
		if (ctx == 0) throw new Error(`createHmac: could not start "${algorithm}"`);
		return { _ctx: ctx };
	}

	update(data: Bytes): Hmac {
		if (this._ctx != 0) {
			msCryptoHmacUpdateHandle(this._ctx, rawString(data));
		}
		return this;
	}

	digest(): Buffer {
		if (this._ctx == 0) {
			return rawBuffer("");
		}
		const result = msCryptoHmacFinalBufferHandle(this._ctx);
		this._ctx = 0;
		return rawBuffer(result);
	}

	onDestroy(): void {
		if (this._ctx != 0) {
			msCryptoHmacFreeHandle(this._ctx);
			this._ctx = 0;
		}
	}
}

// ===== Factory Functions =====

export function createHash(algorithm: HashAlgorithm): Hasher {
	return Hasher.create(algorithm);
}

export function createHmac(algorithm: HashAlgorithm, key: Bytes): Hmac {
	return Hmac.create(algorithm, key);
}

// ===== Utility =====

export function getHashes(): HashAlgorithm[] {
	return ["sha256", "sha512", "sha384", "sha224", "sha1", "md5", "ripemd160",
		"sha3-256", "sha3-384", "sha3-512", "sha3-224"];
}

export function isHashSupported(algorithm: string): boolean {
	return msCryptoIsHashSupported(algorithm);
}

// ===== Encoding =====

import { encodeHex, decodeHexString, encodeBase64, decodeBase64String } from "../core/encoding";

export function toHex(data: Bytes): string {
	if (typeof data == "string") return data.asBytes().encodeHex();
	return data.encodeHex();
}

export function fromHex(hex: string): Result<Buffer, CryptoError> {
	if (hex.asBytes().length == 0) return Result.ok(rawBuffer(""));
	const raw = hex.decodeHexString();
	if (raw.asBytes().length == 0) return Result.err(invalidEncoding("fromHex", "not an even-length hexadecimal string"));
	return Result.ok(rawBuffer(raw));
}

export function toBase64(data: Bytes): string {
	if (typeof data == "string") return data.asBytes().encodeBase64();
	return data.encodeBase64();
}

export function fromBase64(b64: string): Result<Buffer, CryptoError> {
	if (b64.asBytes().length == 0) return Result.ok(rawBuffer(""));
	const raw = b64.decodeBase64String();
	if (raw.asBytes().length == 0) return Result.err(invalidEncoding("fromBase64", "not canonical padded base64"));
	return Result.ok(rawBuffer(raw));
}

// ===== Key Derivation =====

export function pbkdf2Sync(password: Bytes, salt: Bytes, iterations: int32, keyLength: int32, digest: HashAlgorithm): Result<Buffer, CryptoError> {
	if (iterations < 1) return Result.err(invalidInput("pbkdf2", "iterations must be at least 1"));
	if (keyLength < 1 || keyLength > 1048576) return Result.err(invalidInput("pbkdf2", "keyLength must be between 1 and 1048576"));
	const result = msCryptoPbkdf2(rawString(password), rawString(salt), iterations, keyLength, digest);
	if (result.byteLength == 0) return Result.err(keyDerivationFailed("pbkdf2", "key derivation failed"));
	return Result.ok(rawBuffer(result));
}

export async function pbkdf2(password: Bytes, salt: Bytes, iterations: int32, keyLength: int32, digest: HashAlgorithm): Promise<Result<Buffer, CryptoError>> { return pbkdf2Sync(password, salt, iterations, keyLength, digest); }

export function hkdfSync(algorithm: HashAlgorithm, ikm: Bytes, salt: Bytes, info: Bytes, length: int32): Result<Buffer, CryptoError> {
	if (length < 1) return Result.err(invalidInput("hkdf", "length must be at least 1"));
	const maxLength = 255 * msCryptoHashSize(algorithm);
	if (length > maxLength) return Result.err(invalidInput("hkdf", `length must be at most ${maxLength} for ${algorithm}`));
	const result = msCryptoHkdf(algorithm, rawString(ikm), rawString(salt), rawString(info), length);
	if (result.byteLength == 0) return Result.err(keyDerivationFailed("hkdf", "key derivation failed"));
	return Result.ok(rawBuffer(result));
}

export async function hkdf(algorithm: HashAlgorithm, ikm: Bytes, salt: Bytes, info: Bytes, length: int32): Promise<Result<Buffer, CryptoError>> { return hkdfSync(algorithm, ikm, salt, info, length); }

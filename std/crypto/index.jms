/**
 * Crypto, JavaScript backend: the surface of index.cms, run by the MetaScript port in std/crypto/pure.
 *
 * The asynchronous digests, HMAC, PBKDF2 and HKDF go to `globalThis.crypto.subtle` when it exists and implements
 * the hash (SHA-1, SHA-256, SHA-384, SHA-512); otherwise, as on a browser page that is not a secure context, they
 * run the port and give the bytes the `*Sync` form gives.
 */

import { Buffer } from "std/core/buffer";
import { ByteInput } from "std/core/buffer/bytes";
when (!nodejs) {
	import { bytesOf } from "./pure/bytes";
}
import { CryptoError, hashFailed, hmacFailed, keyDerivationFailed } from "./errors";
import { HashAlgorithm, digestSync, hmacSync } from "./pure/coreNative";
import { pbkdf2Sync, hkdfSync, pbkdf2Refusal, hkdfRefusal } from "./pure/kdfNative";
export {
	HashAlgorithm, randomBytesSync, randomBytes, randomIntSync, randomInt, randomUUIDSync, randomUUID, timingSafeEqual,
	init, cleanup, digestSync, hmacSync, sha256Sync, sha384Sync, sha512Sync, sha1Sync, md5Sync, Hasher, Hmac,
	createHash, createHmac, getHashes, isHashSupported, toHex, fromHex, toBase64, fromBase64,
} from "./pure/coreNative";
export { pbkdf2Sync, hkdfSync } from "./pure/kdfNative";
export { CryptoError, CryptoErrorKind, cryptoError } from "./errors";

@emit(`function msWcHasSubtle() {
	const c = globalThis.crypto;
	return !!(c && c.subtle);
}
async function msWcRun(job) {
	try {
		return { value: await job(globalThis.crypto.subtle), error: "" };
	} catch (e) {
		return { value: new ArrayBuffer(0), error: String(e && e.message ? e.message : e) };
	}
}
function msWcDigest(name, data) {
	return msWcRun((s) => s.digest(name, Uint8Array.from(data)));
}
function msWcHmac(name, key, data) {
	return msWcRun(async (s) => {
		const k = await s.importKey("raw", Uint8Array.from(key), { name: "HMAC", hash: name }, false, ["sign"]);
		return s.sign("HMAC", k, Uint8Array.from(data));
	});
}
function msWcPbkdf2(name, password, salt, iterations, length) {
	return msWcRun(async (s) => {
		const k = await s.importKey("raw", Uint8Array.from(password), "PBKDF2", false, ["deriveBits"]);
		return s.deriveBits({ name: "PBKDF2", hash: name, salt: Uint8Array.from(salt), iterations }, k, length * 8);
	});
}
function msWcHkdf(name, ikm, salt, info, length) {
	return msWcRun(async (s) => {
		const k = await s.importKey("raw", Uint8Array.from(ikm), "HKDF", false, ["deriveBits"]);
		return s.deriveBits({ name: "HKDF", hash: name, salt: Uint8Array.from(salt), info: Uint8Array.from(info) }, k, length * 8);
	});
}`);

interface Settled {
	value: ArrayBuffer;
	error: string;
}

extern function wcHasSubtle(): boolean from "msWcHasSubtle()";
extern function wcDigest(name: string, data: Readonly<uint8[]>): Promise<Settled> from "msWcDigest(#, #)";
extern function wcHmac(name: string, key: Readonly<uint8[]>, data: Readonly<uint8[]>): Promise<Settled> from "msWcHmac(#, #, #)";
extern function wcPbkdf2(name: string, password: Readonly<uint8[]>, salt: Readonly<uint8[]>, iterations: number, length: number): Promise<Settled> from "msWcPbkdf2(#, #, #, #, #)";
extern function wcHkdf(name: string, ikm: Readonly<uint8[]>, salt: Readonly<uint8[]>, info: Readonly<uint8[]>, length: number): Promise<Settled> from "msWcHkdf(#, #, #, #, #)";

/** The WebCrypto name of a hash `crypto.subtle` runs here, or "" when the port runs it. */
function subtleName(algorithm: string): string {
	if (!wcHasSubtle()) return "";
	if (algorithm == "sha256") return "SHA-256";
	if (algorithm == "sha384") return "SHA-384";
	if (algorithm == "sha512") return "SHA-512";
	if (algorithm == "sha1") return "SHA-1";
	return "";
}

export function digest<D extends ByteInput>(algorithm: HashAlgorithm, data: D): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(digestSync(algorithm, data));
	} else {
		return digestOwned(algorithm, bytesOf(data));
	}
}

async function digestOwned(algorithm: HashAlgorithm, data: uint8[]): Promise<Result<Buffer, CryptoError>> {
	const name = subtleName(algorithm);
	if (name == "") return digestSync(algorithm, data);
	const done = await wcDigest(name, data);
	if (done.error != "") return Result.err(hashFailed(algorithm, done.error));
	return Result.ok(new Buffer(done.value));
}

export function sha256<D extends ByteInput>(data: D): Promise<Result<Buffer, CryptoError>> { return digest("sha256", data); }
export function sha384<D extends ByteInput>(data: D): Promise<Result<Buffer, CryptoError>> { return digest("sha384", data); }
export function sha512<D extends ByteInput>(data: D): Promise<Result<Buffer, CryptoError>> { return digest("sha512", data); }
export function sha1<D extends ByteInput>(data: D): Promise<Result<Buffer, CryptoError>> { return digest("sha1", data); }
export function md5<D extends ByteInput>(data: D): Promise<Result<Buffer, CryptoError>> { return digest("md5", data); }

export function hmac<K extends ByteInput, D extends ByteInput>(algorithm: HashAlgorithm, key: K, data: D): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(hmacSync(algorithm, key, data));
	} else {
		return hmacOwned(algorithm, bytesOf(key), bytesOf(data));
	}
}

async function hmacOwned(algorithm: HashAlgorithm, key: uint8[], data: uint8[]): Promise<Result<Buffer, CryptoError>> {
	const name = subtleName(algorithm);
	// WebCrypto refuses an empty HMAC key, which HMAC itself allows.
	if (name == "" || key.length == 0) return hmacSync(algorithm, key, data);
	const done = await wcHmac(name, key, data);
	if (done.error != "") return Result.err(hmacFailed(algorithm, done.error));
	return Result.ok(new Buffer(done.value));
}

export function pbkdf2<P extends ByteInput, S extends ByteInput>(password: P, salt: S, iterations: int32, keyLength: int32, digest: HashAlgorithm): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(pbkdf2Sync(password, salt, iterations, keyLength, digest));
	} else {
		return pbkdf2Owned(bytesOf(password), bytesOf(salt), iterations, keyLength, digest);
	}
}

async function pbkdf2Owned(password: uint8[], salt: uint8[], iterations: int32, keyLength: int32, digest: HashAlgorithm): Promise<Result<Buffer, CryptoError>> {
	const name = subtleName(digest);
	if (name == "") return pbkdf2Sync(password, salt, iterations, keyLength, digest);
	const refusal = pbkdf2Refusal(iterations, keyLength, digest);
	if (refusal != null) return Result.err(refusal);
	const done = await wcPbkdf2(name, password, salt, iterations, keyLength);
	if (done.error != "") return Result.err(keyDerivationFailed("pbkdf2", done.error));
	return Result.ok(new Buffer(done.value));
}

export function hkdf<I extends ByteInput, S extends ByteInput, N extends ByteInput>(algorithm: HashAlgorithm, ikm: I, salt: S, info: N, length: int32): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(hkdfSync(algorithm, ikm, salt, info, length));
	} else {
		return hkdfOwned(algorithm, bytesOf(ikm), bytesOf(salt), bytesOf(info), length);
	}
}

async function hkdfOwned(algorithm: HashAlgorithm, ikm: uint8[], salt: uint8[], info: uint8[], length: int32): Promise<Result<Buffer, CryptoError>> {
	const name = subtleName(algorithm);
	// WebCrypto refuses empty HKDF input keying material, which RFC 5869 allows.
	if (name == "" || ikm.length == 0) return hkdfSync(algorithm, ikm, salt, info, length);
	const refusal = hkdfRefusal(algorithm, length);
	if (refusal != null) return Result.err(refusal);
	const done = await wcHkdf(name, ikm, salt, info, length);
	if (done.error != "") return Result.err(keyDerivationFailed("hkdf", done.error));
	return Result.ok(new Buffer(done.value));
}

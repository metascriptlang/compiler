// std/crypto/aes — AES encryption module
// import { seal, open } from "std/crypto/aes"
//
// Safe by default: seal/open use AES-GCM with auto-generated nonce.
// CBC mode available for legacy interop (expert use).

@include("runtime/crypto/ciphers/aes.h");
@compile("runtime/crypto/ciphers/aes.c");

// mbedTLS AES source + platform_util (needed if aes imported without base crypto)
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/aes.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/aesni.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/aesce.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/platform_util.c");

// mbedTLS include paths (shared with base crypto module)
@passC("-Ivendor/mbedtls/tf-psa-crypto/include");
@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/include");
@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/src");
@passC("-Ivendor/mbedtls/tf-psa-crypto/core");
@passC("-Iruntime/crypto");
@passC("-DMBEDTLS_CONFIG_FILE=\"<mbedtls/mbedtlsConfig.h>\"");
@passC("-DMBEDTLS_DECLARE_PRIVATE_IDENTIFIERS");

import { Buffer } from "std/core/buffer";
import { Bytes, rawString, rawBuffer } from "std/core/buffer/bytes";
import { CryptoError, CryptoErrorKind, cryptoError } from "../errors";
import { newOutputBuffer, outputBytes } from "../outputBuffer";

// C bindings
extern function msCryptoAesSealInto(key: string, plainText: string, aad: string, out: Ptr<uint8>): int64;
extern function msCryptoAesOpen(key: string, sealed: string, aad: string, ref plainText: string): int64;
extern function msCryptoAesCbcEncrypt(key: string, plainText: string, iv: string): string;
extern function msCryptoAesCbcDecrypt(key: string, cipherText: string, iv: string): string;

export { CryptoError, CryptoErrorKind } from "../errors";

function validateAesKey(key: string, op: string): Result<boolean, CryptoError> {
	if (key.byteLength != 16 && key.byteLength != 32) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidKey, op, "key must be 16 or 32 bytes"));
	}
	return Result.ok(true);
}

// ===== High-Level AEAD (safe by default) =====

/**
 * Encrypt with AES-GCM. Auto-generates 12-byte nonce.
 * Returns: nonce(12) || cipherText || authTag(16) as one Buffer.
 * Key: 16 bytes (AES-128) or 32 bytes (AES-256).
 */
export function seal(keyBytes: Bytes, plainTextBytes: Bytes, aadBytes: Bytes = ""): Result<Buffer, CryptoError> {
	const key = rawString(keyBytes);
	const _v1 = try validateAesKey(key, "seal");
	const text = rawString(plainTextBytes);
	const sealed = newOutputBuffer(12 + (text.byteLength as int64) + 16);
	if (msCryptoAesSealInto(key, text, rawString(aadBytes), outputBytes(sealed)) != 1) {
		return Result.err(cryptoError(CryptoErrorKind.EncryptionFailed, "seal", "AES-GCM encryption failed"));
	}
	return Result.ok(sealed);
}

/**
 * Decrypt AES-GCM sealed blob. Verifies authentication tag.
 * Input: nonce(12) || cipherText || authTag(16).
 * Returns plainText or error if authentication fails.
 */
export function open(keyBytes: Bytes, sealedBytes: Bytes, aadBytes: Bytes = ""): Result<Buffer, CryptoError> {
	const key = rawString(keyBytes);
	const sealed = rawString(sealedBytes);
	const _v2 = try validateAesKey(key, "open");
	if (sealed.byteLength < 28) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "open", "sealed data too short"));
	}
	let plainText = "";
	if (msCryptoAesOpen(key, sealed, rawString(aadBytes), plainText) != 1) {
		return Result.err(cryptoError(CryptoErrorKind.AuthenticationFailed, "open", "authentication tag mismatch"));
	}
	return Result.ok(rawBuffer(plainText));
}

// ===== CBC Mode (expert use — no authentication) =====

/**
 * AES-CBC encrypt with PKCS7 padding.
 * Key: 16 or 32 bytes. IV: must be 16 bytes.
 * WARNING: CBC provides no authentication. Use seal/open for authenticated encryption.
 */
export function cbcEncrypt(keyBytes: Bytes, plainTextBytes: Bytes, ivBytes: Bytes): Result<Buffer, CryptoError> {
	const key = rawString(keyBytes);
	const iv = rawString(ivBytes);
	const _v3 = try validateAesKey(key, "cbcEncrypt");
	if (iv.byteLength != 16) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "cbcEncrypt", "IV must be 16 bytes"));
	}
	const result = msCryptoAesCbcEncrypt(key, rawString(plainTextBytes), iv);
	if (result.byteLength == 0) {
		return Result.err(cryptoError(CryptoErrorKind.EncryptionFailed, "cbcEncrypt", "AES-CBC encryption failed"));
	}
	return Result.ok(rawBuffer(result));
}

/**
 * AES-CBC decrypt with PKCS7 unpadding.
 * Key: 16 or 32 bytes. IV: must be 16 bytes.
 */
export function cbcDecrypt(keyBytes: Bytes, cipherTextBytes: Bytes, ivBytes: Bytes): Result<Buffer, CryptoError> {
	const key = rawString(keyBytes);
	const iv = rawString(ivBytes);
	const _v4 = try validateAesKey(key, "cbcDecrypt");
	if (iv.byteLength != 16) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "cbcDecrypt", "IV must be 16 bytes"));
	}
	const result = msCryptoAesCbcDecrypt(key, rawString(cipherTextBytes), iv);
	if (result.byteLength == 0) {
		return Result.err(cryptoError(CryptoErrorKind.DecryptionFailed, "cbcDecrypt", "AES-CBC decryption failed (bad padding or key)"));
	}
	return Result.ok(rawBuffer(result));
}

function patternBuffer(size: int32): Buffer {
	const buf = Buffer.alloc(size);
	for (let i = 0; i < size; i++) buf[i] = ((i * 7 + i / 251) % 256) as uint8;
	return buf;
}

test "aes seal fills one buffer of nonce, cipher text and tag at every block edge" {
	const key = "0123456789abcdef0123456789abcdef";
	for (const size of [0, 1, 63, 64, 65, 65536]) {
		const plain = patternBuffer(size);
		const sealed = seal(key, plain, "aad");
		assert sealed.ok;
		assert sealed.value.length == size + 28;
		const opened = open(key, sealed.value, "aad");
		assert opened.ok;
		assert opened.value.length == size;
		for (let i = 0; i < size; i++) assert opened.value[i] == plain[i];
		assert !open(key, sealed.value, "other").ok;
		const forged = Buffer.copy(sealed.value);
		forged[size + 27] = (forged[size + 27] ^ 1) as uint8;
		assert !open(key, forged, "aad").ok;
	}
}

test "aes seal rejects a bad key length" {
	assert !seal("short", "x").ok;
}

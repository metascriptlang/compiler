// std/crypto/aes — AES encryption module
// import { AesKey, seal, open } from "std/crypto/aes"
//
// Safe by default: seal/open use AES-GCM with auto-generated nonce.
// CBC mode available for legacy interop (expert use).
// Keys are AesKey objects: the raw bytes stay in native state the object owns and wipes.

@include("runtime/crypto/ciphers/aes.h");
@compile("runtime/crypto/ciphers/aes.c");
@compile("runtime/crypto/ciphers/aesGcmHw.c");

// mbedTLS AES source + platform_util (needed if aes imported without base crypto)
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/aes.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/aesni.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/aesce.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/platform_util.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/gcm.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/block_cipher.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/aria.c");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/camellia.c");
@passC("-DMBEDTLS_BLOCK_CIPHER_C");
@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/constant_time.c");

// mbedTLS include paths (shared with base crypto module)
@passC("-Ivendor/mbedtls/tf-psa-crypto/include");
@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/include");
@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/src");
@passC("-Ivendor/mbedtls/tf-psa-crypto/core");
@passC("-Iruntime/crypto");
@passC("-DMBEDTLS_CONFIG_FILE=\"<mbedtls/mbedtlsConfig.h>\"");
@passC("-DMBEDTLS_DECLARE_PRIVATE_IDENTIFIERS");

import { Buffer } from "std/core/buffer";
import { Bytes, rawString, rawBuffer } from "std/core/buffer/bytes";
import { CryptoError, CryptoErrorKind, cryptoError } from "../errors";
import { newOutputBuffer, outputBytes } from "../outputBuffer";

// C bindings
extern function msCryptoAesKeyNew(raw: string): int64;
extern function msCryptoAesKeyGenerate(byteLength: int32): int64;
extern function msCryptoAesKeyExport(handle: int64): string;
extern function msCryptoAesKeyFree(handle: int64): void;
extern function msCryptoAesSealInto(key: int64, plainText: string, aad: string, out: Ptr<uint8>): int64;
extern function msCryptoAesOpenInto(key: int64, sealed: string, aad: string, out: Ptr<uint8>): int64;
extern function msCryptoAesCbcEncrypt(key: int64, plainText: string, iv: string): string;
extern function msCryptoAesCbcDecrypt(key: int64, cipherText: string, iv: string, ref plainText: string): int64;

export { CryptoError, CryptoErrorKind } from "../errors";

// ===== Key =====

/**
 * An AES-128 or AES-256 key. The object owns the native copy of the key bytes and wipes it when
 * its last reference goes, so the bytes never appear in a seal/open signature.
 */
export class AesKey {
	_handle: int64;

	/** From exactly 16 (AES-128) or 32 (AES-256) raw bytes. */
	static import(raw: Bytes): Result<AesKey, CryptoError> {
		const handle = msCryptoAesKeyNew(rawString(raw));
		if (handle == 0) {
			return Result.err(cryptoError(CryptoErrorKind.InvalidKey, "AesKey.import", "key must be 16 or 32 bytes"));
		}
		return Result.ok({ _handle: handle });
	}

	/** A random key from the OS source: 128 or 256 bits. */
	static generate(bits: int32 = 256): Result<AesKey, CryptoError> {
		if (bits != 128 && bits != 256) {
			return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "AesKey.generate", "bits must be 128 or 256"));
		}
		const handle = msCryptoAesKeyGenerate(bits / 8);
		if (handle == -1) {
			return Result.err(cryptoError(CryptoErrorKind.RandomFailed, "AesKey.generate", "the OS random source failed"));
		}
		return Result.ok({ _handle: handle });
	}

	/** A copy of the raw key bytes, for the caller that must store it. */
	exportRaw(): Buffer {
		return rawBuffer(msCryptoAesKeyExport(liveHandle(this, "AesKey.exportRaw")));
	}
}

function onDestroy(this key: AesKey): void {
	msCryptoAesKeyFree(key._handle);
	key._handle = 0;
}

function liveHandle(key: AesKey, op: string): int64 {
	if (key._handle == 0) throw new Error(`${op}: the key was already destroyed`);
	return key._handle;
}

// ===== High-Level AEAD (safe by default) =====

/**
 * Encrypt with AES-GCM. Auto-generates 12-byte nonce.
 * Returns: nonce(12) || cipherText || authTag(16) as one Buffer.
 * Completes inline on C: nothing waits, so nothing spawns.
 */
export function sealSync(key: AesKey, plainTextBytes: Bytes, aadBytes: Bytes = ""): Result<Buffer, CryptoError> {
	const handle = liveHandle(key, "seal");
	const text = rawString(plainTextBytes);
	const sealed = newOutputBuffer(12 + (text.byteLength as int64) + 16);
	const status = msCryptoAesSealInto(handle, text, rawString(aadBytes), outputBytes(sealed));
	if (status == -1) {
		return Result.err(cryptoError(CryptoErrorKind.RandomFailed, "seal", "the OS random source failed"));
	}
	if (status != 1) {
		return Result.err(cryptoError(CryptoErrorKind.EncryptionFailed, "seal", "AES-GCM encryption failed"));
	}
	return Result.ok(sealed);
}

export async function seal(key: AesKey, plainTextBytes: Bytes, aadBytes: Bytes = ""): Promise<Result<Buffer, CryptoError>> { return sealSync(key, plainTextBytes, aadBytes); }

/**
 * Decrypt AES-GCM sealed blob. Verifies authentication tag.
 * Input: nonce(12) || cipherText || authTag(16).
 * Returns plainText or error if authentication fails.
 */
export function openSync(key: AesKey, sealedBytes: Bytes, aadBytes: Bytes = ""): Result<Buffer, CryptoError> {
	const handle = liveHandle(key, "open");
	const sealed = rawString(sealedBytes);
	if (sealed.byteLength < 28) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "open", "sealed data too short"));
	}
	const plain = newOutputBuffer((sealed.byteLength as int64) - 28);
	if (msCryptoAesOpenInto(handle, sealed, rawString(aadBytes), outputBytes(plain)) != 1) {
		return Result.err(cryptoError(CryptoErrorKind.AuthenticationFailed, "open", "authentication tag mismatch"));
	}
	return Result.ok(plain);
}

export async function open(key: AesKey, sealedBytes: Bytes, aadBytes: Bytes = ""): Promise<Result<Buffer, CryptoError>> { return openSync(key, sealedBytes, aadBytes); }

// ===== CBC Mode (expert use — no authentication) =====

/**
 * AES-CBC encrypt with PKCS7 padding. IV: must be 16 bytes.
 * WARNING: CBC provides no authentication. Use seal/open for authenticated encryption.
 */
export function cbcEncryptSync(key: AesKey, plainTextBytes: Bytes, ivBytes: Bytes): Result<Buffer, CryptoError> {
	const handle = liveHandle(key, "cbcEncrypt");
	const iv = rawString(ivBytes);
	if (iv.byteLength != 16) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "cbcEncrypt", "IV must be 16 bytes"));
	}
	const result = msCryptoAesCbcEncrypt(handle, rawString(plainTextBytes), iv);
	if (result.byteLength == 0) {
		return Result.err(cryptoError(CryptoErrorKind.EncryptionFailed, "cbcEncrypt", "AES-CBC encryption failed"));
	}
	return Result.ok(rawBuffer(result));
}

export async function cbcEncrypt(key: AesKey, plainTextBytes: Bytes, ivBytes: Bytes): Promise<Result<Buffer, CryptoError>> { return cbcEncryptSync(key, plainTextBytes, ivBytes); }

/**
 * AES-CBC decrypt with PKCS7 unpadding. IV: must be 16 bytes.
 * WARNING: CBC provides no authentication, so the padding check is an oracle for anyone who can
 * tamper with the cipher text and see whether decryption failed. Use seal/open for authenticated encryption.
 */
export function cbcDecryptSync(key: AesKey, cipherTextBytes: Bytes, ivBytes: Bytes): Result<Buffer, CryptoError> {
	const handle = liveHandle(key, "cbcDecrypt");
	const iv = rawString(ivBytes);
	if (iv.byteLength != 16) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "cbcDecrypt", "IV must be 16 bytes"));
	}
	let plainText = "";
	if (msCryptoAesCbcDecrypt(handle, rawString(cipherTextBytes), iv, plainText) != 1) {
		return Result.err(cryptoError(CryptoErrorKind.DecryptionFailed, "cbcDecrypt", "AES-CBC decryption failed (bad padding or key)"));
	}
	return Result.ok(rawBuffer(plainText));
}

export async function cbcDecrypt(key: AesKey, cipherTextBytes: Bytes, ivBytes: Bytes): Promise<Result<Buffer, CryptoError>> { return cbcDecryptSync(key, cipherTextBytes, ivBytes); }

function patternBuffer(size: int32): Buffer {
	const buf = Buffer.alloc(size);
	for (let i = 0; i < size; i++) buf[i] = ((i * 7 + i / 251) % 256) as uint8;
	return buf;
}

test "aes seal fills one buffer of nonce, cipher text and tag at every block edge" {
	const imported = AesKey.import("0123456789abcdef0123456789abcdef");
	assert imported.ok;
	const key = imported.value;
	for (const size of [0, 1, 63, 64, 65, 65536]) {
		const plain = patternBuffer(size);
		const sealed = await seal(key, plain, "aad");
		assert sealed.ok;
		assert sealed.value.length == size + 28;
		const opened = await open(key, sealed.value, "aad");
		assert opened.ok;
		assert opened.value.length == size;
		for (let i = 0; i < size; i++) assert opened.value[i] == plain[i];
		assert !(await open(key, sealed.value, "other")).ok;
		const forged = Buffer.copy(sealed.value);
		forged[size + 27] = (forged[size + 27] ^ 1) as uint8;
		assert !(await open(key, forged, "aad")).ok;
	}
}

test "aes import rejects a bad key length and generate round-trips through exportRaw" {
	assert !AesKey.import("short").ok;
	assert !AesKey.generate(192).ok;
	const generated = AesKey.generate(128);
	assert generated.ok;
	const raw = generated.value.exportRaw();
	assert raw.length == 16;
	const again = AesKey.import(raw);
	assert again.ok;
	const sealed = await seal(generated.value, "x");
	assert sealed.ok;
	assert (await open(again.value, sealed.value)).ok;
}

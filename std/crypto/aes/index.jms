/**
 * AES on the JavaScript backend: the same surface and wire format as index.cms (`nonce(12) || cipher text || tag(16)`
 * for GCM, PKCS#7 for CBC).
 *
 * The async forms (`seal`, `open`, `cbcEncrypt`, `cbcDecrypt`) run on `crypto.subtle`, with the WebCrypto key
 * imported once per `AesKey` and kept on it. Without `crypto.subtle` (a browser outside a secure context) they run
 * the `*Sync` code instead. The `*Sync` forms run the portable AES in `std/crypto/pure/aes`, which is not
 * constant-time: its table lookups are indexed by secret bytes, so prefer the async forms on JS. An `AesKey` has no
 * `onDestroy` here: JS has no deterministic destruction, so the raw bytes and the key schedule live until the
 * garbage collector frees the object.
 */

import { Buffer } from "std/core/buffer";
import { ByteInput } from "std/core/buffer/bytes";
import { bytesOf } from "../pure/bytes";
import { expandKeyDecrypt, gcmSealWithNonce, gcmOpen, cbcEncrypt as pureCbcEncrypt, cbcDecrypt as pureCbcDecrypt } from "../pure/aes";
import { randomBytesSync } from "../index";
when (!nodejs) {
	import { expandKey } from "../pure/aes";
}
import { CryptoError, CryptoErrorKind, cryptoError } from "../errors";
export { CryptoError, CryptoErrorKind } from "../errors";

@emit(`function msAesBytes(u8) {
	const n = u8.length;
	const out = new Array(n).fill(0);
	for (let i = 0; i < n; i++) out[i] = u8[i];
	return out;
}
function msAesSubtle() {
	const c = globalThis.crypto;
	return c && c.subtle ? c.subtle : null;
}
function msAesMessage(e) {
	return String(e && e.message ? e.message : e);
}
async function msAesImport(raw, name) {
	try {
		return { key: await msAesSubtle().importKey("raw", Uint8Array.from(raw), { name }, false, ["encrypt", "decrypt"]), error: "" };
	} catch (e) {
		return { key: null, error: msAesMessage(e) };
	}
}
async function msAesGcmSeal(key, nonce, plain, aad) {
	try {
		const iv = Uint8Array.from(nonce);
		const body = new Uint8Array(await msAesSubtle().encrypt({ name: "AES-GCM", iv, additionalData: Uint8Array.from(aad), tagLength: 128 }, key, Uint8Array.from(plain)));
		const out = new Uint8Array(12 + body.length);
		out.set(iv);
		out.set(body, 12);
		return { value: msAesBytes(out), error: "" };
	} catch (e) {
		return { value: [], error: msAesMessage(e) };
	}
}
async function msAesGcmOpen(key, sealed, aad) {
	try {
		const all = Uint8Array.from(sealed);
		const plain = await msAesSubtle().decrypt({ name: "AES-GCM", iv: all.subarray(0, 12), additionalData: Uint8Array.from(aad), tagLength: 128 }, key, all.subarray(12));
		return { value: msAesBytes(new Uint8Array(plain)), error: "" };
	} catch (e) {
		return { value: [], error: msAesMessage(e) };
	}
}
async function msAesCbc(key, iv, data, encrypt) {
	try {
		const s = msAesSubtle();
		const algorithm = { name: "AES-CBC", iv: Uint8Array.from(iv) };
		const out = encrypt ? await s.encrypt(algorithm, key, Uint8Array.from(data)) : await s.decrypt(algorithm, key, Uint8Array.from(data));
		return { value: msAesBytes(new Uint8Array(out)), error: "" };
	} catch (e) {
		return { value: [], error: msAesMessage(e) };
	}
}`);

when (nodejs) {
	import { NodeInput, nodeInput, nodeInputLength } from "../pure/nodeCrypto";

	@import("node:crypto", { createCipheriv, createDecipheriv });

	@emit(`function msAesNodeIn(x) {
	return typeof x === "string" ? new TextEncoder().encode(x) : x;
}
function msAesNodeName(raw, mode) {
	return (raw.length === 16 ? "aes-128-" : "aes-256-") + mode;
}
function msAesNodeOut(parts) {
	let n = 0;
	for (const p of parts) n += p.length;
	const out = new Array(n);
	let at = 0;
	for (const p of parts) for (let i = 0; i < p.length; i++) out[at++] = p[i];
	return out;
}
function msAesNodeGcmSeal(raw, nonce, plain, aad) {
	const iv = Uint8Array.from(nonce);
	const c = createCipheriv(msAesNodeName(raw, "gcm"), Uint8Array.from(raw), iv);
	const extra = msAesNodeIn(aad);
	if (extra.length > 0) c.setAAD(extra);
	const head = c.update(msAesNodeIn(plain));
	const tail = c.final();
	return msAesNodeOut([iv, head, tail, c.getAuthTag()]);
}
function msAesNodeGcmOpen(raw, sealed, aad) {
	const all = msAesNodeIn(sealed);
	const d = createDecipheriv(msAesNodeName(raw, "gcm"), Uint8Array.from(raw), all.subarray(0, 12));
	d.setAuthTag(all.subarray(all.length - 16));
	const extra = msAesNodeIn(aad);
	if (extra.length > 0) d.setAAD(extra);
	const head = d.update(all.subarray(12, all.length - 16));
	try {
		return msAesNodeOut([head, d.final()]);
	} catch (e) {
		return null;
	}
}
function msAesNodeCbc(raw, iv, data, encrypt) {
	try {
		const make = encrypt ? createCipheriv : createDecipheriv;
		const c = make(msAesNodeName(raw, "cbc"), Uint8Array.from(raw), msAesNodeIn(iv));
		const head = c.update(msAesNodeIn(data));
		return msAesNodeOut([head, c.final()]);
	} catch (e) {
		return null;
	}
}`);

	extern function nodeGcmSeal(raw: Buffer, nonce: Buffer, plain: NodeInput, aad: NodeInput): Buffer from "msAesNodeGcmSeal(#, #, #, #)";
	extern function nodeGcmOpen(raw: Buffer, sealed: NodeInput, aad: NodeInput): Buffer | null from "msAesNodeGcmOpen(#, #, #)";
	extern function nodeCbc(raw: Buffer, iv: NodeInput, data: NodeInput, encrypt: boolean): Buffer | null from "msAesNodeCbc(#, #, #, #)";

	function sealNode(key: AesKey, plain: NodeInput, aad: NodeInput): Result<Buffer, CryptoError> {
		const nonce = randomBytesSync(12);
		if (!nonce.ok) {
			return Result.err(cryptoError(CryptoErrorKind.RandomFailed, "seal", "the platform random source failed"));
		}
		return Result.ok(nodeGcmSeal(key._raw, nonce.value, plain, aad));
	}

	function openNode(key: AesKey, sealed: NodeInput, aad: NodeInput): Result<Buffer, CryptoError> {
		if (nodeInputLength(sealed) < 28) {
			return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "open", "sealed data too short"));
		}
		const plain = nodeGcmOpen(key._raw, sealed, aad);
		if (plain == null) {
			return Result.err(cryptoError(CryptoErrorKind.AuthenticationFailed, "open", "authentication tag mismatch"));
		}
		return Result.ok(plain);
	}

	function cbcNode(key: AesKey, data: NodeInput, iv: NodeInput, encrypt: boolean): Result<Buffer, CryptoError> {
		const operation = encrypt ? "cbcEncrypt" : "cbcDecrypt";
		if (nodeInputLength(iv) != 16) {
			return Result.err(cryptoError(CryptoErrorKind.InvalidInput, operation, "IV must be 16 bytes"));
		}
		const out = nodeCbc(key._raw, iv, data, encrypt);
		if (out == null) {
			return encrypt
				? Result.err(cryptoError(CryptoErrorKind.EncryptionFailed, operation, "AES-CBC encryption failed"))
				: Result.err(cryptoError(CryptoErrorKind.DecryptionFailed, operation, "AES-CBC decryption failed (bad padding or key)"));
		}
		return Result.ok(out);
	}

}

interface Imported {
	key: unknown;
	error: string;
}

interface Settled {
	value: Buffer;
	error: string;
}

extern function wcAvailable(): boolean from "msAesSubtle() !== null";
extern function wcImport(raw: Buffer, name: string): Promise<Imported> from "msAesImport(#, #)";
extern function wcGcmSeal(key: unknown, nonce: Buffer, plain: Buffer, aad: Buffer): Promise<Settled> from "msAesGcmSeal(#, #, #, #)";
extern function wcGcmOpen(key: unknown, sealed: Buffer, aad: Buffer): Promise<Settled> from "msAesGcmOpen(#, #, #)";
extern function wcCbc(key: unknown, iv: Buffer, data: Buffer, encrypt: boolean): Promise<Settled> from "msAesCbc(#, #, #, #)";

// ===== Key =====

/** An AES-128 or AES-256 key: the raw bytes, their key schedule for the `*Sync` forms, and the WebCrypto keys the async forms import on first use. */
export class AesKey {
	_raw: Buffer;
	_enc: uint32[];
	_dec: uint32[];
	_gcm: unknown;
	_cbc: unknown;

	/** From exactly 16 (AES-128) or 32 (AES-256) raw bytes. */
	static import<R extends ByteInput>(raw: R): Result<AesKey, CryptoError> {
		const bytes = bytesOf(raw);
		if (bytes.length != 16 && bytes.length != 32) {
			return Result.err(cryptoError(CryptoErrorKind.InvalidKey, "AesKey.import", "key must be 16 or 32 bytes"));
		}
		when (nodejs) {
			return Result.ok({ _raw: bytes.slice(0), _enc: new Array<uint32>(0), _dec: new Array<uint32>(0), _gcm: null, _cbc: null });
		} else {
			return Result.ok({ _raw: bytes.slice(0), _enc: expandKey(bytes), _dec: new Array<uint32>(0), _gcm: null, _cbc: null });
		}
	}

	/** A random key from the platform source: 128 or 256 bits. */
	static generate(bits: int32 = 256): Result<AesKey, CryptoError> {
		if (bits != 128 && bits != 256) {
			return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "AesKey.generate", "bits must be 128 or 256"));
		}
		const drawn = randomBytesSync(bits / 8);
		if (!drawn.ok) {
			return Result.err(cryptoError(CryptoErrorKind.RandomFailed, "AesKey.generate", "the platform random source failed"));
		}
		return AesKey.import(drawn.value);
	}

	/** A copy of the raw key bytes, for the caller that must store it. */
	exportRaw(): Buffer {
		return this._raw.slice(0);
	}
}

function decryptSchedule(key: AesKey): uint32[] {
	if (key._dec.length == 0) key._dec = expandKeyDecrypt(key._raw);
	return key._dec;
}

// The WebCrypto key of one mode, imported once; null when it imported, else the failure.
async function subtleKey(key: AesKey, gcm: boolean, operation: string): Promise<CryptoError | null> {
	if ((gcm ? key._gcm : key._cbc) != null) return null;
	const done = await wcImport(key._raw, gcm ? "AES-GCM" : "AES-CBC");
	if (done.error != "") return cryptoError(CryptoErrorKind.InvalidKey, operation, done.error);
	if (gcm) key._gcm = done.key;
	else key._cbc = done.key;
	return null;
}

// ===== High-Level AEAD (safe by default) =====

/**
 * Encrypt with AES-GCM. Auto-generates a 12-byte nonce.
 * Returns: nonce(12) || cipherText || authTag(16) as one Buffer.
 */
export function sealSync<P extends ByteInput, A extends ByteInput>(key: AesKey, plainTextBytes: P, aadBytes: A = ""): Result<Buffer, CryptoError> {
	when (nodejs) {
		return sealNode(key, nodeInput(plainTextBytes), nodeInput(aadBytes));
	} else {
		return sealSyncOwned(key, bytesOf(plainTextBytes), bytesOf(aadBytes));
	}
}

function sealSyncOwned(key: AesKey, plainTextBytes: Buffer, aadBytes: Buffer): Result<Buffer, CryptoError> {
	const nonce = randomBytesSync(12);
	if (!nonce.ok) {
		return Result.err(cryptoError(CryptoErrorKind.RandomFailed, "seal", "the platform random source failed"));
	}
	return Result.ok(gcmSealWithNonce(key._enc, nonce.value, plainTextBytes, aadBytes) as Buffer);
}

export function seal<P extends ByteInput, A extends ByteInput>(key: AesKey, plainTextBytes: P, aadBytes: A = ""): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(sealNode(key, nodeInput(plainTextBytes), nodeInput(aadBytes)));
	} else {
		return sealOwned(key, bytesOf(plainTextBytes), bytesOf(aadBytes));
	}
}

async function sealOwned(key: AesKey, plainTextBytes: Buffer, aadBytes: Buffer): Promise<Result<Buffer, CryptoError>> {
	if (!wcAvailable()) return sealSyncOwned(key, plainTextBytes, aadBytes);
	const nonce = randomBytesSync(12);
	if (!nonce.ok) {
		return Result.err(cryptoError(CryptoErrorKind.RandomFailed, "seal", "the platform random source failed"));
	}
	const failed = await subtleKey(key, true, "seal");
	if (failed != null) return Result.err(failed);
	const done = await wcGcmSeal(key._gcm, nonce.value, plainTextBytes, aadBytes);
	if (done.error != "") return Result.err(cryptoError(CryptoErrorKind.EncryptionFailed, "seal", done.error));
	return Result.ok(done.value);
}

/**
 * Decrypt AES-GCM sealed blob. Verifies authentication tag.
 * Input: nonce(12) || cipherText || authTag(16).
 * Returns plainText or error if authentication fails.
 */
export function openSync<S extends ByteInput, A extends ByteInput>(key: AesKey, sealedBytes: S, aadBytes: A = ""): Result<Buffer, CryptoError> {
	when (nodejs) {
		return openNode(key, nodeInput(sealedBytes), nodeInput(aadBytes));
	} else {
		return openSyncOwned(key, bytesOf(sealedBytes), bytesOf(aadBytes));
	}
}

function openSyncOwned(key: AesKey, sealedBytes: Buffer, aadBytes: Buffer): Result<Buffer, CryptoError> {
	const sealed = sealedBytes;
	if (sealed.length < 28) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "open", "sealed data too short"));
	}
	const plain = gcmOpen(key._enc, sealed, aadBytes);
	if (plain == null) {
		return Result.err(cryptoError(CryptoErrorKind.AuthenticationFailed, "open", "authentication tag mismatch"));
	}
	return Result.ok(plain as Buffer);
}

export function open<S extends ByteInput, A extends ByteInput>(key: AesKey, sealedBytes: S, aadBytes: A = ""): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(openNode(key, nodeInput(sealedBytes), nodeInput(aadBytes)));
	} else {
		return openOwned(key, bytesOf(sealedBytes), bytesOf(aadBytes));
	}
}

async function openOwned(key: AesKey, sealedBytes: Buffer, aadBytes: Buffer): Promise<Result<Buffer, CryptoError>> {
	if (!wcAvailable()) return openSyncOwned(key, sealedBytes, aadBytes);
	const sealed = sealedBytes;
	if (sealed.length < 28) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "open", "sealed data too short"));
	}
	const failed = await subtleKey(key, true, "open");
	if (failed != null) return Result.err(failed);
	const done = await wcGcmOpen(key._gcm, sealed, aadBytes);
	if (done.error != "") return Result.err(cryptoError(CryptoErrorKind.AuthenticationFailed, "open", "authentication tag mismatch"));
	return Result.ok(done.value);
}

// ===== CBC Mode (expert use — no authentication) =====

/**
 * AES-CBC encrypt with PKCS7 padding. IV: must be 16 bytes.
 * WARNING: CBC provides no authentication. Use seal/open for authenticated encryption.
 */
export function cbcEncryptSync<P extends ByteInput, I extends ByteInput>(key: AesKey, plainTextBytes: P, ivBytes: I): Result<Buffer, CryptoError> {
	when (nodejs) {
		return cbcNode(key, nodeInput(plainTextBytes), nodeInput(ivBytes), true);
	} else {
		return cbcEncryptSyncOwned(key, bytesOf(plainTextBytes), bytesOf(ivBytes));
	}
}

function cbcEncryptSyncOwned(key: AesKey, plainTextBytes: Buffer, ivBytes: Buffer): Result<Buffer, CryptoError> {
	const iv = ivBytes;
	if (iv.length != 16) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "cbcEncrypt", "IV must be 16 bytes"));
	}
	return Result.ok(pureCbcEncrypt(key._enc, iv, plainTextBytes) as Buffer);
}

export function cbcEncrypt<P extends ByteInput, I extends ByteInput>(key: AesKey, plainTextBytes: P, ivBytes: I): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(cbcNode(key, nodeInput(plainTextBytes), nodeInput(ivBytes), true));
	} else {
		return cbcEncryptOwned(key, bytesOf(plainTextBytes), bytesOf(ivBytes));
	}
}

async function cbcEncryptOwned(key: AesKey, plainTextBytes: Buffer, ivBytes: Buffer): Promise<Result<Buffer, CryptoError>> {
	if (!wcAvailable()) return cbcEncryptSyncOwned(key, plainTextBytes, ivBytes);
	const iv = ivBytes;
	if (iv.length != 16) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "cbcEncrypt", "IV must be 16 bytes"));
	}
	const failed = await subtleKey(key, false, "cbcEncrypt");
	if (failed != null) return Result.err(failed);
	const done = await wcCbc(key._cbc, iv, plainTextBytes, true);
	if (done.error != "") return Result.err(cryptoError(CryptoErrorKind.EncryptionFailed, "cbcEncrypt", done.error));
	return Result.ok(done.value);
}

/**
 * AES-CBC decrypt with PKCS7 unpadding. IV: must be 16 bytes.
 * WARNING: CBC provides no authentication, so the padding check is an oracle for anyone who can
 * tamper with the cipher text and see whether decryption failed. Use seal/open for authenticated encryption.
 */
export function cbcDecryptSync<C extends ByteInput, I extends ByteInput>(key: AesKey, cipherTextBytes: C, ivBytes: I): Result<Buffer, CryptoError> {
	when (nodejs) {
		return cbcNode(key, nodeInput(cipherTextBytes), nodeInput(ivBytes), false);
	} else {
		return cbcDecryptSyncOwned(key, bytesOf(cipherTextBytes), bytesOf(ivBytes));
	}
}

function cbcDecryptSyncOwned(key: AesKey, cipherTextBytes: Buffer, ivBytes: Buffer): Result<Buffer, CryptoError> {
	const iv = ivBytes;
	if (iv.length != 16) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "cbcDecrypt", "IV must be 16 bytes"));
	}
	const plain = pureCbcDecrypt(decryptSchedule(key), iv, cipherTextBytes);
	if (plain == null) {
		return Result.err(cryptoError(CryptoErrorKind.DecryptionFailed, "cbcDecrypt", "AES-CBC decryption failed (bad padding or key)"));
	}
	return Result.ok(plain as Buffer);
}

export function cbcDecrypt<C extends ByteInput, I extends ByteInput>(key: AesKey, cipherTextBytes: C, ivBytes: I): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(cbcNode(key, nodeInput(cipherTextBytes), nodeInput(ivBytes), false));
	} else {
		return cbcDecryptOwned(key, bytesOf(cipherTextBytes), bytesOf(ivBytes));
	}
}

async function cbcDecryptOwned(key: AesKey, cipherTextBytes: Buffer, ivBytes: Buffer): Promise<Result<Buffer, CryptoError>> {
	if (!wcAvailable()) return cbcDecryptSyncOwned(key, cipherTextBytes, ivBytes);
	const iv = ivBytes;
	if (iv.length != 16) {
		return Result.err(cryptoError(CryptoErrorKind.InvalidInput, "cbcDecrypt", "IV must be 16 bytes"));
	}
	const cipher = cipherTextBytes;
	const failed = await subtleKey(key, false, "cbcDecrypt");
	if (failed != null) return Result.err(failed);
	const done = cipher.length == 0 || cipher.length % 16 != 0
		? { value: cipher, error: "ciphertext is not a whole number of blocks" }
		: await wcCbc(key._cbc, iv, cipher, false);
	if (done.error != "") return Result.err(cryptoError(CryptoErrorKind.DecryptionFailed, "cbcDecrypt", "AES-CBC decryption failed (bad padding or key)"));
	return Result.ok(done.value);
}

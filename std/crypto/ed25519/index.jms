/**
 * Ed25519 on the JavaScript backend: WebCrypto (`crypto.subtle`, Ed25519 in Node 20+ and current browsers) for the
 * async forms, and the pure `.ms` code of std/crypto/pure/ed25519 for every `*Sync` form and wherever `subtle` is
 * missing or lacks Ed25519 (old browsers, insecure contexts). The same surface as index.cms.
 *
 * The `.ms` path is BigInt arithmetic: JS cannot promise constant time. Secret scalars take no branch, but the
 * fixed-window table is indexed by them, so a timing or cache side channel is not ruled out.
 */

import { Buffer } from "std/core/buffer";
import { Bytes } from "std/core/buffer/bytes";
import { bytesOf } from "../pure/bytes";
import { ed25519PublicFromSeed, ed25519Sign, ed25519Verify, ed25519Acceptable } from "../pure/ed25519";
import { CryptoError, CryptoErrorKind, cryptoError } from "../errors";
export { CryptoError, CryptoErrorKind } from "../errors";

@emit(`function msEdSubtle() {
	const c = globalThis.crypto;
	return c && c.subtle ? c.subtle : null;
}
const msEdNoSubtle = "crypto.subtle is unavailable: browsers expose it only on secure contexts (https or localhost)";
function msEdMessage(e) {
	return String(e && e.message ? e.message : e);
}
function msEdUnb64url(text) {
	const padded = text.replace(/-/g, "+").replace(/_/g, "/");
	return Uint8Array.from(atob(padded), (ch) => ch.charCodeAt(0));
}
const msEdPkcs8Prefix = [0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20];
async function msEdFromSeed(seed) {
	const s = msEdSubtle();
	if (!s) return { key: null, pub: null, raw: [], error: msEdNoSubtle };
	try {
		const key = await s.importKey("pkcs8", Uint8Array.from([...msEdPkcs8Prefix, ...seed]), { name: "Ed25519" }, true, ["sign"]);
		const raw = msEdUnb64url((await s.exportKey("jwk", key)).x);
		const pub = await s.importKey("raw", raw, { name: "Ed25519" }, true, ["verify"]);
		return { key, pub, raw: Array.from(raw), error: "" };
	} catch (e) {
		return { key: null, pub: null, raw: [], error: msEdMessage(e) };
	}
}
async function msEdImportPublic(raw) {
	const s = msEdSubtle();
	if (!s) return { key: null, pub: null, raw: [], error: msEdNoSubtle };
	try {
		const pub = await s.importKey("raw", Uint8Array.from(raw), { name: "Ed25519" }, true, ["verify"]);
		return { key: null, pub, raw: Array.from(raw), error: "" };
	} catch (e) {
		return { key: null, pub: null, raw: [], error: msEdMessage(e) };
	}
}
async function msEdSign(key, message) {
	const s = msEdSubtle();
	if (!s) return { value: [], error: msEdNoSubtle };
	try {
		return { value: Array.from(new Uint8Array(await s.sign({ name: "Ed25519" }, key, Uint8Array.from(message)))), error: "" };
	} catch (e) {
		return { value: [], error: msEdMessage(e) };
	}
}
async function msEdVerify(pub, signature, message) {
	const s = msEdSubtle();
	if (!s) return false;
	try {
		return await s.verify({ name: "Ed25519" }, pub, Uint8Array.from(signature), Uint8Array.from(message));
	} catch (e) {
		return false;
	}
}
function msEdNone() {
	return null;
}
function msEdRandom() {
	const out = new Uint8Array(32);
	globalThis.crypto.getRandomValues(out);
	return Array.from(out);
}`);

interface Imported {
	key: unknown;
	pub: unknown;
	raw: Buffer;
	error: string;
}

interface Signed {
	value: Buffer;
	error: string;
}

extern function edFromSeed(seed: Buffer): Promise<Imported> from "msEdFromSeed(#)";
extern function edImportPublic(raw: Buffer): Promise<Imported> from "msEdImportPublic(#)";
extern function edSign(key: unknown, message: Buffer): Promise<Signed> from "msEdSign(#, #)";
extern function edVerify(pub: unknown, signature: Buffer, message: Buffer): Promise<boolean> from "msEdVerify(#, #, #)";
extern function edNone(): unknown from "msEdNone()";
extern function edIsNone(key: unknown): boolean from "(# === null)";
extern function edRandomSeed(): Buffer from "msEdRandom()";

function invalidKey(operation: string, message: string): CryptoError {
	return cryptoError(CryptoErrorKind.InvalidKey, operation, message);
}

export class Ed25519PublicKey {
	_raw: Buffer;
	_key: unknown;

	static importSync(raw: Bytes): Result<Ed25519PublicKey, CryptoError> {
		const bytes = bytesOf(raw);
		if (bytes.length != 32) return Result.err(invalidKey("Ed25519PublicKey.import", "public key must be 32 bytes"));
		return Result.ok({ _raw: bytes.slice(0), _key: edNone() });
	}

	static async import(raw: Bytes): Promise<Result<Ed25519PublicKey, CryptoError>> {
		const bytes = bytesOf(raw);
		if (bytes.length != 32) return Result.err(invalidKey("Ed25519PublicKey.import", "public key must be 32 bytes"));
		const done = await edImportPublic(bytes);
		if (done.error != "") return Ed25519PublicKey.importSync(bytes);
		return Result.ok({ _raw: bytes.slice(0), _key: done.pub });
	}

	exportSync(): Result<Buffer, CryptoError> {
		return Result.ok(this._raw.slice(0));
	}

	async export(): Promise<Result<Buffer, CryptoError>> { return this.exportSync(); }
}

export class Ed25519PrivateKey {
	_seed: Buffer;
	_key: unknown;
	_public: Ed25519PublicKey;

	static generateSync(): Result<Ed25519PrivateKey, CryptoError> {
		const made = Ed25519PrivateKey.fromSeedSync(edRandomSeed());
		if (!made.ok) return Result.err(cryptoError(CryptoErrorKind.KeyGenerationFailed, "Ed25519PrivateKey.generate", made.error.message));
		return Result.ok(made.value);
	}

	static async generate(): Promise<Result<Ed25519PrivateKey, CryptoError>> {
		const made = await Ed25519PrivateKey.fromSeed(edRandomSeed());
		if (!made.ok) return Result.err(cryptoError(CryptoErrorKind.KeyGenerationFailed, "Ed25519PrivateKey.generate", made.error.message));
		return Result.ok(made.value);
	}

	static fromSeedSync(seed: Bytes): Result<Ed25519PrivateKey, CryptoError> {
		const bytes = bytesOf(seed);
		if (bytes.length != 32) return Result.err(invalidKey("Ed25519PrivateKey.fromSeed", "seed must be 32 bytes"));
		return Result.ok({ _seed: bytes.slice(0), _key: edNone(), _public: { _raw: ed25519PublicFromSeed(bytes) as Buffer, _key: edNone() } });
	}

	static async fromSeed(seed: Bytes): Promise<Result<Ed25519PrivateKey, CryptoError>> {
		const bytes = bytesOf(seed);
		if (bytes.length != 32) return Result.err(invalidKey("Ed25519PrivateKey.fromSeed", "seed must be 32 bytes"));
		const done = await edFromSeed(bytes);
		if (done.error != "") return Ed25519PrivateKey.fromSeedSync(bytes);
		return Result.ok({ _seed: bytes.slice(0), _key: done.key, _public: { _raw: done.raw, _key: done.pub } });
	}

	exportSeedSync(): Result<Buffer, CryptoError> {
		return Result.ok(this._seed.slice(0));
	}

	async exportSeed(): Promise<Result<Buffer, CryptoError>> { return this.exportSeedSync(); }

	publicKey(): Ed25519PublicKey {
		return this._public;
	}
}

export function signSync(key: Ed25519PrivateKey, message: Bytes): Result<Buffer, CryptoError> {
	return Result.ok(ed25519Sign(key._seed, key._public._raw, bytesOf(message)) as Buffer);
}

export async function sign(key: Ed25519PrivateKey, message: Bytes): Promise<Result<Buffer, CryptoError>> {
	if (edIsNone(key._key)) return signSync(key, message);
	const done = await edSign(key._key, bytesOf(message));
	if (done.error != "") return Result.err(cryptoError(CryptoErrorKind.SignatureFailed, "ed25519.sign", done.error));
	return Result.ok(done.value);
}

// False on any failure: a bad signature, a malformed input, a small-order key or R, or S not below L.
export function verifySync(key: Ed25519PublicKey, signature: Bytes, message: Bytes): boolean {
	const sig = bytesOf(signature);
	if (!ed25519Acceptable(key._raw, sig)) return false;
	return ed25519Verify(key._raw, sig, bytesOf(message));
}

export async function verify(key: Ed25519PublicKey, signature: Bytes, message: Bytes): Promise<boolean> {
	if (edIsNone(key._key)) return verifySync(key, signature, message);
	const sig = bytesOf(signature);
	if (!ed25519Acceptable(key._raw, sig)) return false;
	return await edVerify(key._key, sig, bytesOf(message));
}

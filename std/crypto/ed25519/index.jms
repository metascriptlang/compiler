/**
 * Ed25519 on the JavaScript backend: WebCrypto (`crypto.subtle`, Ed25519 in Node 20+ and current browsers) for the
 * async forms, and the pure `.ms` code of std/crypto/pure/ed25519 for every `*Sync` form and wherever `subtle` is
 * missing or lacks Ed25519 (old browsers, insecure contexts). The same surface as index.cms.
 *
 * The `.ms` path does its field arithmetic on BigInt, so JS cannot promise constant time: secret scalars take no
 * branch and pick base-table entries with masks, never by index, but a BigInt operation's time follows its values.
 */

import { Buffer } from "std/core/buffer";
import { ByteInput } from "std/core/buffer/bytes";
import { bytesOf } from "../pure/bytes";
import { ed25519Sign, ed25519Verify, ed25519Acceptable } from "../pure/ed25519";
when (!nodejs) {
	import { ed25519PublicFromSeed } from "../pure/ed25519";
}
import { CryptoError, CryptoErrorKind, cryptoError } from "../errors";
export { CryptoError, CryptoErrorKind } from "../errors";

@emit(`function msEdBytes(u8) {
	const n = u8.length;
	const out = new Array(n).fill(0);
	for (let i = 0; i < n; i++) out[i] = u8[i];
	return out;
}
function msEdSubtle() {
	const c = globalThis.crypto;
	return c && c.subtle ? c.subtle : null;
}
const msEdNoSubtle = "crypto.subtle is unavailable: browsers expose it only on secure contexts (https or localhost)";
function msEdMessage(e) {
	return String(e && e.message ? e.message : e);
}
function msEdUnb64url(text) {
	const padded = text.replace(/-/g, "+").replace(/_/g, "/");
	return Uint8Array.from(atob(padded), (ch) => ch.charCodeAt(0));
}
const msEdPkcs8Prefix = [0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20];
async function msEdFromSeed(seed) {
	const s = msEdSubtle();
	if (!s) return { key: null, pub: null, raw: [], error: msEdNoSubtle };
	try {
		const key = await s.importKey("pkcs8", Uint8Array.from([...msEdPkcs8Prefix, ...seed]), { name: "Ed25519" }, true, ["sign"]);
		const raw = msEdUnb64url((await s.exportKey("jwk", key)).x);
		const pub = await s.importKey("raw", raw, { name: "Ed25519" }, true, ["verify"]);
		return { key, pub, raw: msEdBytes(raw), error: "" };
	} catch (e) {
		return { key: null, pub: null, raw: [], error: msEdMessage(e) };
	}
}
async function msEdImportPublic(raw) {
	const s = msEdSubtle();
	if (!s) return { key: null, pub: null, raw: [], error: msEdNoSubtle };
	try {
		const pub = await s.importKey("raw", Uint8Array.from(raw), { name: "Ed25519" }, true, ["verify"]);
		return { key: null, pub, raw: msEdBytes(raw), error: "" };
	} catch (e) {
		return { key: null, pub: null, raw: [], error: msEdMessage(e) };
	}
}
async function msEdSign(key, message) {
	const s = msEdSubtle();
	if (!s) return { value: [], error: msEdNoSubtle };
	try {
		return { value: Array.from(new Uint8Array(await s.sign({ name: "Ed25519" }, key, Uint8Array.from(message)))), error: "" };
	} catch (e) {
		return { value: [], error: msEdMessage(e) };
	}
}
async function msEdVerify(pub, signature, message) {
	const s = msEdSubtle();
	if (!s) return false;
	try {
		return await s.verify({ name: "Ed25519" }, pub, Uint8Array.from(signature), Uint8Array.from(message));
	} catch (e) {
		return false;
	}
}
function msEdNone() {
	return null;
}
function msEdRandom() {
	const out = new Uint8Array(32);
	globalThis.crypto.getRandomValues(out);
	return msEdBytes(out);
}`);

interface Imported {
	key: unknown;
	pub: unknown;
	raw: uint8[];
	error: string;
}

interface Signed {
	value: uint8[];
	error: string;
}

extern function edFromSeed(seed: Readonly<uint8[]>): Promise<Imported> from "msEdFromSeed(#)";
extern function edImportPublic(raw: Readonly<uint8[]>): Promise<Imported> from "msEdImportPublic(#)";
extern function edSign(key: unknown, message: Readonly<uint8[]>): Promise<Signed> from "msEdSign(#, #)";
extern function edVerify(pub: unknown, signature: Readonly<uint8[]>, message: Readonly<uint8[]>): Promise<boolean> from "msEdVerify(#, #, #)";
extern function edNone(): unknown from "msEdNone()";
extern function edIsNone(key: unknown): boolean from "(# === null)";
extern function edRandomSeed(): uint8[] from "msEdRandom()";

when (nodejs) {
	import { NodeInput, nodeInput, bufferOver } from "../pure/nodeCrypto";

	@emit(`const msEdNode = globalThis.process.getBuiltinModule("node:crypto");
const msEdPkcs8 = Uint8Array.from([0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20]);
const msEdSpki = Uint8Array.from([0x30, 0x2a, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x03, 0x21, 0x00]);
function msEdNodeDer(prefix, raw) {
	const der = new Uint8Array(prefix.length + 32);
	der.set(prefix);
	for (let i = 0; i < 32; i++) der[prefix.length + i] = raw[i];
	return der;
}
function msEdNodePrivate(seed) {
	const key = msEdNode.createPrivateKey({ key: msEdNodeDer(msEdPkcs8, seed), format: "der", type: "pkcs8" });
	const pub = msEdNode.createPublicKey(key);
	const spki = pub.export({ format: "der", type: "spki" });
	return { key, pub, raw: msEdBytes(spki.subarray(spki.length - 32)), error: "" };
}
function msEdNodePublic(raw) {
	try {
		return msEdNode.createPublicKey({ key: msEdNodeDer(msEdSpki, raw), format: "der", type: "spki" });
	} catch (e) {
		return null;
	}
}
function msEdNodeIn(x) {
	return typeof x === "string" ? new TextEncoder().encode(x) : x;
}
function msEdNodeSign(key, message) {
	return msEdNode.sign(null, msEdNodeIn(message), key);
}
function msEdNodeVerify(pub, signature, message) {
	try {
		return msEdNode.verify(null, msEdNodeIn(message), pub, Uint8Array.from(signature));
	} catch (e) {
		return false;
	}
}`);

	extern function nodePrivate(seed: Readonly<uint8[]>): Imported from "msEdNodePrivate(#)";
	extern function nodePublic(raw: Readonly<uint8[]>): unknown from "msEdNodePublic(#)";
	extern function nodeSign(key: unknown, message: NodeInput): Uint8Array from "msEdNodeSign(#, #)";
	extern function nodeVerify(pub: unknown, signature: Readonly<uint8[]>, message: NodeInput): boolean from "msEdNodeVerify(#, #, #)";

	function signNode(key: Ed25519PrivateKey, message: NodeInput): Buffer {
		return bufferOver(nodeSign(key._key, message));
	}

	function verifyNode(key: Ed25519PublicKey, signature: uint8[], message: NodeInput): boolean {
		if (!ed25519Acceptable(key._raw, signature)) return false;
		return nodeVerify(key._key, signature, message);
	}
}

function invalidKey(operation: string, message: string): CryptoError {
	return cryptoError(CryptoErrorKind.InvalidKey, operation, message);
}

export class Ed25519PublicKey {
	_raw: uint8[];
	_key: unknown;

	static importSync<R extends ByteInput>(raw: R): Result<Ed25519PublicKey, CryptoError> {
		return ed25519PublicOwned(bytesOf(raw));
	}

	static import<R extends ByteInput>(raw: R): Promise<Result<Ed25519PublicKey, CryptoError>> {
		when (nodejs) {
			return Promise.resolve(ed25519PublicOwned(bytesOf(raw)));
		} else {
			return importEd25519Public(bytesOf(raw));
		}
	}

	exportSync(): Result<Buffer, CryptoError> {
		return Result.ok(Buffer.from(this._raw));
	}

	async export(): Promise<Result<Buffer, CryptoError>> { return this.exportSync(); }
}

export class Ed25519PrivateKey {
	_seed: uint8[];
	_key: unknown;
	_public: Ed25519PublicKey;

	static generateSync(): Result<Ed25519PrivateKey, CryptoError> {
		const made = Ed25519PrivateKey.fromSeedSync(edRandomSeed());
		if (!made.ok) return Result.err(cryptoError(CryptoErrorKind.KeyGenerationFailed, "Ed25519PrivateKey.generate", made.error.message));
		return Result.ok(made.value);
	}

	static async generate(): Promise<Result<Ed25519PrivateKey, CryptoError>> {
		const made = await Ed25519PrivateKey.fromSeed(edRandomSeed());
		if (!made.ok) return Result.err(cryptoError(CryptoErrorKind.KeyGenerationFailed, "Ed25519PrivateKey.generate", made.error.message));
		return Result.ok(made.value);
	}

	static fromSeedSync<S extends ByteInput>(seed: S): Result<Ed25519PrivateKey, CryptoError> {
		return ed25519PrivateOwned(bytesOf(seed));
	}

	static fromSeed<S extends ByteInput>(seed: S): Promise<Result<Ed25519PrivateKey, CryptoError>> {
		when (nodejs) {
			return Promise.resolve(ed25519PrivateOwned(bytesOf(seed)));
		} else {
			return ed25519FromSeed(bytesOf(seed));
		}
	}

	exportSeedSync(): Result<Buffer, CryptoError> {
		return Result.ok(Buffer.from(this._seed));
	}

	async exportSeed(): Promise<Result<Buffer, CryptoError>> { return this.exportSeedSync(); }

	publicKey(): Ed25519PublicKey {
		return this._public;
	}
}

export function signSync<M extends ByteInput>(key: Ed25519PrivateKey, message: M): Result<Buffer, CryptoError> {
	when (nodejs) {
		if (!edIsNone(key._key)) return Result.ok(signNode(key, nodeInput(message)));
	}
	return signSyncOwned(key, bytesOf(message));
}

function signSyncOwned(key: Ed25519PrivateKey, message: uint8[]): Result<Buffer, CryptoError> {
	return Result.ok(Buffer.from(ed25519Sign(key._seed, key._public._raw, message)));
}

export function sign<M extends ByteInput>(key: Ed25519PrivateKey, message: M): Promise<Result<Buffer, CryptoError>> {
	when (nodejs) {
		return Promise.resolve(signSync(key, message));
	} else {
		return signOwned(key, bytesOf(message));
	}
}

async function signOwned(key: Ed25519PrivateKey, message: uint8[]): Promise<Result<Buffer, CryptoError>> {
	if (edIsNone(key._key)) return signSyncOwned(key, message);
	const done = await edSign(key._key, message);
	if (done.error != "") return Result.err(cryptoError(CryptoErrorKind.SignatureFailed, "ed25519.sign", done.error));
	return Result.ok(Buffer.from(done.value));
}

// False on any failure: a bad signature, a malformed input, a small-order key or R, or S not below L.
export function verifySync<S extends ByteInput, M extends ByteInput>(key: Ed25519PublicKey, signature: S, message: M): boolean {
	when (nodejs) {
		if (!edIsNone(key._key)) return verifyNode(key, bytesOf(signature), nodeInput(message));
	}
	return verifySyncOwned(key, bytesOf(signature), bytesOf(message));
}

function verifySyncOwned(key: Ed25519PublicKey, signature: uint8[], message: uint8[]): boolean {
	const sig = signature;
	if (!ed25519Acceptable(key._raw, sig)) return false;
	return ed25519Verify(key._raw, sig, message);
}

export function verify<S extends ByteInput, M extends ByteInput>(key: Ed25519PublicKey, signature: S, message: M): Promise<boolean> {
	when (nodejs) {
		return Promise.resolve(verifySync(key, signature, message));
	} else {
		return verifyOwned(key, bytesOf(signature), bytesOf(message));
	}
}

async function verifyOwned(key: Ed25519PublicKey, signature: uint8[], message: uint8[]): Promise<boolean> {
	if (edIsNone(key._key)) return verifySyncOwned(key, signature, message);
	const sig = signature;
	if (!ed25519Acceptable(key._raw, sig)) return false;
	return await edVerify(key._key, sig, message);
}

async function importEd25519Public(bytes: uint8[]): Promise<Result<Ed25519PublicKey, CryptoError>> {
	if (bytes.length != 32) return Result.err(invalidKey("Ed25519PublicKey.import", "public key must be 32 bytes"));
	const done = await edImportPublic(bytes);
	if (done.error != "") return ed25519PublicOwned(bytes);
	return Result.ok({ _raw: bytes.slice(0), _key: done.pub });
}

async function ed25519FromSeed(bytes: uint8[]): Promise<Result<Ed25519PrivateKey, CryptoError>> {
	if (bytes.length != 32) return Result.err(invalidKey("Ed25519PrivateKey.fromSeed", "seed must be 32 bytes"));
	const done = await edFromSeed(bytes);
	if (done.error != "") return ed25519PrivateOwned(bytes);
	return Result.ok({ _seed: bytes.slice(0), _key: done.key, _public: { _raw: done.raw, _key: done.pub } });
}

function ed25519PublicOwned(bytes: uint8[]): Result<Ed25519PublicKey, CryptoError> {
	if (bytes.length != 32) return Result.err(invalidKey("Ed25519PublicKey.import", "public key must be 32 bytes"));
	when (nodejs) {
		return Result.ok({ _raw: bytes.slice(0), _key: nodePublic(bytes) });
	} else {
		return Result.ok({ _raw: bytes.slice(0), _key: edNone() });
	}
}

function ed25519PrivateOwned(bytes: uint8[]): Result<Ed25519PrivateKey, CryptoError> {
	if (bytes.length != 32) return Result.err(invalidKey("Ed25519PrivateKey.fromSeed", "seed must be 32 bytes"));
	when (nodejs) {
		const made = nodePrivate(bytes);
		return Result.ok({ _seed: bytes.slice(0), _key: made.key, _public: { _raw: made.raw, _key: made.pub } });
	} else {
		return Result.ok({ _seed: bytes.slice(0), _key: edNone(), _public: { _raw: ed25519PublicFromSeed(bytes), _key: edNone() } });
	}
}

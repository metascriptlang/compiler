// std/crypto/ed25519 — EdDSA signatures on Edwards25519 curve
// import { Ed25519PrivateKey, Ed25519PublicKey, sign, verify } from "std/crypto/ed25519"
//
// Deterministic signatures (no random nonce), 64-byte signatures, 32-byte keys.
// Uses Monocypher (audited by Cure53, RFC 8032 compatible).
//
// A private key derives its public half once, when it is made, so sign never derives it again and
// no caller can supply a public half that differs from the seed's.

@include("runtime/crypto/curves/ed25519.h");
@compile("runtime/crypto/curves/ed25519.c");

// Monocypher sources (core + Ed25519 optional)
@compile("vendor/monocypher/src/monocypher.c");
@compile("vendor/monocypher/src/optional/monocypher-ed25519.c");

// Include paths
@passC("-Ivendor/monocypher/src");

import { Buffer } from "std/core/buffer";
import { Bytes, rawString, rawBuffer } from "std/core/buffer/bytes";
import { CryptoError, CryptoErrorKind, cryptoError } from "../errors";
export { CryptoError, CryptoErrorKind } from "../errors";

// C bindings
extern function msEd25519KeyGenerate(): int64;
extern function msEd25519KeyFromSeed(seed: string): int64;
extern function msEd25519KeySeed(key: int64): string;
extern function msEd25519KeyPublicRaw(key: int64): string;
extern function msEd25519KeySign(key: int64, message: string): string;
extern function msEd25519PublicFromRaw(raw: string): int64;
extern function msEd25519PublicRaw(key: int64): string;
extern function msEd25519PublicVerify(key: int64, signature: string, message: string): boolean;
extern function msEd25519KeyFree(key: int64): void;

export class Ed25519PublicKey {
	_h: int64;

	static importSync(raw: Bytes): Result<Ed25519PublicKey, CryptoError> {
		const h = msEd25519PublicFromRaw(rawString(raw));
		if (h == 0) return Result.err(cryptoError(CryptoErrorKind.InvalidKey, "Ed25519PublicKey.import", "public key must be 32 bytes"));
		return Result.ok({ _h: h });
	}

	static async import(raw: Bytes): Promise<Result<Ed25519PublicKey, CryptoError>> { return Ed25519PublicKey.importSync(raw); }

	exportSync(): Result<Buffer, CryptoError> {
		return Result.ok(rawBuffer(msEd25519PublicRaw(this._h)));
	}

	async export(): Promise<Result<Buffer, CryptoError>> { return this.exportSync(); }

	onDestroy(): void {
		if (this._h != 0) {
			msEd25519KeyFree(this._h);
			this._h = 0;
		}
	}
}

export class Ed25519PrivateKey {
	_h: int64;

	static generateSync(): Result<Ed25519PrivateKey, CryptoError> {
		const h = msEd25519KeyGenerate();
		if (h == 0) return Result.err(cryptoError(CryptoErrorKind.KeyGenerationFailed, "Ed25519PrivateKey.generate", "key generation failed"));
		return Result.ok({ _h: h });
	}

	static async generate(): Promise<Result<Ed25519PrivateKey, CryptoError>> { return Ed25519PrivateKey.generateSync(); }

	static fromSeedSync(seed: Bytes): Result<Ed25519PrivateKey, CryptoError> {
		const h = msEd25519KeyFromSeed(rawString(seed));
		if (h == 0) return Result.err(cryptoError(CryptoErrorKind.InvalidKey, "Ed25519PrivateKey.fromSeed", "seed must be 32 bytes"));
		return Result.ok({ _h: h });
	}

	static async fromSeed(seed: Bytes): Promise<Result<Ed25519PrivateKey, CryptoError>> { return Ed25519PrivateKey.fromSeedSync(seed); }

	exportSeedSync(): Result<Buffer, CryptoError> {
		return Result.ok(rawBuffer(msEd25519KeySeed(this._h)));
	}

	async exportSeed(): Promise<Result<Buffer, CryptoError>> { return this.exportSeedSync(); }

	publicKey(): Ed25519PublicKey {
		const h = msEd25519PublicFromRaw(msEd25519KeyPublicRaw(this._h));
		if (h == 0) throw new Error("Ed25519PrivateKey.publicKey: out of memory");
		return { _h: h };
	}

	onDestroy(): void {
		if (this._h != 0) {
			msEd25519KeyFree(this._h);
			this._h = 0;
		}
	}
}

export function signSync(key: Ed25519PrivateKey, message: Bytes): Result<Buffer, CryptoError> {
	const sig = msEd25519KeySign(key._h, rawString(message));
	if (sig == "") return Result.err(cryptoError(CryptoErrorKind.SignatureFailed, "ed25519.sign", "signing failed"));
	return Result.ok(rawBuffer(sig));
}

export async function sign(key: Ed25519PrivateKey, message: Bytes): Promise<Result<Buffer, CryptoError>> { return signSync(key, message); }

// False on any failure: a bad signature, a malformed input or an unknown hash.
export function verifySync(key: Ed25519PublicKey, signature: Bytes, message: Bytes): boolean {
	return msEd25519PublicVerify(key._h, rawString(signature), rawString(message));
}

export async function verify(key: Ed25519PublicKey, signature: Bytes, message: Bytes): Promise<boolean> { return verifySync(key, signature, message); }

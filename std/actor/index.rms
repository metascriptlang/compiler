// MetaScript Actor Library — Raiser tier
//
// The mailbox, pid table and stop live in std/core/promise (the prelude), because an
// `actor` lowers to a class that registers there whether or not the program imports this
// module. Links, monitors and traps are inert here as on the JS backend: exit signals
// originate only from stop(), which runs on the caller's stack.

import { ExitReason, msActorStop } from "std/core/promise";

export { ExitReason } from "std/core/promise";

@builtin("nonisolated")
export extern function nonisolated(): void;

export function stop(pid: int64, reason: ExitReason): void {
	msActorStop(pid, reason);
}

export function link(a: int64, b: int64): void {}
export function unlink(a: int64, b: int64): void {}
export function trapExits(actorPid: int64, shouldTrap: boolean): void {}
export function monitor(watcherPid: int64, targetPid: int64): int64 { return 0; }
export function demonitor(targetPid: int64, monitorRef: int64): void {}
export function setIdleTimeout(pid: int64, ms: number): void {}

const names: Map<string, int64> = new Map<string, int64>();

export function registerName(pid: int64, name: string): boolean {
	if (names.has(name)) return false;
	names.set(name, pid);
	return true;
}

export function whereis(name: string): int64 {
	const pid = names.get(name);
	if (pid == null) return 0;
	return pid;
}

export function unregister(name: string): void {
	names.delete(name);
}

export function clockMs(): number {
	return performance.now();
}

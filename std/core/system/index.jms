// MetaScript System Prelude — JavaScript Backend

// Native JS console
export extern class console {
	@builtin("Echo")
	static extern log(...values: unknown[]): void;
	static extern error(value: string): void;
	static extern warn(value: string): void;
}

export extern class process {
	static extern exit(): never;
	static extern exit(code: int32): never;
}

// Timers — the platform globals under the names users already write. Declared
// extern (no body) so the call site emits the host's own function: defining a
// wrapper here would shadow the global and recurse forever.
export extern function setTimeout(fn: () => void, ms: number): number;
export extern function clearTimeout(id: number): void;
export extern function setInterval(fn: () => void, ms: number): number;
export extern function clearInterval(id: number): void;

export class Result<T, E> {
	ok: boolean;
	value: T;
	error: E;

	@builtin("ResultOk")
	static extern ok(val: T): Result<T, E>;
	@builtin("ResultErr")
	static extern err(e: E): Result<T, E>;
}

export class Error {
	message: string;

	constructor(message: string) {
		this.message = message;
	}
}

@builtin("compilerFunc")
export extern function compilerFunc(): void;

@builtin("delegate")
export extern function delegate(): void;

@compilerFunc
function msFieldError(head: string, actual: string): never {
	@emit(`throw new Error(${head} + ${actual} + "'");`);
	unreachable;
}

@compilerFunc
function msCharToString(c: char): string {
	@emit(`return ${c} < 128 ? String.fromCharCode(${c}) : "\\uFFFD";`);
	unreachable;
}

export class AbortSignal {
	aborted: boolean;
	reason: string;

	constructor() {
		this.aborted = false;
		this.reason = "";
	}

	throwIfAborted(): void {
		if (this.aborted) {
			unreachable;
		}
	}

	static abort(reason: string): AbortSignal {
		const s = new AbortSignal();
		s.aborted = true;
		s.reason = reason;
		return s;
	}
}

export class AbortController {
	signal: AbortSignal;

	constructor() {
		this.signal = new AbortSignal();
	}

	abort(reason: string): void {
		if (!this.signal.aborted) {
			this.signal.aborted = true;
			this.signal.reason = reason;
		}
	}
}

// ===== Derived comparison operators (standard library parity) =====
// Given ==, < and <= for a type, derive !=, > and >= at zero cost.
// `<=` stays a per-type base operator: deriving it as !(b < a) only holds for a
// total order, and silently inverts the answer for partial ones (NaN, subset).
export template `!=`<T>(a: T, b: T): boolean { return !(a == b); }
export template `>`<T>(a: T, b: T): boolean { return b < a; }
export template `>=`<T>(a: T, b: T): boolean { return b <= a; }

// ===== Checked integer division, modulo and power =====
// The operator lowering calls these (runtime/core/checkedArith.h on C); their
// bodies are emitted whole so the integer operators inside are not lowered again.

@compilerFunc
function msCheckRangeI8(v: float64, lo: float64, hi: float64): float64 {
	@emit(`if (!(${v} > ${lo} - 1 && ${v} < ${hi} + 1)) throw new Error("value " + ${v} + " not in range " + ${lo} + " .. " + ${hi});
	return ${v};`);
	unreachable;
}

@compilerFunc
function msCheckRangeI16(v: float64, lo: float64, hi: float64): float64 {
	@emit(`if (!(${v} > ${lo} - 1 && ${v} < ${hi} + 1)) throw new Error("value " + ${v} + " not in range " + ${lo} + " .. " + ${hi});
	return ${v};`);
	unreachable;
}

@compilerFunc
function msCheckRangeI32(v: float64, lo: float64, hi: float64): float64 {
	@emit(`if (!(${v} > ${lo} - 1 && ${v} < ${hi} + 1)) throw new Error("value " + ${v} + " not in range " + ${lo} + " .. " + ${hi});
	return ${v};`);
	unreachable;
}

@compilerFunc
function msToInt32(v: float64): int32 {
	@emit(`return ${v} | 0;`);
	unreachable;
}

@compilerFunc
function msCheckRangeI64(v: float64): float64 {
	@emit(`if (!(${v} >= -9223372036854775808 && ${v} < 9223372036854775808)) throw new Error("value " + ${v} + " not in range -9223372036854775808 .. 9223372036854775807");
	return ${v};`);
	unreachable;
}

@compilerFunc
function msDivI32(a: int32, b: int32): int32 {
	@emit(`if (${b} === 0) throw new Error("division by zero");
	if (${b} === -1 && ${a} === -2147483648) throw new Error("over- or underflow");
	return (${a} / ${b}) | 0;`);
	unreachable;
}

@compilerFunc
function msModI32(a: int32, b: int32): int32 {
	@emit(`if (${b} === 0) throw new Error("division by zero");
	return (${a} % ${b}) | 0;`);
	unreachable;
}

@compilerFunc
function msDivU32(a: uint32, b: uint32): uint32 {
	@emit(`if (${b} === 0) throw new Error("division by zero");
	return (${a} / ${b}) >>> 0;`);
	unreachable;
}

@compilerFunc
function msModU32(a: uint32, b: uint32): uint32 {
	@emit(`if (${b} === 0) throw new Error("division by zero");
	return ${a} % ${b};`);
	unreachable;
}

@compilerFunc
function msDivI64(a: int64, b: int64): int64 {
	@emit(`if (${b} === 0n) throw new Error("division by zero");
	if (${b} === -1n && ${a} === -9223372036854775808n) throw new Error("over- or underflow");
	return ${a} / ${b};`);
	unreachable;
}

@compilerFunc
function msModI64(a: int64, b: int64): int64 {
	@emit(`if (${b} === 0n) throw new Error("division by zero");
	return ${a} % ${b};`);
	unreachable;
}

@compilerFunc
function msDivU64(a: uint64, b: uint64): uint64 {
	@emit(`if (${b} === 0n) throw new Error("division by zero");
	return ${a} / ${b};`);
	unreachable;
}

@compilerFunc
function msModU64(a: uint64, b: uint64): uint64 {
	@emit(`if (${b} === 0n) throw new Error("division by zero");
	return ${a} % ${b};`);
	unreachable;
}

@compilerFunc
function msPowI32(a: int32, b: int32): int32 {
	@emit(`if (${b} < 0) throw new Error("value " + ${b} + " not in range 0 .. 2147483647");
	let r = 1, x = ${a}, y = ${b};
	for (;;) {
		if (y & 1) { r = r * x; if (r > 2147483647 || r < -2147483648) throw new Error("over- or underflow"); }
		y = y >>> 1;
		if (y === 0) return r | 0;
		x = x * x;
		if (x > 2147483647 || x < -2147483648) throw new Error("over- or underflow");
	}`);
	unreachable;
}

@compilerFunc
function msPowU32(a: uint32, b: uint32): uint32 {
	@emit(`let r = 1, x = ${a}, y = ${b};
	for (;;) {
		if (y & 1) { r = r * x; if (r > 4294967295) throw new Error("over- or underflow"); }
		y = y >>> 1;
		if (y === 0) return r;
		x = x * x;
		if (x > 4294967295) throw new Error("over- or underflow");
	}`);
	unreachable;
}

@compilerFunc
function msPowI64(a: int64, b: int64): int64 {
	@emit(`if (${b} < 0n) throw new Error("value " + ${b} + " not in range 0 .. 9223372036854775807");
	let r = 1n, x = ${a}, y = ${b};
	for (;;) {
		if (y & 1n) { r = r * x; if (r > 9223372036854775807n || r < -9223372036854775808n) throw new Error("over- or underflow"); }
		y = y >> 1n;
		if (y === 0n) return r;
		x = x * x;
		if (x > 9223372036854775807n || x < -9223372036854775808n) throw new Error("over- or underflow");
	}`);
	unreachable;
}

@compilerFunc
function msPowU64(a: uint64, b: uint64): uint64 {
	@emit(`let r = 1n, x = ${a}, y = ${b};
	for (;;) {
		if (y & 1n) { r = r * x; if (r > 18446744073709551615n) throw new Error("over- or underflow"); }
		y = y >> 1n;
		if (y === 0n) return r;
		x = x * x;
		if (x > 18446744073709551615n) throw new Error("over- or underflow");
	}`);
	unreachable;
}

// ===== Checked element access =====
// The access lowering calls these; runtime/core/system.c holds the C twins, and
// the corpus compares both backends' messages.

@compilerFunc
function msChkIndex(i: int64, len: int64): int64 {
	@emit(`if (!(${i} >= 0 && ${i} < ${len})) throw new Error("index " + ${i} + " out of bounds (length " + ${len} + ")");
	return Number(${i});`);
	unreachable;
}

@compilerFunc
function msSpanAt(v: unknown, i: int64): unknown {
	@emit(`if (!(${i} >= 0 && ${i} < ${v}.len)) throw new Error("index " + ${i} + " out of bounds (length " + ${v}.len + ")");
	return ${v}.base[${v}.off + Number(${i})];`);
	unreachable;
}

@compilerFunc
function msSpanValues(v: unknown): unknown {
	@emit(`return ${v}.base.slice(${v}.off, ${v}.off + ${v}.len);`);
	unreachable;
}

@compilerFunc
function msSpanCell(v: unknown, i: int64): unknown {
	@emit(`if (!(${i} >= 0 && ${i} < ${v}.len)) throw new Error("index " + ${i} + " out of bounds (length " + ${v}.len + ")");
	return [${v}.base, ${v}.off + Number(${i})];`);
	unreachable;
}

@compilerFunc
function msArrayCell(a: unknown, i: int64): unknown {
	@emit(`if (!(${i} >= 0 && ${i} < ${a}.length)) throw new Error("index " + ${i} + " out of bounds (length " + ${a}.length + ")");
	return [${a}, Number(${i})];`);
	unreachable;
}

@compilerFunc
function msSpanOf(a: unknown): unknown {
	@emit(`return { base: ${a}, off: 0, len: ${a}.length };`);
	unreachable;
}

@compilerFunc
function msSliceOf(a: unknown, start: number, end: number): unknown {
	@emit(`const s = Number(${start}), e = Number(${end}), n = ${a}.length;
	if (e !== s && (s < 0 || e < s || e > n)) throw new Error("slice " + s + ".." + e + " out of bounds (length " + n + ")");
	return { base: ${a}, off: s, len: e - s };`);
	unreachable;
}

@compilerFunc
function msSliceSpan(v: unknown, start: number, end: number): unknown {
	@emit(`const s = Number(${start}), e = Number(${end}), n = ${v}.len;
	if (e !== s && (s < 0 || e < s || e > n)) throw new Error("slice " + s + ".." + e + " out of bounds (length " + n + ")");
	return { base: ${v}.base, off: ${v}.off + s, len: e - s };`);
	unreachable;
}

@compilerFunc
function msArrayAt(a: unknown, i: int64): unknown {
	@emit(`if (!(${i} >= 0 && ${i} < ${a}.length)) throw new Error("index " + ${i} + " out of bounds (length " + ${a}.length + ")");
	return ${a}[${i}];`);
	unreachable;
}

@compilerFunc
function msChkArray(a: unknown, i: int64): unknown {
	@emit(`if (!(${i} >= 0 && ${i} < ${a}.length)) throw new Error("index " + ${i} + " out of bounds (length " + ${a}.length + ")");
	return ${a};`);
	unreachable;
}

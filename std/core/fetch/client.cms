// HTTP Client — plain HTTP over raw TCP.
//
// Keep this file free of TLS dependencies so that a program importing only
// `request` / `requestWithRedirects` does NOT pull `std/crypto/tls` (and its
// mbedtls vendor) into the alive-set.
//
// For HTTPS, use `std/https` — it reuses `doRequestOver` and
// `requestWithRedirectsOver` from this file, swapping in a TLS transport.
//
// `fetch(url)` lives in `std/core/fetch` (auto-imported via prelude); it
// dispatches to `request` from this module or from `std/https` based on the
// URL protocol.

@include("runtime/net/socket.h");

extern function msNetSocket(): int32;
extern function msNetConnect(fd: int32, host: string, port: int32): int32;
extern function msNetSend(fd: int32, data: string): int32;
extern function msNetRecv(fd: int32, maxBytes: int32): string;
extern function msNetClose(fd: int32): void;
extern function msNetSetTimeout(fd: int32, ms: int32): int32;

import {
	HttpMethod, HttpResponse, RequestOptions, FetchOptions, ParsedUrl, HttpHeaders,
	methodToString, parseMethod,
} from "./types";
import {
	HttpError,
	connectionFailed, socketError, invalidResponse, invalidRequest, tooManyRedirects,
} from "./errors";
import {
	createHeaders, setHeader, getHeader, serializeHeaders,
	getContentLength, isChunked,
} from "./headers";
import { parseResponse, parseUrl, decodeChunked } from "./parser";

// ===== Constants =====

// Socket recv buffer per call — typical MTU-aligned chunk for HTTP/1.1.
export const RECV_CHUNK_SIZE: int32 = 8192;

// Max total bytes for response headers section — prevents unbounded buffering
// on malicious/broken servers. GitHub's headers are ~4-6 KB; 64 KB is ample.
export const MAX_HEADER_BYTES: int32 = 65536;

// ===== Client Interface =====

export interface HttpClient {
	timeout: int32;
	maxRedirects: int32;
	userAgent: string;
}

export function createClient(): HttpClient {
	return {
		timeout: 30000,
		maxRedirects: 5,
		userAgent: "MetaScript/1.0",
	};
}

// ===== Shared Helpers (exported for std/https + std/core/fetch) =====

// Resolved FetchOptions with defaults applied.
export interface ResolvedOptions {
	method: HttpMethod;
	body: string;
	headers: HttpHeaders;
	timeout: int32;
	maxRedirects: int32;
}

// Apply FetchOptions over defaults. Null options → all defaults.
export function resolveFetchOptions(options: FetchOptions, defaultTimeout: int32, defaultMaxRedirects: int32): ResolvedOptions {
	let method = HttpMethod.GET;
	let body = "";
	let headers = createHeaders();
	let timeout = defaultTimeout;
	let maxRedirects = defaultMaxRedirects;

	if (options !== null) {
		if (options.method !== "") method = parseMethod(options.method);
		body = options.body;
		if (options.headers._names.length > 0) headers = options.headers;
		if (options.timeout > 0) timeout = options.timeout;
		if (options.maxRedirects >= 0) maxRedirects = options.maxRedirects;
	}

	return { method: method, body: body, headers: headers, timeout: timeout, maxRedirects: maxRedirects };
}

// Build path + query string from parsed URL.
export function urlPath(u: ParsedUrl): string {
	if (u.query.length === 0) return u.path;
	return u.path + "?" + u.query;
}

// ===== Transport-agnostic HTTP/1.1 Flow (DRY core for http + https) =====

// Send fn: bytes → int (negative = error). Recv fn: max bytes → received bytes (empty = EOF).
// Close fn: tear down the connection (always called exactly once on the way out).
//
// std/http/client wires these to msNet*; std/https/client wires them to
// tlsRead/tlsWrite/tlsClose. The HTTP/1.1 logic itself lives only here.
export function doRequestOver(
	options: RequestOptions,
	sendFn: (data: string) => int32,
	recvFn: (maxBytes: int32) => string,
	closeFn: () => void,
): Result<HttpResponse, HttpError> {
	// Build request line + headers + body.
	setHeader(options.headers, "host", options.hostname);
	if (options.body.byteLength > 0) {
		setHeader(options.headers, "content-length", options.body.byteLength.toString());
	}
	setHeader(options.headers, "connection", "close");

	let reqStr = methodToString(options.method) + " " + options.path + " HTTP/1.1\r\n";
	reqStr = reqStr + serializeHeaders(options.headers) + "\r\n" + options.body;

	if (sendFn(reqStr) < 0) {
		closeFn();
		return Result.err(socketError("send failed"));
	}

	// Read response headers — loop until \r\n\r\n.
	let data = "";
	while (!data.contains("\r\n\r\n")) {
		const chunk = recvFn(RECV_CHUNK_SIZE);
		if (chunk.length === 0) break;
		data = data + chunk;
		if (data.length > MAX_HEADER_BYTES) break;
	}
	if (data.length === 0) {
		closeFn();
		return Result.err(invalidResponse("empty response"));
	}

	const parsed = parseResponse(data);
	if (!parsed.ok) {
		closeFn();
		return Result.err(parsed.error);
	}

	const contentLength = getContentLength(parsed.value.headers);
	let body = "";

	if (isChunked(parsed.value.headers)) {
		let chunkedData = data.slice(parsed.value.bodyStart, data.length);
		while (!chunkedData.startsWith("0\r\n") && !chunkedData.contains("\r\n0\r\n")) {
			const more = recvFn(RECV_CHUNK_SIZE);
			if (more.length === 0) break;
			chunkedData = chunkedData + more;
		}
		closeFn();
		const decoded = decodeChunked(chunkedData);
		if (!decoded.ok) return Result.err(decoded.error);
		body = decoded.value;
	} else if (contentLength > 0) {
		body = readFullBodyOver(recvFn, data, parsed.value.bodyStart, contentLength);
		closeFn();
	} else if (contentLength < 0) {
		body = readUntilCloseOver(recvFn, data, parsed.value.bodyStart);
		closeFn();
	} else {
		closeFn();
	}

	return Result.ok({
		status: parsed.value.status,
		statusText: parsed.value.statusText,
		headers: parsed.value.headers,
		body: body,
	});
}

function readFullBodyOver(recvFn: (maxBytes: int32) => string, initialData: string, bodyStart: int32, contentLength: int32): string {
	const available = initialData.length - bodyStart;
	if (available >= contentLength) {
		return initialData.slice(bodyStart, bodyStart + contentLength);
	}
	let body = initialData.slice(bodyStart, initialData.length);
	let remaining = contentLength - available;
	while (remaining > 0) {
		const chunk = recvFn(remaining);
		if (chunk.length === 0) break;
		body = body + chunk;
		remaining = remaining - chunk.length;
	}
	return body;
}

function readUntilCloseOver(recvFn: (maxBytes: int32) => string, initialData: string, bodyStart: int32): string {
	let body = initialData.slice(bodyStart, initialData.length);
	while (true) {
		const chunk = recvFn(RECV_CHUNK_SIZE);
		if (chunk.length === 0) break;
		body = body + chunk;
	}
	return body;
}

// Redirect-following loop, parameterized over a per-attempt request fn.
// std/http calls it with `doRequestPlain`; std/https calls it with its
// own TLS-using doRequest.
export function requestWithRedirectsOver(
	options: RequestOptions,
	maxRedirects: int32,
	doReq: (opts: RequestOptions) => Result<HttpResponse, HttpError>,
): Result<HttpResponse, HttpError> {
	let remaining = maxRedirects;
	let currentHostname = options.hostname;
	let currentPort = options.port;
	let currentPath = options.path;
	let currentMethod = options.method;
	let currentBody = options.body;
	let currentTls = options.tls;

	while (remaining >= 0) {
		const headers = createHeaders();
		let i = 0;
		while (i < options.headers._names.length) {
			setHeader(headers, options.headers._names[i], options.headers._values[i]);
			i = i + 1;
		}

		const resp = doReq({
			method: currentMethod, hostname: currentHostname, port: currentPort,
			path: currentPath, headers: headers, body: currentBody,
			timeout: options.timeout, tls: currentTls,
		});
		if (!resp.ok) return resp;

		if (resp.value.status < 300 || resp.value.status >= 400) {
			return resp;
		}

		const location = getHeader(resp.value.headers, "location");
		if (location.length === 0) return resp;

		if (location.startsWith("http://") || location.startsWith("https://")) {
			const parsed = parseUrl(location);
			if (!parsed.ok) return Result.err(parsed.error);
			currentHostname = parsed.value.hostname;
			currentPort = parsed.value.port;
			currentPath = parsed.value.path;
			currentTls = parsed.value.protocol === "https";
			if (parsed.value.query.length > 0) {
				currentPath = currentPath + "?" + parsed.value.query;
			}
		} else {
			currentPath = location;
		}

		// 301/302/303: force GET and strip body (per RFC 7231)
		if (resp.value.status === 301 || resp.value.status === 302 || resp.value.status === 303) {
			currentMethod = HttpMethod.GET;
			currentBody = "";
		}

		remaining = remaining - 1;
	}
	return Result.err(tooManyRedirects(maxRedirects));
}

// ===== Plain HTTP transport (TCP) =====

function doRequestPlain(options: RequestOptions): Result<HttpResponse, HttpError> {
	const fd = msNetSocket();
	if (fd < 0) return Result.err(socketError("socket() failed"));

	if (options.timeout > 0) {
		msNetSetTimeout(fd, options.timeout);
	}

	if (msNetConnect(fd, options.hostname, options.port) < 0) {
		msNetClose(fd);
		return Result.err(connectionFailed(`connect to ${options.hostname}:${options.port} failed`));
	}

	return doRequestOver(
		options,
		(data: string) => msNetSend(fd, data),
		(maxBytes: int32) => msNetRecv(fd, maxBytes),
		() => msNetClose(fd),
	);
}

// ===== Public API =====

// Full options request. Rejects TLS — callers needing HTTPS use std/https.
export function request(options: RequestOptions): Result<HttpResponse, HttpError> {
	if (options.tls) {
		return Result.err(invalidRequest("HTTPS requires std/https"));
	}
	return doRequestPlain(options);
}

// Redirect-following request for plain HTTP.
export function requestWithRedirects(options: RequestOptions, maxRedirects: int32): Result<HttpResponse, HttpError> {
	if (options.tls) {
		return Result.err(invalidRequest("HTTPS requires std/https"));
	}
	return requestWithRedirectsOver(options, maxRedirects, doRequestPlain);
}

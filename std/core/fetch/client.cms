// HTTP Client — plain HTTP over raw TCP.
//
// Keep this file free of TLS dependencies so that a program importing only
// `request` / `requestWithRedirects` does NOT pull `std/crypto/tls` (and its
// mbedtls vendor) into the alive-set.
//
// For HTTPS, use `std/https` — it reuses `doRequestOver` and
// `requestWithRedirectsOver` from this file, swapping in a TLS transport.
//
// `fetch(url)` lives in `std/core/fetch` (auto-imported via prelude); it
// dispatches to `request` from this module or from `std/https` based on the
// URL protocol.

@include("runtime/net/socket.h");

extern function msNetSocket(): int32;
extern function msNetConnect(fd: int32, host: string, port: int32): int32;
extern function msNetSend(fd: int32, data: string): int32;
extern function msNetRecv(fd: int32, maxBytes: int32): string;
extern function msNetClose(fd: int32): void;
extern function msNetSetTimeout(fd: int32, ms: int32): int32;

import {
	HttpMethod, HttpResponse, RequestOptions, FetchOptions, ParsedUrl, HttpHeaders,
	methodToString, parseMethod,
} from "./types";
import {
	HttpError,
	connectionFailed, socketError, invalidResponse, invalidRequest, tooManyRedirects,
} from "./errors";
import {
	createHeaders, setHeader, getHeader, serializeHeaders,
	getContentLength, isChunked,
} from "./headers";
import { parseResponse, parseUrl, decodeChunked } from "./parser";
import { utf8String } from "../string/bytes";
import { Bytes, rawString, rawBuffer } from "../buffer/bytes";

// ===== Constants =====

// Socket recv buffer per call — typical MTU-aligned chunk for HTTP/1.1.
export const RECV_CHUNK_SIZE: int32 = 8192;

// Max total bytes for response headers section — prevents unbounded buffering
// on malicious/broken servers. GitHub's headers are ~4-6 KB; 64 KB is ample.
export const MAX_HEADER_BYTES: int32 = 65536;

// The body as text: each ill-formed UTF-8 sequence reads as U+FFFD. `bytes` holds the body untouched.
export function text(this response: HttpResponse): string {
	return utf8String(response.bytes, false);
}

// ===== Client Interface =====

export interface HttpClient {
	timeout: int32;
	maxRedirects: int32;
	userAgent: string;
}

export function createClient(): HttpClient {
	return {
		timeout: 30000,
		maxRedirects: 5,
		userAgent: "MetaScript/1.0",
	};
}

// ===== Shared Helpers (exported for std/https + std/core/fetch) =====

// Resolved FetchOptions with defaults applied.
export interface ResolvedOptions {
	method: HttpMethod;
	body: string;
	headers: HttpHeaders;
	timeout: int32;
	maxRedirects: int32;
}

// Apply FetchOptions over defaults. Null options → all defaults.
export function resolveFetchOptions(options: FetchOptions | null, defaultTimeout: int32, defaultMaxRedirects: int32): ResolvedOptions {
	let method = HttpMethod.GET;
	let body = "";
	let headers = createHeaders();
	let timeout = defaultTimeout;
	let maxRedirects = defaultMaxRedirects;

	if (options != null) {
		if (options.method != "") method = parseMethod(options.method);
		body = options.body;
		const given = options.headers;
		if (given != null && given._names.length > 0) headers = given;
		if (options.timeout > 0) timeout = options.timeout;
		if (options.maxRedirects >= 0) maxRedirects = options.maxRedirects;
	}

	return { method: method, body: body, headers: headers, timeout: timeout, maxRedirects: maxRedirects };
}

// Build path + query string from parsed URL.
export function urlPath(u: ParsedUrl): string {
	if (u.query.length == 0) return u.path;
	return u.path + "?" + u.query;
}

// ===== Transport-agnostic HTTP/1.1 Flow (DRY core for http + https) =====

// Send fn: bytes → int (negative = error). Recv fn: max bytes → received bytes (empty = EOF).
// Close fn: tear down the connection (always called exactly once on the way out).
//
// std/http/client wires these to msNet*; std/https/client wires them to
// tlsRead/tlsWrite/tlsClose. The HTTP/1.1 logic itself lives only here.
export function doRequestOver(
	options: RequestOptions,
	sendFn: (data: Bytes) => int32,
	recvFn: (maxBytes: int32) => Buffer,
	closeFn: () => void,
): Result<HttpResponse, HttpError> {
	// Build request line + headers + body.
	setHeader(options.headers, "host", options.hostname);
	const methodDefinesBody = options.method == HttpMethod.POST || options.method == HttpMethod.PUT || options.method == HttpMethod.PATCH;
	if (options.body.byteLength > 0 || methodDefinesBody) {
		setHeader(options.headers, "content-length", options.body.byteLength.toString());
	}
	setHeader(options.headers, "connection", "close");

	let reqStr = methodToString(options.method) + " " + options.path + " HTTP/1.1\r\n";
	reqStr = reqStr + serializeHeaders(options.headers) + "\r\n" + options.body;

	if (sendFn(reqStr) < 0) {
		closeFn();
		return Result.err(socketError("send failed"));
	}

	// Read response headers — loop until \r\n\r\n. The buffer may also hold the
	// start of the body once headers terminate.
	const headPieces: Buffer[] = [];
	let headTail: Buffer = [];
	let headTotal = 0;
	let headEnd = -1;
	while (headEnd < 0) {
		const chunk = recvFn(RECV_CHUNK_SIZE);
		if (chunk.length == 0) break;
		headPieces.push(chunk);
		const window = Buffer.concat(headTail, chunk);
		const found = indexOfText(window, "\r\n\r\n");
		if (found >= 0) headEnd = headTotal - (headTail.length as int32) + found;
		headTotal += chunk.length as int32;
		headTail = lastBytes(window, 3);
		if (headTotal > MAX_HEADER_BYTES) break;
	}
	const data = Buffer.concatList(headPieces);
	if (data.length == 0) {
		closeFn();
		return Result.err(invalidResponse("empty response"));
	}

	const parsed = parseResponse(utf8String(data, false));
	if (!parsed.ok) {
		closeFn();
		return Result.err(parsed.error);
	}
	if (headEnd < 0) {
		closeFn();
		return Result.err(invalidResponse("response headers not terminated"));
	}
	const bodyStart = (headEnd + 4) as int32;

	const contentLength = getContentLength(parsed.value.headers);
	let body: Buffer = [];

	if (isChunked(parsed.value.headers)) {
		const chunkPieces: Buffer[] = [];
		let chunkTail: Buffer = [];
		let chunkTotal = 0;
		let more: Buffer = [...data[bodyStart..data.length]];
		while (true) {
			chunkPieces.push(more);
			const window = Buffer.concat(chunkTail, more);
			const windowStart = chunkTotal - (chunkTail.length as int32);
			const ended = (windowStart == 0 && indexOfText(window, "0\r\n") == 0) || indexOfText(window, "\r\n0\r\n") >= 0;
			chunkTotal += more.length as int32;
			chunkTail = lastBytes(window, 4);
			if (ended) break;
			more = recvFn(RECV_CHUNK_SIZE);
			if (more.length == 0) break;
		}
		const chunkedData = Buffer.concatList(chunkPieces);
		closeFn();
		const decoded = decodeChunked(chunkedData);
		if (!decoded.ok) return Result.err(decoded.error);
		body = decoded.value;
	} else if (contentLength > 0) {
		body = readFullBodyOver(recvFn, data, bodyStart, contentLength);
		closeFn();
	} else if (contentLength < 0) {
		body = readUntilCloseOver(recvFn, data, bodyStart);
		closeFn();
	} else {
		closeFn();
	}

	return Result.ok({
		status: parsed.value.status,
		statusText: parsed.value.statusText,
		headers: parsed.value.headers,
		bytes: body,
	});
}

function lastBytes(data: Buffer, count: int32): Buffer {
	const length = data.length as int32;
	const from = length > count ? length - count : 0;
	return [...data[from..data.length]];
}

function indexOfText(data: Buffer, needle: string): int32 {
	return data.indexOfBuffer(Buffer.fromString(needle, "utf8"), 0) as int32;
}

function readFullBodyOver(recvFn: (maxBytes: int32) => Buffer, initialData: Buffer, bodyStart: int32, contentLength: int32): Buffer {
	const available = (initialData.length as int32) - bodyStart;
	if (available >= contentLength) {
		return [...initialData[bodyStart..(bodyStart + contentLength)]];
	}
	const pieces: Buffer[] = [[...initialData[bodyStart..initialData.length]]];
	let remaining = contentLength - available;
	while (remaining > 0) {
		const chunk = recvFn(remaining);
		if (chunk.length == 0) break;
		pieces.push(chunk);
		remaining = remaining - (chunk.length as int32);
	}
	return Buffer.concatList(pieces);
}

function readUntilCloseOver(recvFn: (maxBytes: int32) => Buffer, initialData: Buffer, bodyStart: int32): Buffer {
	const pieces: Buffer[] = [[...initialData[bodyStart..initialData.length]]];
	while (true) {
		const chunk = recvFn(RECV_CHUNK_SIZE);
		if (chunk.length == 0) break;
		pieces.push(chunk);
	}
	return Buffer.concatList(pieces);
}

// Redirect-following loop, parameterized over a per-attempt request fn.
// std/http calls it with `doRequestPlain`; std/https calls it with its
// own TLS-using doRequest.
export function requestWithRedirectsOver(
	options: RequestOptions,
	maxRedirects: int32,
	doReq: (opts: RequestOptions) => Result<HttpResponse, HttpError>,
): Result<HttpResponse, HttpError> {
	let remaining = maxRedirects;
	let currentHostname = options.hostname;
	let currentPort = options.port;
	let currentPath = options.path;
	let currentMethod = options.method;
	let currentBody = options.body;
	let currentTls = options.tls;

	while (remaining >= 0) {
		const headers = createHeaders();
		let i = 0;
		while (i < options.headers._names.length) {
			setHeader(headers, options.headers._names[i], options.headers._values[i]);
			i = i + 1;
		}

		const resp = doReq({
			method: currentMethod, hostname: currentHostname, port: currentPort,
			path: currentPath, headers: headers, body: currentBody,
			timeout: options.timeout, tls: currentTls,
		});
		if (!resp.ok) return resp;

		if (resp.value.status < 300 || resp.value.status >= 400) {
			return resp;
		}

		const location = getHeader(resp.value.headers, "location");
		if (location.length == 0) return resp;

		if (location.startsWith("http://") || location.startsWith("https://")) {
			const parsed = parseUrl(location);
			if (!parsed.ok) return Result.err(parsed.error);
			currentHostname = parsed.value.hostname;
			currentPort = parsed.value.port;
			currentPath = parsed.value.path;
			currentTls = parsed.value.protocol == "https";
			if (parsed.value.query.length > 0) {
				currentPath = currentPath + "?" + parsed.value.query;
			}
		} else {
			currentPath = location;
		}

		// 301/302/303: force GET and strip body (per RFC 7231)
		if (resp.value.status == 301 || resp.value.status == 302 || resp.value.status == 303) {
			currentMethod = HttpMethod.GET;
			currentBody = "";
		}

		remaining = remaining - 1;
	}
	return Result.err(tooManyRedirects(maxRedirects));
}

// ===== Plain HTTP transport (TCP) =====

function doRequestPlain(options: RequestOptions): Result<HttpResponse, HttpError> {
	const fd = msNetSocket();
	if (fd < 0) return Result.err(socketError("socket() failed"));

	if (options.timeout > 0) {
		msNetSetTimeout(fd, options.timeout);
	}

	if (msNetConnect(fd, options.hostname, options.port) < 0) {
		msNetClose(fd);
		return Result.err(connectionFailed(`connect to ${options.hostname}:${options.port} failed`));
	}

	return doRequestOver(
		options,
		(data: Bytes) => msNetSend(fd, rawString(data)),
		(maxBytes: int32) => rawBuffer(msNetRecv(fd, maxBytes)),
		() => msNetClose(fd),
	);
}

// ===== Public API =====

// Full options request. Rejects TLS — callers needing HTTPS use std/https.
export function request(options: RequestOptions): Result<HttpResponse, HttpError> {
	if (options.tls) {
		return Result.err(invalidRequest("HTTPS requires std/https"));
	}
	return doRequestPlain(options);
}

// Redirect-following request for plain HTTP.
export function requestWithRedirects(options: RequestOptions, maxRedirects: int32): Result<HttpResponse, HttpError> {
	if (options.tls) {
		return Result.err(invalidRequest("HTTPS requires std/https"));
	}
	return requestWithRedirectsOver(options, maxRedirects, doRequestPlain);
}

function wireOf(head: string, body: number[]): Buffer {
	return Buffer.concat(Buffer.fromString(head, "utf8"), Buffer.fromArray(body));
}

function unitsOf(value: string): string {
	const out: string[] = [];
	for (let i = 0; i < value.length; i++) out.push(value.charCodeAt(i).toString(16));
	return out.join(",");
}

function options(): RequestOptions {
	return {
		method: HttpMethod.GET, hostname: "h", port: 80, path: "/",
		headers: createHeaders(), body: "", timeout: 1000, tls: false,
	};
}

function serve(pieces: Buffer[]): (maxBytes: int32) => Buffer {
	let next = 0;
	return (maxBytes: int32) => {
		if (next >= pieces.length) return [];
		next += 1;
		return pieces[next - 1];
	};
}

function fetchOver(pieces: Buffer[]): Result<HttpResponse, HttpError> {
	return doRequestOver(options(), (data: Bytes) => 0, serve(pieces), () => {});
}

test "a response keeps every body byte and reads as valid text" {
	const response = fetchOver([wireOf("HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n", [0x61, 0xFF, 0x62, 0x00])]);
	assert response.ok;
	if (response.ok) {
		assert response.value.bytes.length == 4;
		assert response.value.bytes[1] == 0xFF;
		assert response.value.text().length == 4;
		assert unitsOf(response.value.text()) == "61,fffd,62,0";
	}
}

test "a content-length body that starts on continuation bytes and is split across reads arrives exact" {
	const head = "HTTP/1.1 200 OK\r\nContent-Length: 6\r\n\r\n";
	const response = fetchOver([
		wireOf(head, [0x80, 0xC3]),
		Buffer.fromArray([0xA9, 0xFF, 0xE2, 0x82]),
	]);
	assert response.ok;
	if (response.ok) {
		assert response.value.bytes.length == 6;
		assert response.value.bytes.toHex() == "80c3a9ffe282";
	}
}

test "a chunked body keeps a character split across the chunk boundary" {
	const head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n";
	const wire = Buffer.concatList([
		wireOf(head, []),
		Buffer.fromString("2\r\n", "utf8"), Buffer.fromArray([0xC3, 0x80]),
		Buffer.fromString("\r\n2\r\n", "utf8"), Buffer.fromArray([0xFF, 0x41]),
		Buffer.fromString("\r\n0\r\n\r\n", "utf8"),
	]);
	const response = fetchOver([wire]);
	assert response.ok;
	if (response.ok) assert response.value.bytes.toHex() == "c380ff41";
}

test "a head terminator split across reads at every offset is found" {
	const head = "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\n";
	const wire = wireOf(head, [0x68, 0x69]);
	const headEnd = head.length as int32;
	for (let cut = headEnd - 3; cut < headEnd; cut++) {
		const response = fetchOver([[...wire[0..cut]], [...wire[cut..wire.length]]]);
		assert response.ok;
		if (response.ok) assert response.value.bytes.toHex() == "6869";
	}
}

test "a chunked terminator split across reads at every offset is found" {
	const head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n";
	const tailText = "\r\n0\r\n\r\n";
	const wire = Buffer.concatList([wireOf(head, []), Buffer.fromString("1\r\nA", "utf8"), Buffer.fromString(tailText, "utf8")]);
	const tailStart = (wire.length as int32) - (tailText.length as int32);
	for (let cut = tailStart + 1; cut < tailStart + 5; cut++) {
		const response = fetchOver([[...wire[0..cut]], [...wire[cut..wire.length]]]);
		assert response.ok;
		if (response.ok) assert response.value.bytes.toHex() == "41";
	}
}

test "a head and a chunked body delivered one byte per read arrive exact" {
	const head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n";
	const wire = Buffer.concatList([wireOf(head, []), Buffer.fromString("3\r\nabc\r\n0\r\n\r\n", "utf8")]);
	const pieces: Buffer[] = [];
	for (let i = 0; i < wire.length; i++) pieces.push(Buffer.fromArray([wire[i]]));
	const response = fetchOver(pieces);
	assert response.ok;
	if (response.ok) assert response.value.bytes.toHex() == "616263";
}

test "two thousand tiny chunks arrive exact" {
	const head = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n";
	const pieces: Buffer[] = [wireOf(head, [])];
	for (let i = 0; i < 2000; i++) pieces.push(Buffer.fromString("1\r\nx\r\n", "utf8"));
	pieces.push(Buffer.fromString("0\r\n\r\n", "utf8"));
	const response = fetchOver(pieces);
	assert response.ok;
	if (response.ok) assert response.value.bytes.length == 2000;
}

test "a body read until close keeps every byte" {
	const response = fetchOver([wireOf("HTTP/1.1 200 OK\r\n\r\n", [0xE2, 0x82]), Buffer.fromArray([0xAC, 0x80])]);
	assert response.ok;
	if (response.ok) assert response.value.bytes.toHex() == "e282ac80";
}

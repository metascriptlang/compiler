when (!bare && !solana) {
	@include("runtime/bigint/bigint.h");

	// mbedTLS bignum only — no PSA/TLS sources are pulled in by this module.
	@passC("-Iruntime/crypto");
	@passC("-Ivendor/mbedtls/tf-psa-crypto/include");
	@passC("-Ivendor/mbedtls/tf-psa-crypto/core");
	@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/include");
	@passC("-Ivendor/mbedtls/tf-psa-crypto/drivers/builtin/src");
	@passC("-DMBEDTLS_CONFIG_FILE=\"<mbedtls/mbedtlsConfig.h>\"");
	// bignum.h lives under mbedtls/private and only declares mbedtls_mpi_* when the
	// consumer opts in to the private surface.
	@passC("-DMBEDTLS_DECLARE_PRIVATE_IDENTIFIERS");

	@compile("runtime/bigint/bigint.c");
	@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/bignum.c");
	@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/bignum_core.c");
	@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/constant_time.c");
	@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/platform_util.c");
	// bignum.c allocates through mbedtls_calloc/mbedtls_free, real functions under
	// MBEDTLS_PLATFORM_MEMORY: only dead stripping lets an executable link without them.
	@compile("vendor/mbedtls/tf-psa-crypto/drivers/builtin/src/platform.c");

	// The operator forms are synthesized by src/transform/native/bigIntOpLower.ms
	// and reach C as bare calls against the header above.
	when (mscDeclaresRuntime) {
		@compilerFunc
		extern function msBigIntAdd(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntSub(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntMul(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntDiv(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntMod(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntPow(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntAnd(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntOr(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntXor(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntShl(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntShr(a: bigint, b: bigint): bigint;
		@compilerFunc
		extern function msBigIntNeg(a: bigint): bigint;
		@compilerFunc
		extern function msBigIntNot(a: bigint): bigint;
		@compilerFunc
		extern function msBigIntCmp(a: bigint, b: bigint): int32;
		@compilerFunc
		extern function msBigIntIsZero(a: bigint): boolean;
		@compilerFunc
		extern function msBigIntToInt64(a: bigint): int64;
		@compilerFunc
		extern function msBigIntToDebugString(a: bigint): string;
	}
	@compilerFunc
	extern function msBigIntToString(b: bigint, radix: int32): string;
	@compilerFunc
	extern function msBigIntToFloat64(b: bigint): float64;
	@compilerFunc
	extern function msBigIntToFloat32(b: bigint): float32;
	@compilerFunc
	extern function msBigIntToSigned(b: bigint, bits: int32): int64;
	@compilerFunc
	extern function msBigIntFromFloat64(v: float64): bigint;
	@compilerFunc
	extern function msBigIntFromLit(s: string): bigint;
	@compilerFunc
	extern function msBigIntFromInt64(v: int64): bigint;
	@compilerFunc
	extern function msBigIntFromUint64(v: uint64): bigint;
	extern function msBigIntAsIntN(bits: int64, b: bigint): bigint;
	extern function msBigIntAsUintN(bits: int64, b: bigint): bigint;
	extern function msBigIntParses(s: string): boolean;
	extern function msBigIntParse(s: string): bigint;

	export function toString(this b: bigint, radix: int32 = 10): string {
		return msBigIntToString(b, radix);
	}

	export function BigInt(v: string): bigint {
		if (!msBigIntParses(v)) throw new Error("Cannot convert " + v + " to a BigInt");
		return msBigIntParse(v);
	}

	export extern function asIntN(this typeof BigInt, bits: int64, b: bigint): bigint from "msBigIntAsIntN";
	export extern function asUintN(this typeof BigInt, bits: int64, b: bigint): bigint from "msBigIntAsUintN";
}

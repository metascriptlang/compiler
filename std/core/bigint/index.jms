// bigint on the js target is the native BigInt primitive: the operators need no
// lowering and the literal reaches the emitter verbatim. The module exists so the
// prelude import resolves on both targets; the conversion surface lands here.

export function toString(this b: bigint, radix: int32 = 10): string {
	@emit(`return ${b}.toString(Number(${radix}));`);
	unreachable;
}

export function BigInt(v: string): bigint {
	@emit(`return globalThis.BigInt(${v});`);
	unreachable;
}

export function asIntN(this typeof BigInt, bits: int64, b: bigint): bigint {
	@emit(`return globalThis.BigInt.asIntN(Number(${bits}), ${b});`);
	unreachable;
}

export function asUintN(this typeof BigInt, bits: int64, b: bigint): bigint {
	@emit(`return globalThis.BigInt.asUintN(Number(${bits}), ${b});`);
	unreachable;
}

@compilerFunc
function msBigIntToSigned(b: bigint, bits: int32): bigint {
	@emit(`const hi = (1n << BigInt(${bits} - 1)) - 1n;
	if (${b} > hi || ${b} < -hi - 1n) {
		const m = "value " + ${b} + " not in range " + (-hi - 1n) + " .. " + hi;
		if (typeof process === "object" && process !== null && typeof process.exit === "function") {
			process.stderr.write("Error: " + m + "\\n");
			process.exit(1);
		}
		const e = new Error(m);
		e.msDefect = true;
		throw e;
	}
	return ${b};`);
	unreachable;
}

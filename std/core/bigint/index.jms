// bigint on the js target is the native BigInt primitive: the operators need no
// lowering and the literal reaches the emitter verbatim. The module exists so the
// prelude import resolves on both targets; the conversion surface lands here.

export function toString(this b: bigint, radix: int32 = 10): string {
	if (radix < 2 || radix > 36) throw new RangeError("toString() radix argument must be between 2 and 36");
	@emit(`return ${b}.toString(Number(${radix}));`);
	unreachable;
}

export function BigInt(v: string): bigint {
	try {
		return parseBigInt(v);
	} catch (e) {
		throw new SyntaxError(`Cannot convert ${v} to a BigInt`);
	}
}

export function BigInt(v: float64): bigint { return v as bigint; }

export function BigInt(v: boolean): bigint { return v ? 1n : 0n; }
export function BigInt(v: int8): bigint { return v as bigint; }
export function BigInt(v: int16): bigint { return v as bigint; }
export function BigInt(v: int32): bigint { return v as bigint; }
export function BigInt(v: int64): bigint { return v as bigint; }
export function BigInt(v: uint8): bigint { return v as bigint; }
export function BigInt(v: uint16): bigint { return v as bigint; }
export function BigInt(v: uint32): bigint { return v as bigint; }
export function BigInt(v: uint64): bigint { return v as bigint; }
export function BigInt(v: char): bigint { return v as bigint; }
export function BigInt(v: bigint): bigint { return v; }

function notIntegerMessage(v: float64): string {
	return `The number ${v} cannot be converted to a BigInt because it is not an integer`;
}

function parseBigInt(v: string): bigint {
	@emit(`return globalThis.BigInt(${v});`);
	unreachable;
}

@compilerFunc
function msBigIntFromNumber(v: float64): bigint {
	if (v % 1.0 != 0.0) throw new RangeError(notIntegerMessage(v));
	@emit(`return globalThis.BigInt(${v});`);
	unreachable;
}

export function asIntN(this typeof BigInt, bits: int64, b: bigint): bigint {
	@emit(`return globalThis.BigInt.asIntN(Number(${bits}), ${b});`);
	unreachable;
}

export function asUintN(this typeof BigInt, bits: int64, b: bigint): bigint {
	@emit(`return globalThis.BigInt.asUintN(Number(${bits}), ${b});`);
	unreachable;
}

@compilerFunc
function msBigIntToSigned(b: bigint, bits: int32): bigint {
	@emit(`const hi = (1n << BigInt(${bits} - 1)) - 1n;
	if (${b} > hi || ${b} < -hi - 1n) {
		const m = "value " + ${b} + " not in range " + (-hi - 1n) + " .. " + hi;
		if (typeof process === "object" && process !== null && typeof process.exit === "function") {
			process.stderr.write("Error: " + m + "\\n");
			process.exit(1);
		}
		const e = new Error(m);
		e.msDefect = true;
		throw e;
	}
	return ${b};`);
	unreachable;
}

@compilerFunc
function msBigIntToFloat32(b: bigint): float32 {
	@emit(`const neg = ${b} < 0n;
	const m = neg ? -${b} : ${b};
	const n = m.toString(2).length;
	if (n <= 24) return Number(${b});
	const shift = BigInt(n - 24);
	let q = m >> shift;
	const rest = m - (q << shift);
	const half = 1n << (shift - 1n);
	if (rest > half || (rest === half && (q & 1n) === 1n)) q = q + 1n;
	const r = Math.fround(Number(q) * 2 ** Number(shift));
	return neg ? -r : r;`);
	unreachable;
}

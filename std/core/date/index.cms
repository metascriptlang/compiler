// std/core/date — prelude.
//
// `Date` is auto-imported into every program as a prelude class (like
// `Math`, `JSON`, `Promise`). Currently minimal: `Date.now()` (wall-clock
// milliseconds since Unix epoch), `new Date(ms?)`, `getTime()` and `valueOf()`.
//
// Future additions (not in v0.1): `Date.parse(iso)`,
// instance methods (toISOString, getFullYear, etc.).

when (!bare && !solana) {
	@include("runtime/core/datetime.h");
	@compile("runtime/core/datetime.c");

	import { Math, abs, trunc } from "../math";
	import { Number } from "../number";

	extern function msTimeNow(): number;

	function timeClip(t: number): number {
		if (Math.abs(t) > 8.64e15) return Number.NaN;
		return Math.trunc(t) + 0.0;
	}

	export class Date {
		private ms: number;

		constructor(ms: number = Date.now()) {
			this.ms = timeClip(ms);
		}

		// Wall-clock time in whole milliseconds since Unix epoch, as JS/Node
		// `Date.now()`. Use when comparing to external timestamps — not for
		// elapsed-time measurement (use `performance.now()`).
		static now(): number {
			return timeClip(msTimeNow());
		}

		getTime(): number {
			return this.ms;
		}

		valueOf(): number {
			return this.ms;
		}
	}
}

// MetaScript String Prelude — Raiser Backend
// Shape-mirrors std/core/string/index.cms minus the C-only surface
// (@include/@compile, in-place mutation, capacity). Kernels only where the
// Raiser side has a real fast path: charAt/slice are opcode-intercepted,
// charCodeAt/asBytes/asString go through host bridges, everything else is
// the shared Tier-2 byte-loop source (same 17 names as index.cms).

// ===== Operators =====
export extern function `==`(this a: string, b: string): boolean from "msStringEquals";
export extern function `<`(this a: string, b: string): boolean from "msStringCompareLt";
export function `!=`(this a: string, b: string): boolean { return !(a == b); }
export function `>`(this a: string, b: string): boolean { return b < a; }
export function `<=`(this a: string, b: string): boolean { return !(b < a); }
export function `>=`(this a: string, b: string): boolean { return !(a < b); }

// ===== Comparison =====
export function equals(this s: string, other: string): boolean { return s == other; }

// ===== Search =====
export function indexOf(this s: string, sub: string, start: int32 = 0): int32 {
	return s.byteIndexOf(sub, start);
}
export function lastIndexOf(this s: string, sub: string, startIdx: int32 = -1): int32 {
	return s.byteLastIndexOf(sub, startIdx);
}

// ===== Extraction =====
export extern function charAt(this s: string, idx: int32): string from "msStringCharAt";
export extern function charCodeAt(this s: string, idx: int32): int32 from "msStringCharCodeAt";
export extern function slice(this s: string, start: int32, end: int32): string from "msStringSlice";
export extern function substring(this s: string, start: int32, end: int32): string from "msStringSubstring";

// ===== Zero-Copy Bridge (string → uint8[]) =====

export extern function asBytes(this s: string): uint8[] from "msAsBytes";

// ===== Shared Byte-Loop Algorithms (single source, both backends) =====
export function byteLength(this s: string): int32 {
	return s.asBytes().length;
}

export function byteAt(this s: string, idx: int32): int32 {
	const b = s.asBytes();
	if (idx < 0 || idx >= b.length) return -1;
	return b[idx] as int32;
}

export function byteSlice(this s: string, start: int32, end: int32): string {
	const b = s.asBytes();
	const result: uint8[] = [];
	let i = start;
	while (i < end && i < b.length) { result.push(b[i]); i = i + 1; }
	return result.asString();
}

// ===== Transformation =====
export extern function padStart(this s: string, targetLen: int32, pad: string): string from "msStringPadStart";
export extern function padEnd(this s: string, targetLen: int32, pad: string): string from "msStringPadEnd";

// ===== Parsing =====
export extern function parseFloat(this s: string): number from "msStringParseFloat";
export extern function parseInt(this s: string): int64 from "msStringParseInt";

// ===== Character Construction =====
export extern function fromCodePoint(cp: number): string from "msStringFromCodePoint";

export { byteIndexOf, byteLastIndexOf, startsWith, endsWith, contains, count, trim, trimStart, trimEnd, split, toLowerCase, toUpperCase, replace, replaceAll, repeat, reverse, equalsIgnoreCase, asciiLower, asciiUpper, isSpaceByte } from "./shared";

// MetaScript String Prelude — Raiser Backend
// Shape-mirrors std/core/string/index.cms minus the C-only surface
// (@include/@compile). Kernels only where the
// Raiser side has a real fast path: charAt/slice are opcode-intercepted,
// charCodeAt/asBytes/asString, the byte tier, split and replace go through host bridges,
// everything else is the shared Tier-2 byte-loop source.

// ===== Operators =====
export extern function `==`(this a: string, b: string): boolean from "msStringEquals";
export extern function `<`(this a: string, b: string): boolean from "msStringCompareLt";
export extern function `<=`(this a: string, b: string): boolean from "msStringCompareLe";
// Derived operators (!=, >, >=) come from the system templates.

@builtin("ToString")
export extern function String<T>(val: T): string;

// ===== Comparison =====
export function equals(this s: string, other: string): boolean { return s == other; }

// ===== Extraction =====
export extern function charAt(this s: string, idx: int32): string from "msStringCharAt";
export extern function charCodeAt(this s: string, idx: int32): int32 from "msStringCharCodeAt";
export extern function slice(this s: string, start: int32, end: int32 = 2147483647): string from "msStringSlice";

/** Returns the character at the index, counting from the end for a negative one; an index out of range gives null, like `find` on a miss. */
export function at(this s: string, idx: int32): string | null {
	const i = idx < 0 ? s.length + idx : idx;
	if (i < 0 || i >= s.length) return null;
	return s.charAt(i);
}

export function substring(this s: string, start: int32, end: int32 = 2147483647): string {
	const a = clampIndex(start, s.length);
	const b = clampIndex(end, s.length);
	return a <= b ? s.slice(a, b) : s.slice(b, a);
}

export { asBytes, byteLength, byteAt, byteSlice, byteIndexOf, byteLastIndexOf } from "./bytes";

// ===== Transformation =====
export { replace, replaceAll, padStart, padEnd, split } from "./editNative";

// ===== Parsing =====
export function parseFloat(this s: string): number {
	return parseFloatPrefix(s);
}
export function parseInt(this s: string): int64 {
	return parseIntPrefix(s);
}

// ===== Character Construction =====
export extern function fromCodePoint(cp: number): string from "msStringFromCodePoint";

const CHAR_UNIT_MASK: int32 = 0xFFFF;

export function fromCharCode(this typeof String, ...codes: int32[]): string {
	let text = "";
	for (const code of codes) text += fromCodePoint((code & CHAR_UNIT_MASK) as number);
	return text;
}

import { clampIndex } from "./shared";
import { parseFloatPrefix, parseIntPrefix } from "../number/parse";
export { repeat, reverse, equalsIgnoreCase, asciiLower, asciiUpper, isSpaceByte } from "./shared";
import { asBytes, byteSlice, wellFormedString } from "./bytes";
import { asciiLower, asciiUpper, isSpaceByte } from "./shared";

// The Raiser keeps the ASCII-only byte loops; C and JS return the ECMAScript result for every code point.
export function trim(this s: string): string {
	const sb = s.asBytes();
	if (sb.length == 0) return "";
	let a = 0;
	let b = sb.length - 1;
	while (a <= b && isSpaceByte(sb[a] as int32)) { a = a + 1; }
	while (b >= a && isSpaceByte(sb[b] as int32)) { b = b - 1; }
	return s.byteSlice(a, b + 1);
}

export function trimStart(this s: string): string {
	const sb = s.asBytes();
	if (sb.length == 0) return "";
	let a = 0;
	while (a < sb.length && isSpaceByte(sb[a] as int32)) { a = a + 1; }
	return s.byteSlice(a, sb.length);
}

export function trimEnd(this s: string): string {
	const sb = s.asBytes();
	if (sb.length == 0) return "";
	let b = sb.length;
	while (b > 0 && isSpaceByte(sb[b - 1] as int32)) { b = b - 1; }
	return s.byteSlice(0, b);
}

export function toLowerCase(this s: string): string {
	const sb = s.asBytes();
	const result: uint8[] = [];
	let i = 0;
	while (i < sb.length) { result.push(asciiLower(sb[i] as int32) as uint8); i = i + 1; }
	return wellFormedString(result);
}

export function toUpperCase(this s: string): string {
	const sb = s.asBytes();
	const result: uint8[] = [];
	let i = 0;
	while (i < sb.length) { result.push(asciiUpper(sb[i] as int32) as uint8); i = i + 1; }
	return wellFormedString(result);
}

export { indexOf, lastIndexOf, startsWith, endsWith, includes, contains, count } from "./search";

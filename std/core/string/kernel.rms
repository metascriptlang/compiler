// MetaScript String Kernel — Raiser Backend
// Kernels only where the Raiser side has a real fast path: charAt/slice are
// opcode-intercepted, charCodeAt/asBytes/asString and the byte tier go through
// host bridges, everything else is the shared byte-loop source.

// ===== Comparison =====
export function equals(this s: string, other: string): boolean { return s == other; }

// ===== Search =====
export function indexOf(this s: string, sub: string, start: int32 = 0): int32 {
	return s.byteIndexOf(sub, start);
}
export function lastIndexOf(this s: string, sub: string, startIdx: int32 = -1): int32 {
	return s.byteLastIndexOf(sub, startIdx);
}

// ===== Extraction =====
export extern function charAt(this s: string, idx: int32): string from "msStringCharAt";
export extern function charCodeAt(this s: string, idx: int32): int32 from "msStringCharCodeAt";
export extern function slice(this s: string, start: int32, end: int32 = 2147483647): string from "msStringSlice";

// ===== Transformation =====
export extern function padStart(this s: string, targetLen: int32, pad: string): string from "msStringPadStart";
export extern function padEnd(this s: string, targetLen: int32, pad: string): string from "msStringPadEnd";

// ===== Parsing =====
export extern function parseFloat(this s: string): number from "msStringParseFloat";
export extern function parseInt(this s: string): int64 from "msStringParseInt";

// ===== Character Construction =====
export extern function fromCodePoint(cp: number): string from "msStringFromCodePoint";

const CHAR_UNIT_MASK: int32 = 0xFFFF;

export function fromCharCode(this typeof String, code: int32): string {
	return fromCodePoint((code & CHAR_UNIT_MASK) as number);
}

// ===== Zero-Copy Bridge (string → Readonly<Span<uint8>>) =====

@builtin("AsBytes")
export extern function asBytes(this s: string): Readonly<Span<uint8>> from "msAsBytes";

// ===== Byte Kernels =====
export extern function byteLength(this s: string): int32 from "msStringByteLength";
export extern function byteAt(this s: string, idx: int32): int32 from "msStringByteAt";
export extern function byteSlice(this s: string, start: int32, end: int32): string from "msStringByteSlice";
export extern function byteIndexOf(this s: string, sub: string, start: int32 = 0): int32 from "msStringByteIndexOf";
export extern function byteLastIndexOf(this s: string, sub: string, startIdx: int32 = -1): int32 from "msStringByteLastIndexOf";

// ===== Capacity & In-Place Mutation =====
export extern function capacity(this s: string): int32 from "msStringCapacity";
export extern function setLength(this s: string, newLen: int32): void from "&msStringSetLength";
export extern function append(this s: string, other: string): void from "&msStringAppend";
export extern function setSlice(this s: string, start: number, end: number): void from "&msStringSetSlice";
export extern function stripInPlace(this s: string): void from "&msStringStripInPlace";

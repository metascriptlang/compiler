// MetaScript String Byte Tier — Raiser Backend

// ===== Zero-Copy Bridge (string → Readonly<Span<uint8>>) =====

@builtin("AsBytes")
export extern function asBytes(this s: string): Readonly<Span<uint8>> from "msAsBytes";

// ===== Byte Kernels =====
export extern function byteLength(this s: string): int32 from "msStringByteLength";
export extern function byteAt(this s: string, idx: int32): int32 from "msStringByteAt";
export extern function byteSlice(this s: string, start: int32, end: int32): string from "msStringByteSlice";
export extern function byteIndexOf(this s: string, sub: string, start: int32 = 0): int32 from "msStringByteIndexOf";
export extern function byteLastIndexOf(this s: string, sub: string, startIdx: int32 = -1): int32 from "msStringByteLastIndexOf";

// MetaScript String Byte Tier — C Backend

@include("runtime/core/string.h");

// ===== Zero-Copy Bridge (string → Readonly<Span<uint8>>) =====

/** Returns a read-only view of the string's underlying bytes (zero-copy); `[...s.asBytes()]` copies them. */
@builtin("AsBytes")
export extern function asBytes(this s: string): Readonly<Span<uint8>> from "msAsBytes";

import { wellFormedPrefix, repairedLength, writeRepaired } from "./utf8Repair";

extern function newBytes(length: int64): string from "msStringNewUninit";
extern function copyBytes(dst: Ptr<uint8>, at: int64, src: Readonly<Span<uint8>>, from: int64, n: int64): void from "msMemCopyTo";
extern function msStringMarkAscii(s: string): void;
extern function msStringMarkNonAscii(s: string): void;

const highBits: uint64 = 0x8080808080808080;

// Keep the scan single-exit: clang 18/21 turn a `return false` inside a byte loop of a
// boolean function into a per-byte select, measured ~1.35x slower than the C kernel.
export function asciiWords(bytes: Readonly<Ptr<uint8>>, wordCount: int64): int64 {
	const words = bytes as Readonly<Ptr<uint64>>;
	let word: int64 = 0;
	while (word < wordCount && (words[word] & highBits) == 0) word += 1;
	return word;
}

function asciiPrefix(data: Readonly<Span<uint8>>): int64 {
	const length = data.length as int64;
	if (length == 0) return 0;
	const bytes = data as Readonly<Ptr<uint8>>;
	let i = asciiWords(bytes, length >> 3) << 3;
	while (i < length && bytes[i] < 0x80) i += 1;
	return i;
}

/** The bytes as a string: each ill-formed UTF-8 sequence becomes one U+FFFD per maximal subpart; with `surrogates`, encoded surrogates stay and a split pair joins into its 4-byte form. */
export function utf8String(data: Readonly<Span<uint8>>, surrogates: boolean): string {
	const length = data.length as int64;
	const ascii = asciiPrefix(data);
	const valid = ascii == length ? length : wellFormedPrefix(data, ascii, surrogates);
	if (valid == length) {
		const whole = newBytes(length);
		copyBytes((whole as cstring) as Ptr<uint8>, 0, data, 0, length);
		if (ascii == length) msStringMarkAscii(whole); else msStringMarkNonAscii(whole);
		return whole;
	}
	return repairedString(data, valid, surrogates);
}

function repairedString(data: Readonly<Span<uint8>>, valid: int64, surrogates: boolean): string {
	const result = newBytes(repairedLength(data, valid, surrogates));
	const bytes = (result as cstring) as Ptr<uint8>;
	copyBytes(bytes, 0, data, 0, valid);
	writeRepaired(data, valid, surrogates, bytes);
	msStringMarkNonAscii(result);
	return result;
}

/** A string a kernel filled from outside, as text: the same string, neither copied nor allocated, when it is already valid (one scan, ASCII fast path first); an ill-formed one is repaired as `utf8String` repairs it. `raw` is a sink: a last-use argument moves in and out without a copy, and a valid one is flagged in place. */
export function utf8Text(sink raw: string, surrogates: boolean): string {
	const data = raw.asBytes();
	const length = data.length as int64;
	if (length == 0) return raw;
	const ascii = asciiPrefix(data);
	const valid = ascii == length ? length : wellFormedPrefix(data, ascii, surrogates);
	if (valid != length) return repairedString(data, valid, surrogates);
	if (ascii == length) msStringMarkAscii(raw); else msStringMarkNonAscii(raw);
	return raw;
}

/** The bytes as a string without a scan; the caller guarantees well-formed WTF-8 with no split surrogate pair. */
export function wellFormedString(data: Readonly<Span<uint8>>): string {
	const length = data.length as int64;
	const whole = newBytes(length);
	copyBytes((whole as cstring) as Ptr<uint8>, 0, data, 0, length);
	return whole;
}

// ===== Shared Byte-Loop Algorithms (single source, both backends) =====
export function byteLength(this s: string): int32 {
	return s.asBytes().length;
}

export function byteAt(this s: string, idx: int32): int32 {
	const b = s.asBytes();
	if (idx < 0 || idx >= b.length) return -1;
	return b[idx] as int32;
}

@exportName("msStringByteAt")
function byteAtOrNone(s: string, idx: int64): int64 {
	const b = s.asBytes();
	return idx < 0 || idx >= b.length ? -1 : b[idx] as int64;
}

extern function byteSliceKernel(s: string, start: int32, end: int32): string from "msStringByteSlice";

export function byteSlice(this s: string, start: int32, end: int32): string {
	const length = s.asBytes().length;
	const from = start < 0 ? 0 : start > length ? length : start;
	const to = end < from ? from : end > length ? length : end;
	return byteSliceKernel(s, from, to);
}

extern function msMemChr(hay: Readonly<Span<uint8>>, from: int64, end: int64, byte: uint8): int64;
export extern function byteEqAt(hay: Readonly<Span<uint8>>, at: int64, needle: Readonly<Span<uint8>>): boolean from "msMemEqAt";
export extern function byteIsAscii(s: string): boolean from "msStringIsAscii";

/** First index at or after `from` where the non-empty `nb` occurs in `hb`, or -1. */
@inline
export function findBytesFrom(hb: Readonly<Span<uint8>>, nb: Readonly<Span<uint8>>, from: int64): int64 {
	const limit = hb.length - nb.length;
	let at = from;
	while (at <= limit) {
		const hit = msMemChr(hb, at, limit + 1, nb[0]);
		if (hit < 0) return -1;
		if (nb.length == 1 || byteEqAt(hb, hit, nb)) return hit;
		at = hit + 1;
	}
	return -1;
}

@exportName("msStringByteIndexOf")
export function stringByteIndexOf(s: string, sub: string, byteStart: int64): int64 {
	const nb = sub.asBytes();
	if (nb.length == 0) return byteStart;
	return findBytesFrom(s.asBytes(), nb, byteStart < 0 ? 0 : byteStart);
}

export function byteIndexOf(this s: string, sub: string, start: int32 = 0): int32 {
	return stringByteIndexOf(s, sub, start) as int32;
}

export function byteLastIndexOf(this s: string, sub: string, startIdx: int32 = -1): int32 {
	const sb = s.asBytes();
	const xb = sub.asBytes();
	if (xb.length == 0) return sb.length;
	if (xb.length > sb.length) return -1;
	let i = sb.length - xb.length;
	if (startIdx >= 0 && startIdx < i) i = startIdx;
	while (i >= 0) {
		let found = true;
		let j = 0;
		while (j < xb.length) {
			if (sb[i + j] != xb[j]) { found = false; break; }
			j = j + 1;
		}
		if (found) return i;
		i = i - 1;
	}
	return -1;
}

// MetaScript String Prelude — JavaScript Backend
// string = native JS string (docs/STRING-CONTRACT.md §3). The byte tier is a
// hand-rolled WTF-8 encode cached per string — TextEncoder is banned: it
// rewrites lone surrogates to U+FFFD while the C payload keeps raw WTF-8.

// ===== WTF-8 byte tier =====

function wtf8Cached(s: string): uint8[] {
	@emit(`var g = globalThis.__msWtf8Cache || (globalThis.__msWtf8Cache = new Map());
	var c = g.get(${s});
	if (c !== undefined) return c;
	var r = [], i = 0;
	while (i < ${s}.length) {
		var ch = ${s}.charCodeAt(i);
		if (ch < 128) { r.push(ch); }
		else if (ch < 2048) { r.push((ch >> 6) | 192, (ch & 63) | 128); }
		else if (ch < 55296 || ch >= 57344) { r.push((ch >> 12) | 224, ((ch >> 6) & 63) | 128, (ch & 63) | 128); }
		else { var lo = ${s}.charCodeAt(i + 1); if (ch < 56320 && lo >= 56320 && lo < 57344) { i++; var cp2 = 65536 + (((ch & 1023) << 10) | (lo & 1023)); r.push((cp2 >> 18) | 240, ((cp2 >> 12) & 63) | 128, ((cp2 >> 6) & 63) | 128, (cp2 & 63) | 128); } else { r.push((ch >> 12) | 224, ((ch >> 6) & 63) | 128, (ch & 63) | 128); } }
		i++;
	}
	if (g.size >= 512) g.clear();
	g.set(${s}, r);
	return r;`);
	unreachable;
}

// Fresh mutable copy — the cache entry must never escape.
export function asBytes(this s: string): uint8[] {
	const c = wtf8Cached(s);
	@emit(`return ${c}.slice();`);
	unreachable;
}

// WTF-8 decode — 3-byte sequences may decode to lone surrogates (round-trip).
export function asString(this arr: uint8[]): string {
	@emit(`var b = ${arr}, r = "", i = 0;
	while (i < b.length) {
		var x = b[i];
		if (x < 128) { r += String.fromCharCode(x); i++; }
		else if (x < 224) { r += String.fromCharCode(((x & 31) << 6) | (b[i+1] & 63)); i += 2; }
		else if (x < 240) { r += String.fromCharCode(((x & 15) << 12) | ((b[i+1] & 63) << 6) | (b[i+2] & 63)); i += 3; }
		else { var cp = ((x & 7) << 18) | ((b[i+1] & 63) << 12) | ((b[i+2] & 63) << 6) | (b[i+3] & 63); cp -= 65536; r += String.fromCharCode(55296 + (cp >> 10), 56320 + (cp & 1023)); i += 4; }
	}
	return r;`);
	unreachable;
}

export function byteLength(this s: string): int32 {
	return wtf8Cached(s).length;
}

export function byteAt(this s: string, idx: int32): int32 {
	const b = wtf8Cached(s);
	if (idx < 0 || idx >= b.length) return -1;
	return b[idx] as int32;
}

export function byteSlice(this s: string, start: int32, end: int32): string {
	const b = wtf8Cached(s);
	const sub: uint8[] = [];
	for (let i = start < 0 ? 0 : start; i < end && i < b.length; i += 1) {
		sub.push(b[i]);
	}
	return sub.asString();
}

// ===== Operators =====

export function `==`(this a: string, b: string): boolean {
	@emit(`return ${a} === ${b};`);
	unreachable;
}
export function `<`(this a: string, b: string): boolean {
	@emit(`return ${a} < ${b};`);
	unreachable;
}
export function `!=`(this a: string, b: string): boolean { return !(a == b); }
export function `>`(this a: string, b: string): boolean { return b < a; }
export function `<=`(this a: string, b: string): boolean { return !(b < a); }
export function `>=`(this a: string, b: string): boolean { return !(a < b); }

export function msStringCompare(a: string, b: string): int32 {
	@emit(`return ${a} < ${b} ? -1 : (${a} > ${b} ? 1 : 0);`);
	unreachable;
}

export function msStringEquals(a: string, b: string): boolean {
	@emit(`return ${a} === ${b};`);
	unreachable;
}

// ===== String Extension Methods (after lowering: s.method(args) → method(s, args)) =====

export function charAt(this s: string, idx: int32): string {
	@emit(`return (${idx} < 0 || ${idx} >= ${s}.length) ? "" : ${s}.charAt(${idx});`);
	unreachable;
}

export function charCodeAt(this s: string, idx: int32): int32 {
	@emit(`return (${idx} < 0 || ${idx} >= ${s}.length) ? -1 : ${s}.charCodeAt(${idx});`);
	unreachable;
}

export function indexOf(this s: string, sub: string, start: int32 = 0): int32 {
	@emit(`return ${s}.indexOf(${sub}, ${start});`);
	unreachable;
}

export function lastIndexOf(this s: string, sub: string, startIdx: int32 = -1): int32 {
	@emit(`return ${startIdx} < 0 ? ${s}.lastIndexOf(${sub}) : ${s}.lastIndexOf(${sub}, ${startIdx});`);
	unreachable;
}

export function slice(this s: string, start: int32, end: int32): string {
	@emit(`return ${s}.slice(${start}, ${end});`);
	unreachable;
}

export function equals(this s: string, other: string): boolean {
	return msStringEquals(s, other);
}

export function substring(this s: string, start: int32, end: int32): string {
	return s.slice(start, end);
}

export function padStart(this s: string, targetLen: int32, pad: string): string {
	@emit(`return ${s}.padStart(${targetLen}, ${pad});`);
	unreachable;
}

export function padEnd(this s: string, targetLen: int32, pad: string): string {
	@emit(`return ${s}.padEnd(${targetLen}, ${pad});`);
	unreachable;
}

// strtod/strtoll parity: unparseable input is 0, never NaN.
export function parseFloat(this s: string): number {
	@emit(`var v = Number.parseFloat(${s}); return Number.isNaN(v) ? 0 : v;`);
	unreachable;
}

export function parseInt(this s: string): int64 {
	@emit(`var v = Number.parseInt(${s}, 10); return Number.isNaN(v) ? 0 : v;`);
	unreachable;
}

// Native strings carry no separate allocation — capacity is the byte length.
export function capacity(this s: string): int32 {
	return s.byteLength();
}

export function fromCodePoint(cp: number): string {
	@emit(`return (${cp} < 0 || ${cp} > 1114111) ? "" : String.fromCodePoint(${cp});`);
	unreachable;
}

// Number/bool to string (called by builtinLower .toString())
export function msNumberToString(n: number): string {
	@emit(`return String(${n});`);
	unreachable;
}

export function msNumberToStringRadix(n: number, radix: number): string {
	@emit(`return ${n}.toString(${radix});`);
	unreachable;
}

// 64-bit integer formatting. On C these take an int64/uint64 parameter so the
// value never round-trips through a double; here every number is already a
// double, so they are the same String()/toString() call. Exact int64 semantics
// on this backend wait on the BigInt mapping — until then these exist so the
// shared lowering can name one function for both backends.
export function msIntToString(n: int64): string {
	@emit(`return String(${n});`);
	unreachable;
}

export function msUint64ToString(n: uint64): string {
	@emit(`return String(${n});`);
	unreachable;
}

export function msIntToStringRadix(n: int64, radix: number): string {
	@emit(`return ${n}.toString(${radix});`);
	unreachable;
}

export function msUint64ToStringRadix(n: uint64, radix: number): string {
	@emit(`return ${n}.toString(${radix});`);
	unreachable;
}

export function msBoolToString(b: boolean): string {
	@emit(`return ${b} ? "true" : "false";`);
	unreachable;
}

// String hash — DJB2 over WTF-8 bytes (matches C runtime msStringHash)
export function msStringHash(s: string): int32 {
	const sb = wtf8Cached(s);
	let h: int32 = 5381;
	for (let i = 0; i < sb.length; i += 1) {
		h = (h * 33 + sb[i]) as int32;
	}
	return h;
}

// .length on string → UTF-16 code units (LANG.md Index-Space Contract) = native.
export function msStringLength(s: string): int32 {
	@emit(`return ${s}.length;`);
	unreachable;
}

// ===== Shared Byte-Loop Algorithms (single source, both backends) =====
export { byteIndexOf, byteLastIndexOf, startsWith, endsWith, contains, count, trim, trimStart, trimEnd, split, toLowerCase, toUpperCase, replace, replaceAll, repeat, reverse, equalsIgnoreCase } from "./shared";

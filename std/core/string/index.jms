// MetaScript String Prelude — JavaScript Backend
// Strings are UTF-8 byte arrays (number[]), same as C backend.
// toJSStr/fromJSStr use @emit with template interpolation for native JS String interop.

// Native JS API
extern class String {
	static fromCharCode(code: int32): string;
}

// Zero-copy bridge (string ↔ uint8[]) — identity in JS
export function asBytes(this s: string): uint8[] {
	return s as unknown as uint8[];
}

export function asString(this arr: uint8[]): string {
	return arr as unknown as string;
}

// String concat — creates new byte array (called by lowerStringConcatFlatten for 2-part +)
export function msStringConcat(a: string, b: string): string {
	const ab = a.asBytes();
	const bb = b.asBytes();
	const result: uint8[] = [];
	let i = 0;
	while (i < ab.length) { result.push(ab[i]); i = i + 1; }
	i = 0;
	while (i < bb.length) { result.push(bb[i]); i = i + 1; }
	return result.asString();
}

// String concat N parts — rest params (called by lowerStringConcatFlatten for 3+ part +)
// On JS, count is ignored — we iterate ...parts directly. On C, the codegen rewrites
// the call into `msStringConcatArr(arr, count)` against a stack-local array.
export function msStringConcatArr(count: number, ...parts: string[]): string {
	const result: uint8[] = [];
	let i = 0;
	while (i < parts.length) {
		const part = parts[i];
		const p = part.asBytes();
		let j = 0;
		while (j < p.length) { result.push(p[j]); j = j + 1; }
		i = i + 1;
	}
	return result.asString();
}

// Self-append N parts — called by stringOpLower for `x = x + a + b + ...`
// and `x = `${x}${a}${b}``. Thin loop over msStringAppend (same pattern as
// the C runtime wrapper).
export function msStringAppendArr(dest: string, count: number, ...parts: string[]): void {
	let i = 0;
	while (i < parts.length) { msStringAppend(dest, parts[i]); i = i + 1; }
}

// ===== Operators =====
// Primitive operators (implementation)
export function `==`(this a: string, b: string): boolean {
	return msStringEquals(a, b);
}
export function `<`(this a: string, b: string): boolean {
	return msStringCompare(a, b) < 0;
}
// Derived operators (call == and < internally)
export function `!=`(this a: string, b: string): boolean { return !(a == b); }
export function `>`(this a: string, b: string): boolean { return b < a; }
export function `<=`(this a: string, b: string): boolean { return !(b < a); }
export function `>=`(this a: string, b: string): boolean { return !(a < b); }

// Lexicographic compare — returns <0, 0, >0 (shared by <, <=, derived >, >=)
export function msStringCompare(a: string, b: string): int32 {
	const ab = a.asBytes();
	const bb = b.asBytes();
	let i = 0;
	while (i < ab.length && i < bb.length) {
		if (ab[i] !== bb[i]) return (ab[i] as int32) - (bb[i] as int32);
		i = i + 1;
	}
	return ab.length - bb.length;
}

// String equality — byte-by-byte comparison (implementation)
export function msStringEquals(a: string, b: string): boolean {
	const ab = a.asBytes();
	const bb = b.asBytes();
	if (ab.length !== bb.length) return false;
	let i = 0;
	while (i < ab.length) {
		if (ab[i] !== bb[i]) return false;
		i = i + 1;
	}
	return true;
}

// ===== String Extension Methods (after lowering: s.method(args) → method(s, args)) =====
// Pure MetaScript on byte arrays — shared logic with C backend.

export function byteLength(this s: string): int64 {
	return s.asBytes().length as int64;
}

export function byteAt(this s: string, idx: int64): int32 {
	const b = s.asBytes();
	if (idx < 0 || idx >= b.length) return -1;
	return b[idx] as int32;
}

export function byteSlice(this s: string, start: int64, end: int64): string {
	const b = s.asBytes();
	const result: uint8[] = [];
	let i = start;
	while (i < end && i < b.length) { result.push(b[i]); i = i + 1; }
	return result.asString();
}

export function charAt(this s: string, idx: int64): string {
	const js = toJSStr(s);
	@emit(`if (${idx} < 0 || ${idx} >= ${js}.length) return [];`);
	@emit(`return fromJSStr(${js}.charAt(${idx}));`);
	unreachable;
}

export function charCodeAt(this s: string, idx: int64): int32 {
	const js = toJSStr(s);
	@emit(`if (${idx} < 0 || ${idx} >= ${js}.length) return -1;`);
	@emit(`return ${js}.charCodeAt(${idx});`);
	unreachable;
}

export function startsWith(this s: string, prefix: string): boolean {
	const sb = s.asBytes();
	const pb = prefix.asBytes();
	if (pb.length === 0) return true;
	if (sb.length < pb.length) return false;
	let i = 0;
	while (i < pb.length) {
		if (sb[i] !== pb[i]) return false;
		i = i + 1;
	}
	return true;
}

export function endsWith(this s: string, suffix: string): boolean {
	const sb = s.asBytes();
	const xb = suffix.asBytes();
	if (xb.length === 0) return true;
	if (sb.length < xb.length) return false;
	const off = sb.length - xb.length;
	let i = 0;
	while (i < xb.length) {
		if (sb[off + i] !== xb[i]) return false;
		i = i + 1;
	}
	return true;
}

export function contains(this s: string, sub: string): boolean {
	return s.indexOf(sub, 0) >= 0;
}

export function indexOf(this s: string, sub: string, start: int64 = 0): int64 {
	const sb = s.asBytes();
	const xb = sub.asBytes();
	if (xb.length === 0) return start;
	let i = start;
	while (i <= sb.length - xb.length) {
		let found = true;
		let j = 0;
		while (j < xb.length) {
			if (sb[i + j] !== xb[j]) { found = false; break; }
			j = j + 1;
		}
		if (found) return i;
		i = i + 1;
	}
	return -1;
}

export function lastIndexOf(this s: string, sub: string, startIdx: int64 = -1): int64 {
	const sb = s.asBytes();
	const xb = sub.asBytes();
	if (xb.length === 0) return sb.length as int64;
	if (xb.length > sb.length) return -1;
	let i = sb.length - xb.length;
	if (startIdx >= 0 && startIdx < i) i = startIdx;
	while (i >= 0) {
		let found = true;
		let j = 0;
		while (j < xb.length) {
			if (sb[i + j] !== xb[j]) { found = false; break; }
			j = j + 1;
		}
		if (found) return i as int64;
		i = i - 1;
	}
	return -1;
}

export function trim(this s: string): string {
	const sb = s.asBytes();
	if (sb.length === 0) return "";
	let a = 0;
	let b = sb.length - 1;
	while (a <= b && isSpaceByte(sb[a])) { a = a + 1; }
	while (b >= a && isSpaceByte(sb[b])) { b = b - 1; }
	return s.byteSlice(a, b + 1);
}

export function slice(this s: string, start: int64, end: int64): string {
	const js = toJSStr(s);
	@emit(`return fromJSStr(${js}.slice(${start}, ${end}));`);
	unreachable;
}

export function split(this s: string, delimiter: string): string[] {
	const sb = s.asBytes();
	const db = delimiter.asBytes();
	const parts: string[] = [];
	if (sb.length === 0) { parts.push(""); return parts; }
	if (db.length === 0) {
		let c = 0;
		while (c < sb.length) { parts.push(s.byteSlice(c, c + 1)); c = c + 1; }
		return parts;
	}
	let pos = 0;
	while (pos <= sb.length) {
		const found = s.indexOf(delimiter, pos);
		if (found < 0) { parts.push(s.byteSlice(pos, sb.length)); break; }
		parts.push(s.byteSlice(pos, found));
		pos = found + db.length;
	}
	return parts;
}

export function toLowerCase(this s: string): string {
	const sb = s.asBytes();
	const result: uint8[] = [];
	let i = 0;
	while (i < sb.length) { result.push(asciiLower(sb[i])); i = i + 1; }
	return result.asString();
}

export function toUpperCase(this s: string): string {
	const sb = s.asBytes();
	const result: uint8[] = [];
	let i = 0;
	while (i < sb.length) { result.push(asciiUpper(sb[i])); i = i + 1; }
	return result.asString();
}

export function replace(this s: string, search: string, replacement: string): string {
	const sb = s.asBytes();
	const xb = search.asBytes();
	if (sb.length === 0 || xb.length === 0) return s.byteSlice(0, sb.length);
	const pos = s.indexOf(search, 0);
	if (pos < 0) return s.byteSlice(0, sb.length);
	const rb = replacement.asBytes();
	const result: uint8[] = [];
	let i = 0;
	while (i < pos) { result.push(sb[i]); i = i + 1; }
	let j = 0;
	while (j < rb.length) { result.push(rb[j]); j = j + 1; }
	i = pos + xb.length;
	while (i < sb.length) { result.push(sb[i]); i = i + 1; }
	return result.asString();
}

export function equals(this s: string, other: string): boolean {
	return msStringEquals(s, other);
}

function asciiLower(b: int32): int32 {
	if (b >= "A".code && b <= "Z".code) return b + 32;
	return b;
}

function asciiUpper(b: int32): int32 {
	if (b >= "a".code && b <= "z".code) return b - 32;
	return b;
}

function isSpaceByte(b: int32): boolean {
	return b === " ".code || (b >= "\t".code && b <= "\r".code);
}

export function equalsIgnoreCase(this s: string, other: string): boolean {
	const ab = s.asBytes();
	const bb = other.asBytes();
	if (ab.length !== bb.length) return false;
	let i = 0;
	while (i < ab.length) {
		if (asciiLower(ab[i]) !== asciiLower(bb[i])) return false;
		i = i + 1;
	}
	return true;
}

// Non-overlapping occurrences. An empty needle counts every gap: byteLength + 1.
export function count(this s: string, sub: string): int64 {
	const sb = s.asBytes();
	const xb = sub.asBytes();
	if (xb.length === 0) return (sb.length + 1) as int64;
	let n: int64 = 0;
	let pos = 0;
	while (pos <= sb.length - xb.length) {
		const found = s.indexOf(sub, pos);
		if (found < 0) break;
		n = n + 1;
		pos = found + xb.length;
	}
	return n;
}

export function substring(this s: string, start: int64, end: int64): string {
	return s.slice(start, end);
}

export function trimStart(this s: string): string {
	const sb = s.asBytes();
	if (sb.length === 0) return "";
	let a = 0;
	while (a < sb.length && isSpaceByte(sb[a])) { a = a + 1; }
	return s.byteSlice(a, sb.length);
}

export function trimEnd(this s: string): string {
	const sb = s.asBytes();
	if (sb.length === 0) return "";
	let b = sb.length;
	while (b > 0 && isSpaceByte(sb[b - 1])) { b = b - 1; }
	return s.byteSlice(0, b);
}

export function repeat(this s: string, count: int32): string {
	const sb = s.asBytes();
	if (count <= 0 || sb.length === 0) return "";
	const result: uint8[] = [];
	let i = 0;
	while (i < count) {
		let j = 0;
		while (j < sb.length) { result.push(sb[j]); j = j + 1; }
		i = i + 1;
	}
	return result.asString();
}

export function replaceAll(this s: string, search: string, replacement: string): string {
	const sb = s.asBytes();
	const xb = search.asBytes();
	if (sb.length === 0 || xb.length === 0) return s.byteSlice(0, sb.length);
	const rb = replacement.asBytes();
	const result: uint8[] = [];
	let pos = 0;
	while (pos <= sb.length - xb.length) {
		const found = s.indexOf(search, pos);
		if (found < 0) break;
		let k = pos;
		while (k < found) { result.push(sb[k]); k = k + 1; }
		let j = 0;
		while (j < rb.length) { result.push(rb[j]); j = j + 1; }
		pos = found + xb.length;
	}
	while (pos < sb.length) { result.push(sb[pos]); pos = pos + 1; }
	return result.asString();
}

// Byte reverse, matching msStringReverse — mangles multi-byte UTF-8 on both backends.
export function reverse(this s: string): string {
	const sb = s.asBytes();
	const result: uint8[] = [];
	let i = sb.length - 1;
	while (i >= 0) { result.push(sb[i]); i = i - 1; }
	return result.asString();
}

export function padStart(this s: string, targetLen: int64, pad: string): string {
	const sb = s.asBytes();
	const pb = pad.asBytes();
	if (sb.length >= targetLen || pb.length === 0) return s.byteSlice(0, sb.length);
	const result: uint8[] = [];
	const padTotal = targetLen - sb.length;
	let pos = 0;
	let pi = 0;
	while (pos < padTotal) {
		result.push(pb[pi]);
		pi = pi + 1;
		if (pi >= pb.length) pi = 0;
		pos = pos + 1;
	}
	let i = 0;
	while (i < sb.length) { result.push(sb[i]); i = i + 1; }
	return result.asString();
}

export function padEnd(this s: string, targetLen: int64, pad: string): string {
	const sb = s.asBytes();
	const pb = pad.asBytes();
	if (sb.length >= targetLen || pb.length === 0) return s.byteSlice(0, sb.length);
	const result: uint8[] = [];
	let i = 0;
	while (i < sb.length) { result.push(sb[i]); i = i + 1; }
	const padTotal = targetLen - sb.length;
	let pos = 0;
	let pi = 0;
	while (pos < padTotal) {
		result.push(pb[pi]);
		pi = pi + 1;
		if (pi >= pb.length) pi = 0;
		pos = pos + 1;
	}
	return result.asString();
}

// strtod/strtoll parity: unparseable input is 0, never NaN.
export function parseFloat(this s: string): number {
	const js = toJSStr(s);
	@emit(`var v = Number.parseFloat(${js}); return Number.isNaN(v) ? 0 : v;`);
	unreachable;
}

export function parseInt(this s: string): int64 {
	const js = toJSStr(s);
	@emit(`var v = Number.parseInt(${js}, 10); return Number.isNaN(v) ? 0 : v;`);
	unreachable;
}

// JS arrays carry no separate allocation, so capacity is always the live length.
export function capacity(this s: string): int64 {
	return s.asBytes().length as int64;
}

export function setLength(this s: string, newLen: int64): void {
	const b = s.asBytes();
	while (b.length > newLen) { b.pop(); }
	while (b.length < newLen) { b.push(0); }
}

export function append(this s: string, other: string): void {
	msStringAppend(s, other);
}

export function setSlice(this s: string, start: number, end: number): void {
	const b = s.asBytes();
	let a = start;
	let e = end;
	if (a < 0) a = 0;
	if (e > b.length) e = b.length;
	if (a >= e) { s.setLength(0); return; }
	const n = e - a;
	let i = 0;
	while (i < n) { b[i] = b[a + i]; i = i + 1; }
	s.setLength(n);
}

export function stripInPlace(this s: string): void {
	const b = s.asBytes();
	if (b.length === 0) return;
	let first = 0;
	let last = b.length - 1;
	while (first <= last && isSpaceByte(b[first])) { first = first + 1; }
	while (last >= first && isSpaceByte(b[last])) { last = last - 1; }
	s.setSlice(first, last + 1);
}

export function fromCodePoint(cp: number): string {
	@emit(`if (${cp} < 0 || ${cp} > 1114111) return [];`);
	@emit(`return fromJSStr(String.fromCodePoint(${cp}));`);
	unreachable;
}

// Number/bool to string (called by builtinLower .toString())
export function msNumberToString(n: number): string {
	@emit(`return fromJSStr(String(${n}));`);
	unreachable;
}

export function msNumberToStringRadix(n: number, radix: number): string {
	@emit(`return fromJSStr(${n}.toString(${radix}));`);
	unreachable;
}

export function msBoolToString(b: boolean): string {
	@emit(`return ${b} ? [116,114,117,101] : [102,97,108,115,101];`);
	unreachable;
}

// String hash — DJB2 (matches C runtime msStringHash)
export function msStringHash(s: string): int32 {
	const sb = s.asBytes();
	let h: int32 = 5381;
	let i = 0;
	while (i < sb.length) {
		h = (h * 33 + sb[i]) as int32;
		i = i + 1;
	}
	return h;
}

// String append (in-place, called by lowerStringOps for +=)
export function msStringAppend(dest: string, src: string): void {
	const db = dest.asBytes();
	const sb = src.asBytes();
	let i = 0;
	while (i < sb.length) { db.push(sb[i]); i = i + 1; }
}

// For long string literals (>64 bytes)
export function makeNimstrLit(s: string): string {
	@emit(`var r = []; for (var i = 0; i < ${s}.length; i++) r.push(${s}.charCodeAt(i)); return r;`);
	unreachable;
}

// UTF-8 byte array → native JS string (boundary conversion)
export function toJSStr(s: string): string {
	const bytes = asBytes(s);
	@emit(`if (!Array.isArray(${bytes})) return ${bytes};
	var r = "", i = 0;
	while (i < ${bytes}.length) {
		var b = ${bytes}[i];
		if (b < 128) { r += String.fromCharCode(b); i++; }
		else if (b < 224) { r += String.fromCharCode(((b & 31) << 6) | (${bytes}[i+1] & 63)); i += 2; }
		else if (b < 240) { r += String.fromCharCode(((b & 15) << 12) | ((${bytes}[i+1] & 63) << 6) | (${bytes}[i+2] & 63)); i += 3; }
		else { var cp = ((b & 7) << 18) | ((${bytes}[i+1] & 63) << 12) | ((${bytes}[i+2] & 63) << 6) | (${bytes}[i+3] & 63); cp -= 65536; r += String.fromCharCode(55296 + (cp >> 10), 56320 + (cp & 1023)); i += 4; }
	}
	return r;`);
	unreachable;
}

// Native JS string → UTF-8 byte array (boundary conversion)
export function fromJSStr(s: string): string {
	@emit(`var r = [], i = 0;
	while (i < ${s}.length) {
		var ch = ${s}.charCodeAt(i);
		if (ch < 128) { r.push(ch); }
		else if (ch < 2048) { r.push((ch >> 6) | 192, (ch & 63) | 128); }
		else if (ch < 55296 || ch >= 57344) { r.push((ch >> 12) | 224, ((ch >> 6) & 63) | 128, (ch & 63) | 128); }
		else { i++; var cp2 = 65536 + (((ch & 1023) << 10) | (${s}.charCodeAt(i) & 1023)); r.push((cp2 >> 18) | 240, ((cp2 >> 12) & 63) | 128, ((cp2 >> 6) & 63) | 128, (cp2 & 63) | 128); }
		i++;
	}
	return r;`);
	unreachable;
}

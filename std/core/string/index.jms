// MetaScript String Prelude — JavaScript Backend
// string = native JS string (docs/STRING-CONTRACT.md §3).

import { wtf8Cached } from "./bytes";
export { asBytes, asString, byteLength, byteAt, byteSlice, byteIndexOf, byteLastIndexOf } from "./bytes";

// ===== Operators =====

export function `==`(this a: string, b: string): boolean {
	@emit(`return ${a} === ${b};`);
	unreachable;
}
export function `<`(this a: string, b: string): boolean {
	@emit(`return ${a} < ${b};`);
	unreachable;
}
export function `<=`(this a: string, b: string): boolean {
	@emit(`return ${a} <= ${b};`);
	unreachable;
}
// Derived operators (!=, >, >=) come from the system templates.

export function msStringCompare(a: string, b: string): int32 {
	@emit(`return ${a} < ${b} ? -1 : (${a} > ${b} ? 1 : 0);`);
	unreachable;
}

export function msStringEquals(a: string, b: string): boolean {
	@emit(`return ${a} === ${b};`);
	unreachable;
}

// ===== Type Coercion =====

@builtin("ToString")
export extern function String<T>(val: T): string;

// ===== Character Construction =====

export function fromCharCode(this typeof String, ...codes: int32[]): string {
	@emit(`return globalThis.String.fromCharCode(...${codes}.map((code) => Number(code) & 0xFFFF));`);
	unreachable;
}

// ===== String Extension Methods (after lowering: s.method(args) → method(s, args)) =====

@compilerFunc
export function charAt(this s: string, idx: int32): string {
	@emit(`return (${idx} < 0 || ${idx} >= ${s}.length) ? "" : ${s}.charAt(${idx});`);
	unreachable;
}

export function charCodeAt(this s: string, idx: int32): int32 {
	@emit(`return (${idx} < 0 || ${idx} >= ${s}.length) ? -1 : ${s}.charCodeAt(${idx});`);
	unreachable;
}

export function indexOf(this s: string, sub: string, start: int32 = 0): int32 {
	@emit(`return ${s}.indexOf(${sub}, ${start});`);
	unreachable;
}

export function lastIndexOf(this s: string, sub: string, startIdx: int32 = -1): int32 {
	@emit(`return ${startIdx} < 0 ? ${s}.lastIndexOf(${sub}) : ${s}.lastIndexOf(${sub}, ${startIdx});`);
	unreachable;
}

export function slice(this s: string, start: int32, end: int32 = 2147483647): string {
	@emit(`return ${s}.slice(${start}, ${end});`);
	unreachable;
}

export function equals(this s: string, other: string): boolean {
	return msStringEquals(s, other);
}

export function substring(this s: string, start: int32, end: int32 = 2147483647): string {
	const a = clampIndex(start, s.length);
	const b = clampIndex(end, s.length);
	return a <= b ? s.slice(a, b) : s.slice(b, a);
}

export function padStart(this s: string, targetLen: int32, pad: string): string {
	@emit(`return ${s}.padStart(${targetLen}, ${pad});`);
	unreachable;
}

export function padEnd(this s: string, targetLen: int32, pad: string): string {
	@emit(`return ${s}.padEnd(${targetLen}, ${pad});`);
	unreachable;
}

export extern function parseFloat(this s: string): number from "Number.parseFloat(#)";

function intPrefix(s: string): string {
	@emit(`var m = /^[+-]?(?:0[xX][0-9a-fA-F]+|[0-9]+)/.exec(${s}.trimStart());
return m === null ? "" : m[0];`);
	unreachable;
}

function intPrefixValue(t: string): bigint {
	@emit(`var neg = ${t}[0] === "-";
var v = globalThis.BigInt(neg || ${t}[0] === "+" ? ${t}.slice(1) : ${t});
return neg ? -v : v;`);
	unreachable;
}

export function parseInt(this s: string): int64 {
	const text = intPrefix(s);
	if (text == "") return 0;
	const v = intPrefixValue(text);
	if (v < -9223372036854775808n || v > 9223372036854775807n) {
		throw new Error(`value ${text} not in range -9223372036854775808 .. 9223372036854775807`);
	}
	return v as int64;
}

// Native strings carry no separate allocation — capacity is the byte length.
export function capacity(this s: string): int32 {
	return s.byteLength();
}

// ===== In-Place Mutators (surface parity only) =====
// C's string is a mutable heap buffer, so setLength/append/setSlice/
// stripInPlace exist in index.cms. js strings are native and immutable, so
// these cannot rebind the caller's value: the names are declared for graph
// check parity (every C-surface program compiles on js), but a call refuses
// loudly instead of silently diverging.

export function setLength(this s: string, newLen: int32): void {
	@emit(`throw new Error("string.setLength(): in-place string mutation is not available on the js backend (strings are native and immutable)");`);
	unreachable;
}

export function append(this s: string, other: string): void {
	@emit(`throw new Error("string.append(): in-place string mutation is not available on the js backend (strings are native and immutable)");`);
	unreachable;
}

export function setSlice(this s: string, start: number, end: number): void {
	@emit(`throw new Error("string.setSlice(): in-place string mutation is not available on the js backend (strings are native and immutable)");`);
	unreachable;
}

export function stripInPlace(this s: string): void {
	@emit(`throw new Error("string.stripInPlace(): in-place string mutation is not available on the js backend (strings are native and immutable)");`);
	unreachable;
}


export function fromCodePoint(cp: number): string {
	@emit(`return (${cp} < 0 || ${cp} > 1114111) ? "" : String.fromCodePoint(${cp});`);
	unreachable;
}

// Number/bool to string (called by builtinLower .toString())
@compilerFunc
export function msNumberToString(n: number): string {
	@emit(`return String(${n});`);
	unreachable;
}

function checkRadix(radix: number): void {
	if (!(radix >= 2.0 && radix < 37.0)) throw new RangeError("toString() radix argument must be between 2 and 36");
}

@compilerFunc
export function msNumberToStringRadix(n: number, radix: number): string {
	checkRadix(radix);
	@emit(`return ${n}.toString(${radix});`);
	unreachable;
}

// 64-bit integer formatting. On C these take an int64/uint64 parameter so the
// value never round-trips through a double; here every number is already a
// double, so they are the same String()/toString() call. Exact int64 semantics
// on this backend wait on the BigInt mapping — until then these exist so the
// shared lowering can name one function for both backends.
@compilerFunc
export function msIntToString(n: int64): string {
	@emit(`return String(${n});`);
	unreachable;
}

@compilerFunc
export function msUint64ToString(n: uint64): string {
	@emit(`return String(${n});`);
	unreachable;
}

@compilerFunc
export function msIntToStringRadix(n: int64, radix: number): string {
	checkRadix(radix);
	@emit(`return ${n}.toString(${radix});`);
	unreachable;
}

@compilerFunc
export function msUint64ToStringRadix(n: uint64, radix: number): string {
	checkRadix(radix);
	@emit(`return ${n}.toString(${radix});`);
	unreachable;
}

@compilerFunc
export function msBoolToString(b: boolean): string {
	@emit(`return ${b} ? "true" : "false";`);
	unreachable;
}

// String hash — DJB2 over WTF-8 bytes (matches C runtime msStringHash)
@compilerFunc
export function msStringHash(s: string): int32 {
	const sb = wtf8Cached(s);
	let h: float64 = 5381;
	for (let i = 0; i < sb.length; i += 1) {
		h = (h * 33 + sb[i]) % 4294967296.0;
	}
	if (h > 2147483647) h = h - 4294967296.0;
	return h as int32;
}

// .length on string → UTF-16 code units (LANG.md Index-Space Contract) = native.
@compilerFunc
export function msStringLength(s: string): int32 {
	@emit(`return ${s}.length;`);
	unreachable;
}

@compilerFunc
export function msStringByteLength(s: string): int32 {
	return wtf8Cached(s).length;
}

@compilerFunc
export function msStringByteAt(s: string, idx: int32): int32 {
	return s.byteAt(idx);
}

// ===== Shared Byte-Loop Algorithms (single source, both backends) =====
import { clampIndex } from "./shared";
export { startsWith, endsWith, contains, count, trim, trimStart, trimEnd, split, toLowerCase, toUpperCase, replace, replaceAll, repeat, reverse, equalsIgnoreCase } from "./shared";

// MetaScript String Prelude — C Backend
// Extension methods backed by runtime/core/string.h
// Loaded automatically via globalImports() -> "std/core/string"

@include("core/string.h");

// ===== Comparison =====

extern function equals(this s: string, other: string): boolean from "msStringEquals";

extern function equalsIgnoreCase(this s: string, other: string): boolean from "msStringEqualsIgnoreCase";

extern function startsWith(this s: string, prefix: string): boolean from "msStringStartsWith";

extern function endsWith(this s: string, suffix: string): boolean from "msStringEndsWith";

extern function contains(this s: string, sub: string): boolean from "msStringContains";

// ===== Search =====

extern function indexOf(this s: string, sub: string, start: number): number from "msStringIndexOf";

extern function lastIndexOf(this s: string, sub: string): number from "msStringLastIndexOf";

extern function count(this s: string, sub: string): number from "msStringCount";

// ===== Extraction =====

extern function charAt(this s: string, idx: number): string from "msStringCharAt";

extern function charCodeAt(this s: string, idx: number): number from "msStringCharCodeAt";

extern function slice(this s: string, start: number, end: number): string from "msStringSlice";

extern function substring(this s: string, start: number, end: number): string from "msStringSubstring";

// ===== Transformation =====

extern function toLower(this s: string): string from "msStringToLower";

extern function toUpper(this s: string): string from "msStringToUpper";

extern function trim(this s: string): string from "msStringTrim";

extern function trimStart(this s: string): string from "msStringTrimStart";

extern function trimEnd(this s: string): string from "msStringTrimEnd";

extern function repeat(this s: string, count: number): string from "msStringRepeat";

extern function replace(this s: string, search: string, replacement: string): string from "msStringReplace";

extern function replaceAll(this s: string, search: string, replacement: string): string from "msStringReplaceAll";

extern function reverse(this s: string): string from "msStringReverse";

extern function padStart(this s: string, targetLen: number, pad: string): string from "msStringPadStart";

extern function padEnd(this s: string, targetLen: number, pad: string): string from "msStringPadEnd";

// ===== Splitting =====

extern function split(this s: string, delimiter: string): string[] from "msStringSplit";

// ===== Parsing =====

extern function parseFloat(this s: string): number from "msStringParseFloat";

extern function parseInt(this s: string): number from "msStringParseInt";

// ===== Capacity & Length =====

extern function capacity(this s: string): number from "msStringCapacity";

extern function setLength(this s: string, newLen: number): void from "&msStringSetLength";

// ===== In-Place Append =====

extern function append(this s: string, other: string): void from "&msStringAppend";

// ===== In-Place Operations =====

extern function setSlice(this s: string, start: number, end: number): void from "&msStringSetSlice";

extern function stripInPlace(this s: string): void from "&msStringStripInPlace";

// ===== Character Construction =====

extern function fromCodePoint(cp: number): string from "msStringFromCodePoint";

// ===== Zero-Copy Bridge (string → uint8[]) =====

@builtin("AsBytes")
extern function asBytes(this s: string): uint8[] from "ms_asBytes";

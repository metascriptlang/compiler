// MetaScript String Prelude — C Backend
// Extension methods backed by runtime/core/string.h
// Loaded automatically via globalImports() -> "std/core/string"

@include("runtime/core/string.h");
@compile("runtime/core/string.c");
@compile("runtime/core/stringCase.c");

// ===== Operators =====
// Primitive operators (C runtime)
@compilerFunc @inline
function msStringEquals(a: string, b: string): boolean {
	const x = a.asBytes();
	const y = b.asBytes();
	if (x.length != y.length) return false;
	return x.length == 0 || msEqualMem(x, y);
}

extern function msEqualMem(a: Readonly<Span<uint8>>, b: Readonly<Span<uint8>>): boolean;
extern function msMemMismatch(a: Readonly<Span<uint8>>, b: Readonly<Span<uint8>>): int64;

// UTF-16 code unit order differs from UTF-8 byte order only where the first differing code points
// are a supplementary one (lead 0xF0..0xF4, a surrogate pair) against a BMP one at or above U+E000
// (lead 0xEE/0xEF), which sorts above the pair, or against a lone surrogate (lead 0xED), which
// compares with the pair's units.
@exportName("msStringCompare")
function stringCompare(a: string, b: string): int32 {
	const x = a.asBytes();
	const y = b.asBytes();
	const n = x.length < y.length ? x.length : y.length;
	if (n > 0) {
		const i = msMemMismatch(x, y);
		if (i < n) {
			const p = x[i];
			const q = y[i];
			if (p >= 0xED && q >= 0xED && (p >= 0xF0) != (q >= 0xF0)) {
				if (p == 0xED || q == 0xED) return compareUnitsFrom(x, y, i);
				return p >= 0xF0 ? -1 : 1;
			}
			return p < q ? -1 : 1;
		}
	}
	return x.length < y.length ? -1 : x.length > y.length ? 1 : 0;
}

@inline
function seqLenAt(s: Readonly<Span<uint8>>, at: int64): int64 {
	const b = s[at];
	const n = b < 0x80 ? 1 : b < 0xE0 ? 2 : b < 0xF0 ? 3 : 4;
	return at + n <= s.length ? n : 1;
}

function codePointAt(s: Readonly<Span<uint8>>, at: int64, seq: int64): int32 {
	const b = s[at] as int32;
	if (seq == 1) return b;
	if (seq == 2) return ((b & 0x1F) << 6) | ((s[at + 1] as int32) & 0x3F);
	if (seq == 3) return ((b & 0x0F) << 12) | (((s[at + 1] as int32) & 0x3F) << 6) | ((s[at + 2] as int32) & 0x3F);
	return ((b & 0x07) << 18) | (((s[at + 1] as int32) & 0x3F) << 12) | (((s[at + 2] as int32) & 0x3F) << 6) | ((s[at + 3] as int32) & 0x3F);
}

@noinline
function compareUnitsFrom(x: Readonly<Span<uint8>>, y: Readonly<Span<uint8>>, at: int64): int32 {
	let i = at;
	let j = at;
	let lowX: int32 = 0;
	let lowY: int32 = 0;
	while (true) {
		let u: int32 = -1;
		if (lowX != 0) {
			u = lowX;
			lowX = 0;
		} else if (i < x.length) {
			const seq = seqLenAt(x, i);
			u = codePointAt(x, i, seq);
			i = i + seq;
			if (u >= 0x10000) {
				lowX = 0xDC00 + ((u - 0x10000) & 0x3FF);
				u = 0xD800 + ((u - 0x10000) >> 10);
			}
		}
		let v: int32 = -1;
		if (lowY != 0) {
			v = lowY;
			lowY = 0;
		} else if (j < y.length) {
			const seq = seqLenAt(y, j);
			v = codePointAt(y, j, seq);
			j = j + seq;
			if (v >= 0x10000) {
				lowY = 0xDC00 + ((v - 0x10000) & 0x3FF);
				v = 0xD800 + ((v - 0x10000) >> 10);
			}
		}
		if (u != v) return u < v ? -1 : 1;
		if (u < 0) return x[at] < y[at] ? -1 : 1;
	}
}

@exportName("msStringCompareBytes")
function stringCompareBytes(a: string, b: string): int32 {
	const x = a.asBytes();
	const y = b.asBytes();
	const n = x.length < y.length ? x.length : y.length;
	if (n > 0) {
		const i = msMemMismatch(x, y);
		if (i < n) return x[i] < y[i] ? -1 : 1;
	}
	return x.length < y.length ? -1 : x.length > y.length ? 1 : 0;
}

@inline export function `==`(this a: string, b: string): boolean { return msStringEquals(a, b); }
export extern function `<`(this a: string, b: string): boolean from "msStringCompareLt";
export extern function `<=`(this a: string, b: string): boolean from "msStringCompareLe";
// Derived operators (!=, >, >=) come from the system templates.

// ===== Comparison =====

/** Determines whether two strings are equivalent. */
@inline export function equals(this s: string, other: string): boolean { return msStringEquals(s, other); }

// ===== Extraction =====

/**
 * Returns the character at the specified index.
 * @param idx The zero-based index of the desired character.
 */
export extern function charAt(this s: string, idx: int32): string from "msStringCharAt";

/**
 * Returns the Unicode value of the character at the specified location.
 * @param idx The zero-based index of the desired character. If there is no character at the specified index, NaN is returned.
 */
export extern function charCodeAt(this s: string, idx: int32): int32 from "msStringCharCodeAt";

/**
 * Returns a section of a string.
 * @param start The index to the beginning of the specified portion of stringObj.
 * @param end The index to the end of the specified portion of stringObj. The substring includes the characters up to, but not including, the character indicated by end.
 */
export extern function slice(this s: string, start: int32, end: int32 = 2147483647): string from "msStringSlice";

/** Returns the character at the index, counting from the end for a negative one; an index out of range gives null, like `find` on a miss. */
export function at(this s: string, idx: int32): string | null {
	const i = idx < 0 ? s.length + idx : idx;
	if (i < 0 || i >= s.length) return null;
	return s.charAt(i);
}

export function substring(this s: string, start: int32, end: int32 = 2147483647): string {
	const a = clampIndex(start, s.length);
	const b = clampIndex(end, s.length);
	return a <= b ? s.slice(a, b) : s.slice(b, a);
}

// ===== Parsing =====

/** Converts a string representation of a number to a floating-point number. */
export function parseFloat(this s: string): number {
	return parseFloatPrefix(s);
}

/** Converts a string representation of an integer to a number. */
export function parseInt(this s: string): int64 {
	return parseIntPrefix(s);
}

// ===== Character Construction =====

/** Returns a string created from the specified Unicode code point. */
export extern function fromCodePoint(cp: number): string from "msStringFromCodePoint";

const CHAR_UNIT_MASK: int32 = 0xFFFF;

export function fromCharCode(this typeof String, code: int32): string {
	return fromCodePoint((code & CHAR_UNIT_MASK) as number);
}

export function fromCharCode(this typeof String, ...codes: int32[]): string {
	let text = "";
	for (const code of codes) text += fromCodePoint((code & CHAR_UNIT_MASK) as number);
	return text;
}

// ===== Type Coercion =====

/** Converts any value to its string representation. Delegates to .toString(). */
@builtin("ToString")
export extern function String<T>(val: T): string;
export { asBytes, byteLength, byteAt, byteSlice, byteIndexOf, byteLastIndexOf } from "./bytes";
import { clampIndex } from "./shared";
import { parseFloatPrefix, parseIntPrefix } from "../number/parse";
export { repeat, reverse, equalsIgnoreCase } from "./shared";

export extern function trim(this s: string): string from "msStringTrim";
export extern function trimStart(this s: string): string from "msStringTrimStart";
export extern function trimEnd(this s: string): string from "msStringTrimEnd";
export extern function toLowerCase(this s: string): string from "msStringToLowerCase";
export extern function toUpperCase(this s: string): string from "msStringToUpperCase";
export { indexOf, lastIndexOf, startsWith, endsWith, includes, contains, count } from "./search";
import "./utf16";
export { replace, replaceAll, padStart, padEnd, split } from "./editNative";

// MetaScript String Prelude — C Backend
// Extension methods backed by runtime/core/string.h
// Loaded automatically via globalImports() -> "std/core/string"

@include("std/core/string/native.h");
@compile("std/core/string/native.c");

// ===== Operators =====
// Primitive operators (C runtime)
export extern function `==`(this a: string, b: string): boolean from "msStringEquals";
export extern function `<`(this a: string, b: string): boolean from "msStringCompareLt";
// Derived operators (call == and < internally)
export function `!=`(this a: string, b: string): boolean { return !(a == b); }
export function `>`(this a: string, b: string): boolean { return b < a; }
export function `<=`(this a: string, b: string): boolean { return !(b < a); }
export function `>=`(this a: string, b: string): boolean { return !(a < b); }

// ===== Comparison =====

/** Determines whether two strings are equivalent. */
export extern function equals(this s: string, other: string): boolean from "msStringEquals";

/** Determines whether two strings are equivalent, ignoring case. */
export extern function equalsIgnoreCase(this s: string, other: string): boolean from "msStringEqualsIgnoreCase";

/**
 * Returns true if the sequence of elements of searchString converted to a String is the
 * same as the corresponding elements of this object (converted to a String) starting at
 * position. Otherwise returns false.
 */
export extern function startsWith(this s: string, prefix: string): boolean from "msStringStartsWith";

/**
 * Returns true if the sequence of elements of searchString converted to a String is the
 * same as the corresponding elements of this object (converted to a String) starting at
 * endPosition – length(this). Otherwise returns false.
 */
export extern function endsWith(this s: string, suffix: string): boolean from "msStringEndsWith";

/**
 * Returns true if searchString appears as a substring of the result of converting this
 * object to a String, at one or more positions that are
 * greater than or equal to position; otherwise, returns false.
 * @param sub search string
 */
export extern function contains(this s: string, sub: string): boolean from "msStringContains";

// ===== Search =====

/**
 * Returns the position of the first occurrence of a substring.
 * @param sub The substring to search for in the string.
 * @param start The index at which to begin searching the String object. If omitted, search starts at the beginning of the string.
 */
export extern function indexOf(this s: string, sub: string, start: int64 = 0): int64 from "msStringIndexOf";

/**
 * Returns the last occurrence of a substring in the string.
 * @param sub The substring to search for.
 */
export extern function lastIndexOf(this s: string, sub: string): int64 from "msStringLastIndexOf";

/** Returns the number of non-overlapping occurrences of a substring. */
export extern function count(this s: string, sub: string): int64 from "msStringCount";

// ===== Extraction =====

/**
 * Returns the character at the specified index.
 * @param idx The zero-based index of the desired character.
 */
export extern function charAt(this s: string, idx: int64): string from "msStringCharAt";

/**
 * Returns the Unicode value of the character at the specified location.
 * @param idx The zero-based index of the desired character. If there is no character at the specified index, NaN is returned.
 */
export extern function charCodeAt(this s: string, idx: int64): int32 from "msStringCharCodeAt";

/** Returns the byte length of the string in its underlying encoding. */
export extern function byteLength(this s: string): int64 from "msStringByteLength";

/** Returns the raw byte value at the given byte offset. Returns -1 if out of range. */
export extern function byteAt(this s: string, idx: int64): int32 from "msStringByteAt";

/** Returns a substring by byte offsets [start, end). For lexer/binary protocols. */
export extern function byteSlice(this s: string, start: int64, end: int64): string from "msStringByteSlice";

/**
 * Returns a section of a string.
 * @param start The index to the beginning of the specified portion of stringObj.
 * @param end The index to the end of the specified portion of stringObj. The substring includes the characters up to, but not including, the character indicated by end.
 */
export extern function slice(this s: string, start: int64, end: int64): string from "msStringSlice";

/**
 * Returns the substring at the specified location within a String object.
 * @param start The zero-based index number indicating the beginning of the substring.
 * @param end Zero-based index number indicating the end of the substring. The substring includes the characters up to, but not including, the character indicated by end.
 */
export extern function substring(this s: string, start: int64, end: int64): string from "msStringSubstring";

// ===== Transformation =====

/** Converts all the alphabetic characters in a string to lowercase. */
export extern function toLower(this s: string): string from "msStringToLower";

/** Converts all the alphabetic characters in a string to uppercase. */
export extern function toUpper(this s: string): string from "msStringToUpper";

/** Removes the leading and trailing white space and line terminator characters from a string. */
export extern function trim(this s: string): string from "msStringTrim";

/** Removes the leading white space and line terminator characters from a string. */
export extern function trimStart(this s: string): string from "msStringTrimStart";

/** Removes the trailing white space and line terminator characters from a string. */
export extern function trimEnd(this s: string): string from "msStringTrimEnd";

/**
 * Returns a String value that is made from count copies appended together. If count is 0,
 * the empty string is returned.
 * @param count number of copies to append
 */
export extern function repeat(this s: string, count: int32): string from "msStringRepeat";

/**
 * Replaces text in a string, using a search string.
 * @param search A string to search for.
 * @param replacement A string containing the text to replace.
 */
export extern function replace(this s: string, search: string, replacement: string): string from "msStringReplace";

/**
 * Replaces all occurrences of a search string with a replacement string.
 * @param search A string to search for.
 * @param replacement A string containing the text to replace.
 */
export extern function replaceAll(this s: string, search: string, replacement: string): string from "msStringReplaceAll";

/** Reverses the characters in a string. */
export extern function reverse(this s: string): string from "msStringReverse";

/**
 * Pads the current string with a given string (possibly repeated) so that the resulting string reaches a given length.
 * The padding is applied from the start (left) of the current string.
 * @param targetLen The length of the resulting string once the current string has been padded.
 * @param pad The string to pad the current string with.
 */
export extern function padStart(this s: string, targetLen: int64, pad: string): string from "msStringPadStart";

/**
 * Pads the current string with a given string (possibly repeated) so that the resulting string reaches a given length.
 * The padding is applied from the end (right) of the current string.
 * @param targetLen The length of the resulting string once the current string has been padded.
 * @param pad The string to pad the current string with.
 */
export extern function padEnd(this s: string, targetLen: int64, pad: string): string from "msStringPadEnd";

// ===== Splitting =====

/**
 * Split a string into substrings using the specified separator and return them as an array.
 * @param delimiter A string that identifies character or characters to use in separating the string.
 */
export extern function split(this s: string, delimiter: string): string[] from "msStringSplit";

// ===== Parsing =====

/** Converts a string representation of a number to a floating-point number. */
export extern function parseFloat(this s: string): number from "msStringParseFloat";

/** Converts a string representation of an integer to a number. */
export extern function parseInt(this s: string): int64 from "msStringParseInt";

// ===== Capacity & Length =====

/** Returns the allocated capacity of the string buffer. */
export extern function capacity(this s: string): int64 from "msStringCapacity";

/** Sets the length of the string, truncating or extending as needed. */
export extern function setLength(this s: string, newLen: int64): void from "&msStringSetLength";

// ===== In-Place Append =====

/** Appends another string to the end of this string in place. */
export extern function append(this s: string, other: string): void from "&msStringAppend";

// ===== In-Place Operations =====

/** Replaces a section of the string in place. */
export extern function setSlice(this s: string, start: number, end: number): void from "&msStringSetSlice";

/** Strips whitespace from both ends of the string in place. */
export extern function stripInPlace(this s: string): void from "&msStringStripInPlace";

// ===== Character Construction =====

/** Returns a string created from the specified Unicode code point. */
export extern function fromCodePoint(cp: number): string from "msStringFromCodePoint";

// ===== Type Coercion =====

/** Converts any value to its string representation. Delegates to .toString(). */
@builtin("ToString")
export extern function String<T>(val: T): string;
// ===== Zero-Copy Bridge (string → uint8[]) =====

/** Returns the string's underlying bytes as a uint8 array (zero-copy). */
@builtin("AsBytes")
export extern function asBytes(this s: string): uint8[] from "msAsBytes";

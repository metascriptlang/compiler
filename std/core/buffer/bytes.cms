import { Buffer } from "std/core/buffer";
import { wellFormedString } from "../string/bytes";

export type Bytes = string | uint8[];

export function rawString(data: Bytes): string {
	if (typeof data == "string") return data;
	return wellFormedString(data);
}

export function rawBuffer(raw: string): Buffer {
	return Buffer.fromString(raw, "latin1");
}

// Buffer on the js target is a Uint8Array: `uint8[]` already emits as one,
// so the alias keeps every array operation native. String methods do not
// apply here — this module re-provides the byte surface that std/core/buffer
// adds on top of the C string alias:
//   - hot paths (set/byteAt/endian reads/search/fill) bind via `from`
//     templates, emitting native subscripts and DataView calls with zero
//     wrapper frame;
//   - encoders (hex/base64/utf8) are pure loops over that surface.
//
// Invariant leveraged by the DataView templates: every Buffer value produced
// by this module is a whole, offset-0 view of its own ArrayBuffer (alloc/
// fromArray/slice all copy); subarray() appears only transiently inside
// copyTo, never stored or returned.

import { Math } from "std/core/math";
import { encodeHex, encodeBase64 } from "std/core/encoding";
import { hexCapacity, base64Capacity, writeHex, writeBase64, encodeBase64Url } from "./codec";

export type Buffer = uint8[];

// ===== private native bindings =====

// A read or write outside the buffer, an integer outside its width, or a byteLength outside 1..6 throws
// the RangeError the Node Buffer throws; the other backends say the same words.
function need(b: Buffer, o: number, width: number): void {
	const max = b.length - width;
	if (max < 0) throw new RangeError("Attempt to access memory outside buffer bounds");
	if (!(o >= 0 && o <= max && o % 1 == 0)) throw new RangeError(`The value of "offset" is out of range. It must be >= 0 and <= ${max}. Received ${o}`);
}

function inRange(v: number, lo: number, hi: number): void {
	if (!(v >= lo && v <= hi)) throw new RangeError(`The value of "value" is out of range. It must be >= ${lo} and <= ${hi}. Received ${v}`);
}

function bufCopyInto(dst: Buffer, src: Buffer, at: number): void {
	let i = 0;
	while (i < src.length) {
		dst.set(at + i, src.byteAt(i));
		i += 1;
	}
}

// ===== Free Functions (constructors / static-like) =====

export extern function alloc(this typeof Buffer, size: number): Buffer from "new Uint8Array(#)";

// js has no unsafe allocation; a zero-filled array is a semantic superset.
export extern function allocUnsafe(this typeof Buffer, size: number): Buffer from "new Uint8Array(#)";

export extern function fromArray(this typeof Buffer, arr: number[]): Buffer from "new Uint8Array(#)";

// utf8 (or binary/latin1 char codes < 128 — identical bytes) of a string.
function encodeUtf8(s: string): Buffer {
	const out = Buffer.alloc(s.byteLength);
	let i = 0;
	let j = 0;
	while (i < s.length) {
		let cp: int32 = s.charCodeAt(i) as int32;
		if (cp >= 55296 && cp <= 56319 && i + 1 < s.length) {
			const lo: int32 = s.charCodeAt(i + 1) as int32;
			if (lo >= 56320 && lo <= 57343) {
				cp = 65536 + ((cp - 55296) << 10) + (lo - 56320);
				i += 1;
			}
		}
		i += 1;
		if (cp < 128) {
			out.set(j, cp);
			j += 1;
		} else if (cp < 2048) {
			out.set(j, 192 | (cp >> 6));
			out.set(j + 1, 128 | (cp & 63));
			j += 2;
		} else if (cp < 65536) {
			out.set(j, 224 | (cp >> 12));
			out.set(j + 1, 128 | ((cp >> 6) & 63));
			out.set(j + 2, 128 | (cp & 63));
			j += 3;
		} else {
			out.set(j, 240 | (cp >> 18));
			out.set(j + 1, 128 | ((cp >> 12) & 63));
			out.set(j + 2, 128 | ((cp >> 6) & 63));
			out.set(j + 3, 128 | (cp & 63));
			j += 4;
		}
	}
	return out;
}

extern function decodeUtf8Range(b: Buffer, start: number, end: number): string from "new TextDecoder('utf-8', { ignoreBOM: true }).decode(#.subarray(#, #))";

extern function prefixOf(b: Buffer, length: number): Buffer from "#.subarray(0, #)";

function isHex(encoding: string): boolean {
	return encoding.equalsIgnoreCase("hex");
}

function isBase64(encoding: string): boolean {
	return encoding.equalsIgnoreCase("base64") || encoding.equalsIgnoreCase("base64url");
}

function decodeText(value: string, base64: boolean): Buffer {
	const text = value.asBytes();
	const capacity = base64 ? base64Capacity(text) : hexCapacity(text);
	const buf = Buffer.alloc(capacity as number);
	const written = base64 ? writeBase64(text, buf, 0, capacity) : writeHex(text, buf, 0, capacity);
	return written < capacity ? prefixOf(buf, written as number) : buf;
}

export function fromString(this typeof Buffer, value: string, encoding: string): Buffer {
	if (isHex(encoding)) return decodeText(value, false);
	if (isBase64(encoding)) return decodeText(value, true);
	// utf8 — and every other name takes the same fallback as the C side.
	return encodeUtf8(value);
}

export extern function copy(this typeof Buffer, value: Buffer): Buffer from "#.slice()";

export function compare(this typeof Buffer, a: Buffer, b: Buffer): number {
	const n = a.length < b.length ? a.length : b.length;
	let i = 0;
	while (i < n) {
		const x = a.byteAt(i);
		const y = b.byteAt(i);
		if (x != y) return x < y ? -1 : 1;
		i += 1;
	}
	if (a.length == b.length) return 0;
	return a.length < b.length ? -1 : 1;
}

export function concat(this typeof Buffer, a: Buffer, b: Buffer): Buffer {
	const out = Buffer.alloc(a.length + b.length);
	bufCopyInto(out, a, 0);
	bufCopyInto(out, b, a.length);
	return out;
}

export function isAscii(this typeof Buffer, value: Buffer): boolean {
	let i = 0;
	while (i < value.length) {
		if (value.byteAt(i) >= 128) return false;
		i += 1;
	}
	return true;
}

export function isUtf8(this typeof Buffer, value: Buffer): boolean {
	let i = 0;
	const n = value.length;
	while (i < n) {
		const b0 = value.byteAt(i);
		if (b0 < 128) {
			i += 1;
			continue;
		}
		let need = 0;
		let min = 128;
		if (b0 >= 194 && b0 <= 223) { need = 1; }
		else if (b0 == 224) { need = 2; min = 2048; }
		else if (b0 >= 225 && b0 <= 236) { need = 2; }
		else if (b0 == 237) { need = 2; }
		else if (b0 >= 238 && b0 <= 239) { need = 2; }
		else if (b0 == 240) { need = 3; min = 65536; }
		else if (b0 >= 241 && b0 <= 243) { need = 3; }
		else if (b0 == 244) { need = 3; }
		else return false;
		if (i + need >= n) return false;
		let cp = b0 & (31 >> (need - 1));
		let k = 1;
		while (k <= need) {
			const bk = value.byteAt(i + k);
			if ((bk & 192) != 128) return false;
			cp = (cp << 6) | (bk & 63);
			k += 1;
		}
		if (cp < min || cp > 1114111 || (cp >= 55296 && cp <= 57343)) return false;
		i += need + 1;
	}
	return true;
}

export function byteLength(this typeof Buffer, str: string, encoding: string = "utf-8"): number {
	if (encoding == "ascii" || encoding == "latin1" || encoding == "binary") return str.length;
	if (encoding == "utf16le" || encoding == "ucs2" || encoding == "ucs-2") return str.length * 2;
	const n = str.byteLength;
	if (encoding == "hex") return n / 2;
	if (encoding == "base64" || encoding == "base64url") {
		let m = n;
		if (m > 0 && str.byteAt(m - 1) == "=".code) m -= 1;
		if (m > 1 && str.byteAt(m - 1) == "=".code) m -= 1;
		return (m * 3) / 4;
	}
	return n;
}

export function isBufferEncoding(this typeof Buffer, encoding: string): boolean {
	if (encoding == "utf8" || encoding == "utf-8" ||
			encoding == "hex" || encoding == "ascii" ||
			encoding == "latin1" || encoding == "binary" ||
			encoding == "base64" || encoding == "base64url" ||
			encoding == "utf16le" || encoding == "ucs2" || encoding == "ucs-2") {
		return true;
	}
	return false;
}

export function concatList(this typeof Buffer, buffers: Buffer[]): Buffer {
	let total = 0;
	for (const b of buffers) { total += b.length; }
	const out = Buffer.alloc(total);
	let off = 0;
	for (const b of buffers) {
		bufCopyInto(out, b, off);
		off += b.length;
	}
	return out;
}

// ===== Extension Methods =====

export extern function byteAt(this b: Buffer, i: number): int32 from "#[#]";
export extern function byteLength(this b: Buffer): number from "#.length";

export extern function set(this b: Buffer, i: number, v: number): void from "#[#] = #";

export function toHex(this b: Buffer): string {
	return encodeHex(b);
}

export function toBase64(this b: Buffer): string {
	return encodeBase64(b);
}

export function toStringEncoded(this b: Buffer, encoding: string, start: number, end: number): string {
	const length = b.length as int64;
	const first = start as int64;
	const last = end as int64;
	const from = first < 0 ? 0 : first;
	const to = last < 0 || last > length ? length : last;
	if (from >= to) return "";
	if (isHex(encoding) || isBase64(encoding)) return encodeRange(b, from, to, encoding);
	const ascii = encoding.equalsIgnoreCase("ascii");
	if (ascii || encoding.equalsIgnoreCase("latin1") || encoding.equalsIgnoreCase("binary")) {
		const mask: int32 = ascii ? 127 : 255;
		let out = "";
		for (let i = from; i < to; i++) out = out + String.fromCharCode(b.byteAt(i as number) & mask);
		return out;
	}
	return decodeUtf8Range(b, from as number, to as number);
}

function encodeRange(data: Readonly<Span<uint8>>, from: int64, to: int64, encoding: string): string {
	const range = data[from..to];
	if (isHex(encoding)) return encodeHex(range);
	return encoding.equalsIgnoreCase("base64url") ? encodeBase64Url(range) : encodeBase64(range);
}

export function copyTo(this b: Buffer, target: Buffer, targetStart: number, sourceStart: number, sourceEnd: number): number {
	let s = sourceStart;
	let e = sourceEnd;
	let at = targetStart;
	if (s < 0) s = 0;
	if (e > b.length) e = b.length;
	if (at < 0) at = 0;
	if (s >= e) return 0;
	let len = e - s;
	if (at + len > target.length) len = target.length - at;
	if (len <= 0) return 0;
	for (let i = 0; i < len; i += 1) {
		target.set(at + i, b.byteAt(s + i));
	}
	return len;
}

export extern function fill(this b: Buffer, value: number, start: number, end: number): void from "#.fill(#, #, #)";
export extern function indexOf(this b: Buffer, value: number, byteOffset: number): number from "#.indexOf(#, #)";
export extern function lastIndexOf(this b: Buffer, value: number, byteOffset: number): number from "#.lastIndexOf(#, #)";
export extern function includes(this b: Buffer, value: number, byteOffset: number): boolean from "#.includes(#, #)";
function bufFind(hay: Buffer, needle: Buffer, from: number, reverse: boolean): number {
	const n = needle.length;
	if (n == 0) return from;
	let i = from;
	while (i >= 0 && i <= hay.length - n) {
		let k = 0;
		while (k < n && hay.byteAt(i + k) == needle.byteAt(k)) { k += 1; }
		if (k == n) return i;
		if (reverse) { i -= 1; } else { i += 1; }
	}
	return -1;
}
export function indexOfBuffer(this b: Buffer, needle: Buffer, byteOffset: number): number {
	return bufFind(b, needle, byteOffset < 0 ? 0 : byteOffset, false);
}
export function lastIndexOfBuffer(this b: Buffer, needle: Buffer, byteOffset: number): number {
	if (b.length == 0) return -1;
	if (needle.length == 0) return byteOffset < 0 || byteOffset >= b.length ? b.length : byteOffset;
	const last = b.length - needle.length;
	return bufFind(b, needle, byteOffset < 0 || byteOffset > last ? last : byteOffset, true);
}
export function includesBuffer(this b: Buffer, needle: Buffer, byteOffset: number): boolean {
	return indexOfBuffer(b, needle, byteOffset) != -1;
}
export extern function bufReverse(this b: Buffer): void from "#.reverse()";

export extern function swap16(this b: Buffer): void from "(function (u) { for (var i = 0; i + 1 < u.length; i += 2) { var t = u[i]; u[i] = u[i + 1]; u[i + 1] = t; } })(#)";
export extern function swap32(this b: Buffer): void from "(function (u) { for (var i = 0; i + 3 < u.length; i += 4) { var t = u[i]; u[i] = u[i + 3]; u[i + 3] = t; t = u[i + 1]; u[i + 1] = u[i + 2]; u[i + 2] = t; } })(#)";
export extern function swap64(this b: Buffer): void from "(function (u) { for (var i = 0; i + 7 < u.length; i += 8) { for (var k = 0; k < 4; k++) { var t = u[i + k]; u[i + k] = u[i + 7 - k]; u[i + 7 - k] = t; } } })(#)";

export function write(this b: Buffer, str: string, offset: number, length: number, encoding: string): number {
	if (encoding == "binary" || encoding == "latin1" || encoding == "ascii") {
		let i = 0;
		while (i < str.length && i < length) {
			b.set(offset + i, str.charCodeAt(i) & 255);
			i += 1;
		}
		return i;
	}
	if (isHex(encoding) || isBase64(encoding)) {
		const total = b.length as int64;
		const at = offset as int64;
		const limit = length as int64;
		if (str.length == 0 || at < 0 || at >= total) return 0;
		const room = limit < 0 || limit > total - at ? total - at : limit;
		const text = str.asBytes();
		return (isHex(encoding) ? writeHex(text, b, at, room) : writeBase64(text, b, at, room)) as number;
	}
	// utf8 fallback.
	const enc = encodeUtf8(str);
	let i = 0;
	while (i < enc.length && i < length) {
		b.set(offset + i, enc.byteAt(i));
		i += 1;
	}
	return i;
}

export function fillString(this b: Buffer, value: string, start: number, end: number, encoding: string): void {
	const pat = Buffer.fromString(value, encoding);
	if (pat.length == 0) return;
	let i = start;
	let k = 0;
	while (i < end) {
		b.set(i, pat.byteAt(k % pat.length));
		i += 1;
		k += 1;
	}
}

export function fillBuffer(this b: Buffer, value: Buffer, start: number, end: number): void {
	if (value.length == 0) return;
	let i = start;
	let k = 0;
	while (i < end) {
		b.set(i, value.byteAt(k % value.length));
		i += 1;
		k += 1;
	}
}

export function readUInt8(this b: Buffer, o: number): int32 {
	need(b, o, 1);
	return b.byteAt(o);
}
extern function dvReadUInt16BE(this b: Buffer, o: number): number from "new DataView(#.buffer).getUint16(#, false)";
export function readUInt16BE(this b: Buffer, o: number): number {
	need(b, o, 2);
	return dvReadUInt16BE(b, o);
}
extern function dvReadUInt16LE(this b: Buffer, o: number): number from "new DataView(#.buffer).getUint16(#, true)";
export function readUInt16LE(this b: Buffer, o: number): number {
	need(b, o, 2);
	return dvReadUInt16LE(b, o);
}
extern function dvReadUInt32BE(this b: Buffer, o: number): number from "new DataView(#.buffer).getUint32(#, false)";
export function readUInt32BE(this b: Buffer, o: number): number {
	need(b, o, 4);
	return dvReadUInt32BE(b, o);
}
extern function dvReadUInt32LE(this b: Buffer, o: number): number from "new DataView(#.buffer).getUint32(#, true)";
export function readUInt32LE(this b: Buffer, o: number): number {
	need(b, o, 4);
	return dvReadUInt32LE(b, o);
}
extern function dvReadInt8(this b: Buffer, o: number): number from "new DataView(#.buffer).getInt8(#)";
export function readInt8(this b: Buffer, o: number): number {
	need(b, o, 1);
	return dvReadInt8(b, o);
}
extern function dvReadInt16BE(this b: Buffer, o: number): number from "new DataView(#.buffer).getInt16(#, false)";
export function readInt16BE(this b: Buffer, o: number): number {
	need(b, o, 2);
	return dvReadInt16BE(b, o);
}
extern function dvReadInt16LE(this b: Buffer, o: number): number from "new DataView(#.buffer).getInt16(#, true)";
export function readInt16LE(this b: Buffer, o: number): number {
	need(b, o, 2);
	return dvReadInt16LE(b, o);
}
extern function dvReadInt32BE(this b: Buffer, o: number): number from "new DataView(#.buffer).getInt32(#, false)";
export function readInt32BE(this b: Buffer, o: number): number {
	need(b, o, 4);
	return dvReadInt32BE(b, o);
}
extern function dvReadInt32LE(this b: Buffer, o: number): number from "new DataView(#.buffer).getInt32(#, true)";
export function readInt32LE(this b: Buffer, o: number): number {
	need(b, o, 4);
	return dvReadInt32LE(b, o);
}
extern function dvReadFloatBE(this b: Buffer, o: number): number from "new DataView(#.buffer).getFloat32(#, false)";
export function readFloatBE(this b: Buffer, o: number): number {
	need(b, o, 4);
	return dvReadFloatBE(b, o);
}
extern function dvReadFloatLE(this b: Buffer, o: number): number from "new DataView(#.buffer).getFloat32(#, true)";
export function readFloatLE(this b: Buffer, o: number): number {
	need(b, o, 4);
	return dvReadFloatLE(b, o);
}
extern function dvReadDoubleBE(this b: Buffer, o: number): number from "new DataView(#.buffer).getFloat64(#, false)";
export function readDoubleBE(this b: Buffer, o: number): number {
	need(b, o, 8);
	return dvReadDoubleBE(b, o);
}
extern function dvReadDoubleLE(this b: Buffer, o: number): number from "new DataView(#.buffer).getFloat64(#, true)";
export function readDoubleLE(this b: Buffer, o: number): number {
	need(b, o, 8);
	return dvReadDoubleLE(b, o);
}
extern function dvReadBigUInt64LE(this b: Buffer, o: number): bigint from "new DataView(#.buffer).getBigUint64(#, true)";
export function readBigUInt64LE(this b: Buffer, o: number): bigint {
	need(b, o, 8);
	return dvReadBigUInt64LE(b, o);
}
extern function dvReadBigUInt64BE(this b: Buffer, o: number): bigint from "new DataView(#.buffer).getBigUint64(#, false)";
export function readBigUInt64BE(this b: Buffer, o: number): bigint {
	need(b, o, 8);
	return dvReadBigUInt64BE(b, o);
}
extern function dvReadBigInt64LE(this b: Buffer, o: number): bigint from "new DataView(#.buffer).getBigInt64(#, true)";
export function readBigInt64LE(this b: Buffer, o: number): bigint {
	need(b, o, 8);
	return dvReadBigInt64LE(b, o);
}
extern function dvReadBigInt64BE(this b: Buffer, o: number): bigint from "new DataView(#.buffer).getBigInt64(#, false)";
export function readBigInt64BE(this b: Buffer, o: number): bigint {
	need(b, o, 8);
	return dvReadBigInt64BE(b, o);
}

extern function dvSetBigU64LE(this b: Buffer, o: number, v: bigint): void from "new DataView(#.buffer).setBigUint64(#, #, true)";
extern function dvSetBigU64BE(this b: Buffer, o: number, v: bigint): void from "new DataView(#.buffer).setBigUint64(#, #, false)";
extern function dvSetBigI64LE(this b: Buffer, o: number, v: bigint): void from "new DataView(#.buffer).setBigInt64(#, #, true)";
extern function dvSetBigI64BE(this b: Buffer, o: number, v: bigint): void from "new DataView(#.buffer).setBigInt64(#, #, false)";

export function writeBigUInt64LE(this b: Buffer, value: bigint, o: number): number {
	need(b, o, 8);
	dvSetBigU64LE(b, o, value);
	return o + 8;
}

export function writeBigUInt64BE(this b: Buffer, value: bigint, o: number): number {
	need(b, o, 8);
	dvSetBigU64BE(b, o, value);
	return o + 8;
}

export function writeBigInt64LE(this b: Buffer, value: bigint, o: number): number {
	need(b, o, 8);
	dvSetBigI64LE(b, o, value);
	return o + 8;
}

export function writeBigInt64BE(this b: Buffer, value: bigint, o: number): number {
	need(b, o, 8);
	dvSetBigI64BE(b, o, value);
	return o + 8;
}

extern function dvSetU16BE(this b: Buffer, o: number, v: number): void from "new DataView(#.buffer).setUint16(#, #, false)";
extern function dvSetU16LE(this b: Buffer, o: number, v: number): void from "new DataView(#.buffer).setUint16(#, #, true)";
extern function dvSetU32BE(this b: Buffer, o: number, v: number): void from "new DataView(#.buffer).setUint32(#, #, false)";
extern function dvSetU32LE(this b: Buffer, o: number, v: number): void from "new DataView(#.buffer).setUint32(#, #, true)";
extern function dvSetF32LE(this b: Buffer, o: number, v: number): void from "new DataView(#.buffer).setFloat32(#, #, true)";
extern function dvSetF32BE(this b: Buffer, o: number, v: number): void from "new DataView(#.buffer).setFloat32(#, #, false)";
extern function dvSetF64LE(this b: Buffer, o: number, v: number): void from "new DataView(#.buffer).setFloat64(#, #, true)";
extern function dvSetF64BE(this b: Buffer, o: number, v: number): void from "new DataView(#.buffer).setFloat64(#, #, false)";

export function writeUInt8(this b: Buffer, v: number, o: number): number {
	inRange(v, 0, 255);
	need(b, o, 1);
	b.set(o, v as int32);
	return o + 1;
}
export function writeUInt16BE(this b: Buffer, v: number, o: number): number {
	need(b, o, 2);
	inRange(v, 0, 65535);
	dvSetU16BE(b, o, v);
	return o + 2;
}
export function writeUInt16LE(this b: Buffer, v: number, o: number): number {
	need(b, o, 2);
	inRange(v, 0, 65535);
	dvSetU16LE(b, o, v);
	return o + 2;
}
export function writeUInt32BE(this b: Buffer, v: number, o: number): number {
	need(b, o, 4);
	inRange(v, 0, 4294967295);
	dvSetU32BE(b, o, v);
	return o + 4;
}
export function writeUInt32LE(this b: Buffer, v: number, o: number): number {
	need(b, o, 4);
	inRange(v, 0, 4294967295);
	dvSetU32LE(b, o, v);
	return o + 4;
}
export function writeInt8(this b: Buffer, v: number, o: number): number {
	inRange(v, -128, 127);
	need(b, o, 1);
	b.set(o, (v as int32) & 255);
	return o + 1;
}
export function writeInt16BE(this b: Buffer, v: number, o: number): number {
	need(b, o, 2);
	inRange(v, -32768, 32767);
	dvSetU16BE(b, o, (v as int32) & 65535);
	return o + 2;
}
export function writeInt16LE(this b: Buffer, v: number, o: number): number {
	need(b, o, 2);
	inRange(v, -32768, 32767);
	dvSetU16LE(b, o, (v as int32) & 65535);
	return o + 2;
}
export function writeInt32BE(this b: Buffer, v: number, o: number): number {
	need(b, o, 4);
	inRange(v, -2147483648, 2147483647);
	dvSetU32BE(b, o, v);
	return o + 4;
}
export function writeInt32LE(this b: Buffer, v: number, o: number): number {
	need(b, o, 4);
	inRange(v, -2147483648, 2147483647);
	dvSetU32LE(b, o, v);
	return o + 4;
}
export function writeFloatLE(this b: Buffer, v: number, o: number): number {
	need(b, o, 4);
	dvSetF32LE(b, o, v);
	return o + 4;
}
export function writeFloatBE(this b: Buffer, v: number, o: number): number {
	need(b, o, 4);
	dvSetF32BE(b, o, v);
	return o + 4;
}
export function writeDoubleLE(this b: Buffer, v: number, o: number): number {
	need(b, o, 8);
	dvSetF64LE(b, o, v);
	return o + 8;
}
export function writeDoubleBE(this b: Buffer, v: number, o: number): number {
	need(b, o, 8);
	dvSetF64BE(b, o, v);
	return o + 8;
}

function badByteLength(byteLength: number, rule: string): never {
	throw new RangeError(
		`The value of "byteLength" is out of range. It must be ${rule}. Received ${byteLength}`,
	);
}

function checkByteLength(byteLength: number): void {
	if (Math.floor(byteLength) != byteLength) badByteLength(byteLength, "an integer");
	if (byteLength < 1 || byteLength > 6) badByteLength(byteLength, ">= 1 and <= 6");
}

export function readUIntLE(this b: Buffer, o: number, byteLength: number): number {
	checkByteLength(byteLength);
	need(b, o, byteLength);
	let v: number = 0;
	let k = 0;
	while (k < byteLength) {
		v += b.byteAt(o + k) * Math.pow(2, k * 8);
		k += 1;
	}
	return v;
}
export function readUIntBE(this b: Buffer, o: number, byteLength: number): number {
	checkByteLength(byteLength);
	need(b, o, byteLength);
	let v: number = 0;
	let k = 0;
	while (k < byteLength) {
		v = v * 256 + b.byteAt(o + k);
		k += 1;
	}
	return v;
}
export function readIntLE(this b: Buffer, o: number, byteLength: number): number {
	const u = readUIntLE(b, o, byteLength);
	const half = Math.pow(2, byteLength * 8 - 1);
	return u >= half ? u - half * 2 : u;
}
export function readIntBE(this b: Buffer, o: number, byteLength: number): number {
	const u = readUIntBE(b, o, byteLength);
	const half = Math.pow(2, byteLength * 8 - 1);
	return u >= half ? u - half * 2 : u;
}
export function writeUIntLE(this b: Buffer, v: number, o: number, byteLength: number): number {
	checkByteLength(byteLength);
	inRange(v, 0, Math.pow(2, byteLength * 8) - 1);
	need(b, o, byteLength);
	let x = v;
	let k = 0;
	while (k < byteLength) {
		b.set(o + k, x % 256);
		x = Math.floor(x / 256);
		k += 1;
	}
	return o + byteLength;
}
export function writeUIntBE(this b: Buffer, v: number, o: number, byteLength: number): number {
	checkByteLength(byteLength);
	inRange(v, 0, Math.pow(2, byteLength * 8) - 1);
	need(b, o, byteLength);
	let x = v;
	let k = byteLength - 1;
	while (k >= 0) {
		b.set(o + k, x % 256);
		x = Math.floor(x / 256);
		k -= 1;
	}
	return o + byteLength;
}
export function writeIntLE(this b: Buffer, v: number, o: number, byteLength: number): number {
	checkByteLength(byteLength);
	inRange(v, -Math.pow(2, byteLength * 8 - 1), Math.pow(2, byteLength * 8 - 1) - 1);
	const bound = Math.pow(2, byteLength * 8);
	return writeUIntLE(b, v >= 0 ? v : v + bound, o, byteLength);
}
export function writeIntBE(this b: Buffer, v: number, o: number, byteLength: number): number {
	checkByteLength(byteLength);
	inRange(v, -Math.pow(2, byteLength * 8 - 1), Math.pow(2, byteLength * 8 - 1) - 1);
	const bound = Math.pow(2, byteLength * 8);
	return writeUIntBE(b, v >= 0 ? v : v + bound, o, byteLength);
}

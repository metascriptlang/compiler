// Buffer on the js target is a plain growable Array of bytes, the
// representation a `uint8[]` literal has, so push and aliasing match the C
// side. This module provides the JS bodies of the byte surface that
// std/core/buffer declares:
//   - hot paths (set/byteAt/search/fill) bind via `from` templates, emitting
//     native subscripts with zero wrapper frame;
//   - endian reads and writes go through one scratch DataView;
//   - encoders (hex/base64/utf8) are pure loops over that surface.

import { Math } from "std/core/math";
import { encodeHex, encodeBase64 } from "std/core/encoding";
import {
	hexCapacity, base64Capacity, writeHex, writeBase64, encodeBase64Url, writeRoom,
	utf8Encoding, hexEncoding, base64Encoding, base64UrlEncoding, latin1Encoding, asciiEncoding,
	encodingOf, textEncoding, sliceEncoding, encodedLength, writeText, ucs2Text,
	needBytes, needValue, storedInt, needWideValue, needBigValue, needWidth,
} from "./codec";

import { Buffer } from "./type";
export { Buffer } from "./type";
export { toJSON, inspect } from "./protocols";

/** Decodes the bytes as UTF-8 the way Node does: an ill-formed sequence becomes U+FFFD. */
export function toString(this b: Buffer): string {
	return b.toStringEncoded("utf8", 0, b.length);
}

// ===== private native bindings =====

@emit(`const msBufWord = new DataView(new ArrayBuffer(8));
function msBufLoad(b, o, n) {
	for (let i = 0; i < n; i++) msBufWord.setUint8(i, b[o + i]);
	return msBufWord;
}
function msBufSet(b, i, v) {
	i = Math.trunc(i);
	if (i >= 0 && i < b.length) b[i] = v & 255;
}
function msBufAt(b, i) {
	i = Math.trunc(i);
	return i >= 0 && i < b.length ? b[i] : -1;
}
function msBufStore(b, o, n, put) {
	put(msBufWord);
	for (let i = 0; i < n; i++) b[o + i] = msBufWord.getUint8(i);
}`);

function bufCopyInto(dst: Buffer, src: Buffer, at: number): void {
	let i = 0;
	while (i < src.length) {
		dst.set(at + i, src.byteAt(i));
		i += 1;
	}
}

// ===== Free Functions (constructors / static-like) =====

export function alloc(this typeof Buffer, size: number): Buffer {
	return new Array<uint8>(size as int64) as Buffer;
}

// js has no unsafe allocation; a zero-filled array is a semantic superset.
export function allocUnsafe(this typeof Buffer, size: number): Buffer {
	return new Array<uint8>(size as int64) as Buffer;
}

export extern function fromArray(this typeof Buffer, arr: number[]): Buffer from "Array.from(#, (x) => x & 255)";

extern function decodeUtf8Range(b: Buffer, start: number, end: number): string from "new TextDecoder('utf-8', { ignoreBOM: true }).decode(Uint8Array.from(#.slice(#, #)))";

extern function prefixOf(b: Buffer, length: number): Buffer from "#.slice(0, #)";

function decodeText(value: string, base64: boolean): Buffer {
	const text = value.asBytes();
	const capacity = base64 ? base64Capacity(text) : hexCapacity(text);
	const buf = Buffer.alloc(capacity as number);
	const written = base64 ? writeBase64(text, buf, 0, capacity) : writeHex(text, buf, 0, capacity);
	return written < capacity ? prefixOf(buf, written as number) : buf;
}

export function fromString(this typeof Buffer, value: string, name: string): Buffer {
	const encoding = textEncoding(name);
	if (encoding == hexEncoding) return decodeText(value, false);
	if (encoding == base64Encoding || encoding == base64UrlEncoding) return decodeText(value, true);
	const capacity = encodedLength(value, encoding);
	const buf = Buffer.alloc(capacity);
	const written = writeText(value.asBytes(), buf, 0, capacity as int64, encoding);
	return (written as number) < capacity ? prefixOf(buf, written as number) : buf;
}

export extern function slice(this b: Buffer, start: number = 0, end: number = 9007199254740991): Buffer from "#.slice(#, #)";

export extern function copy(this typeof Buffer, value: Buffer): Buffer from "#.slice()";

export function compare(this typeof Buffer, a: Buffer, b: Buffer): number {
	const n = a.length < b.length ? a.length : b.length;
	let i = 0;
	while (i < n) {
		const x = a.byteAt(i);
		const y = b.byteAt(i);
		if (x != y) return x < y ? -1 : 1;
		i += 1;
	}
	if (a.length == b.length) return 0;
	return a.length < b.length ? -1 : 1;
}

export function concat(this typeof Buffer, a: Buffer, b: Buffer): Buffer {
	const out = Buffer.alloc(a.length + b.length);
	bufCopyInto(out, a, 0);
	bufCopyInto(out, b, a.length);
	return out;
}

export function isAscii(this typeof Buffer, value: Buffer): boolean {
	let i = 0;
	while (i < value.length) {
		if (value.byteAt(i) >= 128) return false;
		i += 1;
	}
	return true;
}

export function isUtf8(this typeof Buffer, value: Buffer): boolean {
	let i = 0;
	const n = value.length;
	while (i < n) {
		const b0 = value.byteAt(i);
		if (b0 < 128) {
			i += 1;
			continue;
		}
		let need = 0;
		let min = 128;
		if (b0 >= 194 && b0 <= 223) { need = 1; }
		else if (b0 == 224) { need = 2; min = 2048; }
		else if (b0 >= 225 && b0 <= 236) { need = 2; }
		else if (b0 == 237) { need = 2; }
		else if (b0 >= 238 && b0 <= 239) { need = 2; }
		else if (b0 == 240) { need = 3; min = 65536; }
		else if (b0 >= 241 && b0 <= 243) { need = 3; }
		else if (b0 == 244) { need = 3; }
		else return false;
		if (i + need >= n) return false;
		let cp = b0 & (31 >> (need - 1));
		let k = 1;
		while (k <= need) {
			const bk = value.byteAt(i + k);
			if ((bk & 192) != 128) return false;
			cp = (cp << 6) | (bk & 63);
			k += 1;
		}
		if (cp < min || cp > 1114111 || (cp >= 55296 && cp <= 57343)) return false;
		i += need + 1;
	}
	return true;
}

export function byteLength(this typeof Buffer, str: string, encoding: string = "utf-8"): number {
	return encodedLength(str, encodingOf(encoding));
}

export function isBufferEncoding(this typeof Buffer, encoding: string): boolean {
	return encodingOf(encoding) >= 0;
}

export function concatList(this typeof Buffer, buffers: Buffer[]): Buffer {
	let total = 0;
	for (const b of buffers) { total += b.length; }
	const out = Buffer.alloc(total);
	let off = 0;
	for (const b of buffers) {
		bufCopyInto(out, b, off);
		off += b.length;
	}
	return out;
}

// ===== Extension Methods =====

extern function byteInBounds(this b: Buffer, i: number): int32 from "msBufAt(#, #)";
export function byteAt(this b: Buffer, i: number): int32 {
	return b.byteInBounds(i);
}
export extern function byteLength(this b: Buffer): number from "#.length";

extern function setInBounds(this b: Buffer, i: number, v: number): void from "msBufSet(#, #, #)";
export function set(this b: Buffer, i: number, v: number): void {
	b.setInBounds(i, v);
}

export function toHex(this b: Buffer): string {
	return encodeHex(b);
}

export function toBase64(this b: Buffer): string {
	return encodeBase64(b);
}

export function toStringEncoded(this b: Buffer, name: string, start: number, end: number): string {
	const length = b.length as int64;
	const first = start as int64;
	const last = end as int64;
	const from = first < 0 ? 0 : first;
	const to = last < 0 || last > length ? length : last;
	if (from >= to) return "";
	const encoding = sliceEncoding(name);
	if (encoding == utf8Encoding) return decodeUtf8Range(b, from as number, to as number);
	if (encoding == asciiEncoding || encoding == latin1Encoding) {
		const mask: int32 = encoding == asciiEncoding ? 127 : 255;
		let out = "";
		for (let i = from; i < to; i++) out = out + String.fromCharCode(b.byteAt(i as number) & mask);
		return out;
	}
	return encodeRange(b, from, to, encoding);
}

function encodeRange(data: Readonly<Span<uint8>>, from: int64, to: int64, encoding: int32): string {
	const range = data[from..to];
	if (encoding == hexEncoding) return encodeHex(range);
	if (encoding == base64Encoding) return encodeBase64(range);
	if (encoding == base64UrlEncoding) return encodeBase64Url(range);
	return ucs2Text(range);
}

export function copyTo(this b: Buffer, target: Buffer, targetStart: number, sourceStart: number, sourceEnd: number): number {
	let s = sourceStart;
	let e = sourceEnd;
	let at = targetStart;
	if (s < 0) s = 0;
	if (e > b.length) e = b.length;
	if (at < 0) at = 0;
	if (s >= e) return 0;
	let len = e - s;
	if (at + len > target.length) len = target.length - at;
	if (len <= 0) return 0;
	for (let i = 0; i < len; i += 1) {
		target.set(at + i, b.byteAt(s + i));
	}
	return len;
}

export extern function fill(this b: Buffer, value: number, start: number, end: number): void from "#.fill((#) & 255, #, #)";
export extern function indexOf(this b: Buffer, value: number, byteOffset: number): number from "#.indexOf(#, #)";
export extern function lastIndexOf(this b: Buffer, value: number, byteOffset: number): number from "#.lastIndexOf(#, #)";
export extern function includes(this b: Buffer, value: number, byteOffset: number): boolean from "#.includes(#, #)";
function bufFind(hay: Buffer, needle: Buffer, from: number, reverse: boolean): number {
	const n = needle.length;
	if (n == 0) return from;
	let i = from;
	while (i >= 0 && i <= hay.length - n) {
		let k = 0;
		while (k < n && hay.byteAt(i + k) == needle.byteAt(k)) { k += 1; }
		if (k == n) return i;
		if (reverse) { i -= 1; } else { i += 1; }
	}
	return -1;
}
export function indexOfBuffer(this b: Buffer, needle: Buffer, byteOffset: number): number {
	return bufFind(b, needle, byteOffset < 0 ? 0 : byteOffset, false);
}
export function lastIndexOfBuffer(this b: Buffer, needle: Buffer, byteOffset: number): number {
	if (b.length == 0) return -1;
	if (needle.length == 0) return byteOffset < 0 || byteOffset >= b.length ? b.length : byteOffset;
	const last = b.length - needle.length;
	return bufFind(b, needle, byteOffset < 0 || byteOffset > last ? last : byteOffset, true);
}
export function includesBuffer(this b: Buffer, needle: Buffer, byteOffset: number): boolean {
	return indexOfBuffer(b, needle, byteOffset) != -1;
}
export extern function bufReverse(this b: Buffer): void from "#.reverse()";

export extern function swap16(this b: Buffer): void from "(function (u) { for (var i = 0; i + 1 < u.length; i += 2) { var t = u[i]; u[i] = u[i + 1]; u[i + 1] = t; } })(#)";
export extern function swap32(this b: Buffer): void from "(function (u) { for (var i = 0; i + 3 < u.length; i += 4) { var t = u[i]; u[i] = u[i + 3]; u[i + 3] = t; t = u[i + 1]; u[i + 1] = u[i + 2]; u[i + 2] = t; } })(#)";
export extern function swap64(this b: Buffer): void from "(function (u) { for (var i = 0; i + 7 < u.length; i += 8) { for (var k = 0; k < 4; k++) { var t = u[i + k]; u[i + k] = u[i + 7 - k]; u[i + 7 - k] = t; } } })(#)";

export function write(this b: Buffer, str: string, offset: number, length: number, name: string): number {
	const room = writeRoom(b.length as int64, offset, length);
	const encoding = textEncoding(name);
	if (str.length == 0) return 0;
	const text = str.asBytes();
	if (encoding == hexEncoding) return writeHex(text, b, offset as int64, room) as number;
	if (encoding == base64Encoding || encoding == base64UrlEncoding) return writeBase64(text, b, offset as int64, room) as number;
	return writeText(text, b, offset as int64, room, encoding) as number;
}

export function fillString(this b: Buffer, value: string, start: number, end: number, encoding: string): void {
	const pat = Buffer.fromString(value, encoding);
	if (pat.length == 0) return;
	let i = start;
	let k = 0;
	while (i < end) {
		b.set(i, pat.byteAt(k % pat.length));
		i += 1;
		k += 1;
	}
}

export function fillBuffer(this b: Buffer, value: Buffer, start: number, end: number): void {
	if (value.length == 0) return;
	let i = start;
	let k = 0;
	while (i < end) {
		b.set(i, value.byteAt(k % value.length));
		i += 1;
		k += 1;
	}
}

export function readUInt8(this b: Buffer, o: number): int32 {
	needBytes(b.length, o, 1);
	return b.byteAt(o);
}
export function readUInt16BE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 2);
	@emit(`return msBufLoad(${b}, ${o}, 2).getUint16(0, false);`);
	unreachable;
}
export function readUInt16LE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 2);
	@emit(`return msBufLoad(${b}, ${o}, 2).getUint16(0, true);`);
	unreachable;
}
export function readUInt32BE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 4);
	@emit(`return msBufLoad(${b}, ${o}, 4).getUint32(0, false);`);
	unreachable;
}
export function readUInt32LE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 4);
	@emit(`return msBufLoad(${b}, ${o}, 4).getUint32(0, true);`);
	unreachable;
}
export function readInt8(this b: Buffer, o: number): number {
	needBytes(b.length, o, 1);
	@emit(`return msBufLoad(${b}, ${o}, 1).getInt8(0);`);
	unreachable;
}
export function readInt16BE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 2);
	@emit(`return msBufLoad(${b}, ${o}, 2).getInt16(0, false);`);
	unreachable;
}
export function readInt16LE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 2);
	@emit(`return msBufLoad(${b}, ${o}, 2).getInt16(0, true);`);
	unreachable;
}
export function readInt32BE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 4);
	@emit(`return msBufLoad(${b}, ${o}, 4).getInt32(0, false);`);
	unreachable;
}
export function readInt32LE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 4);
	@emit(`return msBufLoad(${b}, ${o}, 4).getInt32(0, true);`);
	unreachable;
}
export function readFloatBE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 4);
	@emit(`return msBufLoad(${b}, ${o}, 4).getFloat32(0, false);`);
	unreachable;
}
export function readFloatLE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 4);
	@emit(`return msBufLoad(${b}, ${o}, 4).getFloat32(0, true);`);
	unreachable;
}
export function readDoubleBE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 8);
	@emit(`return msBufLoad(${b}, ${o}, 8).getFloat64(0, false);`);
	unreachable;
}
export function readDoubleLE(this b: Buffer, o: number): number {
	needBytes(b.length, o, 8);
	@emit(`return msBufLoad(${b}, ${o}, 8).getFloat64(0, true);`);
	unreachable;
}
export function readBigUInt64LE(this b: Buffer, o: number): bigint {
	needBytes(b.length, o, 8);
	@emit(`return msBufLoad(${b}, ${o}, 8).getBigUint64(0, true);`);
	unreachable;
}
export function readBigUInt64BE(this b: Buffer, o: number): bigint {
	needBytes(b.length, o, 8);
	@emit(`return msBufLoad(${b}, ${o}, 8).getBigUint64(0, false);`);
	unreachable;
}
export function readBigInt64LE(this b: Buffer, o: number): bigint {
	needBytes(b.length, o, 8);
	@emit(`return msBufLoad(${b}, ${o}, 8).getBigInt64(0, true);`);
	unreachable;
}
export function readBigInt64BE(this b: Buffer, o: number): bigint {
	needBytes(b.length, o, 8);
	@emit(`return msBufLoad(${b}, ${o}, 8).getBigInt64(0, false);`);
	unreachable;
}

extern function dvSetBigU64LE(this b: Buffer, o: number, v: bigint): void from "msBufStore(#, #, 8, (w) => w.setBigUint64(0, #, true))";
extern function dvSetBigU64BE(this b: Buffer, o: number, v: bigint): void from "msBufStore(#, #, 8, (w) => w.setBigUint64(0, #, false))";
extern function dvSetBigI64LE(this b: Buffer, o: number, v: bigint): void from "msBufStore(#, #, 8, (w) => w.setBigInt64(0, #, true))";
extern function dvSetBigI64BE(this b: Buffer, o: number, v: bigint): void from "msBufStore(#, #, 8, (w) => w.setBigInt64(0, #, false))";

export function writeBigUInt64LE(this b: Buffer, value: bigint, o: number): number {
	needBigValue(value, false);
	needBytes(b.length, o, 8);
	dvSetBigU64LE(b, o, value);
	return o + 8;
}

export function writeBigUInt64BE(this b: Buffer, value: bigint, o: number): number {
	needBigValue(value, false);
	needBytes(b.length, o, 8);
	dvSetBigU64BE(b, o, value);
	return o + 8;
}

export function writeBigInt64LE(this b: Buffer, value: bigint, o: number): number {
	needBigValue(value, true);
	needBytes(b.length, o, 8);
	dvSetBigI64LE(b, o, value);
	return o + 8;
}

export function writeBigInt64BE(this b: Buffer, value: bigint, o: number): number {
	needBigValue(value, true);
	needBytes(b.length, o, 8);
	dvSetBigI64BE(b, o, value);
	return o + 8;
}

extern function dvSetU16BE(this b: Buffer, o: number, v: number): void from "msBufStore(#, #, 2, (w) => w.setUint16(0, #, false))";
extern function dvSetU16LE(this b: Buffer, o: number, v: number): void from "msBufStore(#, #, 2, (w) => w.setUint16(0, #, true))";
extern function dvSetU32BE(this b: Buffer, o: number, v: number): void from "msBufStore(#, #, 4, (w) => w.setUint32(0, #, false))";
extern function dvSetU32LE(this b: Buffer, o: number, v: number): void from "msBufStore(#, #, 4, (w) => w.setUint32(0, #, true))";
extern function dvSetF32LE(this b: Buffer, o: number, v: number): void from "msBufStore(#, #, 4, (w) => w.setFloat32(0, #, true))";
extern function dvSetF32BE(this b: Buffer, o: number, v: number): void from "msBufStore(#, #, 4, (w) => w.setFloat32(0, #, false))";
extern function dvSetF64LE(this b: Buffer, o: number, v: number): void from "msBufStore(#, #, 8, (w) => w.setFloat64(0, #, true))";
extern function dvSetF64BE(this b: Buffer, o: number, v: number): void from "msBufStore(#, #, 8, (w) => w.setFloat64(0, #, false))";

export function writeUInt8(this b: Buffer, v: number, o: number): number {
	needValue(v, 0, 255);
	needBytes(b.length, o, 1);
	b.set(o, storedInt(v) as int32);
	return o + 1;
}
export function writeUInt16BE(this b: Buffer, v: number, o: number): number {
	needValue(v, 0, 65535);
	needBytes(b.length, o, 2);
	dvSetU16BE(b, o, v);
	return o + 2;
}
export function writeUInt16LE(this b: Buffer, v: number, o: number): number {
	needValue(v, 0, 65535);
	needBytes(b.length, o, 2);
	dvSetU16LE(b, o, v);
	return o + 2;
}
export function writeUInt32BE(this b: Buffer, v: number, o: number): number {
	needValue(v, 0, 4294967295);
	needBytes(b.length, o, 4);
	dvSetU32BE(b, o, v);
	return o + 4;
}
export function writeUInt32LE(this b: Buffer, v: number, o: number): number {
	needValue(v, 0, 4294967295);
	needBytes(b.length, o, 4);
	dvSetU32LE(b, o, v);
	return o + 4;
}
export function writeInt8(this b: Buffer, v: number, o: number): number {
	needValue(v, -128, 127);
	needBytes(b.length, o, 1);
	b.set(o, (storedInt(v) as int32) & 255);
	return o + 1;
}
export function writeInt16BE(this b: Buffer, v: number, o: number): number {
	needValue(v, -32768, 32767);
	needBytes(b.length, o, 2);
	dvSetU16BE(b, o, (storedInt(v) as int32) & 65535);
	return o + 2;
}
export function writeInt16LE(this b: Buffer, v: number, o: number): number {
	needValue(v, -32768, 32767);
	needBytes(b.length, o, 2);
	dvSetU16LE(b, o, (storedInt(v) as int32) & 65535);
	return o + 2;
}
export function writeInt32BE(this b: Buffer, v: number, o: number): number {
	needValue(v, -2147483648, 2147483647);
	needBytes(b.length, o, 4);
	dvSetU32BE(b, o, v);
	return o + 4;
}
export function writeInt32LE(this b: Buffer, v: number, o: number): number {
	needValue(v, -2147483648, 2147483647);
	needBytes(b.length, o, 4);
	dvSetU32LE(b, o, v);
	return o + 4;
}
export function writeFloatLE(this b: Buffer, v: number, o: number): number {
	needBytes(b.length, o, 4);
	dvSetF32LE(b, o, v);
	return o + 4;

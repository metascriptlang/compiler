	dvSetF64BE(b, o, v);
	return o + 8;
}

export function readUIntLE(this b: Buffer, o: number, byteLength: number): number {
	needWidth(byteLength);
	needBytes(b.length, o, byteLength);
	let v: number = 0;
	let k = 0;
	while (k < byteLength) {
		v += b.byteAt(o + k) * Math.pow(2, k * 8);
		k += 1;
	}
	return v;
}
export function readUIntBE(this b: Buffer, o: number, byteLength: number): number {
	needWidth(byteLength);
	needBytes(b.length, o, byteLength);
	let v: number = 0;
	let k = 0;
	while (k < byteLength) {
		v = v * 256 + b.byteAt(o + k);
		k += 1;
	}
	return v;
}
export function readIntLE(this b: Buffer, o: number, byteLength: number): number {
	const u = readUIntLE(b, o, byteLength);
	const half = Math.pow(2, byteLength * 8 - 1);
	return u >= half ? u - half * 2 : u;
}
export function readIntBE(this b: Buffer, o: number, byteLength: number): number {
	const u = readUIntBE(b, o, byteLength);
	const half = Math.pow(2, byteLength * 8 - 1);
	return u >= half ? u - half * 2 : u;
}
export function writeUIntLE(this b: Buffer, v: number, o: number, byteLength: number): number {
	needWideValue(v, byteLength, false);
	needBytes(b.length, o, byteLength);
	let x = v;
	let k = 0;
	while (k < byteLength) {
		b.set(o + k, x % 256);
		x = Math.floor(x / 256);
		k += 1;
	}
	return o + byteLength;
}
export function writeUIntBE(this b: Buffer, v: number, o: number, byteLength: number): number {
	needWideValue(v, byteLength, false);
	needBytes(b.length, o, byteLength);
	let x = v;

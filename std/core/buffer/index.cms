@include("runtime/core/buffer.h");

import { Math } from "std/core/math";
import { encodeHex, encodeBase64 } from "std/crypto/encoding";
import { newEncodingOutput, freshEncodingOutputBytes } from "std/crypto/encodingOutput";
import { hexCapacity, base64Capacity, writeHex, writeBase64, encodeBase64Url } from "./codec";
import { asciiWords, utf8String } from "../string/bytes";

export type Buffer = uint8[];

function bufferAlloc(size: number): Buffer {
	return new Array<uint8>(size as int64);
}

export function alloc(this typeof Buffer, size: number): Buffer {
	return bufferAlloc(size);
}

export function allocUnsafe(this typeof Buffer, size: number): Buffer {
	return bufferAlloc(size);
}

extern function newBytes(length: int64): string from "msStringNewUninit";
extern function copyTo(dst: Ptr<uint8>, at: int64, src: Readonly<Span<uint8>>, from: int64, n: int64): void from "msMemCopyTo";
extern function msStringMarkAscii(s: string): void;
extern function msStringMarkNonAscii(s: string): void;

when (!bare && !solana) {
	extern function msBigIntFromInt64(v: int64): bigint;
	extern function msBigIntFromUint64(v: uint64): bigint;
	extern function msBigIntToInt64(b: bigint): int64;
}


@include("string.h");
extern function cMemset(p: Ptr<uint8>, value: int32, size: uint64): Ptr<uint8> from "memset";
extern function cMemcpy(
	to: Ptr<uint8>,
	from: Readonly<Ptr<uint8>>,
	size: uint64,
): Ptr<uint8> from "memcpy";
extern function cMemmove(to: Ptr<uint8>, from: Ptr<uint8>, size: uint64): Ptr<uint8> from "memmove";
extern function cMemchr(p: Ptr<uint8>, value: int32, size: uint64): Ptr<uint8> | null from "memchr";
extern function cMemcmp(a: Ptr<uint8>, b: Ptr<uint8>, size: uint64): int32 from "memcmp";

// ===== Byte access =====

extern function bytePointer(this buf: Buffer): Ptr<uint8> from "msBufferData";

function textPointer(this text: string): Readonly<Ptr<uint8>> {
	return (text as cstring) as Readonly<Ptr<uint8>>;
}

function byteCount(this buf: Buffer): int64 {
	return buf.length as int64;
}

function byteCount(this text: string): int64 {
	return text.asBytes().length as int64;
}

export function byteLength(this buf: Buffer): number {
	return buf.length;
}

export function byteAt(this buf: Buffer, index: number): int32 {
	const at = index as int64;
	return at >= 0 && at < buf.byteCount() ? buf.bytePointer()[at] as int32 : -1;
}

function fits(this buf: Buffer, at: int64, width: int64): boolean {
	return at >= 0 && at <= buf.byteCount() - width;
}

function loadField(this buf: Buffer, at: int64, width: int64, bigEndian: boolean): uint64 {
	const bytes = buf.bytePointer() + at;
	let value: uint64 = 0;
	for (let i: int64 = 0; i < width; i++) {
		const byte = bigEndian ? bytes[width - 1 - i] : bytes[i];
		value |= (byte as uint64) << ((i << 3) as uint64);
	}
	return value;
}

function storeField(
	this buf: Buffer,
	at: int64,
	width: int64,
	bigEndian: boolean,
	value: int64,
): void {
	const bytes = buf.bytePointer() + at;
	for (let i: int64 = 0; i < width; i++) {
		const byte = (value >> (i << 3)) as uint8;
		if (bigEndian) bytes[width - 1 - i] = byte;
		else bytes[i] = byte;
	}
}

function signExtend(value: uint64, bits: int64): int64 {
	const sign = (1 as int64) << (bits - 1);
	return ((value as int64) ^ sign) - sign;
}

function bitsToInt64(value: uint64): int64 {
	return value > 0x7FFFFFFFFFFFFFFF ? -((~value) as int64) - 1 : value as int64;
}

function floatFromBits(bits: uint32): float32 {
	let cell: uint32[1] = [bits];
	return (((cell as Span<uint32>) as Ptr<uint32>) as Ptr<float32>)[0];
}

function floatBits(value: float32): uint32 {
	let cell: float32[1] = [value];
	return (((cell as Span<float32>) as Ptr<float32>) as Ptr<uint32>)[0];
}

function doubleFromBits(bits: uint64): number {
	let cell: uint64[1] = [bits];
	return (((cell as Span<uint64>) as Ptr<uint64>) as Ptr<number>)[0];
}

function doubleBits(value: number): uint64 {
	let cell: number[1] = [value];
	return (((cell as Span<number>) as Ptr<number>) as Ptr<uint64>)[0];
}

function readField(this buf: Buffer, offset: number, width: int64, bigEndian: boolean): uint64 {
	const at = offset as int64;
	return buf.fits(at, width) ? buf.loadField(at, width, bigEndian) : 0;
}

function readSigned(this buf: Buffer, offset: number, width: int64, bigEndian: boolean): number {
	const at = offset as int64;
	return buf.fits(at, width)
		? signExtend(buf.loadField(at, width, bigEndian), width << 3) as number
		: 0;
}

function writeField(
	this buf: Buffer,
	value: int64,
	offset: number,
	width: int64,
	bigEndian: boolean,
): number {
	const at = offset as int64;
	if (!buf.fits(at, width)) return at as number;
	buf.storeField(at, width, bigEndian, value);
	return (at + width) as number;
}

function copyBytes(
	this source: Buffer,
	target: Buffer,
	targetStart: int64,
	sourceStart: int64,
	sourceEnd: int64,
): int64 {
	const sourceLength = source.byteCount();
	const from = sourceStart < 0 ? 0 : sourceStart;
	const end = sourceEnd > sourceLength ? sourceLength : sourceEnd;
	const to = targetStart < 0 ? 0 : targetStart;
	if (from >= end) return 0;
	const room = target.byteCount() - to;
	const count = end - from > room ? room : end - from;
	if (count <= 0) return 0;
	cMemmove(target.bytePointer() + to, source.bytePointer() + from, count as uint64);
	return count;
}

function fillRepeated(
	this buf: Buffer,
	from: int64,
	to: int64,
	pattern: Readonly<Ptr<uint8>>,
	patternLength: int64,
): void {
	const at = buf.bytePointer() + from;
	const total = to - from;
	if (patternLength == 1) {
		cMemset(at, pattern[0] as int32, total as uint64);
		return;
	}
	let written = patternLength < total ? patternLength : total;
	cMemcpy(at, pattern, written as uint64);
	while (written + written <= total) {
		cMemcpy(at + written, at, written as uint64);
		written *= 2;
	}
	if (written < total) cMemcpy(at + written, at, (total - written) as uint64);
}

// One byte through memchr, up to four through a first/last byte filter, longer needles
// through a Horspool skip table. Callers guarantee 0 < needleLength <= hayLength.
function findBytes(
	hay: Ptr<uint8>,
	hayLength: int64,
	needle: Ptr<uint8>,
	needleLength: int64,
): int64 {
	if (needleLength == 1) {
		const found = cMemchr(hay, needle[0] as int32, hayLength as uint64);
		return found == null ? -1 : (found as Ptr<uint8>) - hay;
	}
	if (needleLength <= 4) {
		const end = hayLength - needleLength + 1;
		const first = needle[0];
		const last = needle[needleLength - 1];
		let at: int64 = 0;
		while (at < end && !(hay[at] == first && hay[at + needleLength - 1] == last &&
				(needleLength == 2 || cMemcmp(hay + at, needle, needleLength as uint64) == 0))) {
			at += 1;
		}
		return at < end ? at : -1;
	}
	let pastLast: int32[256] = [];
	const table = (pastLast as Span<int32>) as Ptr<int32>;
	for (let i: int64 = 0; i < needleLength - 1; i++) table[needle[i]] = (i + 1) as int32;
	let i = needleLength - 1;
	let found: int64 = -1;
	while (found < 0 && i < hayLength) {
		let j = needleLength - 1;
		let k = i;
		while (j > 0 && hay[k] == needle[j]) {
			k -= 1;
			j -= 1;
		}
		if (j == 0 && hay[k] == needle[0]) found = k;
		else i += needleLength - table[hay[i]] as int64;
	}
	return found;
}

// ===== Free Functions (constructors / static-like) =====

function copyOf(value: Readonly<Span<uint8>>): Buffer {
	const length = value.length as int64;
	const buf = bufferAlloc(length as number);
	copyTo(buf.bytePointer(), 0, value, 0, length);
	return buf;
}

function isHex(encoding: string): boolean {
	return encoding == "hex" || encoding.equalsIgnoreCase("hex");
}

function isBase64(encoding: string): boolean {
	return encoding == "base64" || encoding.equalsIgnoreCase("base64") || encoding.equalsIgnoreCase("base64url");
}

function decodeText(value: string, base64: boolean): Buffer {
	const text = value.asBytes();
	const capacity = base64 ? base64Capacity(text) : hexCapacity(text);
	const buf = bufferAlloc(capacity as number);
	const written = base64 ? writeBase64(text, buf.bytePointer(), 0, capacity) : writeHex(text, buf.bytePointer(), 0, capacity);
	if (written < capacity) buf.length = written as int32;
	return buf;
}

@inline
export function fromString(this typeof Buffer, value: string, encoding: string): Buffer {
	return decodeString(value, encoding);
}

function decodeString(value: string, encoding: string): Buffer {
	if (isHex(encoding)) return decodeText(value, false);
	if (isBase64(encoding)) return decodeText(value, true);
	return copyOf(value.asBytes());
}

export function fromArray(this typeof Buffer, arr: number[]): Buffer {
	const buf = bufferAlloc(arr.length);
	for (let i = 0; i < arr.length; i++) buf.set(i, arr[i]);
	return buf;
}

export function copy(this typeof Buffer, value: Buffer): Buffer {
	return copyOf(value);
}

export function compare(this typeof Buffer, a: Buffer, b: Buffer): number {
	const left = a.byteCount();
	const right = b.byteCount();
	const shared = left < right ? left : right;
	const order = shared == 0 ? 0 : cMemcmp(a.bytePointer(), b.bytePointer(), shared as uint64);
	if (order != 0) return order < 0 ? -1 : 1;
	return left == right ? 0 : left < right ? -1 : 1;
}

export function concat(this typeof Buffer, a: Buffer, b: Buffer): Buffer {
	const result = bufferAlloc((a.byteCount() + b.byteCount()) as number);
	a.copyBytes(result, 0, 0, a.byteCount());
	b.copyBytes(result, a.byteCount(), 0, b.byteCount());
	return result;
}

const HIGH_BITS: uint64 = 0x8080808080808080;

// Through memcpy, which clang folds into one load at any alignment.
function wordAt(bytes: Readonly<Ptr<uint8>>): uint64 {
	let cell: uint64[1] = [0];
	cMemcpy(((cell as Span<uint64>) as Ptr<uint64>) as Ptr<uint8>, bytes, 8);
	return cell[0];
}

// Thin LTO inlines this into the caller's loop, where clang 18 keeps the length tests: byte 0 is
// tested before any size dispatch (1.6-2.1x on x86 behind it), under 8 bytes run the C byte loop,
// longer input joins one result from the words and the overlapping last word.
export function isAscii(this typeof Buffer, value: Buffer): boolean {
	const length = value.byteCount();
	if (length == 0) return true;
	const bytes: Readonly<Ptr<uint8>> = value.bytePointer();
	if (bytes[0] > 0x7F) return false;
	if (length < 8) {
		let at: int64 = 1;
		while (at < length) {
			if (bytes[at] > 0x7F) return false;
			at += 1;
		}
		return true;
	}
	const words = bytes as Readonly<Ptr<uint64>>;
	const wordCount = length >> 3;
	let high = words[0] & HIGH_BITS;
	let word: int64 = 1;
	while (high == 0 && word < wordCount) {
		high = words[word] & HIGH_BITS;
		word += 1;
	}
	return ((high | wordAt(bytes + (length - 8))) & HIGH_BITS) == 0;
}

function isContinuation(byte: uint8): boolean {
	return (byte & 0xC0) == 0x80;
}

export function isUtf8(this typeof Buffer, value: Buffer): boolean {
	const length = value.byteCount();
	if (length <= 0) return true;
	const bytes: Readonly<Ptr<uint8>> = value.bytePointer();
	// The word count is selected, not the call branched around, so short input reaches the byte
	// loop through one taken branch as in C. ASCII runs get their own loop: in one loop clang
	// merged the 1-4 byte steps into an add fed by a register move per byte.
	let i = asciiWords(bytes, length >= 16 ? length >> 3 : 0) << 3;
	while (true) {
		while (i < length && bytes[i] <= 0x7F) i += 1;
		if (i >= length) return true;
		const lead = bytes[i];
		if ((lead & 0xE0) == 0xC0) {
			if (i + 1 >= length || !isContinuation(bytes[i + 1]) || lead < 0xC2) return false;
			i += 2;
		} else if ((lead & 0xF0) == 0xE0) {
			if (i + 2 >= length ||
					!isContinuation(bytes[i + 1]) ||
					!isContinuation(bytes[i + 2])) {
				return false;
			}
			const point = ((lead & 0x0F) as uint32) << 12 |
				((bytes[i + 1] & 0x3F) as uint32) << 6 |
				(bytes[i + 2] & 0x3F) as uint32;
			if (point < 0x800 || (point >= 0xD800 && point <= 0xDFFF)) return false;
			i += 3;
		} else if ((lead & 0xF8) == 0xF0) {
			if (i + 3 >= length ||
					!isContinuation(bytes[i + 1]) ||
					!isContinuation(bytes[i + 2]) ||
					!isContinuation(bytes[i + 3])) {
				return false;
			}
			const point = ((lead & 0x07) as uint32) << 18 |
				((bytes[i + 1] & 0x3F) as uint32) << 12 |
				((bytes[i + 2] & 0x3F) as uint32) << 6 |
				(bytes[i + 3] & 0x3F) as uint32;
			if (point < 0x10000 || point > 0x10FFFF) return false;
			i += 4;
		} else {
			return false;
		}
	}
}

export function byteLength(this typeof Buffer, str: string, encoding: string = "utf-8"): number {
	if (encoding == "ascii" || encoding == "latin1" || encoding == "binary") return str.length;
	if (encoding == "utf16le" || encoding == "ucs2" || encoding == "ucs-2") return str.length * 2;
	const size = str.byteLength;
	if (encoding == "hex") return size / 2;
	if (encoding == "base64" || encoding == "base64url") {
		let unpadded = size;
		if (unpadded > 0 && str.byteAt(unpadded - 1) == "=".code) unpadded -= 1;
		if (unpadded > 1 && str.byteAt(unpadded - 1) == "=".code) unpadded -= 1;
		return (unpadded * 3) / 4;
	}
	return size;
}

export function isBufferEncoding(this typeof Buffer, encoding: string): boolean {
	if (encoding == "utf8" || encoding == "utf-8" ||
			encoding == "hex" || encoding == "ascii" ||
			encoding == "latin1" || encoding == "binary" ||
			encoding == "base64" || encoding == "base64url" ||
			encoding == "utf16le" || encoding == "ucs2" || encoding == "ucs-2") {
		return true;
	}
	return false;
}

export function concatList(this typeof Buffer, buffers: Buffer[]): Buffer {
	let totalLength = 0;
	for (let i = 0; i < buffers.length; i++) totalLength += buffers[i].length;
	const result = bufferAlloc(totalLength);
	let offset: int64 = 0;
	for (let i = 0; i < buffers.length; i++) {
		const length = buffers[i].byteCount();
		buffers[i].copyBytes(result, offset, 0, length);
		offset += length;
	}
	return result;
}

// ===== Extension Methods (only what string doesn't already have) =====

// --- Byte write (string has byteAt for read, but no write) ---

export function set(this buf: Buffer, index: number, value: number): void {
	const at = index as int64;
	if (at >= 0 && at < buf.byteCount()) buf.bytePointer()[at] = (value as int64) as uint8;
}

// --- Hex/Base64 conversion ---

export function toHex(this buf: Buffer): string {
	return encodeHex(buf);
}

export function toBase64(this buf: Buffer): string {
	return encodeBase64(buf);
}

@inline
export function toStringEncoded(
	this buf: Buffer,
	encoding: string,
	start: number,
	end: number,
): string {
	const data: Readonly<Span<uint8>> = buf;
	const length = data.length as int64;
	const first = start as int64;
	const last = end as int64;
	const from = first < 0 ? 0 : first;
	const to = last < 0 || last > length ? length : last;
	if (from >= to) return "";
	return encodeRange(data[from..to], encoding);
}

function encodeRange(range: Readonly<Span<uint8>>, encoding: string): string {
	if (encoding == "utf8" || encoding.equalsIgnoreCase("utf8") || encoding.equalsIgnoreCase("utf-8")) return utf8String(range, false);
	if (isHex(encoding)) return encodeHex(range);
	if (encoding == "base64" || encoding.equalsIgnoreCase("base64")) return encodeBase64(range);
	if (encoding.equalsIgnoreCase("base64url")) return encodeBase64Url(range);
	if (encoding.equalsIgnoreCase("ascii")) return asciiOf(range);
	if (encoding == "latin1" || encoding.equalsIgnoreCase("latin1") || encoding.equalsIgnoreCase("binary")) return latin1Of(range);
	return utf8String(range, false);
}

function latin1Of(range: Readonly<Span<uint8>>): string {
	const length = range.length as int64;
	let high: int64 = 0;
	for (let i: int64 = 0; i < length; i++) high += range[i] >> 7;
	const result = newBytes(length + high);
	const bytes = freshEncodingOutputBytes(result);
	let at: int64 = 0;
	for (let i: int64 = 0; i < length; i++) {
		const byte = range[i];
		if (byte < 0x80) {
			bytes[at] = byte;
			at += 1;
		} else {
			bytes[at] = 0xC0 | (byte >> 6);
			bytes[at + 1] = 0x80 | (byte & 0x3F);
			at += 2;
		}
	}
	if (high == 0) msStringMarkAscii(result); else msStringMarkNonAscii(result);
	return result;
}

function asciiOf(range: Readonly<Span<uint8>>): string {
	const length = range.length as int64;
	const result = newEncodingOutput(length);
	const bytes = freshEncodingOutputBytes(result);
	for (let i: int64 = 0; i < length; i++) bytes[i] = range[i] & 0x7F;
	return result;
}

// --- Cross-buffer copy ---

export function copyTo(
	this buf: Buffer,
	target: Buffer,
	targetStart: number,
	sourceStart: number,
	sourceEnd: number,
): number {
	return buf.copyBytes(
		target,
		targetStart as int64,
		sourceStart as int64,
		sourceEnd as int64,
	) as number;
}

// --- Byte fill ---

export function fill(this buf: Buffer, value: number, start: number, end: number): void {
	const length = buf.byteCount();
	const first = start as int64;
	const last = end as int64;
	const from = first < 0 ? 0 : first;
	const to = last > length ? length : last;
	if (from < to) {
		cMemset(
			buf.bytePointer() + from,
			((value as int64) as uint8) as int32,
			(to - from) as uint64,
		);
	}
}

// --- Single-byte search (by value, not by string needle) ---

// The early miss computes its -1 so clang cannot fold both misses into one float constant: shared,
// arm64 held -1.0 in a callee-saved register across memchr (2-3x slower than C on short buffers),
// and a miss routed through memchr's null instead cost x86 an extra jump per search (1.12-1.16x).
function byteSearchIndex(this buf: Buffer, value: number, byteOffset: number): int64 {
	const offset = byteOffset as int64;
	const start = offset < 0 ? 0 : offset;
	const length = buf.byteCount();
	const bytes = buf.bytePointer();
	if (start >= length) return (length - start - 1) >> 63;
	const found = cMemchr(
		bytes + start,
		((value as int64) as uint8) as int32,
		(length - start) as uint64,
	);
	return found == null ? -1 : (found as Ptr<uint8>) - bytes;
}

export function indexOf(this buf: Buffer, value: number, byteOffset: number): number {
	return buf.byteSearchIndex(value, byteOffset) as number;
}

export function lastIndexOf(this buf: Buffer, value: number, byteOffset: number): number {
	const length = buf.byteCount();
	const offset = byteOffset as int64;
	const needle = (value as int64) as uint8;
	const bytes = buf.bytePointer();
	let at = offset < 0 || offset >= length ? length - 1 : offset;
	while (at >= 0 && bytes[at] != needle) at -= 1;
	return at as number;
}

export function includes(this buf: Buffer, value: number, byteOffset: number): boolean {
	return buf.byteSearchIndex(value, byteOffset) != -1;
}

// --- Buffer-in-buffer search ---

function bufferIndex(this buf: Buffer, needle: Buffer, byteOffset: number): int64 {
	const length = buf.byteCount();
	if (length == 0) return -1;
	const offset = byteOffset as int64;
	const start = offset < 0 ? 0 : offset;
	const needleLength = needle.byteCount();
	if (needleLength == 0) return start;
	if (start >= length || needleLength > length - start) return -1;
	const found = findBytes(
		buf.bytePointer() + start,
		length - start,
		needle.bytePointer(),
		needleLength,
	);
	return found < 0 ? -1 : start + found;
}

export function indexOfBuffer(this buf: Buffer, needle: Buffer, byteOffset: number): number {
	return buf.bufferIndex(needle, byteOffset) as number;
}

export function lastIndexOfBuffer(this buf: Buffer, needle: Buffer, byteOffset: number): number {
	const length = buf.byteCount();
	if (length == 0) return -1;
	const offset = byteOffset as int64;
	const needleLength = needle.byteCount();
	if (needleLength == 0) return (offset < 0 || offset >= length ? length : offset) as number;
	if (needleLength > length) return -1;
	const maxStart = length - needleLength;
	const bytes = buf.bytePointer();
	const pattern = needle.bytePointer();
	let at = offset < 0 || offset > maxStart ? maxStart : offset;
	while (at >= 0 && cMemcmp(bytes + at, pattern, needleLength as uint64) != 0) at -= 1;
	return at as number;
}

export function includesBuffer(this buf: Buffer, needle: Buffer, byteOffset: number): boolean {
	return buf.bufferIndex(needle, byteOffset) != -1;
}

// --- Encoding-aware write ---

export function write(
	this buf: Buffer,
	str: string,
	offset: number,
	length: number,
	encoding: string,
): number {
	const total = buf.byteCount();
	const size = str.byteCount();
	const at = offset as int64;
	if (size == 0 || at < 0 || at >= total) return 0;
	const limit = length as int64;
	const room = limit < 0 || limit > total - at ? total - at : limit;
	if (isHex(encoding)) return writeHex(str.asBytes(), buf.bytePointer(), at, room) as number;
	if (isBase64(encoding)) return writeBase64(str.asBytes(), buf.bytePointer(), at, room) as number;
	const count = size < room ? size : room;
	const to = buf.bytePointer() + at;
	const from = str.textPointer();
	if (encoding.equalsIgnoreCase("ascii")) {
		for (let i: int64 = 0; i < count; i++) to[i] = from[i] & 0x7F;
	} else {
		cMemcpy(to, from, count as uint64);
	}
	return count as number;
}

// --- Fill with pattern ---

function fillDecoded(
	this buf: Buffer,
	from: int64,
	to: int64,
	text: string,
	decoded: Buffer,
): void {
	if (decoded.byteCount() > 0) {
		buf.fillRepeated(from, to, decoded.bytePointer(), decoded.byteCount());
	}
	else buf.fillRepeated(from, to, text.textPointer(), text.byteCount());
}

export function fillString(
	this buf: Buffer,
	value: string,
	start: number,
	end: number,
	encoding: string,
): void {
	if (value.byteCount() == 0) return;
	const length = buf.byteCount();
	const first = start as int64;
	const last = end as int64;
	const from = first < 0 ? 0 : first;
	const to = last > length ? length : last;
	if (from >= to) return;
	// The plain path holds no string temporary: binding the text to a `let` copied a literal to the
	// heap, and a temporary costs a destroy call on every fill.
	if (isHex(encoding)) {
		buf.fillDecoded(from, to, value, decodeText(value, false));
	}
	else if (isBase64(encoding)) {
		buf.fillDecoded(from, to, value, decodeText(value, true));
	}
	else buf.fillRepeated(from, to, value.textPointer(), value.byteCount());
}

// The range converts in the caller, where it inlines and a loop hoists it: converted in the
// out-of-line fill, two float conversions and their reloads cost an empty fill 1.14x of C on x86.
export function fillBuffer(this buf: Buffer, value: Buffer, start: number, end: number): void {
	buf.fillPattern(value, start as int64, end as int64);
}

function fillPattern(this buf: Buffer, value: Buffer, first: int64, last: int64): void {
	const patternLength = value.byteCount();
	if (patternLength == 0) return;
	const length = buf.byteCount();
	const from = first < 0 ? 0 : first;
	const to = last > length ? length : last;
	if (from < to) buf.fillRepeated(from, to, value.bytePointer(), patternLength);
}

// --- Read Unsigned Integers ---

export function readUInt8(this buf: Buffer, offset: number): number {
	return buf.readField(offset, 1, false) as number;
}
export function readUInt16LE(this buf: Buffer, offset: number): number {
	return buf.readField(offset, 2, false) as number;
}
export function readUInt16BE(this buf: Buffer, offset: number): number {
	return buf.readField(offset, 2, true) as number;
}
export function readUInt32LE(this buf: Buffer, offset: number): number {
	return buf.readField(offset, 4, false) as number;
}
export function readUInt32BE(this buf: Buffer, offset: number): number {
	return buf.readField(offset, 4, true) as number;
}

// --- Read Signed Integers ---

export function readInt8(this buf: Buffer, offset: number): number {
	return buf.readSigned(offset, 1, false);
}
export function readInt16LE(this buf: Buffer, offset: number): number {
	return buf.readSigned(offset, 2, false);
}
export function readInt16BE(this buf: Buffer, offset: number): number {
	return buf.readSigned(offset, 2, true);
}
export function readInt32LE(this buf: Buffer, offset: number): number {
	return buf.readSigned(offset, 4, false);
}
export function readInt32BE(this buf: Buffer, offset: number): number {
	return buf.readSigned(offset, 4, true);
}

// --- Read Float/Double ---

export function readFloatLE(this buf: Buffer, offset: number): number {
	return floatFromBits(buf.readField(offset, 4, false) as uint32) as number;
}
export function readFloatBE(this buf: Buffer, offset: number): number {
	return floatFromBits(buf.readField(offset, 4, true) as uint32) as number;
}
export function readDoubleLE(this buf: Buffer, offset: number): number {
	return doubleFromBits(buf.readField(offset, 8, false));
}
export function readDoubleBE(this buf: Buffer, offset: number): number {
	return doubleFromBits(buf.readField(offset, 8, true));
}

// --- Read 64-bit ---

when (!bare && !solana) {
	export function readBigUInt64LE(this buf: Buffer, offset: number): bigint {
		return msBigIntFromUint64(buf.readField(offset, 8, false));
	}
	export function readBigUInt64BE(this buf: Buffer, offset: number): bigint {
		return msBigIntFromUint64(buf.readField(offset, 8, true));
	}
	export function readBigInt64LE(this buf: Buffer, offset: number): bigint {
		return msBigIntFromInt64(bitsToInt64(buf.readField(offset, 8, false)));
	}
	export function readBigInt64BE(this buf: Buffer, offset: number): bigint {
		return msBigIntFromInt64(bitsToInt64(buf.readField(offset, 8, true)));
	}
}

// --- Write Unsigned Integers ---

export function writeUInt8(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 1, false);
}
export function writeUInt16LE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 2, false);
}
export function writeUInt16BE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 2, true);
}
export function writeUInt32LE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 4, false);
}
export function writeUInt32BE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 4, true);
}

// --- Write Signed Integers ---

export function writeInt8(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 1, false);
}
export function writeInt16LE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 2, false);
}
export function writeInt16BE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 2, true);
}
export function writeInt32LE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 4, false);
}
export function writeInt32BE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(value as int64, offset, 4, true);
}

// --- Write Float/Double ---

export function writeFloatLE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(floatBits(value as float32) as int64, offset, 4, false);
}
export function writeFloatBE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(floatBits(value as float32) as int64, offset, 4, true);
}
export function writeDoubleLE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(bitsToInt64(doubleBits(value)), offset, 8, false);
}
export function writeDoubleBE(this buf: Buffer, value: number, offset: number): number {
	return buf.writeField(bitsToInt64(doubleBits(value)), offset, 8, true);
}

// --- Write 64-bit ---

when (!bare && !solana) {
	export function writeBigUInt64LE(this buf: Buffer, value: bigint, offset: number): number {
		return buf.writeField(msBigIntToInt64(BigInt.asUintN(64, value)), offset, 8, false);
	}
	export function writeBigUInt64BE(this buf: Buffer, value: bigint, offset: number): number {
		return buf.writeField(msBigIntToInt64(BigInt.asUintN(64, value)), offset, 8, true);
	}
	export function writeBigInt64LE(this buf: Buffer, value: bigint, offset: number): number {
		return buf.writeField(msBigIntToInt64(BigInt.asIntN(64, value)), offset, 8, false);
	}
	export function writeBigInt64BE(this buf: Buffer, value: bigint, offset: number): number {
		return buf.writeField(msBigIntToInt64(BigInt.asIntN(64, value)), offset, 8, true);
	}
}

// --- Byte Swap / Reverse (in-place mutation) ---


function byteSwap16(value: uint16): uint16 {
	return (value >> 8) | (value << 8);
}

function byteSwap32(value: uint32): uint32 {
	return (value >> 24) | ((value >> 8) & 0xFF00) | ((value << 8) & 0xFF0000) | (value << 24);
}

function byteSwap64(value: uint64): uint64 {
	return ((byteSwap32(value as uint32) as uint64) << 32) |
		(byteSwap32((value >> 32) as uint32) as uint64);
}

function swapWordCount(this buf: Buffer, width: int64): int64 {
	const length = buf.byteCount();
	return length % width == 0 ? length / width : 0;
}

export function swap16(this buf: Buffer): void {
	const count = buf.swapWordCount(2);
	if (count == 0) return;
	const words = buf.bytePointer() as Ptr<uint16>;
	for (let i: int64 = 0; i < count; i++) words[i] = byteSwap16(words[i]);
}

export function swap32(this buf: Buffer): void {
	const count = buf.swapWordCount(4);
	if (count == 0) return;
	const words = buf.bytePointer() as Ptr<uint32>;
	for (let i: int64 = 0; i < count; i++) words[i] = byteSwap32(words[i]);
}

export function swap64(this buf: Buffer): void {
	const count = buf.swapWordCount(8);
	if (count == 0) return;
	const words = buf.bytePointer() as Ptr<uint64>;
	for (let i: int64 = 0; i < count; i++) words[i] = byteSwap64(words[i]);
}

export function bufReverse(this buf: Buffer): void {
	const length = buf.byteCount();
	if (length <= 1) return;
	const bytes = buf.bytePointer();
	let left: int64 = 0;
	let right = length - 1;
	while (left < right) {
		const byte = bytes[left];
		bytes[left] = bytes[right];
		bytes[right] = byte;
		left += 1;
		right -= 1;
	}
}


// --- Variable-Length Integer Read/Write (1-6 bytes) ---

@noinline function badByteLength(byteLength: number): never {
	const rule = Math.floor(byteLength) != byteLength ? "an integer" : ">= 1 and <= 6";
	throw new RangeError(
		`The value of "byteLength" is out of range. It must be ${rule}. Received ${byteLength}`,
	);
}

@inline function widthOrZero(byteLength: number): int64 {
	if (!(byteLength >= 1 && byteLength <= 6)) return 0;
	const width = byteLength as int64;
	return (width as number) == byteLength ? width : 0;
}

function readVariable(
	this buf: Buffer,
	offset: number,
	byteLength: number,
	bigEndian: boolean,
	signed: boolean,
): number {
	const width = widthOrZero(byteLength);
	if (width == 0) badByteLength(byteLength);
	const at = offset as int64;
	if (!buf.fits(at, width)) return 0;
	const value = buf.loadField(at, width, bigEndian);
	return signed ? signExtend(value, width << 3) as number : value as number;
}

function writeVariable(
	this buf: Buffer,
	value: number,
	offset: number,
	byteLength: number,
	bigEndian: boolean,
): number {
	const width = widthOrZero(byteLength);
	if (width == 0) badByteLength(byteLength);
	const at = offset as int64;
	if (buf.byteCount() == 0 || !buf.fits(at, width)) return at as number;
	buf.storeField(at, width, bigEndian, value as int64);
	return (at + width) as number;
}

export function readUIntLE(this buf: Buffer, offset: number, byteLength: number): number {
	return buf.readVariable(offset, byteLength, false, false);
}
export function readUIntBE(this buf: Buffer, offset: number, byteLength: number): number {
	return buf.readVariable(offset, byteLength, true, false);
}
export function readIntLE(this buf: Buffer, offset: number, byteLength: number): number {
	return buf.readVariable(offset, byteLength, false, true);
}
export function readIntBE(this buf: Buffer, offset: number, byteLength: number): number {
	return buf.readVariable(offset, byteLength, true, true);
}
export function writeUIntLE(
	this buf: Buffer,
	value: number,
	offset: number,
	byteLength: number,
): number {
	return buf.writeVariable(value, offset, byteLength, false);
}
export function writeUIntBE(
	this buf: Buffer,
	value: number,
	offset: number,
	byteLength: number,
): number {
	return buf.writeVariable(value, offset, byteLength, true);
}
export function writeIntLE(
	this buf: Buffer,
	value: number,
	offset: number,
	byteLength: number,
): number {
	return buf.writeVariable(value, offset, byteLength, false);
}
export function writeIntBE(
	this buf: Buffer,
	value: number,
	offset: number,
	byteLength: number,
): number {
	return buf.writeVariable(value, offset, byteLength, true);
}

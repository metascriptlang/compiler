@include("runtime/core/buffer.h");
@compile("runtime/core/buffer.c");

// Buffer = string. Same raw bytes, different semantics.
// String methods interpret UTF-8/UTF-16. Buffer methods treat raw bytes.
// Since Buffer IS string, all string methods (equals, byteAt, byteSlice,
// byteLength, indexOf, etc.) work on Buffer directly — no duplication needed.
// Buffer only adds: hex/base64 encoding, endian integer I/O, BMH search,
// byte-level fill/set, swap, validation, and encoding-aware string operations.
export type Buffer = string;

// ===== C Bindings =====

// Allocation (zero-filled / uninitialized)
extern function bufferAlloc(size: number): Buffer from "msBufferAlloc";
extern function bufferAllocUnsafe(size: number): Buffer from "msBufferAllocUnsafe";

export function alloc(this typeof Buffer, size: number): Buffer {
	return bufferAlloc(size);
}

export function allocUnsafe(this typeof Buffer, size: number): Buffer {
	return bufferAllocUnsafe(size);
}

// Encoding
extern function msBufferFromHex(hex: string): Buffer;
extern function msBufferFromBase64(b64: string): Buffer;

when (!bare && !solana) {
	extern function msBigIntFromInt64(v: int64): bigint;
	extern function msBigIntFromUint64(v: uint64): bigint;
	extern function msBigIntToInt64(b: bigint): int64;
}

// Hex and base64 decode in place; the other encodings are written below.
extern function msBufferWriteString(buf: Buffer, str: string, offset: number, length: number, encoding: string): number;

// toString with encoding + range
extern function msBufferToStringRange(buf: Buffer, start: number, end: number, encoding: string): string;

extern function msStringConcat(a: string, b: string): string;
extern function msStringCompareBytes(a: string, b: string): number;
extern function msStringNew(data: cstring, length: int64): string;

@include("string.h");
extern function cMemset(p: Ptr<uint8>, value: int32, size: uint64): Ptr<uint8> from "memset";
extern function cMemcpy(to: Ptr<uint8>, from: Readonly<Ptr<uint8>>, size: uint64): Ptr<uint8> from "memcpy";
extern function cMemmove(to: Ptr<uint8>, from: Ptr<uint8>, size: uint64): Ptr<uint8> from "memmove";
extern function cMemchr(p: Ptr<uint8>, value: int32, size: uint64): Ptr<uint8> | null from "memchr";
extern function cMemcmp(a: Ptr<uint8>, b: Ptr<uint8>, size: uint64): int32 from "memcmp";

// ===== Free Functions (constructors / static-like) =====

// ===== Byte access =====

function bytesOf(buf: Buffer): Ptr<uint8> {
	return (buf as cstring) as Ptr<uint8>;
}

function byteCount(buf: Buffer): int64 {
	return buf.asBytes().length as int64;
}

// Compared as `at <= length - width` so an offset near the int64 limit cannot overflow.
function fits(buf: Buffer, at: int64, width: int64): boolean {
	return at >= 0 && at <= byteCount(buf) - width;
}

function loadField(buf: Buffer, at: int64, width: int64, bigEndian: boolean): uint64 {
	const bytes = bytesOf(buf) + at;
	let value: uint64 = 0;
	for (let i: int64 = 0; i < width; i++) {
		const byte = bigEndian ? bytes[width - 1 - i] : bytes[i];
		value |= (byte as uint64) << ((i << 3) as uint64);
	}
	return value;
}

function storeField(buf: Buffer, at: int64, width: int64, bigEndian: boolean, value: int64): void {
	const bytes = bytesOf(buf) + at;
	for (let i: int64 = 0; i < width; i++) {
		const byte = (value >> (i << 3)) as uint8;
		if (bigEndian) bytes[width - 1 - i] = byte;
		else bytes[i] = byte;
	}
}

function signExtend(value: uint64, bits: int64): int64 {
	const sign = (1 as int64) << (bits - 1);
	return ((value as int64) ^ sign) - sign;
}

function bitsToInt64(value: uint64): int64 {
	return value > 0x7FFFFFFFFFFFFFFF ? -((~value) as int64) - 1 : value as int64;
}

function floatFromBits(bits: uint32): float32 {
	let cell: uint32[1] = [bits];
	return (((cell as Span<uint32>) as Ptr<uint32>) as Ptr<float32>)[0];
}

function floatBits(value: float32): uint32 {
	let cell: float32[1] = [value];
	return (((cell as Span<float32>) as Ptr<float32>) as Ptr<uint32>)[0];
}

function doubleFromBits(bits: uint64): number {
	let cell: uint64[1] = [bits];
	return (((cell as Span<uint64>) as Ptr<uint64>) as Ptr<number>)[0];
}

function doubleBits(value: number): uint64 {
	let cell: number[1] = [value];
	return (((cell as Span<number>) as Ptr<number>) as Ptr<uint64>)[0];
}

function readField(buf: Buffer, offset: number, width: int64, bigEndian: boolean): uint64 {
	const at = offset as int64;
	return fits(buf, at, width) ? loadField(buf, at, width, bigEndian) : 0;
}

function readSigned(buf: Buffer, offset: number, width: int64, bigEndian: boolean): number {
	const at = offset as int64;
	return fits(buf, at, width) ? signExtend(loadField(buf, at, width, bigEndian), width << 3) as number : 0;
}

function writeField(buf: Buffer, value: int64, offset: number, width: int64, bigEndian: boolean): number {
	const at = offset as int64;
	if (!fits(buf, at, width)) return at as number;
	storeField(buf, at, width, bigEndian, value);
	return (at + width) as number;
}

function copyBytes(source: Buffer, target: Buffer, targetStart: int64, sourceStart: int64, sourceEnd: int64): int64 {
	const sourceLength = byteCount(source);
	const from = sourceStart < 0 ? 0 : sourceStart;
	const end = sourceEnd > sourceLength ? sourceLength : sourceEnd;
	const to = targetStart < 0 ? 0 : targetStart;
	if (from >= end) return 0;
	const room = byteCount(target) - to;
	const count = end - from > room ? room : end - from;
	if (count <= 0) return 0;
	cMemmove(bytesOf(target) + to, bytesOf(source) + from, count as uint64);
	return count;
}

// Doubles the filled prefix with each copy.
function fillRepeated(buf: Buffer, from: int64, to: int64, pattern: Ptr<uint8>, patternLength: int64): void {
	const at = bytesOf(buf) + from;
	const total = to - from;
	if (patternLength == 1) {
		cMemset(at, pattern[0] as int32, total as uint64);
		return;
	}
	let written = patternLength < total ? patternLength : total;
	cMemcpy(at, pattern, written as uint64);
	while (written + written <= total) {
		cMemcpy(at + written, at, written as uint64);
		written *= 2;
	}
	if (written < total) cMemcpy(at + written, at, (total - written) as uint64);
}

// One byte through memchr, up to four through a first/last byte filter, longer needles
// through a Horspool skip table. Callers guarantee 0 < needleLength <= hayLength.
function findBytes(hay: Ptr<uint8>, hayLength: int64, needle: Ptr<uint8>, needleLength: int64): int64 {
	if (needleLength == 1) {
		const found = cMemchr(hay, needle[0] as int32, hayLength as uint64);
		return found == null ? -1 : (found as Ptr<uint8>) - hay;
	}
	if (needleLength <= 4) {
		const end = hayLength - needleLength + 1;
		const first = needle[0];
		const last = needle[needleLength - 1];
		let at: int64 = 0;
		while (at < end && !(hay[at] == first && hay[at + needleLength - 1] == last &&
				(needleLength == 2 || cMemcmp(hay + at, needle, needleLength as uint64) == 0))) {
			at += 1;
		}
		return at < end ? at : -1;
	}
	// Holds one past the last position of each byte in needle[0 .. needleLength - 2], 0 when absent,
	// so the zero fill is the table's default and the shift is needleLength minus the entry.
	let seen: int32[256] = [];
	const table = (seen as Span<int32>) as Ptr<int32>;
	for (let i: int64 = 0; i < needleLength - 1; i++) table[needle[i]] = (i + 1) as int32;
	let i = needleLength - 1;
	let found: int64 = -1;
	while (found < 0 && i < hayLength) {
		let j = needleLength - 1;
		let k = i;
		while (j > 0 && hay[k] == needle[j]) {
			k -= 1;
			j -= 1;
		}
		if (j == 0 && hay[k] == needle[0]) found = k;
		else i += needleLength - table[hay[i]] as int64;
	}
	return found;
}

// Case-insensitive prefix match, so "HEX" and "hexadecimal" both select hex.
function encodingIs(encoding: string, name: string): boolean {
	const size = byteCount(name);
	if (byteCount(encoding) < size) return false;
	const given = bytesOf(encoding);
	const expected = bytesOf(name);
	let i: int64 = 0;
	while (i < size && (given[i] >= 0x41 && given[i] <= 0x5A ? given[i] + 32 : given[i]) == expected[i]) i += 1;
	return i == size;
}

// ===== Free Functions (constructors / static-like) =====

function copyOf(value: string): Buffer {
	return msStringNew(value as cstring, byteCount(value));
}

export function fromString(this typeof Buffer, value: string, encoding: string): Buffer {
	if (encoding == "hex") return msBufferFromHex(value);
	if (encoding == "base64") return msBufferFromBase64(value);
	return copyOf(value);
}

export function fromArray(this typeof Buffer, arr: number[]): Buffer {
	const buf = bufferAlloc(arr.length);
	let i = 0;
	while (i < arr.length) {
		buf.set(i, arr[i]);
		i = i + 1;
	}
	return buf;
}

export function copy(this typeof Buffer, value: Buffer): Buffer {
	return copyOf(value);
}

export function compare(this typeof Buffer, a: Buffer, b: Buffer): number {
	return msStringCompareBytes(a, b);
}

export function concat(this typeof Buffer, a: Buffer, b: Buffer): Buffer {
	return msStringConcat(a, b);
}

const HIGH_BITS: uint64 = 0x8080808080808080;

// Keep the scans single-exit: clang 18/21 turn a `return false` inside a byte loop of a
// boolean function into a per-byte select, measured ~1.35x slower than the C kernel.
function asciiWords(bytes: Readonly<Ptr<uint8>>, wordCount: int64): int64 {
	const words = bytes as Readonly<Ptr<uint64>>;
	let word: int64 = 0;
	while (word < wordCount && (words[word] & HIGH_BITS) == 0) word += 1;
	return word;
}

// Through memcpy, which clang folds into one load at any alignment.
function wordAt(bytes: Readonly<Ptr<uint8>>): uint64 {
	let cell: uint64[1] = [0];
	cMemcpy(((cell as Span<uint64>) as Ptr<uint64>) as Ptr<uint8>, bytes, 8);
	return cell[0];
}

// Shaped for the caller it is inlined into under thin LTO, where a reject that left through a
// one-way constant-false block cost a second taken branch per call, measured 1.8-2.2x the C kernel
// on a non-ASCII first byte: short inputs keep the C byte loop, longer ones reject on the first
// byte, then join one result from the words and the overlapping last word.
export function isAscii(this typeof Buffer, value: Buffer): boolean {
	const length = value.asBytes().length as int64;
	if (length == 0) return true;
	const bytes = value.asBytes() as Readonly<Ptr<uint8>>;
	if (length < 8) {
		let at: int64 = 0;
		while (at < length) {
			if (bytes[at] > 0x7F) return false;
			at += 1;
		}
		return true;
	}
	if (bytes[0] > 0x7F) return false;
	const words = bytes as Readonly<Ptr<uint64>>;
	const wordCount = length >> 3;
	let high = words[0] & HIGH_BITS;
	let word: int64 = 1;
	while (high == 0 && word < wordCount) {
		high = words[word] & HIGH_BITS;
		word += 1;
	}
	return ((high | wordAt(bytes + (length - 8))) & HIGH_BITS) == 0;
}

function isContinuation(byte: uint8): boolean {
	return (byte & 0xC0) == 0x80;
}

export function isUtf8(this typeof Buffer, value: Buffer): boolean {
	const length = value.asBytes().length as int64;
	if (length == 0) return true;
	const bytes = value.asBytes() as Readonly<Ptr<uint8>>;
	let i = length >= 8 ? asciiWords(bytes, length >> 3) << 3 : 0;
	while (i < length) {
		const lead = bytes[i];
		if (lead <= 0x7F) {
			i += 1;
		} else if ((lead & 0xE0) == 0xC0) {
			if (i + 1 >= length || !isContinuation(bytes[i + 1]) || lead < 0xC2) return false;
			i += 2;
		} else if ((lead & 0xF0) == 0xE0) {
			if (i + 2 >= length || !isContinuation(bytes[i + 1]) || !isContinuation(bytes[i + 2])) return false;
			const point = ((lead & 0x0F) as uint32) << 12 | ((bytes[i + 1] & 0x3F) as uint32) << 6 | (bytes[i + 2] & 0x3F) as uint32;
			if (point < 0x800 || (point >= 0xD800 && point <= 0xDFFF)) return false;
			i += 3;
		} else if ((lead & 0xF8) == 0xF0) {
			if (i + 3 >= length || !isContinuation(bytes[i + 1]) || !isContinuation(bytes[i + 2]) || !isContinuation(bytes[i + 3])) return false;
			const point = ((lead & 0x07) as uint32) << 18 | ((bytes[i + 1] & 0x3F) as uint32) << 12 |
				((bytes[i + 2] & 0x3F) as uint32) << 6 | (bytes[i + 3] & 0x3F) as uint32;
			if (point < 0x10000 || point > 0x10FFFF) return false;
			i += 4;
		} else {
			return false;
		}
	}
	return true;
}

export function byteLength(this typeof Buffer, str: string, encoding: string = "utf-8"): number {
	if (encoding == "ascii" || encoding == "latin1" || encoding == "binary") return str.length;
	if (encoding == "utf16le" || encoding == "ucs2" || encoding == "ucs-2") return str.length * 2;
	const n = str.byteLength;
	if (encoding == "hex") return n / 2;
	if (encoding == "base64" || encoding == "base64url") {
		let m = n;
		if (m > 0 && str.byteAt(m - 1) == "=".code) m -= 1;
		if (m > 1 && str.byteAt(m - 1) == "=".code) m -= 1;
		return (m * 3) / 4;
	}
	return n;
}

export function isBufferEncoding(this typeof Buffer, encoding: string): boolean {
	if (encoding == "utf8" || encoding == "utf-8" ||
			encoding == "hex" || encoding == "ascii" ||
			encoding == "latin1" || encoding == "binary" ||
			encoding == "base64" || encoding == "base64url" ||
			encoding == "utf16le" || encoding == "ucs2" || encoding == "ucs-2") {
		return true;
	}
	return false;
}

export function concatList(this typeof Buffer, buffers: Buffer[]): Buffer {
	let totalLen = 0;
	let i = 0;
	while (i < buffers.length) {
		totalLen = totalLen + buffers[i].byteLength;
		i = i + 1;
	}
	const result = bufferAlloc(totalLen);
	let offset: int64 = 0;
	i = 0;
	while (i < buffers.length) {
		const blen = byteCount(buffers[i]);
		copyBytes(buffers[i], result, offset, 0, blen);
		offset = offset + blen;
		i = i + 1;
	}
	return result;
}

// ===== Extension Methods (only what string doesn't already have) =====

// --- Byte write (string has byteAt for read, but no write) ---

export function set(this buf: Buffer, index: number, value: number): void {
	const at = index as int64;
	if (at >= 0 && at < byteCount(buf)) bytesOf(buf)[at] = (value as int64) as uint8;
}

// --- Hex/Base64 conversion ---

export extern function toHex(this buf: Buffer): string from "msBufferToHex";

export extern function toBase64(this buf: Buffer): string from "msBufferToBase64";

export function toStringEncoded(this buf: Buffer, encoding: string, start: number, end: number): string {
	return msBufferToStringRange(buf, start, end, encoding);
}

// --- Cross-buffer copy ---

export function copyTo(this buf: Buffer, target: Buffer, targetStart: number, sourceStart: number, sourceEnd: number): number {
	return copyBytes(buf, target, targetStart as int64, sourceStart as int64, sourceEnd as int64) as number;
}

// --- Byte fill ---

export function fill(this buf: Buffer, value: number, start: number, end: number): void {
	const length = byteCount(buf);
	const first = start as int64;
	const last = end as int64;
	const from = first < 0 ? 0 : first;
	const to = last > length ? length : last;
	if (from < to) cMemset(bytesOf(buf) + from, ((value as int64) as uint8) as int32, (to - from) as uint64);
}

// --- Single-byte search (by value, not by string needle) ---

// A miss returns through memchr's null, never an early `return -1`: sharing that constant with the
// one after the call, clang held -1.0 in a callee-saved float register across memchr, measured
// 2-3x slower than C on short buffers.
function byteSearchIndex(buf: Buffer, value: number, byteOffset: number): int64 {
	const offset = byteOffset as int64;
	const start = offset < 0 ? 0 : offset;
	const length = byteCount(buf);
	const bytes = bytesOf(buf);
	const found = start < length ? cMemchr(bytes + start, ((value as int64) as uint8) as int32, (length - start) as uint64) : null;
	return found == null ? -1 : (found as Ptr<uint8>) - bytes;
}

export function indexOf(this buf: Buffer, value: number, byteOffset: number): number {
	return byteSearchIndex(buf, value, byteOffset) as number;
}

export function lastIndexOf(this buf: Buffer, value: number, byteOffset: number): number {
	const length = byteCount(buf);
	const offset = byteOffset as int64;
	const needle = (value as int64) as uint8;
	const bytes = bytesOf(buf);
	let at = offset < 0 || offset >= length ? length - 1 : offset;
	while (at >= 0 && bytes[at] != needle) at -= 1;
	return at as number;
}

export function includes(this buf: Buffer, value: number, byteOffset: number): boolean {
	return byteSearchIndex(buf, value, byteOffset) != -1;
}

// --- Buffer-in-buffer search ---

function bufferIndex(buf: Buffer, needle: Buffer, byteOffset: number): int64 {
	const length = byteCount(buf);
	if (length == 0) return -1;
	const offset = byteOffset as int64;
	const start = offset < 0 ? 0 : offset;
	const needleLength = byteCount(needle);
	if (needleLength == 0) return start;
	if (start >= length || needleLength > length - start) return -1;
	const found = findBytes(bytesOf(buf) + start, length - start, bytesOf(needle), needleLength);
	return found < 0 ? -1 : start + found;
}

export function indexOfBuffer(this buf: Buffer, needle: Buffer, byteOffset: number): number {
	return bufferIndex(buf, needle, byteOffset) as number;
}

export function lastIndexOfBuffer(this buf: Buffer, needle: Buffer, byteOffset: number): number {
	const length = byteCount(buf);
	if (length == 0) return -1;
	const offset = byteOffset as int64;
	const needleLength = byteCount(needle);
	if (needleLength == 0) return (offset < 0 || offset >= length ? length : offset) as number;
	if (needleLength > length) return -1;
	const maxStart = length - needleLength;
	const bytes = bytesOf(buf);
	const pattern = bytesOf(needle);
	let at = offset < 0 || offset > maxStart ? maxStart : offset;
	while (at >= 0 && cMemcmp(bytes + at, pattern, needleLength as uint64) != 0) at -= 1;
	return at as number;
}

export function includesBuffer(this buf: Buffer, needle: Buffer, byteOffset: number): boolean {
	return bufferIndex(buf, needle, byteOffset) != -1;
}

// --- Encoding-aware write ---

export function write(this buf: Buffer, str: string, offset: number, length: number, encoding: string): number {
	if (encodingIs(encoding, "hex") || encodingIs(encoding, "base64")) return msBufferWriteString(buf, str, offset, length, encoding);
	const total = byteCount(buf);
	const size = byteCount(str);
	const at = offset as int64;
	const limit = length as int64;
	if (size == 0 || at < 0 || at >= total) return 0;
	const room = limit < 0 || limit > total - at ? total - at : limit;
	const count = size < room ? size : room;
	const to = bytesOf(buf) + at;
	const from = bytesOf(str);
	if (encodingIs(encoding, "ascii")) {
		for (let i: int64 = 0; i < count; i++) to[i] = from[i] & 0x7F;
	} else {
		cMemcpy(to, from, count as uint64);
	}
	return count as number;
}

// --- Fill with pattern ---

// An empty decode falls back to the raw text.
function fillDecoded(buf: Buffer, from: int64, to: int64, text: string, decoded: Buffer): void {
	if (byteCount(decoded) > 0) fillRepeated(buf, from, to, bytesOf(decoded), byteCount(decoded));
	else fillRepeated(buf, from, to, bytesOf(text), byteCount(text));
}

export function fillString(this buf: Buffer, value: string, start: number, end: number, encoding: string): void {
	if (byteCount(value) == 0) return;
	const length = byteCount(buf);
	const first = start as int64;
	const last = end as int64;
	const from = first < 0 ? 0 : first;
	const to = last > length ? length : last;
	if (from >= to) return;
	// The plain path holds no string temporary: binding the text to a `let` copied a literal to the
	// heap, and a temporary costs a destroy call on every fill.
	if (encodingIs(encoding, "hex")) fillDecoded(buf, from, to, value, msBufferFromHex(value));
	else if (encodingIs(encoding, "base64")) fillDecoded(buf, from, to, value, msBufferFromBase64(value));
	else fillRepeated(buf, from, to, bytesOf(value), byteCount(value));
}

export function fillBuffer(this buf: Buffer, value: Buffer, start: number, end: number): void {
	const patternLength = byteCount(value);
	if (patternLength == 0) return;
	const length = byteCount(buf);
	const first = start as int64;
	const last = end as int64;
	const from = first < 0 ? 0 : first;
	const to = last > length ? length : last;
	if (from < to) fillRepeated(buf, from, to, bytesOf(value), patternLength);
}

// --- Read Unsigned Integers ---

export function readUInt8(this buf: Buffer, offset: number): number { return readField(buf, offset, 1, false) as number; }
export function readUInt16LE(this buf: Buffer, offset: number): number { return readField(buf, offset, 2, false) as number; }
export function readUInt16BE(this buf: Buffer, offset: number): number { return readField(buf, offset, 2, true) as number; }
export function readUInt32LE(this buf: Buffer, offset: number): number { return readField(buf, offset, 4, false) as number; }
export function readUInt32BE(this buf: Buffer, offset: number): number { return readField(buf, offset, 4, true) as number; }

// --- Read Signed Integers ---

export function readInt8(this buf: Buffer, offset: number): number { return readSigned(buf, offset, 1, false); }
export function readInt16LE(this buf: Buffer, offset: number): number { return readSigned(buf, offset, 2, false); }
export function readInt16BE(this buf: Buffer, offset: number): number { return readSigned(buf, offset, 2, true); }
export function readInt32LE(this buf: Buffer, offset: number): number { return readSigned(buf, offset, 4, false); }
export function readInt32BE(this buf: Buffer, offset: number): number { return readSigned(buf, offset, 4, true); }

// --- Read Float/Double ---

export function readFloatLE(this buf: Buffer, offset: number): number { return floatFromBits(readField(buf, offset, 4, false) as uint32) as number; }
export function readFloatBE(this buf: Buffer, offset: number): number { return floatFromBits(readField(buf, offset, 4, true) as uint32) as number; }
export function readDoubleLE(this buf: Buffer, offset: number): number { return doubleFromBits(readField(buf, offset, 8, false)); }
export function readDoubleBE(this buf: Buffer, offset: number): number { return doubleFromBits(readField(buf, offset, 8, true)); }

// --- Read 64-bit ---

when (!bare && !solana) {
	export function readBigUInt64LE(this buf: Buffer, offset: number): bigint { return msBigIntFromUint64(readField(buf, offset, 8, false)); }
	export function readBigUInt64BE(this buf: Buffer, offset: number): bigint { return msBigIntFromUint64(readField(buf, offset, 8, true)); }
	export function readBigInt64LE(this buf: Buffer, offset: number): bigint { return msBigIntFromInt64(bitsToInt64(readField(buf, offset, 8, false))); }
	export function readBigInt64BE(this buf: Buffer, offset: number): bigint { return msBigIntFromInt64(bitsToInt64(readField(buf, offset, 8, true))); }
}

// --- Write Unsigned Integers ---

export function writeUInt8(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 1, false); }
export function writeUInt16LE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 2, false); }
export function writeUInt16BE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 2, true); }
export function writeUInt32LE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 4, false); }
export function writeUInt32BE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 4, true); }

// --- Write Signed Integers ---

export function writeInt8(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 1, false); }
export function writeInt16LE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 2, false); }
export function writeInt16BE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 2, true); }
export function writeInt32LE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 4, false); }
export function writeInt32BE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, value as int64, offset, 4, true); }

// --- Write Float/Double ---

export function writeFloatLE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, floatBits(value as float32) as int64, offset, 4, false); }
export function writeFloatBE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, floatBits(value as float32) as int64, offset, 4, true); }
export function writeDoubleLE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, bitsToInt64(doubleBits(value)), offset, 8, false); }
export function writeDoubleBE(this buf: Buffer, value: number, offset: number): number { return writeField(buf, bitsToInt64(doubleBits(value)), offset, 8, true); }

// --- Write 64-bit ---

when (!bare && !solana) {
	export function writeBigUInt64LE(this buf: Buffer, value: bigint, offset: number): number { return writeField(buf, msBigIntToInt64(BigInt.asUintN(64, value)), offset, 8, false); }
	export function writeBigUInt64BE(this buf: Buffer, value: bigint, offset: number): number { return writeField(buf, msBigIntToInt64(BigInt.asUintN(64, value)), offset, 8, true); }
	export function writeBigInt64LE(this buf: Buffer, value: bigint, offset: number): number { return writeField(buf, msBigIntToInt64(BigInt.asIntN(64, value)), offset, 8, false); }
	export function writeBigInt64BE(this buf: Buffer, value: bigint, offset: number): number { return writeField(buf, msBigIntToInt64(BigInt.asIntN(64, value)), offset, 8, true); }
}

// --- Byte Swap / Reverse (in-place mutation) ---


function byteSwap16(value: uint16): uint16 {
	return (value >> 8) | (value << 8);
}

function byteSwap32(value: uint32): uint32 {
	return (value >> 24) | ((value >> 8) & 0xFF00) | ((value << 8) & 0xFF0000) | (value << 24);
}

function byteSwap64(value: uint64): uint64 {
	return ((byteSwap32(value as uint32) as uint64) << 32) | (byteSwap32((value >> 32) as uint32) as uint64);
}

function wordCount(buf: Buffer, width: int64): int64 {
	const length = buf.asBytes().length as int64;
	return length % width == 0 ? length / width : 0;
}

export function swap16(this buf: Buffer): void {
	const count = wordCount(buf, 2);
	if (count == 0) return;
	const words = bytesOf(buf) as Ptr<uint16>;
	for (let i: int64 = 0; i < count; i++) words[i] = byteSwap16(words[i]);
}

export function swap32(this buf: Buffer): void {
	const count = wordCount(buf, 4);
	if (count == 0) return;
	const words = bytesOf(buf) as Ptr<uint32>;
	for (let i: int64 = 0; i < count; i++) words[i] = byteSwap32(words[i]);
}

export function swap64(this buf: Buffer): void {
	const count = wordCount(buf, 8);
	if (count == 0) return;
	const words = bytesOf(buf) as Ptr<uint64>;
	for (let i: int64 = 0; i < count; i++) words[i] = byteSwap64(words[i]);
}

export function bufReverse(this buf: Buffer): void {
	const length = buf.asBytes().length as int64;
	if (length <= 1) return;
	const bytes = bytesOf(buf);
	let left: int64 = 0;
	let right = length - 1;
	while (left < right) {
		const byte = bytes[left];
		bytes[left] = bytes[right];
		bytes[right] = byte;
		left += 1;
		right -= 1;
	}
}


// --- Variable-Length Integer Read/Write (1-6 bytes) ---

function readVariable(buf: Buffer, offset: number, byteLength: number, bigEndian: boolean, signed: boolean): number {
	const at = offset as int64;
	const width = byteLength as int64;
	if (width <= 0 || width > 6 || !fits(buf, at, width)) return 0;
	const value = loadField(buf, at, width, bigEndian);
	return signed ? signExtend(value, width << 3) as number : value as number;
}

// On a non-empty buffer a negative width writes nothing and still moves the returned offset back by it.
function writeVariable(buf: Buffer, value: number, offset: number, byteLength: number, bigEndian: boolean): number {
	const at = offset as int64;
	const width = byteLength as int64;
	if (width == 0 || width > 6 || byteCount(buf) == 0 || !fits(buf, at, width)) return at as number;
	storeField(buf, at, width, bigEndian, value as int64);
	return (at + width) as number;
}

export function readUIntLE(this buf: Buffer, offset: number, byteLength: number): number { return readVariable(buf, offset, byteLength, false, false); }
export function readUIntBE(this buf: Buffer, offset: number, byteLength: number): number { return readVariable(buf, offset, byteLength, true, false); }
export function readIntLE(this buf: Buffer, offset: number, byteLength: number): number { return readVariable(buf, offset, byteLength, false, true); }
export function readIntBE(this buf: Buffer, offset: number, byteLength: number): number { return readVariable(buf, offset, byteLength, true, true); }
export function writeUIntLE(this buf: Buffer, value: number, offset: number, byteLength: number): number { return writeVariable(buf, value, offset, byteLength, false); }
export function writeUIntBE(this buf: Buffer, value: number, offset: number, byteLength: number): number { return writeVariable(buf, value, offset, byteLength, true); }
export function writeIntLE(this buf: Buffer, value: number, offset: number, byteLength: number): number { return writeVariable(buf, value, offset, byteLength, false); }
export function writeIntBE(this buf: Buffer, value: number, offset: number, byteLength: number): number { return writeVariable(buf, value, offset, byteLength, true); }

export extern function Number(v: string): float64 from "Number(#)";
export extern function Number(v: boolean): float64 from "Number(#)";
export extern function Number(v: float64): float64 from "Number(#)";
export extern function Number(v: int8): float64 from "Number(#)";
export extern function Number(v: int16): float64 from "Number(#)";
export extern function Number(v: int32): float64 from "Number(#)";
export extern function Number(v: int64): float64 from "Number(#)";
export extern function Number(v: uint8): float64 from "Number(#)";
export extern function Number(v: uint16): float64 from "Number(#)";
export extern function Number(v: uint32): float64 from "Number(#)";
export extern function Number(v: uint64): float64 from "Number(#)";

export extern function isNaN(this typeof Number, x: float64): boolean from "Number.isNaN(#)";
export extern function isFinite(this typeof Number, x: float64): boolean from "Number.isFinite(#)";
export extern function isInteger(this typeof Number, x: float64): boolean from "Number.isInteger(#)";
export extern function isSafeInteger(this typeof Number, x: float64): boolean from "Number.isSafeInteger(#)";

// Statics-only attachment onto the callable Number symbol: reads resolve
// through findStaticField and emit as native member accesses on js / C
export class Number {
	static readonly MAX_SAFE_INTEGER: float64 = 9007199254740991;
	static readonly MIN_SAFE_INTEGER: float64 = -9007199254740991;
	static readonly MAX_VALUE: float64 = 1.7976931348623157e308;
	static readonly MIN_VALUE: float64 = 5e-324;
	static readonly EPSILON: float64 = 2.220446049250313e-16;
	static readonly POSITIVE_INFINITY: float64 = 1e308 * 10.0;
	static readonly NEGATIVE_INFINITY: float64 = -1e308 * 10.0;
	static readonly NaN: float64 = 1e308 * 10.0 - 1e308 * 10.0;
}

@passC("-I.");
// Platform-specific @compile (dispatch, pool, selectors) moved to src/compiler/compile.ms
// — the compiler knows osTarget and picks only the right files.
@compile("runtime/promise/combinator.c");
// Engine compiled via std/net/index.cms (only when network I/O is used)

export class Promise<T> {
	finished: boolean;
	failed: boolean;

	// Instance methods
	@builtin("PromiseThen")
	extern then(callback: (value: T) => void): Promise<void> from "msFutureThen";

	@builtin("PromiseCatch")
	extern catch(callback: (error: string) => void): Promise<void> from "msFutureCatch";

	@builtin("PromiseFinally")
	extern finally(callback: () => void): Promise<void> from "msFutureFinally";

	// Static combinators
	@builtin("PromiseAll")
	static extern all<T>(promises: Promise<T>[]): Promise<T[]> from "msPromiseAll";
	@builtin("PromiseRace")
	static extern race<T>(promises: Promise<T>[]): Promise<T> from "msPromiseRace";
	@builtin("PromiseAllSettled")
	static extern allSettled<T>(promises: Promise<T>[]): Promise<T[]> from "msPromiseAllSettled";
	@builtin("PromiseAny")
	static extern any<T>(promises: Promise<T>[]): Promise<T> from "msPromiseAny";

	// Static constructors
	@builtin("PromiseResolve")
	static extern resolve(value: T): Promise<T> from "msPromiseResolve";
	@builtin("PromiseReject")
	static extern reject(error: string): Promise<void> from "msPromiseReject";
}

// Standalone async utilities
@builtin("PromiseSpawn")
export extern function spawn<T>(fn: () => T): Promise<T> from "msSpawn";

@builtin("WaitFor")
export extern function waitFor<T>(fut: Promise<T>): T from "msWaitFor";

export extern function sleepAsync(ms: number): Promise<void> from "msSleepAsync";

// Async stepper start — createCb pattern (used by asyncBridge, not user code)
extern function msAsyncStart(retFut: Promise<void>, stepper: () => void): void;

// asyncCheck — fire-and-forget for async calls (reference asyncCheck parity).
// Starts the async function and raises on error. Does NOT block.
// Use instead of discarding the return value of an async call.
export function asyncCheck(fut: Promise<void>): void {
	// Future is already started (stepper runs via msAsyncCb).
	// Just register an error callback so failures don't go silent.
	// TODO: add error re-raise callback (raise fut.error on failure)
}

// ===== Locker<T> — Thread-safe shared mutable state (Malebolgia pattern) =====
// Wraps a value + ticket lock. Access via lock/unlock or withLock callback.

@include("runtime/promise/locker.h");

extern function msLockerCreate(dataSize: int32): Locker from "msLockerCreate";
extern function msLockerLock(loc: Locker): void from "msLockerLock";
extern function msLockerUnlock(loc: Locker): void from "msLockerUnlock";
extern function msLockerGetDouble(loc: Locker): number from "msLockerGetDouble";
extern function msLockerSetDouble(loc: Locker, val: number): void from "msLockerSetDouble";
extern function msLockerDestroy(loc: Locker): void from "msLockerDestroy";

export interface Locker {
	_ptr: number; // opaque pointer (msLocker*)
}

export function createLocker(): Locker {
	return msLockerCreate(8) as unknown as Locker;
}

export function lockAcquire(loc: Locker): void {
	msLockerLock(loc);
}

export function lockRelease(loc: Locker): void {
	msLockerUnlock(loc);
}

// Typed data access (caller must hold lock)
export function lockerGet(loc: Locker): number {
	return msLockerGetDouble(loc);
}

export function lockerSet(loc: Locker, val: number): void {
	msLockerSetDouble(loc, val);
}

// Malebolgia-aligned: acquire lock, run callback, release (guaranteed via defer)
export function withLock(loc: Locker, fn: () => void): void {
	msLockerLock(loc);
	defer msLockerUnlock(loc);
	fn();
}

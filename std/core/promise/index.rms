// std/core/promise — Raiser tier. `spawn`, `sleepAsync`, `Promise.resolve`,
// `Promise.all`, `race` and `any` compile by their @builtin kind to VM opcodes (src/codegen/raiser/expressions.ms);
// any other extern here reaches CallHost and needs a bridge in
// src/compiler/meta/hostTable.ms.

import { Map } from "../struct";

@builtin("Promise")
export class Promise<T> {

	@builtin("PromiseThen")
	extern then(callback: (value: T) => void): Promise<void> from "msFutureThen";
	@builtin("PromiseThen")
	extern then(callback: (value: T) => void, onRejected: (error: Error) => void): Promise<void> from "msFutureThen";
	@builtin("PromiseCatch")
	extern catch(callback: (error: Error) => void): Promise<void> from "msFutureCatch";
	@builtin("PromiseFinally")
	extern finally(callback: () => void): Promise<void> from "msFutureFinally";

	@builtin("PromiseAll")
	static extern all<T>(promises: Promise<T>[]): Promise<T[]> from "msPromiseAll";
	@builtin("PromiseRace")
	static extern race<T>(promises: Promise<T>[]): Promise<T> from "msPromiseRace";
	@builtin("PromiseAllSettled")
	static extern allSettled<T>(promises: Promise<T>[]): Promise<T[]> from "msPromiseAllSettled";
	static any<T>(promises: Promise<T>[]): Promise<T> {
		return msPromiseAny(promises, new Error("All promises were rejected"));
	}

	@builtin("PromiseResolve")
	static extern resolve(value: T): Promise<T> from "msPromiseResolve";
	@builtin("PromiseReject")
	static extern reject(error: Error): Promise<never> from "msPromiseReject";
}

@builtin("PromiseAny")
extern function msPromiseAny<T>(promises: Promise<T>[], rejection: Error): Promise<T> from "msPromiseAny";
@builtin("PromisePending")
extern function msPromisePending<T>(): Promise<T> from "msFutureCreate";
@builtin("PromiseSettle")
extern function msPromiseSettle<T>(promise: Promise<T>, value: T): void from "msFutureCompleteT";
@builtin("PromiseFail")
extern function msPromiseFail<T>(promise: Promise<T>, reason: Error): void from "msFutureFail";

@compilerFunc
@builtin("PromisePending")
export extern function msActorReplyNew<T>(): Promise<T> from "msActorReplyNew";
@compilerFunc
@builtin("PromiseSettle")
export extern function msActorReplySettle<T>(promise: Promise<T>, value: T): void from "msActorReplySettle";

@compilerFunc
export function promiseFromExecutor<T>(executor: (resolve: (value: T) => void, reject: (reason: string | Error) => void) => void): Promise<T> {
	const promise = msPromisePending<T>();
	try {
		executor((value: T): void => { msPromiseSettle(promise, value); }, (reason: string | Error): void => {
			const error = raisedError(reason);
			msPromiseFail(promise, error);
		});
	} catch (e) {
		msPromiseFail(promise, e);
	}
	return promise;
}

function raisedError(reason: string | Error): Error {
	if (typeof reason === "string") return new Error(reason);
	return reason;
}

@compilerFunc
export function promiseOfValue<T>(value: T): Promise<T> {
	const promise = msPromisePending<T>();
	msPromiseSettle(promise, value);
	return promise;
}

@compilerFunc
export function promiseFromThenable<S, T>(thenable: S, callThen: (thenable: S, resolve: (value: T) => void, reject: (reason: Error) => void) => void): Promise<T> {
	const promise = msPromisePending<T>();
	try {
		callThen(thenable, (value: T): void => { msPromiseSettle(promise, value); }, (reason: Error): void => { msPromiseFail(promise, reason); });
	} catch (e) {
		msPromiseFail(promise, e);
	}
	return promise;
}

@builtin("PromiseSpawn")
export extern function spawn<T>(fn: () => T): Promise<T> from "msSpawn";

@builtin("SleepAsync")
export extern function sleepAsync(ms: number): Promise<void> from "msSleepAsync";

export function asyncCheck(fut: Promise<void>): void {
}

extern function msLockedAcquire<T>(cell: Locked<T>): void from "msLockedAcquire";
extern function msLockedRelease<T>(cell: Locked<T>): void from "msLockedRelease";
extern function msLockedHeldHere<T>(cell: Locked<T>): boolean from "msLockedHeldHere";
@builtin("LockedLoad")
extern function msLockedLoad<T>(cell: Locked<T>): T;
@builtin("LockedStore")
extern function msLockedStore<T>(cell: Locked<T>, value: T): void;

export function lockedUpdate<T>(cell: Locked<T>, fn: (value: T) => T): void {
	if (msLockedHeldHere(cell)) throw new Error("lockedUpdate re-entered a Locked cell that this thread already holds");
	msLockedAcquire(cell);
	defer msLockedRelease(cell);
	msLockedStore(cell, fn(msLockedLoad(cell)));
}

export function lockedRead<T, R>(cell: Locked<T>, fn: (value: T) => R): R {
	if (msLockedHeldHere(cell)) throw new Error("lockedRead re-entered a Locked cell that this thread already holds");
	msLockedAcquire(cell);
	defer msLockedRelease(cell);
	return fn(msLockedLoad(cell));
}

export enum ExitReason {
	Normal,
	Shutdown,
	Killed,
	Abnormal,
}

interface ActorJob {
	run: (() => void) | null;
	runAsync: (() => Promise<void>) | null;
	reply: Promise<void> | null;
}

class ActorCell {
	live: boolean = true;
	busy: boolean = false;
	head: int32 = 0;
	jobs: ActorJob[] = [];
	terminate: ((reason: ExitReason) => void) | null = null;
}

const actorCells: Map<int64, ActorCell> = new Map<int64, ActorCell>();
let actorNext: int64 = 1;

@compilerFunc
export function msActorOpen(): int64 {
	const pid = actorNext;
	actorNext = actorNext + 1;
	actorCells.set(pid, new ActorCell());
	return pid;
}

@compilerFunc
export function msActorOnTerminate(pid: int64, hook: (reason: ExitReason) => void): void {
	const cell = actorCells.get(pid);
	if (cell != null) cell.terminate = hook;
}

function actorRefuse(job: ActorJob): void {
	const reply = job.reply;
	if (reply != null) msPromiseFail(reply, new Error("noproc"));
}

function actorKick(cell: ActorCell): void {
	Promise.resolve(0).then((turn: int32): void => { actorPump(cell); });
}

async function actorPump(cell: ActorCell): Promise<void> {
	while (cell.head < cell.jobs.length) {
		const job = cell.jobs[cell.head];
		cell.head = cell.head + 1;
		if (!cell.live) {
			actorRefuse(job);
			continue;
		}
		try {
			const sync = job.run;
			const suspending = job.runAsync;
			if (suspending != null) await suspending();
			else if (sync != null) sync();
		} catch (e) {
			const reply = job.reply;
			if (reply == null) {
				actorKick(cell);
				throw e;
			}
			msPromiseFail(reply, e);
		}
	}
	cell.jobs = [];
	cell.head = 0;
	cell.busy = false;
}

function actorEnqueue(pid: int64, job: ActorJob): void {
	const cell = actorCells.get(pid);
	if (cell == null || !cell.live) {
		actorRefuse(job);
		return;
	}
	cell.jobs.push(job);
	if (!cell.busy) {
		cell.busy = true;
		actorKick(cell);
	}
}

@compilerFunc
export function msActorPost(pid: int64, job: () => void): void {
	actorEnqueue(pid, { run: job, runAsync: null, reply: null });
}

@compilerFunc
export function msActorPostAsync(pid: int64, job: () => Promise<void>): void {
	actorEnqueue(pid, { run: null, runAsync: job, reply: null });
}

@compilerFunc
export function msActorPostCall(pid: int64, job: () => void, reply: Promise<void>): void {
	actorEnqueue(pid, { run: job, runAsync: null, reply: reply });
}

@compilerFunc
export function msActorPostCallAsync(pid: int64, job: () => Promise<void>, reply: Promise<void>): void {
	actorEnqueue(pid, { run: null, runAsync: job, reply: reply });
}

export function msActorStop(pid: int64, reason: ExitReason): void {
	const cell = actorCells.get(pid);
	if (cell == null || !cell.live) return;
	cell.live = false;
	actorCells.delete(pid);
	const hook = cell.terminate;
	if (hook != null && reason != ExitReason.Killed) hook(reason);
}

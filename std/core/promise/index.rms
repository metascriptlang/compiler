// std/core/promise — Raiser tier. `spawn`, `sleepAsync` and `Promise.resolve`
// compile by their @builtin kind to VM opcodes (src/codegen/raiser/expressions.ms);
// any other extern here reaches CallHost and needs a bridge in
// src/compiler/meta/hostTable.ms.

export class Promise<T> {
	finished: boolean;
	failed: boolean;

	@builtin("PromiseThen")
	extern then(callback: (value: T) => void): Promise<void> from "msFutureThen";
	@builtin("PromiseCatch")
	extern catch(callback: (error: string) => void): Promise<void> from "msFutureCatch";
	@builtin("PromiseFinally")
	extern finally(callback: () => void): Promise<void> from "msFutureFinally";

	@builtin("PromiseAll")
	static extern all<T>(promises: Promise<T>[]): Promise<T[]> from "msPromiseAll";
	@builtin("PromiseRace")
	static extern race<T>(promises: Promise<T>[]): Promise<T> from "msPromiseRace";
	@builtin("PromiseAllSettled")
	static extern allSettled<T>(promises: Promise<T>[]): Promise<T[]> from "msPromiseAllSettled";
	@builtin("PromiseAny")
	static extern any<T>(promises: Promise<T>[]): Promise<T> from "msPromiseAny";

	@builtin("PromiseResolve")
	static extern resolve(value: T): Promise<T> from "msPromiseResolve";
	@builtin("PromiseReject")
	static extern reject(error: Error): Promise<never> from "msPromiseReject";
}

@builtin("PromisePending")
extern function msPromisePending<T>(): Promise<T> from "msFutureCreate";
@builtin("PromiseSettle")
extern function msPromiseSettle<T>(promise: Promise<T>, value: T): void from "msFutureCompleteT";
@builtin("PromiseFail")
extern function msPromiseFail<T>(promise: Promise<T>, reason: Error): void from "msFutureFail";

export function promiseFromExecutor<T>(executor: (resolve: (value: T) => void, reject: (reason: Error) => void) => void): Promise<T> {
	const promise = msPromisePending<T>();
	try {
		executor((value: T): void => { msPromiseSettle(promise, value); }, (reason: Error): void => { msPromiseFail(promise, reason); });
	} catch (e) {
		msPromiseFail(promise, e);
	}
	return promise;
}

@builtin("PromiseSpawn")
export extern function spawn<T>(fn: () => T): Promise<T> from "msSpawn";

@builtin("SleepAsync")
export extern function sleepAsync(ms: number): Promise<void> from "msSleepAsync";

export function asyncCheck(fut: Promise<void>): void {
}

extern function msLockedAcquire<T>(cell: Locked<T>): void from "msLockedAcquire";
extern function msLockedRelease<T>(cell: Locked<T>): void from "msLockedRelease";
@builtin("LockedLoad")
extern function msLockedLoad<T>(cell: Locked<T>): T;
@builtin("LockedStore")
extern function msLockedStore<T>(cell: Locked<T>, value: T): void;

export function lockedUpdate<T>(cell: Locked<T>, fn: (value: T) => T): void {
	msLockedAcquire(cell);
	defer msLockedRelease(cell);
	msLockedStore(cell, fn(msLockedLoad(cell)));
}

export function lockedRead<T, R>(cell: Locked<T>, fn: (value: T) => R): R {
	msLockedAcquire(cell);
	defer msLockedRelease(cell);
	return fn(msLockedLoad(cell));
}

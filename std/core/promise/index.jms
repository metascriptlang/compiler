// MetaScript Promise Prelude — JavaScript Backend
//
// Binds the `Promise` VALUE to the native JS global (reference parity: Nim's
// importjs). The checker's builtin Promise<T> TYPE already covers async/await
// typing on js; this twin only supplies the static-combinator surface so
// `Promise.all([...])` reaches the native global untouched. `extern class`
// suppresses codegen; MS name === JS name binds without a `from` clause
// (same convention as `console` in core/system/index.jms).

@builtin("Promise")
export extern class Promise<T> {
	@builtin("PromiseAll")
	static extern all<T>(promises: Promise<T>[]): Promise<T[]>;
	@builtin("PromiseRace")
	static extern race<T>(promises: Promise<T>[]): Promise<T>;
	@builtin("PromiseAllSettled")
	static extern allSettled<T>(promises: Promise<T>[]): Promise<T[]>;
	@builtin("PromiseAny")
	static extern any<T>(promises: Promise<T>[]): Promise<T>;
	static extern resolve(value: T): Promise<T>;
	static extern reject(error: Error): Promise<never>;

	extern then(callback: (value: T) => void): Promise<void>;
	extern then<U>(callback: (value: T) => Promise<U>): Promise<U>;
	extern then<U>(callback: (value: T) => U): Promise<U>;
	extern then(callback: (value: T) => void, onRejected: (error: Error) => void): Promise<void>;
	extern then<U>(callback: (value: T) => U, onRejected: (error: Error) => U): Promise<U>;
	extern catch(callback: (error: Error) => void): Promise<void>;
	extern catch(callback: (error: Error) => T): Promise<T>;
	extern finally(callback: () => void): Promise<T>;
}

// spawn on js is SCHEDULING, not parallelism — the documented Node-semantics
// degeneration of the PARALOCK worker-pool spawn (tier 1). The closure body
// runs on the event loop as the next microtask; async bodies compose through
// native promise flattening, sync bodies evaluate inside `.then` and resolve
// immediately. Parallelism stays a C-backend concern (tier 2 worker_threads
// is deliberately NOT built until a real workload demands it).
extern function msNewPromise<T>(executor: (resolve: (value: T) => void, reject: (reason: Error) => void) => void): Promise<T> from "new Promise(#)";

@compilerFunc
export function promiseFromExecutor<T>(executor: (resolve: (value: T) => void, reject: (reason: string | Error) => void) => void): Promise<T> {
	return msNewPromise<T>((resolve: (value: T) => void, reject: (reason: Error) => void): void => {
		executor(resolve, (reason: string | Error): void => { reject(raisedError(reason)); });
	});
}

function raisedError(reason: string | Error): Error {
	if (typeof reason === "string") return new Error(reason);
	return reason;
}

extern function msQueueJob(job: () => void): void from "queueMicrotask(#)";

export function promiseFromThenable<S, T>(thenable: S, callThen: (thenable: S, resolve: (value: T) => void, reject: (reason: Error) => void) => void): Promise<T> {
	return msNewPromise<T>((resolve: (value: T) => void, reject: (reason: Error) => void): void => {
		msQueueJob((): void => {
			try {
				callThen(thenable, resolve, reject);
			} catch (e) {
				reject(e);
			}
		});
	});
}

@builtin("PromiseSpawn")
export extern function spawn<T>(fn: () => T): Promise<T> from "Promise.resolve().then(#)";

// sleepAsync — the C twin's msSleepAsync (a timer the exit drain pumps before
// the process ends). On js the native event loop IS the drain: a pending
// setTimeout keeps node alive, so a dropped `sleep-then-print` still runs its
// continuation with the same exit semantics as C.
export extern function sleepAsync(ms: number): Promise<void> from "new Promise((r) => setTimeout(r, #))";

@emit("globalThis.Locked = class Locked { constructor(value) { this.value = value; this.held = false; } };");

extern function msLockedHeldHere<T>(cell: Locked<T>): boolean from "#.held";
extern function msLockedAcquire<T>(cell: Locked<T>): void from "(#.held = true)";
extern function msLockedRelease<T>(cell: Locked<T>): void from "(#.held = false)";
extern function msLockedLoad<T>(cell: Locked<T>): T from "#.value";
extern function msLockedStore<T>(cell: Locked<T>, value: T): void from "(#.value = #)";

export function lockedUpdate<T>(cell: Locked<T>, fn: (value: T) => T): void {
	if (msLockedHeldHere(cell)) throw new Error("lockedUpdate re-entered a Locked cell that this thread already holds");
	msLockedAcquire(cell);
	defer msLockedRelease(cell);
	msLockedStore(cell, fn(msLockedLoad(cell)));
}

export function lockedRead<T, R>(cell: Locked<T>, fn: (value: T) => R): R {
	if (msLockedHeldHere(cell)) throw new Error("lockedRead re-entered a Locked cell that this thread already holds");
	msLockedAcquire(cell);
	defer msLockedRelease(cell);
	return fn(msLockedLoad(cell));
}

// MetaScript Array Prelude — Raiser Backend
// Generic T[] methods only: Raiser values are dynamic, so one generic form
// covers every element type (the C backend monomorphizes per element type
// for native arrays; the VM does not need that). `push` and `setLength` are
// intercepted by the Raiser codegen to the ArrayPush/ArraySetLen opcodes —
// the extern declarations below exist for the checker only, mirroring the
// push pattern. The remaining methods are portable MS over those two ops,
// matching the C kernels' semantics (std/core/array/index.cms).

export class Array<T> {
	length: number;
}

export extern function push<T>(this arr: T[], value: T): void from "&msGenericArrayPush";
export extern function setLength<T>(this arr: T[], newLen: number): void from "&msGenericArraySetLen";

// Negative index support (C kernel contract): -1 reads the last element.
export function at<T>(this arr: T[], idx: number): T {
	let i = idx;
	if (i < 0) i = i + arr.length;
	return arr[i];
}

export function pop<T>(this arr: T[]): T {
	const n = arr.length;
	const v = arr[n - 1];
	arr.setLength(n - 1);
	return v;
}

// The VM heap exposes no allocation size; the live length is the only
// meaningful capacity at comptime.
export function capacity<T>(this arr: T[]): number {
	return arr.length;
}

// Removes deleteCount elements starting at start (clamped).
export function splice<T>(this arr: T[], start: number, deleteCount: number): void {
	const n = arr.length;
	let s = start;
	if (s < 0) s = 0;
	if (s > n) s = n;
	let end = s + deleteCount;
	if (end > n) end = n;
	let dst = s;
	let src = end;
	while (src < n) {
		arr[dst] = arr[src];
		dst = dst + 1;
		src = src + 1;
	}
	arr.setLength(n - (end - s));
}

// Removes deleteCount elements at start, then inserts item at start.
export function splice<T>(this arr: T[], start: number, deleteCount: number, item: T): void {
	splice(arr, start, deleteCount);
	const n = arr.length;
	arr.setLength(n + 1);
	let i = n;
	while (i > start) {
		arr[i] = arr[i - 1];
		i = i - 1;
	}
	arr[start] = item;
}

export function sortBy<T>(this arr: T[], cmp: (a: T, b: T) => number): void {
	const n = arr.length;
	let i = 1;
	while (i < n) {
		const cur = arr[i];
		let j = i - 1;
		while (j >= 0 && cmp(arr[j], cur) > 0) {
			arr[j + 1] = arr[j];
			j = j - 1;
		}
		arr[j + 1] = cur;
		i = i + 1;
	}
}

export function join(this arr: string[], sep: string): string {
	let out = "";
	for (let i = 0; i < arr.length; i = i + 1) {
		if (i > 0) out = out + sep;
		out = out + arr[i];
	}
	return out;
}

// Bodies mirror the .cms generic tier (index.cms:245+) — monomorphized on C,
// dynamic on the VM, same semantics either way.
export function slice<T>(this arr: T[], start: number, end: number): T[] {
	const n = arr.length;
	let lo = start < 0 ? n + start : start;
	let hi = end < 0 ? n + end : end;
	if (lo < 0) { lo = 0; }
	if (hi > n) { hi = n; }
	const out: T[] = [];
	let i = lo;
	while (i < hi) {
		out.push(arr[i]);
		i = i + 1;
	}
	return out;
}

export function indexOf<T>(this arr: T[], value: T): number {
	const n = arr.length;
	let i = 0;
	while (i < n) {
		if (arr[i] == value) return i;
		i = i + 1;
	}
	return -1;
}

export function includes<T>(this arr: T[], value: T): boolean {
	const n = arr.length;
	let i = 0;
	while (i < n) {
		if (arr[i] == value) return true;
		i = i + 1;
	}
	return false;
}

export function count<T>(this arr: T[], value: T): number {
	const n = arr.length;
	let c = 0;
	let i = 0;
	while (i < n) {
		if (arr[i] == value) c = c + 1;
		i = i + 1;
	}
	return c;
}

export function fill<T>(this arr: T[], value: T): void {
	const n = arr.length;
	let i = 0;
	while (i < n) {
		arr[i] = value;
		i = i + 1;
	}
}

export function shift<T>(this arr: T[]): T {
	const v = arr[0];
	arr.splice(0, 1);
	return v;
}

// string ← uint8[] kernel (host bridge; mirrors array/index.cms asString)
export extern function asString(this arr: uint8[]): string from "msAsString";

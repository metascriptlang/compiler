export { toString } from "./shared";
import { spliceStart, spliceCount } from "./shared";

// MetaScript Array Prelude — Raiser Backend
// Generic T[] methods only: Raiser values are dynamic, so one generic form
// covers every element type (the C backend monomorphizes per element type
// for native arrays; the VM does not need that). `push` and `setLength` are
// intercepted by the Raiser codegen to the ArrayPush/ArraySetLen opcodes —
// the extern declarations below exist for the checker only, mirroring the
// push pattern. The remaining methods are portable MS over those two ops,
// matching the C kernels' semantics (std/core/array/index.cms).

@builtin("Array")
export class Array<T> {
	length: number;
}

export extern function push<T>(this arr: T[], sink value: T): void from "&msGenericArrayPush";
export extern function setLength<T>(this arr: T[], newLen: number): void from "&msGenericArraySetLen";

export function shrink<T>(this arr: T[], n: int64): void {
	if (n < 0 || n > arr.length) throw new Error("value " + n + " not in range 0 .. " + arr.length);
	arr.setLength(n as number);
}

// Negative index support (C kernel contract): -1 reads the last element.
export function at<T>(this arr: Vec<T>, idx: number): T {
	let i = idx;
	if (i < 0) i = i + arr.length;
	return arr[i];
}

export function pop<T>(this arr: T[]): T {
	const n = arr.length;
	const v = arr[n - 1];
	arr.setLength(n - 1);
	return v;
}

// The VM heap exposes no allocation size; the live length is the only
// meaningful capacity at comptime.
export function capacity<T>(this arr: Vec<T>): number {
	return arr.length;
}

// Removes deleteCount elements starting at start; a negative start counts from the end.
export function splice<T>(this arr: T[], start: number, deleteCount: number): void {
	const n = arr.length as int64;
	const s = spliceStart(start, n);
	const k = spliceCount(deleteCount, n - s);
	if (k == 0) return;
	let dst = s;
	while (dst + k < n) {
		arr[dst] = arr[dst + k];
		dst = dst + 1;
	}
	arr.setLength((n - k) as number);
}

// Removes deleteCount elements at start, then inserts item at start; a negative start counts from the end.
export function splice<T>(this arr: T[], start: number, deleteCount: number, item: T): void {
	const s = spliceStart(start, arr.length as int64);
	splice(arr, s as number, deleteCount);
	const n = arr.length as int64;
	arr.setLength((n + 1) as number);
	let i = n;
	while (i > s) {
		arr[i] = arr[i - 1];
		i = i - 1;
	}
	arr[s] = item;
}

export function reverse<T>(this arr: T[]): void {
	let lo: int64 = 0;
	let hi = (arr.length as int64) - 1;
	while (lo < hi) {
		const tmp = arr[lo];
		arr[lo] = arr[hi];
		arr[hi] = tmp;
		lo = lo + 1;
		hi = hi - 1;
	}
}

function mergeRuns<T>(a: T[], b: T[], lo: int64, m: int64, hi: int64, cmp: (a: T, b: T) => number): void {
	if (cmp(a[m], a[m + 1]) <= 0) return;
	let j = lo;
	let bb = 0;
	while (j <= m) {
		b[bb] = a[j];
		bb = bb + 1;
		j = j + 1;
	}
	let i = 0;
	let k = lo;
	while (k < j && j <= hi) {
		if (cmp(b[i], a[j]) <= 0) {
			a[k] = b[i];
			i = i + 1;
		} else {
			a[k] = a[j];
			j = j + 1;
		}
		k = k + 1;
	}
	while (k < j) {
		a[k] = b[i];
		k = k + 1;
		i = i + 1;
	}
}

export function sortBy<T>(this arr: T[], cmp: (a: T, b: T) => number): void {
	const n = arr.length;
	if (n < 2) return;
	const half = n / 2;
	const buf: T[] = [];
	for (let q = 0; q < half; q = q + 1) buf.push(arr[0]);
	let s = 1;
	while (s < n) {
		let m = n - 1 - s;
		while (m >= 0) {
			mergeRuns(arr, buf, m - s + 1 > 0 ? m - s + 1 : 0, m, m + s, cmp);
			m = m - s * 2;
		}
		s = s * 2;
	}
}

export function sort(this arr: number[]): void {
	arr.sortBy((a: number, b: number): number => a < b ? -1 : (a > b ? 1 : 0));
}

export function sort(this arr: string[]): void {
	arr.sortBy((a: string, b: string): number => a < b ? -1 : (a > b ? 1 : 0));
}

export function sort<T>(this arr: T[], cmp: (a: T, b: T) => number): void {
	arr.sortBy(cmp);
}

export function join(this arr: Vec<string>, sep: string): string {
	let out = "";
	for (let i = 0; i < arr.length; i = i + 1) {
		if (i > 0) out = out + sep;
		out = out + arr[i];
	}
	return out;
}

export function join<T>(this arr: Vec<T>, sep: string): string {
	let out = "";
	for (let i = 0; i < arr.length; i = i + 1) {
		if (i > 0) out = out + sep;
		out = out + `${arr[i]}`;
	}
	return out;
}

// Bodies mirror the .cms generic tier (index.cms:245+) — monomorphized on C,
// dynamic on the VM, same semantics either way.
/**
 * Calls a function on every element in order and returns the results as a new array.
 * @param fn Mapper receiving the element and its index.
 */
export function map<T, U>(this arr: Vec<T>, fn: (x: T, i: number) => U): U[] {
	const out: U[] = [];
	const n = arr.length;
	for (let i = 0; i < n && i < arr.length; i += 1) {
		out.push(fn(arr[i], i));
	}
	return out;
}

export function slice<T>(this arr: Vec<T>, start: number, end: number = 9007199254740991): T[] {
	const n = arr.length;
	let lo = start < 0 ? n + start : start;
	let hi = end < 0 ? n + end : end;
	if (lo < 0) { lo = 0; }
	if (hi > n) { hi = n; }
	const out: T[] = [];
	let i = lo;
	while (i < hi) {
		out.push(arr[i]);
		i = i + 1;
	}
	return out;
}

export function slice(this view: Readonly<Span<uint8>>, start: number, end: number = 9007199254740991): uint8[] {
	const n = view.length;
	let lo = start < 0 ? n + start : start;
	let hi = end < 0 ? n + end : end;
	if (lo < 0) { lo = 0; }
	if (hi > n) { hi = n; }
	const out: uint8[] = [];
	let i = lo;
	while (i < hi) {
		out.push(view[i]);
		i = i + 1;
	}
	return out;
}

export function concat<T>(this arr: Vec<T>, other: T[]): T[] {
	const out: T[] = [];
	let i = 0;
	while (i < arr.length) {
		out.push(arr[i]);
		i = i + 1;
	}
	let j = 0;
	while (j < other.length) {
		out.push(other[j]);
		j = j + 1;
	}
	return out;
}

export function indexOf<T>(this arr: Vec<T>, value: T): number {
	const n = arr.length;
	let i = 0;
	while (i < n) {
		if (arr[i] == value) return i;
		i = i + 1;
	}
	return -1;
}

export function includes<T>(this arr: Vec<T>, value: T): boolean {
	const n = arr.length;
	let i = 0;
	while (i < n) {
		if (arr[i] == value) return true;
		i = i + 1;
	}
	return false;
}

export { lastIndexOf, findIndex, findLastIndex, filter, some, find, every, reduce, values, keys, entries } from "./shared";
export { map, filter, take, drop, flatMap, reduce, toArray, forEach, some, every, find, chunks, windows, cycle, stepBy, scan, sum } from "./iterator";

export function indexOf(this view: Readonly<Span<uint8>>, value: uint8): number {
	const n = view.length;
	let i = 0;
	while (i < n) {
		if (view[i] == value) return i;
		i = i + 1;
	}
	return -1;
}

export function includes(this view: Readonly<Span<uint8>>, value: uint8): boolean {
	return view.indexOf(value) >= 0;
}

export function count<T>(this arr: Vec<T>, value: T): number {
	const n = arr.length;
	let c = 0;
	let i = 0;
	while (i < n) {
		if (arr[i] == value) c = c + 1;
		i = i + 1;
	}
	return c;
}

export function fill<T>(this arr: T[], value: T): void {
	const n = arr.length;
	let i = 0;
	while (i < n) {
		arr[i] = value;
		i = i + 1;
	}
}

export function shift<T>(this arr: T[]): T {
	const v = arr[0];
	arr.splice(0, 1);
	return v;
}

// string ← uint8[] kernel (host bridge; mirrors array/index.cms asString)
export extern function asString(this arr: Readonly<uint8[]>): string from "msAsString";

export function asString(this view: Readonly<Span<uint8>>): string {
	return view.slice(0).asString();
}

// MetaScript Array Prelude — Raiser Backend
// Generic T[] methods only: Raiser values are dynamic, so one generic form
// covers every element type (the C backend monomorphizes per element type
// for native arrays; the VM does not need that). `push` is intercepted by
// the Raiser codegen to the ArrayPush opcode; the rest resolve to CallHost.
// Mirrors std/core/array/index.cms minus C-only @include/@compile + the
// number[]/string[] specializations.

export class Array<T> {
	length: number;
}

export extern function push<T>(this arr: T[], value: T): void from "&msGenericArrayPush";
export extern function pop<T>(this arr: T[]): T from "&msGenericArrayPop";
export extern function at<T>(this arr: T[], idx: number): T from "&msGenericArrayAt";
export extern function setLength<T>(this arr: T[], newLen: number): void from "&msGenericArraySetLen";
export extern function capacity<T>(this arr: T[]): number from "&msGenericArrayCapacity";
export extern function splice<T>(this arr: T[], start: number, deleteCount: number): void from "&msRefArraySplice";

export function sortBy<T>(this arr: T[], cmp: (a: T, b: T) => number): void {
	const n = arr.length;
	let i = 1;
	while (i < n) {
		const cur = arr[i];
		let j = i - 1;
		while (j >= 0 && cmp(arr[j], cur) > 0) {
			arr[j + 1] = arr[j];
			j = j - 1;
		}
		arr[j + 1] = cur;
		i = i + 1;
	}
}

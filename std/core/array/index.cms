// MetaScript Array Prelude — C Backend
// Extension methods backed by runtime/core/array.h
// Loaded automatically via globalImports() -> "std/core/array"

@include("core/array.h");

// ===== Number Array =====

extern function push(this arr: number[], value: number): void from "&msNumberArrayPush";

extern function pop(this arr: number[]): number from "&msNumberArrayPop";

extern function shift(this arr: number[]): number from "&msNumberArrayShift";

extern function at(this arr: number[], idx: number): number from "&msNumberArrayAt";

extern function indexOf(this arr: number[], value: number): number from "&msNumberArrayIndexOf";

extern function includes(this arr: number[], value: number): boolean from "&msNumberArrayIncludes";

extern function slice(this arr: number[], start: number, end: number): number[] from "&msNumberArraySlice";

extern function concat(this arr: number[], other: number[]): number[] from "&msNumberArrayConcat";

extern function reverse(this arr: number[]): void from "&msNumberArrayReverse";

extern function sort(this arr: number[]): void from "&msNumberArraySort";

extern function fill(this arr: number[], value: number): void from "&msNumberArrayFill";

extern function count(this arr: number[], value: number): number from "&msNumberArrayCount";

extern function join(this arr: number[], sep: string): string from "&msNumberArrayJoin";

extern function setLen(this arr: number[], newLen: number): void from "&msNumberArraySetLen";

extern function capacity(this arr: number[]): number from "&msNumberArrayCapacity";

// ===== String Array =====

extern function push(this arr: string[], value: string): void from "&msStringArrayPush";

extern function pop(this arr: string[]): string from "&msStringArrayPop";

extern function shift(this arr: string[]): string from "&msStringArrayShift";

extern function at(this arr: string[], idx: number): string from "&msStringArrayAt";

extern function indexOf(this arr: string[], value: string): number from "&msStringArrayIndexOf";

extern function includes(this arr: string[], value: string): boolean from "&msStringArrayIncludes";

extern function slice(this arr: string[], start: number, end: number): string[] from "&msStringArraySlice";

extern function concat(this arr: string[], other: string[]): string[] from "&msStringArrayConcat";

extern function reverse(this arr: string[]): void from "&msStringArrayReverse";

extern function sort(this arr: string[]): void from "&msStringArraySort";

extern function fill(this arr: string[], value: string): void from "&msStringArrayFill";

extern function count(this arr: string[], value: string): number from "&msStringArrayCount";

extern function join(this arr: string[], sep: string): string from "&msStringArrayJoin";

extern function setLen(this arr: string[], newLen: number): void from "&msStringArraySetLen";

extern function capacity(this arr: string[]): number from "&msStringArrayCapacity";

// ===== Generic Array (matches any T[] not covered by number[]/string[]) =====
// Uses msGenericArray* macros which work with any MS_ARRAY(T) typedef.
// These are C macros (not functions) that use sizeof(arr->p->data[0]) for type safety.

extern function push<T>(this arr: T[], value: T): void from "&msGenericArrayPush";

extern function pop<T>(this arr: T[]): T from "&msGenericArrayPop";

extern function at<T>(this arr: T[], idx: number): T from "&msGenericArrayAt";

extern function setLen<T>(this arr: T[], newLen: number): void from "&msGenericArraySetLen";

extern function capacity<T>(this arr: T[]): number from "&msGenericArrayCapacity";

// MetaScript Array Prelude — JavaScript Backend
// Array<T> is a native JS type — methods provided by the runtime.

extern class Array<T> {
	length: number;
	extern push(value: T): void;
	extern pop(): T;
	extern shift(): T;
	extern at(idx: number): T;
	extern indexOf(value: T): number;
	extern includes(value: T): boolean;
	extern slice(start: number, end: number): T[];
	extern concat(other: T[]): T[];
	extern reverse(): void;
	extern sort(): void;
	extern fill(value: T): void;
	extern join(sep: string): string;
	extern splice(start: number, deleteCount: number): void;
}

// MetaScript JSON Prelude — C Backend
// Single-file prelude loaded via globalImports(). Contains types, builders,
// accessors, and the typed JSON API (JSON.parse<T>, JSON.stringify<T>).
// Implementation files (parser.ms, stringify.ms) are loaded separately by the
// module system when their symbols are referenced.

// ===== Typed JSON API =====
// Usage: const person = try JSON.parse<Person>(jsonStr);
// @builtin monomorphizes at compile time via builtinLower.

export class JSON {
	@builtin("JsonParse")
	static extern parse<T>(input: string): Result<T, string>;

	@builtin("JsonStringify")
	static extern stringify<T>(value: T): string;
}

// ===== Types =====

export enum JsonKind {
	Null,
	Bool,
	Number,
	String,
	Array,
	Object,
}

export class JsonValue {
	kind: JsonKind;
	boolVal: boolean;
	numVal: number;
	strVal: string;
	arrVal: JsonValue[];
	objKeys: string[];
	objVals: JsonValue[];
}

// ===== Constructors =====

export function jsonNull(): JsonValue {
	return new JsonValue(JsonKind.Null, false, 0, "", [], [], []);
}

export function jsonBool(b: boolean): JsonValue {
	return new JsonValue(JsonKind.Bool, b, 0, "", [], [], []);
}

export function jsonNumber(n: number): JsonValue {
	return new JsonValue(JsonKind.Number, false, n, "", [], [], []);
}

export function jsonString(s: string): JsonValue {
	return new JsonValue(JsonKind.String, false, 0, s, [], [], []);
}

export function jsonArray(items: JsonValue[]): JsonValue {
	return new JsonValue(JsonKind.Array, false, 0, "", items, [], []);
}

export function jsonObjectFromKV(keys: string[], vals: JsonValue[]): JsonValue {
	return new JsonValue(JsonKind.Object, false, 0, "", [], keys, vals);
}

export function jsonObject(): JsonValue {
	return new JsonValue(JsonKind.Object, false, 0, "", [], [], []);
}

// JSON Prelude — auto-loaded, no import needed

// ===== Core Types (from sub-modules, loaded dependency-first) =====

export { JsonKind, JsonValue, JsonValueData } from "./types";
export { jsonNull, jsonBool, jsonNumber, jsonString, jsonArray, jsonObject } from "./builder";
export { stringify, stringifyPretty } from "./stringify";
export { parseJson } from "./parser";
export { asString, asNumber, asBool, asInt, at, length, get } from "./accessors";

// ===== Typed JSON API — @builtin monomorphizes at compile time via builtinLower =====

export class JSON {
	@builtin("JsonParse")
	static extern parse<T>(input: string): Result<T, string>;

	@builtin("JsonStringify")
	static extern stringify<T>(value: T): string;
}

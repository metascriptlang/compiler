// The prelude's typed array classes on the JS backend: the host's own, so a value crosses to a JS API
// with no copy. Their subscripts and methods are index.jms.

export extern class ArrayBuffer {
	byteLength: number;
	constructor(byteLength: number = 0) {}
}

@builtin("TypedArray")
export extern class TypedArray<T> {
	buffer: ArrayBuffer;
	byteOffset: number;
	length: number;
	byteLength: number;
}

export extern class Int8Array extends TypedArray<int8> {
	static BYTES_PER_ELEMENT: number;
	constructor(
		source: number | Readonly<int8[]> | ArrayBuffer = 0,
		byteOffset: number = 0,
		length: number = source instanceof ArrayBuffer ? (source.byteLength % 1 != 0 ? -1 : (source.byteLength - byteOffset) / 1) : 0,
	) {}
}

export extern class Uint8Array extends TypedArray<uint8> {
	static BYTES_PER_ELEMENT: number;
	constructor(
		source: number | Readonly<uint8[]> | ArrayBuffer = 0,
		byteOffset: number = 0,
		length: number = source instanceof ArrayBuffer ? (source.byteLength % 1 != 0 ? -1 : (source.byteLength - byteOffset) / 1) : 0,
	) {}
}

export extern class Uint8ClampedArray extends TypedArray<uint8> {
	static BYTES_PER_ELEMENT: number;
	constructor(
		source: number | Readonly<number[]> | ArrayBuffer = 0,
		byteOffset: number = 0,
		length: number = source instanceof ArrayBuffer ? (source.byteLength % 1 != 0 ? -1 : (source.byteLength - byteOffset) / 1) : 0,
	) {}
}


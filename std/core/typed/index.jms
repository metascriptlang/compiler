// The prelude's typed arrays on the JS backend: the host's own classes, so a value crosses to a
// JS API with no copy. A subscript outside the view stops like an array index does, where the
// host would read undefined and drop the write.

export { ArrayBuffer, TypedArray, Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array } from "./core";
import { ArrayBuffer, TypedArray, Int8Array, Uint8Array, Uint8ClampedArray, Int16Array, Uint16Array, Int32Array, Uint32Array, Float32Array, Float64Array } from "./core";
export { TextEncoder, TextDecoder, TextDecoderOptions, TextDecodeOptions } from "./text";

// A native typed array answers `length` and `[i]` as an array does, so the module reads its
// elements through the array access, which checks the index the same way.
extern function elementsOf<T>(a: Readonly<TypedArray<T>>): Readonly<T[]> from "#";
extern function writableElementsOf<T>(a: TypedArray<T>): T[] from "#";
// The host clamps what a Uint8ClampedArray stores, so its elements take any number.
extern function clampedElementsOf(a: Uint8ClampedArray): number[] from "#";

export extern function slice(this b: ArrayBuffer, begin: number = 0, end: number = b.byteLength): ArrayBuffer from "#.slice(#, #)";

// A view over a buffer whose length is omitted lets the host compute it; a ragged buffer passes -1,
// which the host refuses as the native backends do.

export extern function join<T>(this a: Readonly<TypedArray<T>>, separator: string = ","): string from "#.join(#)";
export extern function toString<T>(this a: Readonly<TypedArray<T>>): string from "#.toString()";

export function `[]`<T>(this a: Readonly<TypedArray<T>>, index: number): T {
	return elementsOf(a)[index];
}

export function `[]=`<T>(this a: TypedArray<T>, index: number, value: T): void {
	writableElementsOf(a)[index] = value;
}

export function `[]=`(this a: Uint8ClampedArray, index: number, value: number): void {
	clampedElementsOf(a)[index] = value;
}

export function set<T>(this a: TypedArray<T>, source: Readonly<Span<T>>, offset: number = 0): void {
	if (offset + source.length > a.length) throw new RangeError("offset is out of bounds");
	const into = writableElementsOf(a);
	for (let i = 0; i < source.length; i++) into[offset + i] = source[i];
}

export function from(this typeof Int8Array, source: Readonly<Span<int8>>): Int8Array {
	const out = new Int8Array(source.length);
	const into = writableElementsOf(out);
	for (let i = 0; i < source.length; i++) into[i] = source[i];
	return out;
}

export extern function subarray(this a: Int8Array, begin: number = 0, end: number = a.length): Int8Array from "#.subarray(#, #)";
export extern function slice(this a: Int8Array, begin: number = 0, end: number = a.length): Int8Array from "#.slice(#, #)";
export extern function fill(this a: Int8Array, value: int8, begin: number = 0, end: number = a.length): Int8Array from "#.fill(#, #, #)";

export function from(this typeof Uint8Array, source: Readonly<Span<uint8>>): Uint8Array {
	const out = new Uint8Array(source.length);
	const into = writableElementsOf(out);
	for (let i = 0; i < source.length; i++) into[i] = source[i];
	return out;
}


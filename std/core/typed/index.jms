export extern function slice(this a: Uint8Array, begin: number = 0, end: number = a.length): Uint8Array from "#.slice(#, #)";
export extern function fill(this a: Uint8Array, value: uint8, begin: number = 0, end: number = a.length): Uint8Array from "#.fill(#, #, #)";

export function from(this typeof Uint8ClampedArray, source: Readonly<Span<number>>): Uint8ClampedArray {
	const out = new Uint8ClampedArray(source.length);
	const into = clampedElementsOf(out);
	for (let i = 0; i < source.length; i++) into[i] = source[i];

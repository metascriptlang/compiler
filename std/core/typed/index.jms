export extern function slice(this a: Uint8ClampedArray, begin: number = 0, end: number = a.length): Uint8ClampedArray from "#.slice(#, #)";
export extern function fill(this a: Uint8ClampedArray, value: number, begin: number = 0, end: number = a.length): Uint8ClampedArray from "#.fill(#, #, #)";


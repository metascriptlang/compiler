// MetaScript Map Prelude — C Backend
// Extension methods backed by runtime/core/map.h
// Loaded automatically via globalImports() -> "std/core/map"

@include("core/map.h");

// ===== Lifecycle =====

extern function mapNew(): Map<string, string> from "msMapNew";

extern function mapDestroy(this m: Map<string, string>): void from "&msMapDestroy";

// ===== Operations =====

extern function set(this m: Map<string, string>, key: string, value: string): void from "&msMapSet";

extern function get(this m: Map<string, string>, key: string): string from "msMapGet";

extern function has(this m: Map<string, string>, key: string): boolean from "msMapHas";

extern function del(this m: Map<string, string>, key: string): boolean from "&msMapDelete";

extern function size(this m: Map<string, string>): number from "msMapSize";

extern function clear(this m: Map<string, string>): void from "&msMapClear";

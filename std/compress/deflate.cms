// std/compress/deflate — gzip / zlib / raw-deflate COMPRESSION.
//
// Import directly as `std/compress/deflate` to leave zip out. Both miniz halves
// compile: miniz.c names each, and lld-link refuses an unresolved name in dropped code.
//
// Wraps runtime/compress/deflate.c which drives miniz's low-level
// tdefl_compress state machine. Exposes one-shot helpers and a streaming
// handle-based API for large inputs.

@passC("-Iruntime/compress");
@include("runtime/compress/deflate.h");
@compile("runtime/compress/deflate.c");
@compile("vendor/miniz/miniz.c");
@compile("vendor/miniz/miniz_tdef.c");
@compile("vendor/miniz/miniz_tinfl.c");

import { adoptBuffer } from "std/core/buffer/bytes";
import { Buffer } from "std/core/buffer";
import { ByteInput } from "std/core/buffer/bytes";
import { CompressError, CompressErrorKind, CompressFormat, compressError } from "./errors";

// Re-export for convenience so callers don't need a separate `./errors` import.
export { CompressFormat, CompressError, CompressErrorKind } from "./errors";

// ===== Extern bindings =====

extern function msDeflateNew(format: int32, level: int32): int64;
extern function msDeflateFeed(handle: int64, chunk: Readonly<Span<uint8>>, isLast: int32): int32;
extern function msDeflateDrain(handle: int64, maxBytes: int32): Vec<uint8>;
extern function msDeflateFree(handle: int64): void;
extern function msDeflateOneShot(data: Readonly<Span<uint8>>, format: int32, level: int32): Vec<uint8>;

function feedBytes(handle: int64, chunk: Readonly<Span<uint8>>, isLast: int32): int32 {
	return msDeflateFeed(handle, chunk, isLast);
}

function oneShot(data: Readonly<Span<uint8>>, format: int32, level: int32): Buffer {
	return adoptBuffer(msDeflateOneShot(data, format, level));
}

// ===== Streaming API =====

// Stream encoder state. Feed chunks with deflateFeed, receive compressed
// output, terminate with deflateFinish.
export interface DeflateStream {
	handle: int64;
	finished: boolean;
}

// Create a streaming deflate context.
//   format: gzip / zlib / raw deflate (default: gzip)
//   level:  0-10 (0 = none, 1 = fastest, 6 = default, 9 = best, 10 = uber)
export function createDeflate(format: CompressFormat = CompressFormat.Gzip, level: int32 = 6): DeflateStream {
	return { handle: msDeflateNew(format as int32, level), finished: false };
}

// Feed a chunk of uncompressed input. Returns any compressed bytes produced
// so far (may be empty while the compressor buffers input internally).
export function deflateFeed<D extends ByteInput>(s: DeflateStream, chunk: D): Result<Buffer, CompressError> {
	return deflateFeedSpan(s, typeof chunk == "string" ? chunk.asBytes() : chunk);
}

function deflateFeedSpan(s: DeflateStream, chunk: Readonly<Span<uint8>>): Result<Buffer, CompressError> {
	if (s.handle == 0) {
		return Result.err(compressError(CompressErrorKind.OutOfMemory, "deflate context allocation failed"));
	}
	if (s.finished) {
		return Result.err(compressError(CompressErrorKind.InvalidInput, "feed after finish"));
	}
	const st = feedBytes(s.handle, chunk, 0);
	if (st < 0) {
		return Result.err(compressError(CompressErrorKind.CompressionFailed, "compression failed"));
	}
	return Result.ok(adoptBuffer(msDeflateDrain(s.handle, 0)));
}

// Signal end of input, flush the compressor, drain the remaining output,
// and release the context. For gzip, appends the CRC32 + ISIZE trailer.
export function deflateFinish(s: DeflateStream): Result<Buffer, CompressError> {
	if (s.handle == 0) {
		return Result.err(compressError(CompressErrorKind.OutOfMemory, "deflate context allocation failed"));
	}
	if (s.finished) return Result.ok(Buffer.alloc(0));
	s.finished = true;
	const st = msDeflateFeed(s.handle, "".asBytes(), 1);
	if (st < 0) {
		msDeflateFree(s.handle);
		s.handle = 0;
		return Result.err(compressError(CompressErrorKind.CompressionFailed, "flush failed"));
	}
	const tail = adoptBuffer(msDeflateDrain(s.handle, 0));
	msDeflateFree(s.handle);
	s.handle = 0;
	return Result.ok(tail);
}

// ===== One-shot helpers =====

// Compress to a complete gzip blob (RFC 1952).
export function gzip<D extends ByteInput>(data: D, level: int32 = 6): Result<Buffer, CompressError> {
	return gzipSpan(typeof data == "string" ? data.asBytes() : data, level);
}

function gzipSpan(data: Readonly<Span<uint8>>, level: int32): Result<Buffer, CompressError> {
	const out = oneShot(data, CompressFormat.Gzip as int32, level);
	if (out.length == 0) {
		return Result.err(compressError(CompressErrorKind.CompressionFailed, "gzip compression failed"));
	}
	return Result.ok(out);
}

// Compress to a zlib-wrapped DEFLATE blob (RFC 1950).
export function deflate<D extends ByteInput>(data: D, level: int32 = 6): Result<Buffer, CompressError> {
	return deflateSpan(typeof data == "string" ? data.asBytes() : data, level);
}

function deflateSpan(data: Readonly<Span<uint8>>, level: int32): Result<Buffer, CompressError> {
	const out = oneShot(data, CompressFormat.Zlib as int32, level);
	if (out.length == 0) {
		return Result.err(compressError(CompressErrorKind.CompressionFailed, "zlib compression failed"));
	}
	return Result.ok(out);
}

// Compress to a raw DEFLATE stream (RFC 1951). Empty input is allowed and
// produces a 2-byte end-of-stream marker.
export function deflateRaw<D extends ByteInput>(data: D, level: int32 = 6): Result<Buffer, CompressError> {
	return deflateRawSpan(typeof data == "string" ? data.asBytes() : data, level);
}

function deflateRawSpan(data: Readonly<Span<uint8>>, level: int32): Result<Buffer, CompressError> {
	const out = oneShot(data, CompressFormat.Deflate as int32, level);
	if (out.length == 0) {
		return Result.err(compressError(CompressErrorKind.CompressionFailed, "deflate compression failed"));
	}
	return Result.ok(out);
}

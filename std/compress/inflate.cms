// std/compress/inflate — gzip / zlib / raw-deflate DECOMPRESSION.
//
// Import directly as `std/compress/inflate` for minimal binaries: only the
// miniz core + tinfl translation units get compiled (~22 KB), no deflate/zip.
//
// Wraps runtime/compress/inflate.c which drives miniz's low-level
// tinfl_decompress state machine. Exposes one-shot helpers and a streaming
// handle-based API for large inputs.

@passC("-Iruntime/compress");
@include("runtime/compress/inflate.h");
@compile("runtime/compress/inflate.c");
@compile("vendor/miniz/miniz.c");
@compile("vendor/miniz/miniz_tinfl.c");

import { Buffer } from "std/core/buffer";
import { Bytes } from "std/core/buffer/bytes";
import { CompressError, CompressErrorKind, CompressFormat, compressError } from "./errors";

// Re-export for convenience so callers don't need a separate `./errors` import.
export { CompressFormat, CompressError, CompressErrorKind } from "./errors";

// ===== Extern bindings =====

extern function msInflateNew(format: int32): int64;
extern function msInflateFeed(handle: int64, chunk: Readonly<Span<uint8>>, isLast: int32): int32;
extern function msInflateDrain(handle: int64, maxBytes: int32): Buffer;
extern function msInflateFree(handle: int64): void;

function feedBytes(handle: int64, chunk: Bytes, isLast: int32): int32 {
	if (typeof chunk == "string") return msInflateFeed(handle, chunk.asBytes(), isLast);
	return msInflateFeed(handle, chunk, isLast);
}

function isEmpty(data: Bytes): boolean {
	if (typeof data == "string") return data.length == 0;
	return data.length == 0;
}

function oneShot(data: Bytes, format: int32, failure: string): Result<Buffer, CompressError> {
	if (isEmpty(data)) {
		return Result.err(compressError(CompressErrorKind.Truncated, "unexpected end of file"));
	}
	const handle = msInflateNew(format);
	if (handle == 0) {
		return Result.err(compressError(CompressErrorKind.OutOfMemory, "inflate context allocation failed"));
	}
	if (feedBytes(handle, data, 1) < 0) {
		msInflateFree(handle);
		return Result.err(compressError(CompressErrorKind.InvalidInput, failure));
	}
	const out = msInflateDrain(handle, 0);
	msInflateFree(handle);
	return Result.ok(out);
}

// ===== Streaming API =====

// Stream decoder state. Feed chunks with inflateFeed, receive decoded output,
// terminate with inflateFinish. Safe for multi-megabyte inputs — internal
// buffering is bounded by miniz's 32 KB LZ window.
export interface InflateStream {
	handle: int64;
	finished: boolean;
}

// Create a streaming inflate context for the given format.
export function createInflate(format: CompressFormat = CompressFormat.Gzip): InflateStream {
	return { handle: msInflateNew(format as int32), finished: false };
}

// Feed a chunk of compressed input. Returns any bytes decoded so far
// (may be empty if more input is needed before any output is produced).
export function inflateFeed(s: InflateStream, chunk: Bytes): Result<Buffer, CompressError> {
	if (s.handle == 0) {
		return Result.err(compressError(CompressErrorKind.OutOfMemory, "inflate context allocation failed"));
	}
	if (s.finished) {
		return Result.err(compressError(CompressErrorKind.InvalidInput, "feed after finish"));
	}
	const st = feedBytes(s.handle, chunk, 0);
	if (st < 0) {
		return Result.err(compressError(CompressErrorKind.InvalidInput, "decompression failed"));
	}
	return Result.ok(msInflateDrain(s.handle, 0));
}

// Signal end of input, drain remaining output, and release the context.
// The InflateStream must not be used after this call.
export function inflateFinish(s: InflateStream): Result<Buffer, CompressError> {
	if (s.handle == 0) {
		return Result.err(compressError(CompressErrorKind.OutOfMemory, "inflate context allocation failed"));
	}
	if (s.finished) return Result.ok(Buffer.alloc(0));
	s.finished = true;
	const st = msInflateFeed(s.handle, "".asBytes(), 1);
	if (st < 0) {
		msInflateFree(s.handle);
		s.handle = 0;
		return Result.err(compressError(CompressErrorKind.Truncated, "stream ended before final block"));
	}
	const tail = msInflateDrain(s.handle, 0);
	msInflateFree(s.handle);
	s.handle = 0;
	return Result.ok(tail);
}

// ===== One-shot helpers =====

// Decompress a complete gzip blob (RFC 1952).
export function gunzip(data: Bytes): Result<Buffer, CompressError> {
	return oneShot(data, CompressFormat.Gzip as int32, "gzip decompression failed");
}

// Decompress a zlib-wrapped DEFLATE blob (RFC 1950).
export function inflate(data: Bytes): Result<Buffer, CompressError> {
	return oneShot(data, CompressFormat.Zlib as int32, "zlib decompression failed");
}

// Decompress a raw DEFLATE stream (RFC 1951).
export function inflateRaw(data: Bytes): Result<Buffer, CompressError> {
	return oneShot(data, CompressFormat.Deflate as int32, "deflate decompression failed");
}

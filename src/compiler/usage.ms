// MetaScript Compiler CLI — Version and usage display

import { bold, cyan, yellow, dim, green } from "../utils/color";

export const VERSION = "0.2.19";

export function printUsage(): void {
	console.log("");
	console.log(bold("Metascript Compiler") + " " + dim("(msc)") + " " + green("v" + VERSION));
	console.log("");
	console.log(yellow("USAGE:"));
	console.log("  msc " + dim("[COMMAND]") + " <file.ms> " + dim("[OPTIONS]"));
	console.log("");
	console.log(yellow("COMMANDS:"));
	console.log("  " + cyan("build") + "                 Build project (reads build.ms)");
	console.log("  " + cyan("build") + " <file>          Build from explicit entry point");
	console.log("  " + cyan("run") + " <file>            Build and run");
	console.log("  " + cyan("test") + " <file>           Run tests");
	console.log("  " + cyan("check") + " <file>          Type check only (no codegen)");
	console.log("  " + cyan("fmt") + " <file>            Format source file");
	console.log("  " + cyan("init") + " [name]            Create new project");
	console.log("  " + cyan("clean") + "                 Remove build artifacts");
	console.log("  " + cyan("lsp") + "                   Start language server");
	console.log("  " + cyan("upgrade") + "               Upgrade msc to the latest release");
	console.log("");
	console.log(yellow("PACKAGE MANAGER:"));
	console.log("  " + cyan("add") + " <name>@<ver>     Add a dependency (registry / file: / git:)");
	console.log("  " + cyan("remove") + " <name>        Remove a dependency");
	console.log("  " + cyan("install") + "              Install locked dependencies");
	console.log("  " + cyan("publish") + "              Publish current package to registry");
	console.log("  " + cyan("login") + "                Authenticate with the registry (GitHub)");
	console.log("  " + cyan("logout") + "               Remove stored credentials");
	console.log("  " + cyan("whoami") + "               Print current user " + dim("(--json for full user object)"));
	console.log("");
	console.log(yellow("VISIBILITY/DEBUGGING:"));
	console.log("  " + cyan("dump-tokens") + " <file>    Show tokenization output");
	console.log("  " + cyan("dump-ast") + " <file>       Show parsed AST");
	console.log("  " + cyan("pipeline") + " <file>       Show compilation pipeline stages");
	console.log("");
	console.log(yellow("OPTIONS:"));
	console.log("  " + cyan("-h") + ", " + cyan("--help") + "            Display this help");
	console.log("  " + cyan("-v") + ", " + cyan("--version") + "         Show version");
	console.log("  " + cyan("--target") + "=<c|js>       Target backend " + dim("(default: c)"));
	console.log("  " + cyan("--output") + "=<file>       Output file path");
	console.log("  " + cyan("-t") + ", " + cyan("--time") + "            Show compilation timing");
	console.log("  " + cyan("--verbose") + "             Verbose phase output");
	console.log("  " + cyan("--error-max") + "=<N>       Stop after N errors " + dim("(0 = all)"));
	console.log("  " + cyan("--colors") + "=<on|off>     Force color output on/off");
	console.log("  " + cyan("--no-color") + "            Disable color output");
	console.log("  " + cyan("--release") + "             Optimize for speed " + dim("(-O2)"));
	console.log("  " + cyan("--danger") + "              Maximum optimization " + dim("(-O3 -flto)"));
	console.log("  " + cyan("--cc") + "=<clang|gcc>      C compiler " + dim("(default: auto-detect)"));
	console.log("  " + cyan("--strip") + "               Strip symbols from binary");
	console.log("  " + cyan("--gc") + "=<mode>           GC mode " + dim("(drc|orc|none|manual)"));
	console.log("  " + cyan("--sanitize") + "=<mode>    Enable sanitizer " + dim("(address|undefined|thread)"));
	console.log("  " + cyan("--passC") + "=<flags>      Extra C compiler flags");
	console.log("  " + cyan("--passL") + "=<flags>      Extra linker flags");
	console.log("  " + cyan("--emit") + "=c             Emit C source only " + dim("(no compile/link)"));
	console.log("  " + cyan("--gendeps") + "             Write .deps file with module paths");
	console.log("  " + cyan("-f") + ", " + cyan("--force") + "           Force full rebuild");
	console.log("");
	console.log(yellow("EXAMPLES:"));
	console.log("  msc build hello.ms                      " + dim("# Build single file to C"));
	console.log("  msc build                               " + dim("# Build project using build.ms"));
	console.log("  msc build --target=js main.ms           " + dim("# Build to JavaScript"));
	console.log("  msc run fibonacci.ms                    " + dim("# Build and run"));
	console.log("  msc test src/index.ms                   " + dim("# Run tests"));
	console.log("  msc check src/index.ms                  " + dim("# Type check only"));
	console.log("  msc dump-ast hello.ms                   " + dim("# Show AST"));
	console.log("");
}

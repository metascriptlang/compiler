// C Header Module — JS backend (Bun FFI → ARO)
//
// Uses bun:ffi to call ARO (Zig C parser) directly — same parser as native backend.
// No bridge.c needed: calls ffi.zig exports (const char*) directly.
//
// Fallback: if dylib not found, uses translateCHeader (pure MetaScript string parser).

import { readFile } from "std/process";
import { mapCType, safeParamName } from "./util";

// ===== ARO FFI Bindings =====

let _aro: any = null;
let _ffi: any = null;
let _aroLoaded = false;
let _aroDir = "";

function loadAro(): boolean {
	if (_aroLoaded) return _aro !== null;
	_aroLoaded = true;

	try {
		_ffi = require("bun:ffi");
		// Resolve paths relative to this module (src/module/aro.jms → src/bindings/aro/)
		_aroDir = __dirname + "/../bindings/aro/zig-out";
		// Platform-appropriate shared library extension
		const suffix = process.platform === "win32" ? "dll" : process.platform === "darwin" ? "dylib" : "so";
		const lib = _ffi.dlopen(_aroDir + `/lib/libaro_ffi.${suffix}`, {
			aroParseHeader:     { args: ["ptr", "ptr", "i32"], returns: "ptr" },
			aroErrorMsg:        { args: ["ptr"], returns: "ptr" },
			aroResultFree:      { args: ["ptr"], returns: "void" },
			// Functions
			aroNumFunctions:    { args: ["ptr"], returns: "i32" },
			aroFnName:          { args: ["ptr", "i32"], returns: "ptr" },
			aroFnReturnType:    { args: ["ptr", "i32"], returns: "ptr" },
			aroFnNumParams:     { args: ["ptr", "i32"], returns: "i32" },
			aroFnParamName:     { args: ["ptr", "i32", "i32"], returns: "ptr" },
			aroFnParamType:     { args: ["ptr", "i32", "i32"], returns: "ptr" },
			aroFnIsVariadic:    { args: ["ptr", "i32"], returns: "bool" },
			// Structs
			aroNumStructs:      { args: ["ptr"], returns: "i32" },
			aroStructName:      { args: ["ptr", "i32"], returns: "ptr" },
			aroStructIsUnion:   { args: ["ptr", "i32"], returns: "bool" },
			aroStructNumFields: { args: ["ptr", "i32"], returns: "i32" },
			aroStructFieldName: { args: ["ptr", "i32", "i32"], returns: "ptr" },
			aroStructFieldType: { args: ["ptr", "i32", "i32"], returns: "ptr" },
			// Enums
			aroNumEnums:        { args: ["ptr"], returns: "i32" },
			aroEnumName:        { args: ["ptr", "i32"], returns: "ptr" },
			aroEnumNumMembers:  { args: ["ptr", "i32"], returns: "i32" },
			aroEnumMemberName:  { args: ["ptr", "i32", "i32"], returns: "ptr" },
			// Typedefs
			aroNumTypedefs:     { args: ["ptr"], returns: "i32" },
			aroTypedefName:     { args: ["ptr", "i32"], returns: "ptr" },
			aroTypedefTarget:   { args: ["ptr", "i32"], returns: "ptr" },
		});
		_aro = lib.symbols;
		return true;
	} catch (e) {
		return false;
	}
}

// Helper: read C string from pointer returned by ARO
function cstr(p: any): string {
	if (!p) return "";
	return new _ffi.CString(p).toString();
}

// Helper: build include dirs array (ARO needs its own builtin headers for stdint.h etc.)
function makeIncludeDirs(headerPath: string): { buf: any; count: number } {
	const dirs: string[] = [];
	// ARO builtin headers (stdint.h, stddef.h, etc.)
	dirs.push(_aroDir + "/include");
	// Header's own directory (for relative #includes)
	const lastSlash = headerPath.lastIndexOf("/");
	if (lastSlash >= 0) dirs.push(headerPath.slice(0, lastSlash));

	// Build C array of char* pointers (8 bytes per pointer on 64-bit platforms)
	const ptrSize = 8;
	const dirBufs = dirs.map(d => Buffer.from(d + "\0"));
	const ptrArray = Buffer.alloc(ptrSize * dirs.length);
	for (let i = 0; i < dirs.length; i++) {
		ptrArray.writeBigUInt64LE(BigInt(_ffi.ptr(dirBufs[i])), i * ptrSize);
	}
	return { buf: ptrArray, count: dirs.length };
}

// ===== ARO-powered parseCHeader =====

function parseCHeaderAro(headerPath: string): string {
	const a = _aro;
	const pathBuf = Buffer.from(headerPath + "\0");
	const inc = makeIncludeDirs(headerPath);
	const result = a.aroParseHeader(pathBuf, inc.buf, inc.count);
	if (result === null) return `// ARO parse error: null result\n`;

	let source = `// Auto-generated from C header: ${headerPath}\n`;

	// === Enums ===
	const enumCount = a.aroNumEnums(result) as number;
	for (let ei = 0; ei < enumCount; ei++) {
		const ename = cstr(a.aroEnumName(result, ei));
		if (ename.length > 0) {
			source = source + `\nexport enum ${ename} {\n`;
			const memberCount = a.aroEnumNumMembers(result, ei) as number;
			for (let mi = 0; mi < memberCount; mi++) {
				source = source + `\t${cstr(a.aroEnumMemberName(result, ei, mi))},\n`;
			}
			source = source + "}\n";
		}
	}

	// === Typedefs ===
	const typedefCount = a.aroNumTypedefs(result) as number;
	for (let ti = 0; ti < typedefCount; ti++) {
		const tname = cstr(a.aroTypedefName(result, ti));
		const ttarget = mapCType(cstr(a.aroTypedefTarget(result, ti)));
		if (tname.length > 0) {
			source = source + `export type ${tname} = ${ttarget};\n`;
		}
	}

	// === Structs ===
	const structCount = a.aroNumStructs(result) as number;
	for (let si = 0; si < structCount; si++) {
		const sname = cstr(a.aroStructName(result, si));
		if (sname.length > 0) {
			source = source + `\nexport extern struct ${sname} {\n`;
			const fieldCount = a.aroStructNumFields(result, si) as number;
			for (let sfi = 0; sfi < fieldCount; sfi++) {
				const fname = cstr(a.aroStructFieldName(result, si, sfi));
				const ftype = mapCType(cstr(a.aroStructFieldType(result, si, sfi)));
				source = source + `\t${fname}: ${ftype};\n`;
			}
			source = source + "}\n";
		}
	}

	// === Functions ===
	const funcCount = a.aroNumFunctions(result) as number;
	for (let fi = 0; fi < funcCount; fi++) {
		const fname = cstr(a.aroFnName(result, fi));
		const retType = mapCType(cstr(a.aroFnReturnType(result, fi)));
		source = source + `export extern function ${fname}(`;

		const paramCount = a.aroFnNumParams(result, fi) as number;
		for (let pi = 0; pi < paramCount; pi++) {
			if (pi > 0) source = source + ", ";
			const pname = safeParamName(cstr(a.aroFnParamName(result, fi, pi)));
			const ptype = mapCType(cstr(a.aroFnParamType(result, fi, pi)));
			source = source + `${pname}: ${ptype}`;
		}

		source = source + `): ${retType};\n`;
	}

	a.aroResultFree(result);
	return source;
}

// ===== Fallback: pure MetaScript string parser =====

function translateCHeader(source: string): string {
	let result = "";
	let pos = 0;

	while (pos < source.length) {
		while (pos < source.length && (source.charCodeAt(pos) <= 32)) pos = pos + 1;
		if (pos >= source.length) break;

		if (pos + 1 < source.length && source.slice(pos, pos + 2) === "//") {
			while (pos < source.length && source.charCodeAt(pos) !== "\n".code) pos = pos + 1;
			continue;
		}
		if (pos + 1 < source.length && source.slice(pos, pos + 2) === "/*") {
			pos = pos + 2;
			while (pos + 1 < source.length && source.slice(pos, pos + 2) !== "*/") pos = pos + 1;
			pos = pos + 2;
			continue;
		}
		if (source.charCodeAt(pos) === "#".code) {
			while (pos < source.length && source.charCodeAt(pos) !== "\n".code) pos = pos + 1;
			continue;
		}

		// typedef struct { ... } Name;
		if (source.slice(pos, pos + 15) === "typedef struct ") {
			const braceStart = source.indexOf("{", pos);
			if (braceStart < 0) { pos = pos + 15; continue; }
			let depth = 1;
			let braceEnd = braceStart + 1;
			while (braceEnd < source.length && depth > 0) {
				if (source.charCodeAt(braceEnd) === "{".code) depth = depth + 1;
				if (source.charCodeAt(braceEnd) === "}".code) depth = depth - 1;
				braceEnd = braceEnd + 1;
			}
			let nameStart = braceEnd;
			while (nameStart < source.length && source.charCodeAt(nameStart) <= 32) nameStart = nameStart + 1;
			let nameEnd = nameStart;
			while (nameEnd < source.length && source.charCodeAt(nameEnd) > 32 && source.charCodeAt(nameEnd) !== ";".code) nameEnd = nameEnd + 1;
			const structName = source.slice(nameStart, nameEnd);

			if (structName.length > 0 && structName !== "{") {
				const fieldsStr = source.slice(braceStart + 1, braceEnd - 1).trim();
				result = result + `export extern struct ${structName} {\n`;
				let fPos = 0;
				while (fPos < fieldsStr.length) {
					while (fPos < fieldsStr.length && fieldsStr.charCodeAt(fPos) <= 32) fPos = fPos + 1;
					if (fPos >= fieldsStr.length) break;
					const semi = fieldsStr.indexOf(";", fPos);
					if (semi < 0) break;
					const fieldDecl = fieldsStr.slice(fPos, semi).trim();
					if (fieldDecl.length > 0) {
						const lastSpace = fieldDecl.lastIndexOf(" ");
						if (lastSpace > 0) {
							const fType = fieldDecl.slice(0, lastSpace).trim();
							const fName = fieldDecl.slice(lastSpace + 1, fieldDecl.length).trim();
							result = result + `\t${fName}: ${mapCType(fType)};\n`;
						}
					}
					fPos = semi + 1;
				}
				result = result + "}\n\n";
			}
			pos = source.indexOf(";", braceEnd);
			if (pos < 0) pos = source.length; else pos = pos + 1;
			continue;
		}

		// Function prototypes (with multi-line join)
		let lineEnd = source.indexOf("\n", pos);
		let line = source.slice(pos, lineEnd >= 0 ? lineEnd : source.length).trim();
		if (line.length > 0 && line.indexOf("(") > 0 && !line.endsWith(";") && !line.endsWith(") {")
			&& !line.startsWith("typedef") && !line.startsWith("#") && !line.startsWith("//")) {
			while (lineEnd >= 0 && !line.endsWith(";") && !line.endsWith(") {")) {
				const nextEnd = source.indexOf("\n", lineEnd + 1);
				const nextPart = source.slice(lineEnd + 1, nextEnd >= 0 ? nextEnd : source.length).trim();
				line = line + " " + nextPart;
				lineEnd = nextEnd;
			}
		}
		let funcLine = line;
		if (funcLine.startsWith("static inline ")) funcLine = funcLine.slice(14, funcLine.length);
		else if (funcLine.startsWith("static ")) funcLine = funcLine.slice(7, funcLine.length);
		else if (funcLine.startsWith("inline ")) funcLine = funcLine.slice(7, funcLine.length);
		else if (funcLine.startsWith("extern ")) funcLine = funcLine.slice(7, funcLine.length);

		if (funcLine.length > 0 && !funcLine.startsWith("typedef")
			&& !funcLine.startsWith("#") && !funcLine.startsWith("extern \"C\"")
			&& !funcLine.startsWith("{") && !funcLine.startsWith("}")
			&& funcLine.indexOf("(") > 0 && (funcLine.endsWith(";") || funcLine.endsWith(") {"))) {
			const hasBody = funcLine.endsWith(") {") || line.endsWith(") {");
			if (hasBody) funcLine = funcLine.slice(0, funcLine.length - 2) + ";";
			const parenOpen = funcLine.indexOf("(");
			const parenClose = funcLine.lastIndexOf(")");
			if (parenOpen > 0 && parenClose > parenOpen) {
				const beforeParen = funcLine.slice(0, parenOpen).trim();
				const lastSp = beforeParen.lastIndexOf(" ");
				if (lastSp > 0) {
					const retType = beforeParen.slice(0, lastSp).trim();
					const funcName = beforeParen.slice(lastSp + 1, beforeParen.length).trim();
					const paramsStr = funcLine.slice(parenOpen + 1, parenClose).trim();

					if (funcName.length > 0 && funcName.charCodeAt(0) !== "*".code) {
						let msParams = "";
						if (paramsStr !== "void" && paramsStr.length > 0) {
							const params = paramsStr.split(",");
							let first = true;
							for (const p of params) {
								const param = p.trim();
								const pLastSp = param.lastIndexOf(" ");
								if (pLastSp > 0) {
									let pType = param.slice(0, pLastSp).trim();
									let pName = param.slice(pLastSp + 1, param.length).trim();
									if (pName.startsWith("*")) {
										pName = pName.slice(1, pName.length);
										pType = pType + "*";
									}
									if (!first) msParams = msParams + ", ";
									msParams = msParams + `${pName}: ${mapCType(pType)}`;
									first = false;
								}
							}
						}
						result = result + `export extern function ${funcName}(${msParams}): ${mapCType(retType)};\n`;
					}
				}
			}
			if (hasBody) {
				let bodyDepth = 1;
				let bodyPos = source.indexOf("{", pos);
				if (bodyPos >= 0) {
					bodyPos = bodyPos + 1;
					while (bodyPos < source.length && bodyDepth > 0) {
						if (source.charCodeAt(bodyPos) === "{".code) bodyDepth = bodyDepth + 1;
						if (source.charCodeAt(bodyPos) === "}".code) bodyDepth = bodyDepth - 1;
						bodyPos = bodyPos + 1;
					}
					pos = bodyPos;
					continue;
				}
			}
		}
		pos = (lineEnd >= 0 ? lineEnd : source.length) + 1;
	}

	return result;
}

// ===== Public API =====

export function parseCHeader(headerPath: string): string {
	if (loadAro()) {
		return parseCHeaderAro(headerPath);
	}
	// Fallback: read file and use string parser
	const source = readFile(headerPath);
	if (source.length === 0) return `// error: could not read ${headerPath}\n`;
	return translateCHeader(source);
}

const overflowInputs: string[] = [
	"9223372036854775808",
	"-9223372036854775809",
	"99999999999999999999999",
	"0x8000000000000000",
	"  -0x10000000000000000xyz",
	"00000000000000000000009223372036854775808",
];
const overflowWant: string[] = [
	"value 9223372036854775808 not in range -9223372036854775808 " +
		".. 9223372036854775807",
	"value -9223372036854775809 not in range -9223372036854775808" +
		" .. 9223372036854775807",
	"value 99999999999999999999999 not in range -9223372036854775" +
		"808 .. 9223372036854775807",
	"value 0x8000000000000000 not in range -9223372036854775808 ." +
		". 9223372036854775807",
	"value -0x10000000000000000 not in range -9223372036854775808" +
		" .. 9223372036854775807",
	"value 00000000000000000000009223372036854775808 not in range" +
		" -9223372036854775808 .. 9223372036854775807",
];

for (let i = 0; i < numberInputs.length; i++) {
	check("Number", i, show(Number(numberInputs[i])), numberWant[i]);
}
for (let i = 0; i < floatInputs.length; i++) {
	check("parseFloat", i, show(floatInputs[i].parseFloat()), floatWant[i]);
}
for (let i = 0; i < intInputs.length; i++) {
	check("parseInt", i, `${intInputs[i].parseInt()}`, intWant[i]);
}
for (let i = 0; i < overflowInputs.length; i++) {
	try {
		check("parseInt overflow", i, `${overflowInputs[i].parseInt()}`, overflowWant[i]);
	} catch (e) {
		check("parseInt overflow", i, e.message, overflowWant[i]);
	}
}
console.log(failures == 0 ? "number text parse done" : `${failures} failures`);

// @stdout: number text parse done
// note: Number(string), parseFloat and parseInt give the answers node gives, on every backend.
// note: parseInt returns int64, so a text with no digits gives 0 and a value past int64 throws.

function show(v: float64): string {
	return v == 0.0 && Math.atan2(v, -1.0) < 0.0 ? "-0" : `${v}`;
}

let failures = 0;

function check(what: string, i: int32, got: string, want: string): void {
	if (got != want) {
		console.log(`FAIL ${what}[${i}] got ${got} want ${want}`);
		failures += 1;
	}
}


// @stdout: 2.2111780289014082 7.188067700007918 6.9087597064926385 2.9524456614523387 9.770086706618915 9.649418517959663 0.9166654141429246 7.926551943304702 7.236761404384283 7.3330078412404225 7.4487869658006005 6.352020182979524 5.037658054120969 5.746151557588343 7.555999642879044 8.855477116629535 9.93400059730626 7.863810144553882 | 8256.233031626221 96.96544592144693 3963.2291264871214 1115.2763902968047 2428.8178713441334 2638.5544828579714 6472.845224249845 879.5251423060106 12.069715054170095 2011.9632464177753 5787.776436412838 437.0185633462122 19.785492001188633 1881.6870092322808 2013.9057819939158 24.746282071512734 4.729592426627503 3244.855013352711 2460.755566958085 2469.750704478865 3169.9906281240874 | 2.9524456614523387 437.0185633462122 2.2111780289014082 2428.8178713441334
// note: `x ** 2` and `x ** 0.5` give the same bits as node on every backend, through a variable exponent, a literal one, Math.pow and a call. These bases are the 39 of a million random pairs where macOS libm's pow lands one ulp away from x*x or sqrt(x).

const roots: number[] = [4.889308275496318, 51.668317259897108, 47.730960682056242, 8.7169353838287389, 95.454594254851628, 93.111277734742885, 0.84027548148581932, 62.830225709907538, 52.370715623985973, 53.773003999693515, 55.48442726188091, 40.348160404979225, 25.377998670249859, 33.018257722774933, 57.093130603188236, 78.419474963149327, 98.684367867281125, 61.839509989588535];
const squares: number[] = [90.863815854421503, 9.84710342798566, 62.954182756089537, 33.39575407588223, 49.283038373705544, 51.366861718991274, 80.453994458012119, 29.656789143567288, 3.4741495440136272, 44.854913291832091, 76.077437104655658, 20.90498895828965, 4.4480885783883206, 43.378416398391963, 44.876561610643876, 4.9745635056266728, 2.1747626138563958, 56.963628863975224, 49.606003335867378, 49.696586446946888, 56.302669813465215];
function power(b: number, e: number): number { return b ** e; }
function row(xs: number[], e: number): string {
	const cells: string[] = [];
	for (const x of xs) {
		const v = x ** e;
		cells.push(v == Math.pow(x, e) && v == power(x, e) ? `${v}` : `${v}!=${Math.pow(x, e)}!=${power(x, e)}`);
	}
	return cells.join(" ");
}
const x = roots[3];
const y = squares[11];
const literal = [`${x ** 0.5}`, `${y ** 2}`, `${4.889308275496318 ** 0.5}`, `${49.283038373705544 ** 2}`].join(" ");
console.log(row(roots, 0.5) + " | " + row(squares, 2) + " | " + literal);

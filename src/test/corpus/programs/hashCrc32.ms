// std/hash crc32 is CRC-32/ISO-HDLC (IEEE 802.3) on every backend: the standard check value, empty input,
// incremental update, byte-span input, and the RFC 5769 §2.1 STUN sample request, whose FINGERPRINT is
// crc32(message before the attribute) ^ 0x5354554e.
// @stdout: check cbf43926 | empty 0 | split cbf43926 | bytes cbf43926
// @stdout: stun e57a3bcf true

import { crc32, crc32Update } from "std/hash";

const sample: uint8[] = [
	0x00, 0x01, 0x00, 0x58, 0x21, 0x12, 0xa4, 0x42, 0xb7, 0xe7, 0xa7, 0x01, 0xbc, 0x34, 0xd6, 0x86, 0xfa, 0x87, 0xdf, 0xae,
	0x80, 0x22, 0x00, 0x10, 0x53, 0x54, 0x55, 0x4e, 0x20, 0x74, 0x65, 0x73, 0x74, 0x20, 0x63, 0x6c, 0x69, 0x65, 0x6e, 0x74,
	0x00, 0x24, 0x00, 0x04, 0x6e, 0x00, 0x01, 0xff,
	0x80, 0x29, 0x00, 0x08, 0x93, 0x2f, 0xf9, 0xb1, 0x51, 0x26, 0x3b, 0x36,
	0x00, 0x06, 0x00, 0x09, 0x65, 0x76, 0x74, 0x6a, 0x3a, 0x68, 0x36, 0x76, 0x59, 0x20, 0x20, 0x20,
	0x00, 0x08, 0x00, 0x14, 0x9a, 0xea, 0xa7, 0x0c, 0xbf, 0xd8, 0xcb, 0x56, 0x78, 0x1e, 0xf2, 0xb5, 0xb2, 0xd3, 0xf2, 0x49, 0xc1, 0xb5, 0x71, 0xa2,
	0x80, 0x28, 0x00, 0x04, 0xe5, 0x7a, 0x3b, 0xcf,
];

const head = sample.slice(0, 100);
const fingerprint: uint32 = crc32Update(0, head) ^ (0x5354554e as uint32);
const carried: uint32 = ((sample[104] as uint32) << 24) | ((sample[105] as uint32) << 16) | ((sample[106] as uint32) << 8) | (sample[107] as uint32);

console.log(`check ${crc32("123456789").toString(16)} | empty ${crc32("")} | split ${crc32Update(crc32("1234"), "56789".asBytes()).toString(16)} | bytes ${crc32("123456789".asBytes()).toString(16)}`);
console.log(`stun ${fingerprint.toString(16)} ${fingerprint == carried}`);

// note: BigInt(number) keeps every bit of an integral float64, from 2^53 to the largest float64, and radix 36 digits agree on both backends.

const nums: number[] = [
	9007199254740992, -9007199254740992, 1e21, 1.1805916207174113e21, 1.7976931348623157e308, -1e300, -0, 0,
	1.2345678901234568e20, 1.8446744073709552e19, 4503599627370497,
];
let dec = "big";
let base36 = "big36";
for (const n of nums) {
	const b = BigInt(n);
	dec += ` ${b}`;
	base36 += ` ${b.toString(36)}`;
}
console.log(dec);
console.log(base36);

const cases: number[][] = [[152, 143, 152, 172, 240, 240, 244], [194, 193, 240, 244, 144, 255, 245, 240, 193], [240], [192, 128, 143, 240], [], [160, 240, 255, 130, 245, 255, 193, 245, 65], [128, 127, 127, 194, 128, 223, 245, 65], [237, 240, 144, 159, 194, 244, 223], [144, 65, 98, 128], [255, 224, 239, 143, 159, 128, 226], [237, 172, 223, 244], [65, 128, 144, 172], [160], [152], [160, 128, 65, 152], [], [194, 127, 144], [226, 160, 239, 128, 144, 255], [172, 98, 224], [128, 160, 237, 65, 239], [192], [226, 191, 65], [], [240, 144, 193, 98, 143, 194, 240], [194, 130, 172, 192, 239, 255, 160, 191], [239, 194, 65, 224, 152, 240], [160, 128, 65, 194, 193, 160, 152, 245, 255], [191, 127, 192, 194, 240, 224, 65, 172, 245], [159, 160, 160, 128, 128], [194], [255, 223, 65, 245, 159, 159, 245, 240, 192], [144, 159, 144, 192, 152, 160, 193, 255, 192], [223, 159, 245, 223], [193, 130, 255], [194, 98, 160, 128, 144, 245, 128, 239], [], [191], [], [224, 223, 130, 226, 160, 224, 239, 159], [144, 160, 244, 193, 130, 128, 192, 223, 144], [255, 152, 245, 245, 128, 224, 194, 194], [], [224], [240, 223, 127, 127, 193, 160], [244, 144, 192, 128, 159], [128, 240], [98, 130, 226, 244, 144], [144, 127], [], [159, 226, 160, 127, 65, 245, 255], [144], [130], [237, 192, 128, 128], [143, 159, 130, 127, 128, 130, 130], [240, 237], [128, 98, 144, 128, 128], [240, 65, 152, 144, 144, 65], [98, 160, 160, 144, 65, 245, 128, 128, 128], [224], [130, 237, 160, 130, 226, 144]];
function codes(s: string): string { let o = ""; for (let i = 0; i < s.length; i++) o += s.charCodeAt(i).toString(16) + "."; return o; }
let out = "";

// @stdout: |a|ab|abc|abcdefghij|abcdefghij0|abcdefghij1|b|z|é|퟿|𐀀x|😀||￿
const xs = ["b", "a", "", "ab", "abc", "\u{1F600}", "", "￿", "é", "z", "abcdefghij1", "abcdefghij0", "abcdefghij", "\u{10000}x", "퟿"];
let line = "";
for (const a of xs) for (const b of xs) line += (a < b ? "<" : a == b ? "=" : ">") + (a <= b ? "1" : "0");
console.log(line);
const s = xs.slice(0); s.sort(); console.log(s.join("|"));

// @stdout: appended 18 0,65,127,128,233,2047,2048,8364,55295,55296,56320,65535,55296,56320,55357,56832,56319,57343
import { fromCodePoint } from "std/core/string";

function codes(s: string): string {
	if (s.length == 0) return "-";
	let acc = "";
	for (let i = 0; i < s.length; i++) acc += (i == 0 ? "" : ",") + s.charCodeAt(i).toString();
	return acc;
}

const samples: string[] = ["", "abc", "é", "日本", "aé日😀b", "😀😀", "x\uD83D", "\uDE00y", "\uD800"];
const indices: int32[] = [-100, -3, -2, -1, 0, 1, 2, 3, 4, 5, 6, 7, 100];
const bounds: int32[] = [-100, -4, -1, 0, 1, 2, 3, 4, 5, 6, 100];

for (const s of samples) {
	console.log("length " + s.length.toString() + " " + codes(s));
	let at = "charAt";
	let code = "charCodeAt";
	for (const i of indices) {
		at += " " + codes(s.charAt(i));
		code += " " + s.charCodeAt(i).toString();
	}
	console.log(at);
	console.log(code);
	for (const a of bounds) {
		let row = "slice " + a.toString() + ":";
		let sub = "substring " + a.toString() + ":";
		for (const b of bounds) {
			row += " " + codes(s.slice(a, b));
			sub += " " + codes(s.substring(a, b));
		}
		console.log(row);
		console.log(sub);
		console.log("slice " + a.toString() + " to end " + codes(s.slice(a)) + " | " + codes(s.substring(a)));
	}
}

const points: int32[] = [0, 65, 127, 128, 233, 2047, 2048, 8364, 55295, 55296, 56320, 65535, 65536, 128512, 1114111];
let built = "";
for (const cp of points) {
	const one = fromCodePoint(cp);
	built += fromCodePoint(cp);
	console.log("fromCodePoint " + cp.toString() + " " + one.length.toString() + " " + codes(one));
}
console.log("appended " + built.length.toString() + " " + codes(built));

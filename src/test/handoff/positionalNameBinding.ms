import { strictErrorCount } from "./helpers";

test "positionalNameBinding: flow narrowing identifies a name by the declaration its position resolves to" {
	const cases = [
		{ name: "a loop-carried assignment at the bottom reaches the read at the top", source: "interface Item { name: string; }\nfunction run(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\tfound = x;\n\t}\n}\n", expected: 0 },
		{ name: "a loop that never assigns the variable leaves the read unreachable", source: "interface Item { name: string; }\nfunction run(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\tconsole.log(x.name);\n\t}\n}\n", expected: -1 },
		{ name: "an inner block that redeclares the name does not assign the outer variable", source: "interface Item { name: string; }\nfunction run(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\t{\n\t\t\tlet found: Item | null = null;\n\t\t\tfound = x;\n\t\t\tconsole.log(found != null ? \"set\" : \"null\");\n\t\t}\n\t}\n}\n", expected: -1 },
		{ name: "an inner for loop that declares the name does not assign the outer variable", source: "interface Item { name: string; }\nfunction run(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\tfor (let found: Item | null = null; found == null; found = x) {\n\t\t\tconsole.log(x.name);\n\t\t}\n\t}\n}\n", expected: -1 },
		{ name: "a for-of binding that reuses the name leaves the outer variable unassigned", source: "interface Item { name: string; }\nfunction run(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\tfor (const found of items) {\n\t\t\tconsole.log(found.name + x.name);\n\t\t}\n\t}\n}\n", expected: -1 },
		{ name: "a shadowing declaration in the loop body still lets the outer assignment reach the head", source: "interface Item { name: string; }\nfunction run(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\t{\n\t\t\tlet found: Item | null = null;\n\t\t\tfound = x;\n\t\t\tconsole.log(found != null ? \"set\" : \"null\");\n\t\t}\n\t\tfound = x;\n\t}\n}\n", expected: 0 },
		{ name: "the back edge of a C-style for, while and do-while loop binds the same way", source: "interface Item { name: string; }\nfunction cfor(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (let i = 0; i < items.length; i += 1) {\n\t\tif (found != null) console.log(found.name);\n\t\tfound = items[i];\n\t}\n}\nfunction whileLoop(items: Item[]): void {\n\tlet found: Item | null = null;\n\tlet i = 0;\n\twhile (i < items.length) {\n\t\tif (found != null) console.log(found.name);\n\t\tfound = items[i];\n\t\ti += 1;\n\t}\n}\nfunction doWhile(items: Item[]): void {\n\tlet found: Item | null = null;\n\tlet i = 0;\n\tdo {\n\t\tif (found != null) console.log(found.name);\n\t\tfound = items[i];\n\t\ti += 1;\n\t} while (i < items.length);\n}\n", expected: 0 },
		{ name: "a parameter, a module variable and a module-level loop bind by position", source: "interface Item { name: string; }\nlet shared: Item | null = null;\nfunction viaParam(items: Item[], found: Item | null): void {\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\tfound = x;\n\t}\n}\nfunction viaModule(items: Item[]): void {\n\tfor (const x of items) {\n\t\tif (shared != null) console.log(shared.name);\n\t\tshared = x;\n\t}\n}\nlet top: Item | null = null;\nconst seeds: Item[] = [{ name: \"a\" }];\nfor (const x of seeds) {\n\tif (top != null) console.log(top.name);\n\ttop = x;\n}\n", expected: 0 },
		{ name: "a lambda, a method and a generic function bind their own bodies", source: "interface Item { name: string; }\nconst viaLambda = (items: Item[]): void => {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\tfound = x;\n\t}\n};\nclass Runner {\n\trun(items: Item[]): void {\n\t\tlet found: Item | null = null;\n\t\tfor (const x of items) {\n\t\t\tif (found != null) console.log(found.name);\n\t\t\tfound = x;\n\t\t}\n\t}\n}\nfunction viaGeneric<T>(items: T[]): void {\n\tlet found: T | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(\"had\");\n\t\tfound = x;\n\t}\n}\nviaGeneric([{ name: \"a\" }]);\n", expected: 0 },
		{ name: "a redeclaration one loop deeper does not assign the outer variable", source: "interface Item { name: string; }\nfunction run(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\tfor (const y of items) {\n\t\t\twhile (y.name == \"\") {\n\t\t\t\tlet found: Item | null = null;\n\t\t\t\tfound = x;\n\t\t\t\tconsole.log(found != null ? \"set\" : \"null\");\n\t\t\t}\n\t\t}\n\t}\n}\n", expected: -1 },
		{ name: "a lambda parameter that reuses the name does not assign the outer variable", source: "interface Item { name: string; }\nfunction run(items: Item[]): void {\n\tlet found: Item | null = null;\n\tfor (const x of items) {\n\t\tif (found != null) console.log(found.name);\n\t\tconst inner = (found: Item | null): void => { found = x; };\n\t\tinner(null);\n\t}\n}\n", expected: -1 },
		{ name: "a write through a member chain on the back edge drops the narrowing", source: "interface Item { name: string; }\ninterface Link { v: string; next: Link | null; }\nfunction run(n: Link, other: Link): void {\n\tfor (let i = 0; i < 2; i += 1) {\n\t\tif (n.next != null) console.log(n.next.v);\n\t\tn.next = other;\n\t}\n}\n", expected: 0 },
		{ name: "a read before the declaration of a block-scoped name stays refused", source: "interface Item { name: string; }\nfunction run(): void {\n\tconsole.log(a);\n\tlet a = \"x\";\n}\n", expected: -1 },
	];
	for (const item of cases) {
		const errors = strictErrorCount(item.source);
		assert item.expected < 0 ? errors > 0 : errors == item.expected, item.name;
	}
}

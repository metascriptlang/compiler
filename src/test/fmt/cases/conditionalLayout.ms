import { fmt } from "../roundtrip";

test "fmt: a conditional chain breaks as one group and a parenthesized one indents its test or member chain" {
	assert fmt("const message = isErrorrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr ? \"an error happened while processing request\" : isWarning ? \"warn\" : \"fine\";\n") == "const message = isErrorrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr\n\t? \"an error happened while processing request\"\n\t: isWarning\n\t\t? \"warn\"\n\t\t: \"fine\";\n";
	assert fmt("const m2 = isErrorrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr ? isWarningggggggggggggggg ? \"a\" : \"b\" : isOther ? \"c\" : \"dddddddddddddd\";\n") == "const m2 = isErrorrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr\n\t? isWarningggggggggggggggg\n\t\t? \"a\"\n\t\t: \"b\"\n\t: isOther\n\t\t? \"c\"\n\t\t: \"dddddddddddddd\";\n";
	assert fmt("const nested = conditionNumberOne ? conditionNumberTwo ? resultNumberOneeeeeeeeeeeeeeeee : resultNumberTwoooooooooooooo : resultNumberThreeeeeeeeeeeeeee;\n") == "const nested = conditionNumberOne\n\t? conditionNumberTwo\n\t\t? resultNumberOneeeeeeeeeeeeeeeee\n\t\t: resultNumberTwoooooooooooooo\n\t: resultNumberThreeeeeeeeeeeeeee;\n";
	assert fmt("const testNested = (conditionNumberOne ? conditionNumberTwo : conditionNumberThreeeeeeeeeeeeeeeeeeeeeeeeeeeee) ? resultNumberOne : resultNumberTwo;\n") == "const testNested = (\n\tconditionNumberOne\n\t\t? conditionNumberTwo\n\t\t: conditionNumberThreeeeeeeeeeeeeeeeeeeeeeeeeeeee\n)\n\t? resultNumberOne\n\t: resultNumberTwo;\n";
	assert fmt("const memberCond = (conditionNumberOne ? someObjectNumberOneeeeeeeeeeeeee : someObjectNumberTwooooooooooooooooooo).member;\n") == "const memberCond = (\n\tconditionNumberOne\n\t\t? someObjectNumberOneeeeeeeeeeeeee\n\t\t: someObjectNumberTwooooooooooooooooooo\n).member;\n";
	assert fmt("function f() { return (conditionNumberOne ? someObjectNumberOneeeeeeeeeeeeee : someObjectNumberTwooooooooooooooooooo).member.other; }\n") == "function f() {\n\treturn (\n\t\tconditionNumberOne\n\t\t\t? someObjectNumberOneeeeeeeeeeeeee\n\t\t\t: someObjectNumberTwooooooooooooooooooo\n\t).member.other;\n}\n";
	assert fmt("const h = !(conditionNumberOne ? someObjectNumberOneeeeeeeeeeeeee : someObjectNumberTwooooooooooooooooooooooooo);\n") == "const h = !(conditionNumberOne\n\t? someObjectNumberOneeeeeeeeeeeeee\n\t: someObjectNumberTwooooooooooooooooooooooooo);\n";
	assert fmt("const j = (conditionNumberOne ? someObjectNumberOneeeeeeeeeeeeee : someObjectNumberTwooooooooooooooooooooo)[0].x;\n") == "const j = (\n\tconditionNumberOne\n\t\t? someObjectNumberOneeeeeeeeeeeeee\n\t\t: someObjectNumberTwooooooooooooooooooooo\n)[0].x;\n";
	assert fmt("const n = aaaaaaaaaaaaaaaaaaaaaaaaaaa && bbbbbbbbbbbbbbbbbbbbbbbbbbbbbb && cccccccccccccccccccccccc ? dddddddddd : eeeeeeeeeeeeee;\n") == "const n =\n\taaaaaaaaaaaaaaaaaaaaaaaaaaa &&\n\tbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb &&\n\tcccccccccccccccccccccccc\n\t\t? dddddddddd\n\t\t: eeeeeeeeeeeeee;\n";
	assert fmt("const l = cond ? someFunction(argumentNumberOne, argumentNumberTwo, argumentNumberThree, argumentNumber4) : null;\n") == "const l = cond\n\t? someFunction(\n\t\t\targumentNumberOne,\n\t\t\targumentNumberTwo,\n\t\t\targumentNumberThree,\n\t\t\targumentNumber4,\n\t\t)\n\t: null;\n";
}

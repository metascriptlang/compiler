{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"$(git -C \"$CLAUDE_PROJECT_DIR\" worktree list --porcelain | sed -n \"1s/^worktree //p\")/tools/wt.sh\" hook-create'"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"$(git -C \"$CLAUDE_PROJECT_DIR\" worktree list --porcelain | sed -n \"1s/^worktree //p\")/tools/wt.sh\" hook-remove'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec \"$(git -C \"$CLAUDE_PROJECT_DIR\" worktree list --porcelain | sed -n \"1s/^worktree //p\")/tools/wt.sh\" hook-session'"
          }
        ]
      }
    ]
  }
}

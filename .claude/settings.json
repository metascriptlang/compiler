{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$HOME/nerdtools/claude/tools/wt.sh\" hook-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$HOME/nerdtools/claude/tools/wt.sh\" hook-remove"
          }
        ]
      }
    ]
  }
}
